+"""Apply patches to a directory tree."""
+
+from dataclasses import dataclass
+from pathlib import Path
+
+from .digest import digest_bytes, digests_equal
+from .ops import ordered, parse_ops
+from .paths import resolve_within
+
+__all__ = [
+    "PatchError",
+    "PreconditionError",
+    "PatchFailed",
+    "PatchReport",
+    "apply_patch",
+    "apply_ops",
+]
+
+
+class PatchError(Exception):
+    """Base class for patch application failures."""
+
+
+class PreconditionError(PatchError):
+    """Raised when the tree does not match the expected state."""
+
+
+class PatchFailed(PatchError):
+    """Raised when phase 2 failed and the tree was rolled back."""
+
+    def __init__(self, path, cause, message=None):
+        if message is None:
+            message = "patch failed at %s: %s" % (path, cause)
+        super().__init__(message)
+        self.path = path
+        self.cause = cause
+        self.rolled_back = True
+
+
+@dataclass(frozen=True)
+class PatchReport:
+    applied: tuple
+    digests: tuple
+    bytes_written: int
+    dry_run: bool
+
+    def paths(self):
+        """Return the touched paths in applied order."""
+        return [path for _kind, path in self.applied]
+
+    def digest_map(self):
+        """Return a fresh dict of path -> digest."""
+        return dict(self.digests)
+
+
+def _default_writer(path, data):
+    with open(path, "wb") as handle:
+        handle.write(data)
+
+
+def _default_remover(path):
+    path.unlink()
+
+
+def _created_dirs(target):
+    """Return the parent directories of *target* that do not exist yet.
+
+    Deepest last.
+    """
+    missing = []
+    parent = target.parent
+    while not parent.exists():
+        missing.append(parent)
+        new_parent = parent.parent
+        if new_parent == parent:
+            break
+        parent = new_parent
+    missing.reverse()
+    return missing
+
+
+def apply_patch(root, raw_ops, *, dry_run=False, writer=None, remover=None):
+    """Apply *raw_ops* under *root* and return a PatchReport."""
+    ops = ordered(parse_ops(raw_ops))
+
+    base = Path(root)
+    if not base.is_dir():
+        raise PreconditionError("root is not an existing directory: %s" % (root,))
+
+    write = _default_writer if writer is None else writer
+    remove = _default_remover if remover is None else remover
+
+    targets = []
+    for op in ops:
+        target = resolve_within(base, op.path)
+        targets.append(target)
+        if op.kind == "add":
+            if target.exists() or target.is_symlink():
+                raise PreconditionError("already exists: %s" % op.path)
+        else:
+            if not target.is_file():
+                raise PreconditionError("not an existing file: %s" % op.path)
+            if op.expect is not None:
+                actual = digest_bytes(target.read_bytes())
+                if not digests_equal(actual, op.expect):
+                    raise PreconditionError("digest mismatch: %s" % op.path)
+
+    applied = []
+    digests = []
+    written = 0
+    for op in ops:
+        applied.append((op.kind, op.path))
+        if op.kind != "delete":
+            digests.append((op.path, digest_bytes(op.data)))
+            if not dry_run:
+                written += len(op.data)
+    digests.sort(key=lambda pair: pair[0])
+
+    if dry_run:
+        return PatchReport(tuple(applied), tuple(digests), 0, True)
+
+    saved = {}  # target -> bytes or None (did not exist)
+    created_files = []
+    created_dirs = []
+
+    def _rollback():
+        for path in reversed(created_files):
+            try:
+                if path.is_file() or path.is_symlink():
+                    path.unlink()
+            except OSError:
+                pass
+        for path, blob in saved.items():
+            if blob is None:
+                continue
+            try:
+                with open(path, "wb") as handle:
+                    handle.write(blob)
+            except OSError:
+                pass
+        for path in sorted(set(created_dirs), key=lambda p: len(p.parts), reverse=True):
+            try:
+                if path.is_dir():
+                    path.rmdir()
+            except OSError:
+                pass
+
+    for op, target in zip(ops, targets):
+        try:
+            if op.kind == "delete":
+                saved[target] = target.read_bytes()
+                remove(target)
+            else:
+                for missing in _created_dirs(target):
+                    missing.mkdir()
+                    created_dirs.append(missing)
+                if target.exists():
+                    saved[target] = target.read_bytes()
+                else:
+                    saved.setdefault(target, None)
+                    created_files.append(target)
+                write(target, op.data)
+        except Exception as exc:  # noqa: BLE001 - rollback then re-raise
+            _rollback()
+            raise PatchFailed(op.path, exc) from exc
+
+    return PatchReport(tuple(applied), tuple(digests), written, False)
+
+
+def apply_ops(root, raw_ops):
+    """Legacy entry point returning the touched paths."""
+    return list(apply_patch(root, raw_ops).paths())
