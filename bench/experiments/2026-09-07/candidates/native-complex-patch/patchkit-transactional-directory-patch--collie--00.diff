+"""Relative path validation for patch targets."""
+
+from pathlib import Path
+
+__all__ = ["PathError", "normalize_relpath", "is_safe_relpath", "resolve_within"]
+
+
+class PathError(ValueError):
+    """Raised when a patch target is not a safe relative path."""
+
+
+def normalize_relpath(raw):
+    """Return the normalized POSIX form of a safe relative path."""
+    if not isinstance(raw, str):
+        raise PathError("path must be a string")
+    if raw == "":
+        raise PathError("empty path")
+    if "\x00" in raw:
+        raise PathError("NUL character in path: %r" % (raw,))
+    if "\\" in raw:
+        raise PathError("backslash in path: %r" % (raw,))
+    if raw.startswith("/"):
+        raise PathError("absolute path: %r" % (raw,))
+    if len(raw) >= 2 and raw[1] == ":":
+        raise PathError("drive-qualified path: %r" % (raw,))
+
+    segments = raw.split("/")
+    parts = []
+    for seg in segments:
+        if seg == "":
+            raise PathError("empty segment in path: %r" % (raw,))
+        if seg == "..":
+            raise PathError("parent traversal: %r" % (raw,))
+        if seg == ".":
+            continue
+        parts.append(seg)
+    if not parts:
+        raise PathError("empty path: %r" % (raw,))
+    return "/".join(parts)
+
+
+def is_safe_relpath(raw):
+    """Return True when *raw* is a safe relative path."""
+    try:
+        normalize_relpath(raw)
+    except PathError:
+        return False
+    except Exception:
+        return False
+    return True
+
+
+def resolve_within(root, raw):
+    """Return the concrete path of *raw* inside *root*."""
+    rel = normalize_relpath(raw)
+    return Path(root).joinpath(*rel.split("/"))
