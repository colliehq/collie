+"""Patch operation records."""
+
+from dataclasses import dataclass
+from typing import Optional
+
+from .digest import parse_digest
+from .paths import normalize_relpath
+
+__all__ = ["KINDS", "ORDER", "OpError", "Op", "parse_ops", "ordered"]
+
+KINDS = ("add", "update", "delete")
+
+ORDER = {"delete": 0, "update": 1, "add": 2}
+
+_ALLOWED_KEYS = frozenset({"kind", "path", "data", "expect"})
+
+
+class OpError(ValueError):
+    """Raised when a raw operation is malformed."""
+
+
+@dataclass(frozen=True)
+class Op:
+    kind: str
+    path: str
+    data: Optional[bytes] = None
+    expect: Optional[str] = None
+
+
+def _validate(kind, path, data, expect):
+    if not isinstance(kind, str) or kind not in KINDS:
+        raise OpError("unknown kind: %r" % (kind,))
+    # PathError propagates unchanged.
+    norm = normalize_relpath(path)
+    if kind == "delete":
+        if data is not None:
+            raise OpError("delete must not carry data: %s" % norm)
+        snapshot = None
+    else:
+        if not isinstance(data, (bytes, bytearray, memoryview)):
+            raise OpError("%s requires bytes-like data: %s" % (kind, norm))
+        snapshot = bytes(data)
+    if kind == "add" and expect is not None:
+        raise OpError("add must not carry expect: %s" % norm)
+    if expect is not None:
+        if not isinstance(expect, str):
+            raise OpError("expect must be a string: %s" % norm)
+        try:
+            parse_digest(expect)
+        except ValueError as exc:
+            raise OpError("bad expect digest for %s: %s" % (norm, exc)) from exc
+    return Op(kind, norm, snapshot, expect)
+
+
+def parse_ops(raw_ops):
+    """Return a tuple of validated Op records built from *raw_ops*."""
+    if isinstance(raw_ops, (str, bytes, bytearray)):
+        raise OpError("raw_ops must be an iterable of operations")
+    try:
+        items = list(raw_ops)
+    except TypeError as exc:
+        raise OpError("raw_ops must be iterable") from exc
+
+    ops = []
+    seen = {}
+    for raw in items:
+        if isinstance(raw, Op):
+            kind, path, data, expect = raw.kind, raw.path, raw.data, raw.expect
+        elif hasattr(raw, "keys") and hasattr(raw, "__getitem__"):
+            keys = set(raw.keys())
+            extra = keys - _ALLOWED_KEYS
+            if extra:
+                raise OpError("unknown keys: %s" % ", ".join(sorted(map(str, extra))))
+            kind = raw["kind"] if "kind" in keys else None
+            path = raw["path"] if "path" in keys else None
+            data = raw["data"] if "data" in keys else None
+            expect = raw["expect"] if "expect" in keys else None
+        else:
+            raise OpError("operation must be an Op or a mapping: %r" % (raw,))
+        op = _validate(kind, path, data, expect)
+        if op.path in seen:
+            raise OpError("duplicate path: %s" % op.path)
+        seen[op.path] = True
+        ops.append(op)
+    return tuple(ops)
+
+
+def ordered(ops):
+    """Return ops in the order they must be applied."""
+    return tuple(sorted(ops, key=lambda op: (ORDER[op.kind], op.path)))
