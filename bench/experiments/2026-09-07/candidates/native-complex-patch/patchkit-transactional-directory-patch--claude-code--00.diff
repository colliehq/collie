+def parse_digest(text):
+    """Return the ``(algorithm, hex)`` pair encoded by *text*."""
+    if not isinstance(text, str):
+        raise ValueError("digest must be a string, got %r" % (type(text).__name__,))
+    if ":" in text:
+        algorithm, _, hexpart = text.partition(":")
+    else:
+        algorithm, hexpart = ALGORITHM, text
+    algorithm = algorithm.strip().lower()
+    hexpart = hexpart.strip().lower()
+    if algorithm != ALGORITHM:
+        raise ValueError("unsupported digest algorithm: %r" % (algorithm,))
+    if len(hexpart) != _HEX_LENGTH or not _HEX_DIGITS.issuperset(hexpart):
