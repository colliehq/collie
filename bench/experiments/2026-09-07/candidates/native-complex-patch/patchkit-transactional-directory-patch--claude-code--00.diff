+
+
+def _build(raw):
+    """Return the validated Op described by a single raw operation."""
+    kind, path, data, expect = _fields_of(raw)
+
+    if kind not in KINDS:
+        raise OpError("unknown kind: %r" % (kind,))
+
+    # Path problems keep their own exception type.
+    path = normalize_relpath(path)
+
+    if kind == "delete":
+        if data is not None:
+            raise OpError("delete must not carry data: %s" % path)
+    else:
+        if not isinstance(data, _BYTES_LIKE):
+            raise OpError("%s requires bytes data: %s" % (kind, path))
+        data = bytes(data)
+
+    if kind == "add" and expect is not None:
+        raise OpError("add must not carry an expect digest: %s" % path)
+    if expect is not None:
+        if not isinstance(expect, str):
+            raise OpError("expect must be a digest string: %s" % path)
+        try:
+            parse_digest(expect)
+        except ValueError as exc:
+            raise OpError("bad expect digest for %s: %s" % (path, exc)) from exc
+
+    return Op(kind, path, data, expect)
+
+
