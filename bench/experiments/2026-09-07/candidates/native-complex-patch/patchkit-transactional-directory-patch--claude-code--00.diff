+def _fields_of(raw):
+    """Return the ``(kind, path, data, expect)`` quadruple of a raw operation."""
+    if isinstance(raw, Op):
+        return raw.kind, raw.path, raw.data, raw.expect
+    if isinstance(raw, Mapping):
+        unknown = sorted(repr(key) for key in raw if key not in _FIELDS)
+        if unknown:
+            raise OpError("unknown keys: %s" % ", ".join(unknown))
+        return (
+            raw.get("kind"),
+            raw.get("path"),
+            raw.get("data"),
+            raw.get("expect"),
+        )
