+"""Apply patches to a directory tree."""
+
+from dataclasses import dataclass
+from pathlib import Path
+
+from .digest import digest_bytes, digests_equal
+from .ops import ordered, parse_ops
+from .paths import resolve_within
+
+
+class PatchError(Exception):
+    """Base class for patch application failures."""
+
+
+class PreconditionError(PatchError):
+    """Raised when the tree does not match the expected state."""
+
+
+class PatchFailed(PatchError):
+    """Raised when an operation fails and the tree has been rolled back."""
+
+    def __init__(self, path, cause, rolled_back=True):
+        super().__init__("patch failed at %s: %s" % (path, cause))
+        self.path = path
+        self.cause = cause
+        self.rolled_back = rolled_back
+
+
+@dataclass(frozen=True)
+class PatchReport:
+    applied: tuple
+    digests: tuple
+    bytes_written: int
+    dry_run: bool
+
+    def paths(self):
+        """Return the touched paths in applied order."""
+        return [path for _kind, path in self.applied]
+
+    def digest_map(self):
+        """Return a fresh dict of path -> digest."""
+        return {path: value for path, value in self.digests}
+
+
+def _default_writer(path, data):
+    with open(path, "wb") as handle:
+        handle.write(data)
+
+
+def _default_remover(path):
+    path.unlink()
+
+
+def apply_patch(root, raw_ops, *, dry_run=False, writer=None, remover=None):
+    """Apply *raw_ops* under *root* and return a PatchReport."""
+    ops = ordered(parse_ops(raw_ops))
+
+    base = Path(root)
+    if not base.is_dir():
+        raise PreconditionError("root is not an existing directory: %s" % (base,))
+
+    write = _default_writer if writer is None else writer
+    remove = _default_remover if remover is None else remover
+
+    targets = []
+    for op in ops:
+        target = resolve_within(base, op.path)
+        targets.append(target)
+        if op.kind == "add":
+            if target.exists() or target.is_symlink():
+                raise PreconditionError("already exists: %s" % op.path)
+        else:
+            if not target.is_file():
+                raise PreconditionError("not an existing file: %s" % op.path)
+            if op.expect is not None:
+                actual = digest_bytes(target.read_bytes())
+                if not digests_equal(actual, op.expect):
+                    raise PreconditionError("digest mismatch: %s" % op.path)
+
+    applied = []
+    digests = []
+    written = 0
+
+    for op in ops:
+        applied.append((op.kind, op.path))
+        if op.kind != "delete":
+            digests.append((op.path, digest_bytes(op.data)))
+
+    if dry_run:
+        return PatchReport(
+            tuple(applied),
+            tuple(sorted(digests, key=lambda item: item[0])),
+            0,
+            True,
+        )
+
+    saved = []  # (path, bytes) of files that existed before we touched them
+    created_files = []
+    created_dirs = []
+    done = 0
+
+    try:
+        for op, target in zip(ops, targets):
+            if op.kind == "delete":
+                saved.append((target, target.read_bytes()))
+                remove(target)
+            else:
+                new_dirs = []
+                parent = target.parent
+                while not parent.exists():
+                    new_dirs.append(parent)
+                    parent = parent.parent
+                for directory in reversed(new_dirs):
+                    directory.mkdir()
+                    created_dirs.append(directory)
+                if target.is_file():
+                    saved.append((target, target.read_bytes()))
+                else:
+                    created_files.append(target)
+                write(target, op.data)
+                written += len(op.data)
+            done += 1
+    except BaseException as exc:  # noqa: BLE001 - rollback then re-raise wrapped
+        _rollback(saved, created_files, created_dirs)
+        failed_path = ops[done].path if done < len(ops) else ops[-1].path
+        raise PatchFailed(failed_path, exc) from exc
+
+    return PatchReport(
+        tuple(applied),
+        tuple(sorted(digests, key=lambda item: item[0])),
+        written,
+        False,
+    )
+
+
+def _rollback(saved, created_files, created_dirs):
+    """Restore the tree to its pre-call state using plain filesystem access."""
+    for path in created_files:
+        try:
+            if path.is_file() or path.is_symlink():
+                path.unlink()
+        except OSError:
+            pass
+    for path, data in reversed(saved):
+        try:
+            path.parent.mkdir(parents=True, exist_ok=True)
+            with open(path, "wb") as handle:
+                handle.write(data)
+        except OSError:
+            pass
+    for directory in sorted(created_dirs, key=lambda p: len(p.parts), reverse=True):
+        try:
+            directory.rmdir()
+        except OSError:
+            pass
+
+
+def apply_ops(root, raw_ops):
+    """Legacy entry point returning the touched paths."""
+    return list(apply_patch(root, raw_ops).paths())
