+"""Patch operation records."""
+
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Optional
+
+from .digest import parse_digest
+from .paths import normalize_relpath
+
+KINDS = ("add", "update", "delete")
+
+ORDER = {"delete": 0, "update": 1, "add": 2}
+
+_FIELDS = frozenset({"kind", "path", "data", "expect"})
+
+
+class OpError(ValueError):
+    """Raised when a raw operation is malformed."""
+
+
+@dataclass(frozen=True)
+class Op:
+    kind: str
+    path: str
+    data: Optional[bytes] = None
+    expect: Optional[str] = None
+
+
+def _fields_from(raw):
+    if isinstance(raw, Op):
+        return raw.kind, raw.path, raw.data, raw.expect
+    if isinstance(raw, Mapping):
+        extra = set(raw.keys()) - _FIELDS
+        if extra:
+            raise OpError("unknown keys: %s" % (", ".join(sorted(map(str, extra))),))
+        return (
+            raw.get("kind"),
+            raw.get("path"),
+            raw.get("data"),
+            raw.get("expect"),
+        )
+    raise OpError("operation must be an Op or a mapping, got %r" % (type(raw).__name__,))
+
+
+def parse_ops(raw_ops):
+    """Return a tuple of validated Op records built from *raw_ops*."""
+    ops = []
+    seen = {}
+    for raw in raw_ops:
+        kind, raw_path, data, expect = _fields_from(raw)
+        if kind not in KINDS:
+            raise OpError("unknown kind: %r" % (kind,))
+        path = normalize_relpath(raw_path)
+        if kind == "delete":
+            if data is not None:
+                raise OpError("delete must not carry data: %s" % path)
+        else:
+            if not isinstance(data, (bytes, bytearray, memoryview)):
+                raise OpError("%s requires bytes-like data: %s" % (kind, path))
+            data = bytes(data)
+        if kind == "add" and expect is not None:
+            raise OpError("add must not carry expect: %s" % path)
+        if expect is not None:
+            if not isinstance(expect, str):
+                raise OpError("expect must be a string: %s" % path)
+            try:
+                parse_digest(expect)
+            except ValueError as exc:
+                raise OpError("invalid expect digest for %s: %s" % (path, exc))
+        if path in seen:
+            raise OpError("duplicate path: %s" % path)
+        seen[path] = True
+        ops.append(Op(kind, path, data, expect))
+    return tuple(ops)
+
+
+def ordered(ops):
+    """Return ops in the order they must be applied."""
+    return tuple(sorted(ops, key=lambda op: (ORDER[op.kind], op.path)))
