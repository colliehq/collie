+"""Content digests used for patch preconditions."""
+
+import hashlib
+
+ALGORITHM = "sha256"
+
+_HEX = set("0123456789abcdef")
+
+
+def _as_bytes(data):
+    if isinstance(data, (bytes, bytearray, memoryview)):
+        return bytes(data)
+    raise TypeError("data must be bytes-like, got %r" % (type(data).__name__,))
+
+
+def digest_bytes(data):
+    """Return the canonical digest string for *data*."""
+    return "%s:%s" % (ALGORITHM, hashlib.sha256(_as_bytes(data)).hexdigest())
+
+
+def content_digest(data):
+    """Legacy helper returning the bare hex digest."""
+    return hashlib.sha256(_as_bytes(data)).hexdigest()
+
+
+def parse_digest(text):
+    """Return (algorithm, hex) for a digest string."""
+    if not isinstance(text, str):
+        raise ValueError("digest must be a string, got %r" % (type(text).__name__,))
+    if ":" in text:
+        algo, _, hexpart = text.partition(":")
+        algo = algo.strip().lower()
+    else:
+        algo = ALGORITHM
+        hexpart = text
+    hexpart = hexpart.strip().lower()
+    if algo != ALGORITHM:
+        raise ValueError("unsupported digest algorithm: %r" % (algo,))
+    if len(hexpart) != 64 or not set(hexpart) <= _HEX:
+        raise ValueError("malformed digest hex: %r" % (hexpart,))
+    return (algo, hexpart)
+
+
+def digests_equal(left, right):
+    """Return True when two digest strings denote the same content."""
+    try:
+        return parse_digest(left) == parse_digest(right)
+    except (ValueError, TypeError):
+        return False
