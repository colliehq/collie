diff --git a/auditflow/formatting.py b/auditflow/formatting.py
index 583c439..e60fd82 100644
--- a/auditflow/formatting.py
+++ b/auditflow/formatting.py
@@ -2,4 +2,7 @@ from .model import AuditRecord
 
 
 def format_record(record: AuditRecord) -> str:
-    return f"{record.actor} {record.action} secret={record.secret}"
+    line = f"{record.actor} {record.action} secret={record.secret}"
+    if record.request_id is None:
+        return line
+    return f"{line} request={record.request_id}"
