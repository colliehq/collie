@@ -4,8 +4,10 @@ from .model import AuditRecord
 
 
 def decode_record(payload: Mapping[str, object]) -> AuditRecord:
+    raw_request_id = payload.get("request_id")
     return AuditRecord(
         actor=str(payload["actor"]),
