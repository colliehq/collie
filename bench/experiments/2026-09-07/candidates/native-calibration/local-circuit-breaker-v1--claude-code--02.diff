diff --git a/breaker.py b/breaker.py
index e38d4ed..b8aa04d 100644
--- a/breaker.py
+++ b/breaker.py
@@ -2,6 +2,10 @@ class CircuitBreaker:
     """A deterministic circuit breaker; callers supply timestamps."""
 
     def __init__(self, failure_threshold: int, cooldown: float):
+        if failure_threshold < 1:
+            raise ValueError("failure_threshold must be at least 1")
+        if cooldown < 0:
+            raise ValueError("cooldown must not be negative")
         self.failure_threshold = failure_threshold
         self.cooldown = cooldown
         self.state = "closed"
@@ -9,16 +13,31 @@ class CircuitBreaker:
         self.opened_at = None
 
     def allow(self, now: float) -> bool:
-        if self.state == "open" and now > self.opened_at + self.cooldown:
+        if self.state == "closed":
+            return True
+        if self.state == "half_open":
+            # Only one probe may be outstanding.
+            return False
+        if now >= self.opened_at + self.cooldown:
             self.state = "half_open"
             return True
-        return self.state != "open"
+        return False
 
     def record_success(self) -> None:
         self.state = "closed"
+        self.failures = 0
+        self.opened_at = None
 
     def record_failure(self, now: float) -> None:
+        if self.state == "open":
+            # Already open: neither extend the cooldown nor count the failure.
+            return
+        if self.state == "half_open":
+            self.failures = self.failure_threshold
+            self.state = "open"
+            self.opened_at = now
+            return
         self.failures += 1
-        if self.failures > self.failure_threshold:
+        if self.failures >= self.failure_threshold:
             self.state = "open"
             self.opened_at = now
