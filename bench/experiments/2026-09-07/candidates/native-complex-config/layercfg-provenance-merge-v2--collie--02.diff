+"""The explicit deletion sentinel."""
+
+
+class _Delete:
+    """Marker meaning: remove this key from the merged result."""
+
+    _instance = None
+
+    def __new__(cls):
+        if cls._instance is None:
+            cls._instance = super().__new__(cls)
+        return cls._instance
+
+    def __repr__(self):
+        return "DELETE"
+
+    def __bool__(self):
+        return False
+
+    def __copy__(self):
+        return self
+
+    def __deepcopy__(self, memo):
+        return self
+
+    def __reduce__(self):
+        return (_delete_singleton, ())
+
+
+DELETE = _Delete()
+
+
+def _delete_singleton():
+    return DELETE
+
+
+def is_delete(value):
+    """Return ``True`` only for the :data:`DELETE` sentinel itself."""
+    return value is DELETE
