+"""Layer registry, provenance tracking and the Config view."""
+
+import copy
+from collections.abc import Mapping
+
+from .errors import LayerError
+from .interpolate import interpolate_tree
+from .merge import deep_merge, walk
+
+
+class Config(Mapping):
+    """Immutable view over a merged configuration."""
+
+    def __init__(self, data, provenance=None):
+        if not isinstance(data, dict):
+            raise TypeError("Config data must be a dict")
+        self._data = copy.deepcopy(data)
+        self._provenance = dict(provenance) if provenance else {}
+
+    @property
+    def data(self):
+        return copy.deepcopy(self._data)
+
+    def to_dict(self):
+        return copy.deepcopy(self._data)
+
+    @property
+    def provenance(self):
+        return dict(self._provenance)
+
+    def source_of(self, *path):
+        if len(path) == 1 and isinstance(path[0], (tuple, list)):
+            key = tuple(path[0])
+        else:
+            key = tuple(path)
+        return self._provenance[key]
+
+    def __getitem__(self, key):
+        return copy.deepcopy(self._data[key])
+
+    def __iter__(self):
+        return iter(self._data)
+
+    def __len__(self):
+        return len(self._data)
+
+    def __contains__(self, key):
+        return key in self._data
+
+    def __eq__(self, other):
+        if isinstance(other, Config):
+            return self._data == other._data
+        if isinstance(other, Mapping):
+            return self._data == dict(other)
+        return NotImplemented
+
+    def __ne__(self, other):
+        result = self.__eq__(other)
+        if result is NotImplemented:
+            return result
+        return not result
+
+    __hash__ = None
+
+    def __repr__(self):
+        return "Config(%r)" % (self._data,)
+
+
+class ConfigLoader:
+    """Accumulates named layers and merges them into a :class:`Config`."""
+
+    def __init__(self, env=None):
+        if env is None:
+            self._env = {}
+        elif isinstance(env, Mapping):
+            self._env = dict(env)
+        else:
+            raise LayerError("env must be a mapping or None")
+        self._layers = []
+
+    @property
+    def layer_names(self):
+        return tuple(name for name, _ in self._layers)
+
+    def add_layer(self, name, data):
+        if not isinstance(name, str) or not name:
+            raise LayerError("layer name must be a non-empty string")
+        if not isinstance(data, dict):
+            raise LayerError("layer data must be a dict")
+        if any(name == existing for existing, _ in self._layers):
+            raise LayerError("duplicate layer name: %r" % (name,))
+        self._layers.append((name, copy.deepcopy(data)))
+        return self
+
+    def build(self):
+        merged = {}
+        provenance = {}
+        for name, raw in self._layers:
+            layer = interpolate_tree(raw, self._env)
+            merged = deep_merge(merged, layer)
+            layer_paths = {path for path, _ in walk(layer)}
+            new_provenance = {}
+            for path, _value in walk(merged):
+                if path in layer_paths:
+                    new_provenance[path] = name
+                else:
+                    new_provenance[path] = provenance.get(path, name)
+            provenance = new_provenance
+        return Config(merged, provenance)
