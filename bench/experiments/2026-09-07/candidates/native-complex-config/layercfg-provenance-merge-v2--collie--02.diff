+"""Environment interpolation with escaping and defaults."""
+
+import re
+
+from .errors import InterpolationError
+from .sentinels import is_delete
+
+_NAME_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
+
+
+def interpolate(text, env=None):
+    """Expand ``${NAME}`` / ``${NAME:-default}`` placeholders in ``text``."""
+    if not isinstance(text, str):
+        raise InterpolationError("interpolate() expects a str")
+    if env is None:
+        env = {}
+
+    out = []
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+        if ch != "$":
+            out.append(ch)
+            i += 1
+            continue
+        nxt = text[i + 1] if i + 1 < n else ""
+        if nxt == "$":
+            out.append("$")
+            i += 2
+            continue
+        if nxt == "{":
+            end = text.find("}", i + 2)
+            if end == -1:
+                raise InterpolationError(
+                    "unterminated placeholder in %r" % (text,)
+                )
+            body = text[i + 2:end]
+            out.append(_resolve(body, env))
+            i = end + 1
+            continue
+        out.append("$")
+        i += 1
+    return "".join(out)
+
+
+def _resolve(body, env):
+    sep = body.find(":-")
+    if sep == -1:
+        name = body
+        default = None
+    else:
+        name = body[:sep]
+        default = body[sep + 2:]
+    if not _NAME_RE.match(name):
+        raise InterpolationError("invalid placeholder name %r" % (name,))
+    try:
+        present = name in env
+    except TypeError:
+        present = False
+    if present:
+        return str(env[name])
+    if default is not None:
+        return default
+    raise InterpolationError("undefined variable %r" % (name,))
+
+
+def interpolate_tree(value, env=None):
+    """Return a new structure with every string interpolated."""
+    if is_delete(value):
+        return value
+    if isinstance(value, dict):
+        return {key: interpolate_tree(item, env) for key, item in value.items()}
+    if isinstance(value, list):
+        return [interpolate_tree(item, env) for item in value]
+    if isinstance(value, str):
+        return interpolate(value, env)
+    return value
