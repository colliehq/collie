+"""Order-preserving deep merge helpers."""
+
+import copy
+
+from .sentinels import is_delete
+
+
+def _clean_copy(value):
+    """Deep copy ``value`` dropping every dict entry whose value is DELETE."""
+    if is_delete(value):
+        return value
+    if isinstance(value, dict):
+        return {
+            key: _clean_copy(item)
+            for key, item in value.items()
+            if not is_delete(item)
+        }
+    return copy.deepcopy(value)
+
+
+def deep_merge(base, overlay):
+    """Merge ``overlay`` on top of ``base`` and return a new independent dict."""
+    if not isinstance(base, dict):
+        raise TypeError("base must be a dict")
+    if not isinstance(overlay, dict):
+        raise TypeError("overlay must be a dict")
+
+    result = _clean_copy(base)
+    for key, value in overlay.items():
+        if is_delete(value):
+            result.pop(key, None)
+            continue
+        if isinstance(value, dict) and isinstance(result.get(key), dict):
+            result[key] = deep_merge(result[key], value)
+        else:
+            result[key] = _clean_copy(value)
+    return result
+
+
+def walk(data, prefix=()):
+    """Yield ``(path, value)`` for every leaf of ``data`` in insertion order."""
+    if not isinstance(data, dict):
+        raise TypeError("walk() expects a dict")
+    return _walk(data, tuple(prefix))
+
+
+def _walk(data, prefix):
+    for key, value in data.items():
+        path = prefix + (key,)
+        if isinstance(value, dict) and value:
+            for item in _walk(value, path):
+                yield item
+        else:
+            yield (path, value)
