+"""Injectable clocks used by nscache."""
+
+import time
+
+
+def check_real(value, name="value"):
+    """Return ``float(value)`` after validating it is a real number."""
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise TypeError("%s must be a real number" % (name,))
+    return float(value)
+
+
+def check_clock(clock):
+    """Return *clock* if it exposes a callable ``now`` attribute."""
+    now = getattr(clock, "now", None)
+    if now is None or not callable(now):
+        raise TypeError("clock must have a callable now() method")
+    return clock
+
+
+class SystemClock:
+    """Monotonic clock used when no clock is injected."""
+
+    def now(self):
+        return time.monotonic()
+
+
+class ManualClock:
+    """Deterministic clock driven by tests."""
+
+    def __init__(self, start=0.0):
+        self._now = check_real(start, "start")
+
+    def now(self):
+        return self._now
+
+    def advance(self, delta=1.0):
+        delta = check_real(delta, "delta")
+        if delta < 0:
+            raise ValueError("delta must be >= 0")
+        self._now += delta
+        return self._now
+
+    def set_time(self, value):
+        value = check_real(value, "value")
+        if value < self._now:
+            raise ValueError("time must not go backwards")
+        self._now = value
+        return self._now
