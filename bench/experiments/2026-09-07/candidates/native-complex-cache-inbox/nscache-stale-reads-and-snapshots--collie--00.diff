+"""Snapshot serialisation helpers for nscache."""
+
+from .clock import check_real
+
+SNAPSHOT_VERSION = 2
+
+_SNAPSHOT_FIELDS = (
+    "version",
+    "created_at",
+    "capacity",
+    "ttl",
+    "stale_ttl",
+    "entries",
+)
+
+_ENTRY_FIELDS = (
+    "canonical",
+    "namespace",
+    "value",
+    "stored_at",
+    "expires_at",
+)
+
+
+def build_snapshot(created_at, capacity, ttl, stale_ttl, entries):
+    """Return a new snapshot mapping for the supplied cache state."""
+    created_at = check_real(created_at, "created_at")
+    return {
+        "version": SNAPSHOT_VERSION,
+        "created_at": created_at,
+        "capacity": capacity,
+        "ttl": ttl,
+        "stale_ttl": stale_ttl,
+        "entries": [dict(entry) for entry in entries],
+    }
+
+
+def parse_snapshot(data):
+    """Validate *data* and return a ``(created_at, records)`` pair."""
+    if not isinstance(data, dict):
+        raise TypeError("snapshot must be a dict")
+    for field in _SNAPSHOT_FIELDS:
+        if field not in data:
+            raise ValueError("snapshot is missing %r" % (field,))
+    version = data["version"]
+    if isinstance(version, bool) or not isinstance(version, int) \
+            or version != SNAPSHOT_VERSION:
+        raise ValueError("unsupported snapshot version: %r" % (version,))
+    created_at = check_real(data["created_at"], "created_at")
+    entries = data["entries"]
+    if not isinstance(entries, list):
+        raise TypeError("snapshot entries must be a list")
+    records = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise TypeError("snapshot entry must be a dict")
+        for field in _ENTRY_FIELDS:
+            if field not in entry:
+                raise ValueError("snapshot entry is missing %r" % (field,))
+        canonical = entry["canonical"]
+        namespace = entry["namespace"]
+        if not isinstance(canonical, str):
+            raise TypeError("snapshot entry canonical must be a str")
+        if not isinstance(namespace, str):
+            raise TypeError("snapshot entry namespace must be a str")
+        stored_at = check_real(entry["stored_at"], "stored_at")
+        expires_at = check_real(entry["expires_at"], "expires_at")
+        records.append({
+            "canonical": canonical,
+            "namespace": namespace,
+            "value": entry["value"],
+            "stored_at": stored_at,
+            "expires_at": expires_at,
+        })
+    return created_at, records
