+"""Canonical key encoding for the nscache package."""
+
+import math
+import re
+
+MAX_KEY_DEPTH = 6
+
+_NAMESPACE_RE = re.compile(r"\A[A-Za-z0-9_.-]+\Z")
+
+
+def _escape(text):
+    return text.replace("\\", "\\\\").replace("|", "\\p").replace("=", "\\e")
+
+
+def check_namespace(namespace):
+    """Validate *namespace* and return it unchanged."""
+    if not isinstance(namespace, str):
+        raise TypeError("namespace must be a str")
+    if not _NAMESPACE_RE.match(namespace):
+        raise ValueError("invalid namespace: %r" % (namespace,))
+    return namespace
+
+
+def _encode(key, depth):
+    if depth > MAX_KEY_DEPTH:
+        raise ValueError("key nesting deeper than %d" % (MAX_KEY_DEPTH,))
+    if key is None:
+        return "n:"
+    if isinstance(key, bool):
+        return "b:true" if key else "b:false"
+    if isinstance(key, int):
+        return "i:%d" % key
+    if isinstance(key, float):
+        if not math.isfinite(key):
+            raise ValueError("non-finite float keys are not supported")
+        if key == 0.0:
+            key = 0.0
+        return "f:" + repr(key)
+    if isinstance(key, str):
+        return "s:" + _escape(key)
+    if isinstance(key, bytes):
+        return "x:" + key.hex()
+    if isinstance(key, (list, tuple)):
+        return "l:[" + "|".join(_encode(item, depth + 1) for item in key) + "]"
+    if isinstance(key, dict):
+        names = []
+        for name in key:
+            if not isinstance(name, str):
+                raise TypeError("dict keys must be str")
+            names.append(name)
+        parts = []
+        for name in sorted(names):
+            parts.append(
+                _encode(name, depth + 1) + "=" + _encode(key[name], depth + 1)
+            )
+        return "d:{" + "|".join(parts) + "}"
+    raise TypeError("unsupported key type: %s" % type(key).__name__)
+
+
+def encode_key(key):
+    """Encode *key* into its canonical textual form."""
+    return _encode(key, 1)
+
+
+def canonical_key(namespace, key):
+    """Return the canonical cache key for *namespace* and *key*."""
+    return check_namespace(namespace) + "/" + encode_key(key)
