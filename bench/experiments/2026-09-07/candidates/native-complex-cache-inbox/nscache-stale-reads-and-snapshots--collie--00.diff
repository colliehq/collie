+"""Namespaced bounded LRU cache with TTL and stale-read support."""
+
+from collections import OrderedDict
+from typing import Any, NamedTuple
+
+from .clock import SystemClock, check_clock, check_real
+from .keys import canonical_key, check_namespace
+from .snapshot import build_snapshot, parse_snapshot
+
+FRESH = "fresh"
+STALE = "stale"
+_DEAD = "dead"
+
+
+class CacheEntry(NamedTuple):
+    """Snapshot of a single cached record."""
+
+    namespace: str
+    canonical: str
+    value: Any
+    stored_at: float
+    expires_at: float
+    state: str
+
+
+class _Record:
+    __slots__ = ("namespace", "value", "stored_at", "expires_at")
+
+    def __init__(self, namespace, value, stored_at, expires_at):
+        self.namespace = namespace
+        self.value = value
+        self.stored_at = stored_at
+        self.expires_at = expires_at
+
+
+class NamespacedCache:
+    """Bounded LRU cache shared by several namespaces."""
+
+    def __init__(self, capacity, ttl, clock=None, *, stale_ttl=0.0):
+        if isinstance(capacity, bool) or not isinstance(capacity, int):
+            raise TypeError("capacity must be an int")
+        if capacity < 1:
+            raise ValueError("capacity must be >= 1")
+        ttl = check_real(ttl, "ttl")
+        if ttl <= 0:
+            raise ValueError("ttl must be > 0")
+        stale_ttl = check_real(stale_ttl, "stale_ttl")
+        if stale_ttl < 0:
+            raise ValueError("stale_ttl must be >= 0")
+        self.capacity = capacity
+        self.ttl = ttl
+        self.stale_ttl = stale_ttl
+        self._clock = SystemClock() if clock is None else check_clock(clock)
+        self._store = OrderedDict()
+        self._counters = {
+            "hits": 0,
+            "misses": 0,
+            "stale_hits": 0,
+            "evictions": 0,
+            "expirations": 0,
+            "puts": 0,
+        }
+
+    # -- internal helpers ------------------------------------------------
+
+    def _state(self, record, now):
+        if now < record.expires_at:
+            return FRESH
+        if now < record.expires_at + self.stale_ttl:
+            return STALE
+        return _DEAD
+
+    def _make_room(self):
+        if len(self._store) < self.capacity:
+            return
+        now = self._clock.now()
+        dead = [ck for ck, rec in self._store.items()
+                if self._state(rec, now) == _DEAD]
+        for canonical in dead:
+            del self._store[canonical]
+        self._counters["expirations"] += len(dead)
+        while len(self._store) >= self.capacity:
+            victim = None
+            for canonical, record in self._store.items():
+                if self._state(record, now) == STALE:
+                    victim = canonical
+                    break
+            if victim is None:
+                victim = next(iter(self._store))
+            del self._store[victim]
+            self._counters["evictions"] += 1
+
+    # -- public API ------------------------------------------------------
+
+    def put(self, namespace, key, value):
+        canonical = canonical_key(namespace, key)
+        now = self._clock.now()
+        record = self._store.get(canonical)
+        if record is not None:
+            record.value = value
+            record.stored_at = now
+            record.expires_at = now + self.ttl
+            self._store.move_to_end(canonical)
+        else:
+            self._make_room()
+            self._store[canonical] = _Record(
+                namespace, value, now, now + self.ttl
+            )
+        self._counters["puts"] += 1
+        return canonical
+
+    def get(self, namespace, key, default=None):
+        canonical = canonical_key(namespace, key)
+        now = self._clock.now()
+        record = self._store.get(canonical)
+        if record is not None:
+            state = self._state(record, now)
+            if state == FRESH:
+                self._store.move_to_end(canonical)
+                self._counters["hits"] += 1
+                return record.value
+            if state == _DEAD:
+                del self._store[canonical]
+                self._counters["expirations"] += 1
+        self._counters["misses"] += 1
+        return default
+
+    def get_entry(self, namespace, key):
+        canonical = canonical_key(namespace, key)
+        now = self._clock.now()
+        record = self._store.get(canonical)
+        if record is not None:
+            state = self._state(record, now)
+            if state == FRESH:
+                self._store.move_to_end(canonical)
+                self._counters["hits"] += 1
+                return CacheEntry(record.namespace, canonical, record.value,
+                                  record.stored_at, record.expires_at, FRESH)
+            if state == STALE:
+                self._counters["stale_hits"] += 1
+                return CacheEntry(record.namespace, canonical, record.value,
+                                  record.stored_at, record.expires_at, STALE)
+            del self._store[canonical]
+            self._counters["expirations"] += 1
+        self._counters["misses"] += 1
+        return None
+
+    def delete(self, namespace, key):
+        canonical = canonical_key(namespace, key)
+        if canonical in self._store:
+            del self._store[canonical]
+            return True
+        return False
+
+    def clear(self, namespace=None):
+        if namespace is None:
+            removed = len(self._store)
+            self._store.clear()
+            return removed
+        check_namespace(namespace)
+        victims = [ck for ck, rec in self._store.items()
+                   if rec.namespace == namespace]
+        for canonical in victims:
+            del self._store[canonical]
+        return len(victims)
+
+    def purge_expired(self):
+        now = self._clock.now()
+        victims = [ck for ck, rec in self._store.items()
+                   if self._state(rec, now) == _DEAD]
+        for canonical in victims:
+            del self._store[canonical]
+        self._counters["expirations"] += len(victims)
+        return len(victims)
+
+    def keys(self, namespace=None):
+        if namespace is not None:
+            check_namespace(namespace)
+        now = self._clock.now()
+        result = []
+        for canonical, record in self._store.items():
+            if self._state(record, now) == _DEAD:
+                continue
+            if namespace is not None and record.namespace != namespace:
+                continue
+            result.append(canonical)
+        return result
+
+    def namespaces(self):
+        now = self._clock.now()
+        return sorted({rec.namespace for rec in self._store.values()
+                       if self._state(rec, now) != _DEAD})
+
+    def __len__(self):
+        now = self._clock.now()
+        return sum(1 for rec in self._store.values()
+                   if self._state(rec, now) != _DEAD)
+
+    def stats(self):
+        data = dict(self._counters)
+        data["size"] = len(self)
+        data["capacity"] = self.capacity
+        return data
+
+    # -- snapshot / restore ----------------------------------------------
+
+    def snapshot(self):
+        self.purge_expired()
+        now = self._clock.now()
+        entries = []
+        for canonical, record in self._store.items():
+            entries.append({
+                "canonical": canonical,
+                "namespace": record.namespace,
+                "value": record.value,
+                "stored_at": record.stored_at,
+                "expires_at": record.expires_at,
+            })
+        return build_snapshot(now, self.capacity, self.ttl, self.stale_ttl,
+                              entries)
+
+    def restore(self, snapshot):
+        created_at, records = parse_snapshot(snapshot)
+        now = self._clock.now()
+        delta = now - created_at
+        ordered = OrderedDict()
+        for record in records:
+            stored_at = float(record["stored_at"]) + delta
+            expires_at = float(record["expires_at"]) + delta
+            canonical = record["canonical"]
+            if canonical in ordered:
+                del ordered[canonical]
+            ordered[canonical] = _Record(
+                record["namespace"], record["value"], stored_at, expires_at
+            )
+        kept = [(ck, rec) for ck, rec in ordered.items()
+                if self._state(rec, now) != _DEAD]
+        if len(kept) > self.capacity:
+            kept = kept[len(kept) - self.capacity:]
+        self._store = OrderedDict()
+        for canonical, record in kept:
+            self._store[canonical] = record
+        return len(self._store)
