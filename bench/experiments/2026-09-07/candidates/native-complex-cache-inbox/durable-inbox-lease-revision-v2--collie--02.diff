+"""The record type stored in the inbox."""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+
+from .errors import StateFormatError
+
+STATES = ("pending", "claimed", "done")
+
+
+def _deep_copy(value):
+    if value is None:
+        return None
+    return copy.deepcopy(value)
+
+
+@dataclass
+class Entry:
+    """One submitted request."""
+
+    key: str
+    seq: int
+    payload: dict
+    state: str = "pending"
+    revision: int = 1
+    attempts: int = 0
+    created_at: float = 0.0
+    updated_at: float = 0.0
+    owner: str | None = None
+    lease_expires_at: float | None = None
+    result: dict | None = None
+    acked_revision: int | None = None
+
+    def copy(self) -> "Entry":
+        return Entry(
+            key=self.key,
+            seq=self.seq,
+            payload=_deep_copy(self.payload),
+            state=self.state,
+            revision=self.revision,
+            attempts=self.attempts,
+            created_at=self.created_at,
+            updated_at=self.updated_at,
+            owner=self.owner,
+            lease_expires_at=self.lease_expires_at,
+            result=_deep_copy(self.result),
+            acked_revision=self.acked_revision,
+        )
+
+    def lease_expired(self, now: float) -> bool:
+        if self.state != "claimed" or self.lease_expires_at is None:
+            return False
+        return now >= self.lease_expires_at
+
+    def to_dict(self) -> dict:
+        return {
+            "key": self.key,
+            "seq": self.seq,
+            "payload": _deep_copy(self.payload),
+            "state": self.state,
+            "revision": self.revision,
+            "attempts": self.attempts,
+            "created_at": self.created_at,
+            "updated_at": self.updated_at,
+            "owner": self.owner,
+            "lease_expires_at": self.lease_expires_at,
+            "result": _deep_copy(self.result),
+            "acked_revision": self.acked_revision,
+        }
+
+    @classmethod
+    def from_dict(cls, raw: dict) -> "Entry":
+        if not isinstance(raw, dict):
+            raise StateFormatError("entry record must be a JSON object")
+
+        if "key" not in raw:
+            raise StateFormatError("entry record is missing 'key'")
+        key = raw["key"]
+        if not isinstance(key, str) or not key.strip():
+            raise StateFormatError("entry 'key' must be a non-blank string")
+
+        if "seq" not in raw:
+            raise StateFormatError("entry record is missing 'seq'")
+        seq = raw["seq"]
+        if isinstance(seq, bool) or not isinstance(seq, int):
+            raise StateFormatError("entry 'seq' must be an int")
+
+        state = raw.get("state", "pending")
+        if state not in STATES:
+            raise StateFormatError("entry 'state' is not a known state")
+
+        if "payload" in raw and raw["payload"] is not None:
+            payload = raw["payload"]
+            if not isinstance(payload, dict):
+                raise StateFormatError("entry 'payload' must be an object")
+        elif "payload" in raw:
+            raise StateFormatError("entry 'payload' must be an object")
+        else:
+            payload = {}
+
+        if "owner" in raw:
+            owner = raw.get("owner")
+        else:
+            owner = raw.get("claimed_by")
+
+        revision = raw.get("revision", 1)
+        if revision is None:
+            revision = 1
+        attempts = raw.get("attempts", 0)
+        if attempts is None:
+            attempts = 0
+        created_at = raw.get("created_at", 0.0)
+        if created_at is None:
+            created_at = 0.0
+        updated_at = raw.get("updated_at", 0.0)
+        if updated_at is None:
+            updated_at = 0.0
+
+        return cls(
+            key=key,
+            seq=seq,
+            payload=copy.deepcopy(payload),
+            state=state,
+            revision=revision,
+            attempts=attempts,
+            created_at=created_at,
+            updated_at=updated_at,
+            owner=owner,
+            lease_expires_at=raw.get("lease_expires_at"),
+            result=copy.deepcopy(raw.get("result")),
+            acked_revision=raw.get("acked_revision"),
+        )
+
+
+@dataclass(frozen=True)
+class SubmitResult:
+    """The outcome of a submission."""
+
+    entry: Entry
+    created: bool
+    updated: bool
+
+    @property
+    def key(self) -> str:
+        return self.entry.key
+
+    @property
+    def seq(self) -> int:
+        return self.entry.seq
+
+    @property
+    def revision(self) -> int:
+        return self.entry.revision
+
+    @property
+    def state(self) -> str:
+        return self.entry.state
