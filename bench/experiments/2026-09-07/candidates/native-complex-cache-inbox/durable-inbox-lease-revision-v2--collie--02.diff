+"""Durable JSON state file for the inbox."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+from .errors import StateFormatError
+from .model import Entry
+
+CURRENT_VERSION = 2
+SUPPORTED_VERSIONS = (1, 2)
+
+
+class JsonStateStore:
+    """Reads and writes the whole inbox as a single JSON document."""
+
+    def __init__(self, path):
+        self.path = Path(path)
+
+    def load(self) -> dict:
+        if not self.path.exists():
+            return {}
+        try:
+            text = self.path.read_text(encoding="utf-8")
+        except OSError as exc:
+            raise StateFormatError(f"cannot read state file: {exc}") from exc
+        try:
+            raw = json.loads(text)
+        except ValueError as exc:
+            raise StateFormatError(f"state file is not valid JSON: {exc}") from exc
+
+        if not isinstance(raw, dict):
+            raise StateFormatError("state file must contain a JSON object")
+
+        if "version" not in raw:
+            raise StateFormatError("state file is missing 'version'")
+        version = raw["version"]
+        if isinstance(version, bool) or not isinstance(version, int):
+            raise StateFormatError("state file 'version' must be an int")
+        if version not in SUPPORTED_VERSIONS:
+            raise StateFormatError(f"unsupported state file version: {version}")
+
+        if "entries" not in raw:
+            raise StateFormatError("state file is missing 'entries'")
+        entries = raw["entries"]
+        if not isinstance(entries, dict):
+            raise StateFormatError("state file 'entries' must be a JSON object")
+
+        loaded = {}
+        for key, item in entries.items():
+            if not isinstance(item, dict):
+                raise StateFormatError("each entry must be a JSON object")
+            record = dict(item)
+            record["key"] = key
+            loaded[key] = Entry.from_dict(record)
+        return loaded
+
+    def save(self, entries, next_seq) -> None:
+        doc = {"version": CURRENT_VERSION,
+               "next_seq": next_seq,
+               "entries": {key: entry.to_dict()
