+"""The inbox service: submissions, leases and acknowledgements."""
+
+from __future__ import annotations
+
+import copy
+import json
+import math
+import time
+
+from .errors import (
+    ConflictError,
+    InboxError,
+    LeaseError,
+    UnknownKeyError,
+    ValidationError,
+)
+from .model import STATES, Entry, SubmitResult
+from .store import JsonStateStore
+
+
+def _check_text(value, label):
+    if not isinstance(value, str) or not value.strip():
+        raise ValidationError(f"{label} must be a non-blank string")
+    return value
+
+
+def _canonical(payload, label):
+    if not isinstance(payload, dict):
+        raise ValidationError(f"{label} must be a dict")
+    for name in payload:
+        if not isinstance(name, str):
+            raise ValidationError(f"{label} keys must be strings")
+    try:
+        return json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    except (TypeError, ValueError) as exc:
+        raise ValidationError(f"{label} is not JSON serialisable: {exc}") from exc
+
+
+def _check_lease_seconds(value):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValidationError("lease_seconds must be an int or float")
+    if not math.isfinite(float(value)):
+        raise ValidationError("lease_seconds must be finite")
+    if float(value) <= 0:
+        raise ValidationError("lease_seconds must be greater than zero")
+    return value
+
+
+def _check_limit(value):
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValidationError("limit must be an int")
+    if value < 1:
+        raise ValidationError("limit must be at least 1")
+    return value
+
+
+def _check_revision(value):
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValidationError("revision must be an int or None")
+    if value < 1:
+        raise ValidationError("revision must be at least 1")
+    return value
+
+
+class Inbox:
+    """A durable multi-session request inbox."""
+
+    def __init__(self, path, clock=time.time):
+        if not callable(clock):
+            raise ValidationError("clock must be callable")
+        self._clock = clock
+        self._store = JsonStateStore(path)
+        self._entries = self._store.load()
+        if self._entries:
+            self._next_seq = max(e.seq for e in self._entries.values()) + 1
+        else:
+            self._next_seq = 1
+
+    @property
+    def path(self):
+        return self._store.path
+
+    @property
+    def next_seq(self):
+        return self._next_seq
+
+    def _now(self):
+        return float(self._clock())
+
+    def _flush(self):
+        self._store.save(self._entries, self._next_seq)
+
+    def _expire_leases(self, now):
+        count = 0
+        for entry in self._entries.values():
+            if entry.lease_expired(now):
+                entry.state = "pending"
+                entry.owner = None
+                entry.lease_expires_at = None
+                entry.updated_at = now
+                count += 1
+        return count
+
+    def _sorted_entries(self):
+        return sorted(self._entries.values(), key=lambda e: e.seq)
+
+    def _require_claimed(self, key, owner):
+        entry = self._entries.get(key)
+        if entry is None:
+            raise UnknownKeyError(f"unknown key: {key!r}")
+        if entry.state != "claimed":
+            raise LeaseError(f"entry {key!r} is not claimed")
+        if entry.owner != owner:
+            raise LeaseError(f"entry {key!r} is claimed by another owner")
+        return entry
+
+    def submit(self, key, payload) -> SubmitResult:
+        _check_text(key, "key")
+        canonical = _canonical(payload, "payload")
+        now = self._now()
+
+        entry = self._entries.get(key)
+        if entry is None:
+            entry = Entry(key=key, seq=self._next_seq,
+                          payload=copy.deepcopy(payload),
+                          state="pending", revision=1, attempts=0,
+                          created_at=now, updated_at=now)
+            self._entries[key] = entry
+            self._next_seq += 1
+            self._flush()
+            return SubmitResult(entry=entry.copy(), created=True, updated=False)
+
+        stored = json.dumps(entry.payload, sort_keys=True, separators=(",", ":"))
+        if stored == canonical:
+            return SubmitResult(entry=entry.copy(), created=False, updated=False)
+
+        entry.payload = copy.deepcopy(payload)
+        entry.revision += 1
+        entry.updated_at = now
+        entry.state = "pending"
+        entry.owner = None
+        entry.lease_expires_at = None
+        entry.result = None
+        self._flush()
+        return SubmitResult(entry=entry.copy(), created=False, updated=True)
+
+    def claim(self, owner, lease_seconds, limit=1):
+        _check_text(owner, "owner")
+        _check_lease_seconds(lease_seconds)
+        _check_limit(limit)
+
+        now = self._now()
+        changed = self._expire_leases(now)
+
+        claimed = []
+        for entry in self._sorted_entries():
+            if len(claimed) >= limit:
+                break
+            if entry.state != "pending":
+                continue
+            entry.state = "claimed"
+            entry.owner = owner
+            entry.lease_expires_at = now + lease_seconds
+            entry.updated_at = now
+            entry.attempts += 1
+            claimed.append(entry)
+
+        if changed or claimed:
+            self._flush()
+        return [entry.copy() for entry in claimed]
+
+    def ack(self, key, owner, result=None, *, revision=None):
+        _check_text(key, "key")
+        _check_text(owner, "owner")
+        if result is not None:
+            _canonical(result, "result")
+        _check_revision(revision)
+
+        now = self._now()
+        changed = self._expire_leases(now)
+        try:
+            entry = self._require_claimed(key, owner)
+            if revision is not None and revision != entry.revision:
+                raise ConflictError(
+                    f"revision {revision} does not match {entry.revision}")
+        except InboxError:
+            if changed:
+                self._flush()
+            raise
+
+        entry.state = "done"
+        entry.result = copy.deepcopy(result) if result is not None else None
+        entry.acked_revision = entry.revision
+        entry.owner = None
+        entry.lease_expires_at = None
+        entry.updated_at = now
+        self._flush()
+        return entry.copy()
+
+    def release(self, key, owner):
+        _check_text(key, "key")
+        _check_text(owner, "owner")
+
+        now = self._now()
+        changed = self._expire_leases(now)
+        try:
+            entry = self._require_claimed(key, owner)
+        except InboxError:
+            if changed:
+                self._flush()
+            raise
+
+        entry.state = "pending"
+        entry.owner = None
+        entry.lease_expires_at = None
+        entry.updated_at = now
+        self._flush()
+        return entry.copy()
+
+    def sweep(self) -> int:
+        now = self._now()
+        count = self._expire_leases(now)
+        if count:
+            self._flush()
+        return count
+
+    def get(self, key):
+        _check_text(key, "key")
+        entry = self._entries.get(key)
+        return entry.copy() if entry is not None else None
+
+    def list_entries(self, state=None):
+        if state is not None and state not in STATES:
+            raise ValidationError(f"unknown state: {state!r}")
+        return [entry.copy() for entry in self._sorted_entries()
+                if state is None or entry.state == state]
+
+    def stats(self) -> dict:
+        counts = {"pending": 0, "claimed": 0, "done": 0, "total": 0}
+        for entry in self._entries.values():
+            counts["total"] += 1
+            if entry.state in counts:
+                counts[entry.state] += 1
+        return counts
