eys(), [\"x/s:a\", \"x/s:b\"])\n        self.eq(target.get(\"x\", \"b\"), \"two\")\n        self.eq(target.get_entry(\"x\", \"a\").expires_at, 9008.0)\n\nclass RandomisedTests(Base):\n\n    def test_matches_reference_model(self):\n        rng = random.Random(20260907)\n        clock = ManualClock(0.0)\n        cache = NamespacedCache(5, TTL, clock, stale_ttl=STALE)\n        model = Model(5, TTL, STALE, clock)\n        namespaces = [\"alpha\", \"beta\"]\n        candidates = [\"a\", \"b\", 1, 2, True, (\"t\", 1)]\n        pairs = {}\n        for step in range(500):\n            namespace = rng.choice(namespaces)\n            key = rng.choice(candidates)\n            ident = (namespace, type(key).__name__, key)\n            pairs[ident] = (namespace, key)\n            roll = rng.random()\n            if roll < 0.34:\n                value = rng.randrange(1000)\n                self.eq(cache.put(namespace, key, value),\n                        canonical_key(namespace, key), \"put %d\" % step)\n                model.put(ident, value)\n            elif roll < 0.58:\n                self.eq(cache.get(namespace, key, \"MISS\"),\n                        model.get(ident, \"MISS\"), \"get %d\" % step)\n            elif roll < 0.76:\n                found = cache.get_entry(namespace, key)\n                expected = model.get_entry(ident)\n                if expected is None:\n                    self.ok(found is None, \"entry %d\" % step)\n                else:\n                    self.eq((found.state, found.value), expected, \"entry %d\" % step)\n                    self.eq(found.canonical, canonical_key(namespace, key))\n            elif roll < 0.82:\n                self.eq(cache.delete(namespace, key), model.delete(ident),\n                        \"delete %d\" % step)\n            elif roll < 0.88:\n                self.eq(cache.purge_expired(), model.purge_expired(),\n                        \"purge %d\" % step)\n            else:\n                clock.advance(rng.choice([0, 1, 2, 3, 5, 7]))\n            if step % 25 == 0:\n                now = clock.now()\n                self.eq(cache.keys(),\n                        [canonical_key(*pairs[i]) for i in model.keys(now)],\n                        \"order %d\" % step)\n                self.eq(len(cache), len(model.keys(now)), \"size %d\" % step)\n        now = clock.now()\n        stats = cache.stats()\n        for name, value in sorted(model.counters.items()):\n            self.eq(stats[name], value, \"counter \" + name)\n        self.eq(stats[\"size\"], len(model.keys(now)))\n        self.eq(stats[\"capacity\"], 5)\n        expected_keys = [canonical_key(*pairs[i]) for i in model.keys(now)]\n        self.eq(cache.keys(), expected_keys)\n        snap = cache.snapshot()\n        target_clock = ManualClock(now + 250.0)\n        target = NamespacedCache(5, TTL, target_clock, stale_ttl=STALE)\n        self.eq(target.restore(snap), len(snap[\"entries\"]))\n        self.eq(target.keys(), [item[\"canonical\"] for item in snap[\"entries\"]])\n        rebased = {item[\"canonical\"]: item for item in target.snapshot()[\"entries\"]}\n        self.eq(sorted(rebased), sorted(item[\"canonical\"] for item in snap[\"entries\"]))\n        for item in snap[\"entries\"]:\n            mirror = rebased[item[\"canonical\"]]\n            self.eq(mirror[\"expires_at\"], item[\"expires_at\"] + 250.0)\n            self.eq(mirror[\"stored_at\"], item[\"stored_at\"] + 250.0)\n            self.eq(mirror[\"value\"], item[\"value\"])\n            self.eq(mirror[\"namespace\"], item[\"namespace\"])\n        for ident in model.keys(now):\n            namespace, key = pairs[ident]\n            found = target.get_entry(namespace, key)\n            self.ok(found is not None, \"restored \" + str(ident))\n            self.eq(found.value, model.rec[ident][0])\n\n\ndef main():\n    loader = unittest.TestLoader()\n    suite = loader.loadTestsFromModule(sys.modules[__name__])\n    result = unittest.TextTestRunner(verbos