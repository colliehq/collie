s()\n        self.eq(stats[\"stale_hits\"], 1)\n        self.eq(stats[\"evictions\"], 1)\n        self.eq(stats[\"expirations\"], 0)\n\n    def test_stale_is_evicted_before_fresh_lru(self):\n        cache, clock = build(capacity=3, ttl=10.0, stale_ttl=10.0)\n        cache.put(\"n\", \"a\", 1)\n        clock.set_time(6.0)\n        cache.put(\"n\", \"b\", 2)\n        cache.put(\"n\", \"c\", 3)\n        self.eq(cache.get(\"n\", \"a\"), 1)\n        self.eq(cache.keys(), [\"n/s:b\", \"n/s:c\", \"n/s:a\"])\n        clock.set_time(11.0)\n        cache.put(\"n\", \"d\", 4)\n        self.eq(cache.keys(), [\"n/s:b\", \"n/s:c\", \"n/s:d\"])\n        self.eq(cache.stats()[\"evictions\"], 1)\n        self.eq(cache.stats()[\"expirations\"], 0)\n\n    def test_make_room_purges_dead_before_evicting(self):\n        cache, clock = build(capacity=2, ttl=10.0)\n        cache.put(\"n\", \"a\", 1)\n        cache.put(\"n\", \"b\", 2)\n        clock.set_time(10.0)\n        cache.put(\"n\", \"c\", 3)\n        stats = cache.stats()\n        self.eq(stats[\"expirations\"], 2)\n        self.eq(stats[\"evictions\"], 0)\n        self.eq(cache.keys(), [\"n/s:c\"])\n        mixed, mclock = build(capacity=3, ttl=10.0, stale_ttl=5.0)\n        mixed.put(\"n\", \"a\", 1)\n        mclock.set_time(6.0)\n        mixed.put(\"n\", \"b\", 2)\n        mclock.set_time(12.0)\n        mixed.put(\"n\", \"c\", 3)\n        mclock.set_time(16.0)\n        mixed.put(\"n\", \"d\", 4)\n        self.eq(mixed.keys(), [\"n/s:b\", \"n/s:c\", \"n/s:d\"])\n        self.eq(mixed.stats()[\"expirations\"], 1)\n        self.eq(mixed.stats()[\"evictions\"], 0)\n\n    def test_overwrite_never_evicts_or_expires(self):\n        cache, clock = build(capacity=2, ttl=10.0, stale_ttl=4.0)\n        cache.put(\"n\", \"a\", 1)\n        cache.put(\"n\", \"b\", 2)\n        clock.set_time(3.0)\n        self.eq(cache.put(\"n\", \"a\", 11), \"n/s:a\")\n        self.eq(cache.keys(), [\"n/s:b\", \"n/s:a\"])\n        self.eq(cache.get(\"n\", \"a\"), 11)\n        self.eq(cache.stats()[\"evictions\"], 0)\n        clock.set_time(20.0)\n        cache.put(\"n\", \"b\", 22)\n        self.eq(cache.stats()[\"expirations\"], 0)\n        self.eq(cache.stats()[\"evictions\"], 0)\n        self.eq(cache.stats()[\"puts\"], 4)\n        self.eq(len(cache), 1)\n        self.eq(cache.keys(), [\"n/s:b\"])\n        cache.put(\"n\", \"c\", 3)\n        self.eq(cache.stats()[\"expirations\"], 1)\n        self.eq(cache.stats()[\"evictions\"], 0)\n        self.eq(cache.keys(), [\"n/s:b\", \"n/s:c\"])\n\n    def test_delete_clear_and_namespaces(self):\n        cache, clock = build(capacity=5, ttl=10.0, stale_ttl=3.0)\n        cache.put(\"x\", \"a\", 1)\n        cache.put(\"y\", \"b\", 2)\n        cache.put(\"x\", \"c\", 3)\n        self.eq(cache.namespaces(), [\"x\", \"y\"])\n        self.eq(cache.delete(\"x\", \"a\"), True)\n        self.eq(cache.delete(\"x\", \"a\"), False)\n        clock.set_time(14.0)\n        self.eq(cache.namespaces(), [])\n        self.eq(len(cache), 0)\n        self.eq(cache.delete(\"y\", \"b\"), True)\n        stats = cache.stats()\n        self.eq(stats[\"expirations\"], 0)\n        self.eq(stats[\"evictions\"], 0)\n        self.eq(stats[\"hits\"], 0)\n        self.eq(stats[\"misses\"], 0)\n        other, _c = build(capacity=5, ttl=10.0)\n        other.put(\"x\", \"a\", 1)\n        other.put(\"x\", \"b\", 2)\n        other.put(\"y\", \"c\", 3)\n        self.eq(other.clear(\"x\"), 2)\n        self.eq(other.namespaces(), [\"y\"])\n        self.eq(other.clear(), 1)\n        self.eq(other.clear(), 0)\n        self.raises(ValueError, other.clear, \"bad ns\")\n        self.raises(TypeError, other.clear, 5)\n\n    def test_keys_filtering_and_validation(self):\n        cache, clock = build(capacity=5, ttl=10.0, stale_ttl=5.0)\n        cache.put(\"x\", \"a\", 1)\n        cache.put(\"y\", \"b\", 2)\n        cache.put(\"x\", \"c\", 3)\n        self.eq(cache.keys(), [\"x/s:a\", \"y/s:b\", \"x/s:c\"])\n        self.eq(cache.keys(\"x\"), [\"x/s:a\", \"x/s:c\"])\n        self.eq(cache.keys(\"y\"), [\"y/s:b\"])\n        self.eq(cache.keys(\"z\"), [])\n        self.eq(cache.get(\"x\", \"a\"), 1)\n        self.eq(cache.keys(), [\"y/s:b\", \"x/s:c\", \"x/s:a\"])\n        listed = cache.keys()\n        listed.append(\"junk\")\n        self.eq(len(cache.keys()), 3)\n        clock.set_time(12.0)\n        self.eq(len(cache.keys()), 3)\n        clock.set_time(15.0)\n        self.eq(cache.keys(), [])\n        self.eq(cache.stats()[\"expirations\"], 0)\n        self.eq(cache.purge_expired(), 3)\n        self.eq(cache.purge_expired(), 0)\n        self.eq(cache.stats()[\"expirations\"], 3)\n        self.raises(TypeError, cache.keys, 5)\n        self.raises(ValueError, cache.keys, \"a b\")\n        self.raises(ValueError, cache.get, \"a b\", \"k\")\n        self.raises(TypeError, cache.put, \"ns\", object(), 1)\n\n    def test_counters_and_stats_isolation(self):\n        cache, clock = build(capacity=2, ttl=10.0, stale_ttl=4.0)\n        cache.put(\"n\", \"a\", 1)\n        self.eq(cache.get(\"n\", \"a\"), 1)\n        self.ok(cache.get(\"n\", \"zz\") is None)\n        self.eq(cache.get_entry(\"n\", \"a\").state, \"fresh\")\n        self.ok(cache.get_entry(\"n\", \"zz\") is None)\n        clock.set_time(11.0)\n        self.ok(cache.get(\"n\", \"a\") is None)\n        self.eq(cache.get_entry(\"n\", \"a\").state, \"stale\")\n        clock.set_time(14.0)\n        self.ok(cache.get_entry(\"n\", \"a\") is None)\n        self.eq(cache.stats(),\n                {\"hits\": 2, \"misses\": 4, \"stale_hits\": 1, \"evictions\": 0,\n                 \"expirations\": 1, \"puts\": 1, \"size\": 0, \"capacity\": 2})\n        first = cache.stats()\n        first[\"hits\"] = 999\n        first.clear()\n        self.eq(cache.stats()[\"hits\"], 2)\n        self.ok(cache.stats() is not cache.stats())\n\ndef make_snapshot(entries, created_at=100.0):\n    return {\"version\": 2, \"created_at\": created_at, \"capacity\": 5,\n            \"ttl\": 10.0, \"stale_ttl\": 0.0, \"entries\": list(entries)}\n\n\ndef entry(canonical, value, stored_at, expires_at, namespace=\"ns\"):\n    return {\"canonical\": canonical, \"namespace\": namespace, \"value\": value,\n            \"stored_at\": stored_at, \"expires_at\": expires_at}\n\n\nclass SnapshotTests(Base):\n\n    def test_snapshot_format_and_isolation(self):\n        cache, clock = build(capacity=3, ttl=10.0, stale_ttl=4.0, start=100.0)\n        cache.put(\"x\", \"a\", 1)\n        cache.put(\"y\", \"b\", \"two\")\n        clock.set_time(104.0)\n        snap = cache.snapshot()\n        self.eq(set(snap),\n                {\"version\", \"created_at\", \"capacity\", \"ttl\", \"stale_ttl\", \"entries\"})\n        self.eq(snap[\"version\"], 2)\n        self.eq(snap[\"created_at\"], 104.0)\n        self.eq(snap[\"capacity\"], 3)\n        self.eq(snap[\"ttl\"], 10.0)\n        self.eq(snap[\"stale_ttl\"], 4.0)\n        self.eq([item[\"canonical\"] for item in snap[\"entries\"]], [\"x/s:a\", \"y/s:b\"])\n        self.eq(set(snap[\"entries\"][0]),\n                {\"canonical\", \"namespace\", \"value\", \"stored_at\", \"expires_at\"})\n        self.eq(snap[\"entries\"][0][\"namespace\"], \"x\")\n        self.eq(snap[\"entries\"][0][\"value\"], 1)\n        self.eq(snap[\"entries\"][0][\"stored_at\"], 100.0)\n        self.eq(snap[\"entries\"][0][\"expires_at\"], 110.0)\n        self.eq(snap[\"entries\"][1][\"value\"], \"two\")\n        snap[\"entries\"][0][\"value\"] = 999\n        snap[\"entries\"].append(\"junk\")\n        snap[\"version\"] = 7\n        again = cache.snapshot()\n        self.eq(again[\"version\"], 2)\n        self.eq(len(again[\"entries\"]), 2)\n        self.eq(again[\"entries\"][0][\"value\"], 1)\n        self.eq(cache.get(\"x\", \"a\"), 1)\n        self.ok(again is not cache.snapshot())\n        self.ok(again[\"entries\"] is not cache.snapshot()[\"entries\"])\n\n    def test_snapshot_purges_dead_entries(self):\n        cache, clock = build(capacity=3, ttl=10.0, stale_ttl=4.0, start=100.0)\n        cache.put(\"x\", \"a\", 1)\n        cache.put(\"x\", \"b\", 2)\n        clock.set_time(112.0)\n        self.eq(len(cache.snapshot()[\"entries\"]), 2)\n        self.eq(cache.stats()[\"expirations\"], 0)\n        clock.set_time(120.0)\n        self.eq(cache.snapshot()[\"entries\"], [])\n        self.eq(cache.stats()[\"expirations\"], 2)\n        self.eq(len(cache), 0)\n\n    def test_restore_rebases_and_keeps_local_config(self):\n        source, sclock = build(capacity=3, ttl=10.0, start=0.0)\n        source.put(\"n\", \"a\", 1)\n        sclock.set_time(4.0)\n        snap = source.snapshot()\n        target, tclock = build(capacity=3, ttl=100.0, start=1000.0)\n        target.put(\"n\", \"old1\", 1)\n        target.put(\"n\", \"old2\", 2)\n        before = target.stats()\n        self.eq(target.restore(snap), 1)\n        after = target.stats()\n        for name in (\"hits\", \"misses\", \"stale_hits\", \"evictions\", \"expirations\", \"puts\"):\n            self.eq(after[name], before[name], name)\n        self.eq(target.keys(), [\"n/s:a\"])\n        self.eq(target.ttl, 100.0)\n        self.eq(target.get(\"n\", \"a\"), 1)\n        tclock.set_time(1005.9)\n        self.eq(target.get(\"n\", \"a\"), 1)\n        tclock.set_time(1006.0)\n        self.ok(target.get(\"n\", \"a\") is None)\n\n    def test_restore_trims_to_capacity(self):\n        source, sclock = build(capacity=5, ttl=10.0, start=0.0)\n        for index in range(5):\n            source.put(\"n\", \"k%d\" % index, index)\n        sclock.set_time(1.0)\n        snap = source.snapshot()\n        target, _tclock = build(capacity=3, ttl=10.0, start=1.0)\n        self.eq(target.restore(snap), 3)\n        self.eq(target.keys(), [\"n/s:k2\", \"n/s:k3\", \"n/s:k4\"])\n        self.eq(target.get(\"n\", \"k4\"), 4)\n        self.ok(target.get(\"n\", \"k1\") is None)\n        self.eq(len(target), 3)\n\n    def test_restore_drops_dead_records(self):\n        entries = [entry(\"ns/s:dead\", 1, 40.0, 50.0),\n                   entry(\"ns/s:stale\", 2, 85.0, 95.0),\n                   entry(\"ns/s:live\", 3, 100.0, 110.0)]\n        target, _tclock = build(capacity=5, ttl=10.0, stale_ttl=6.0, start=1000.0)\n        self.eq(target.restore(make_snapshot(entries)), 2)\n        self.eq(target.keys(), [\"ns/s:stale\", \"ns/s:live\"])\n        self.eq(target.get_entry(\"ns\", \"stale\").state, \"stale\")\n        self.eq(target.get_entry(\"ns\", \"stale\").value, 2)\n        self.eq(target.get_entry(\"ns\", \"stale\").expires_at, 995.0)\n        self.eq(target.get_entry(\"ns\", \"stale\").stored_at, 985.0)\n        self.eq(target.get(\"ns\", \"live\"), 3)\n        self.eq(len(target), 2)\n        strict, _sclock = build(capacity=5, ttl=10.0, start=1000.0)\n        self.eq(strict.restore(make_snapshot(entries)), 1)\n        self.eq(strict.keys(), [\"ns/s:live\"])\n\n    def test_restore_deduplicates_keeping_last(self):\n        entries = [entry(\"ns/s:a\", 1, 0.0, 10.0),\n                   entry(\"ns/s:b\", 3, 0.0, 10.0),\n                   entry(\"ns/s:a\", 2, 0.0, 10.0)]\n        target, _tclock = build(capacity=5, ttl=10.0, start=0.0)\n        self.eq(target.restore(make_snapshot(entries, created_at=0.0)), 2)\n        self.eq(target.keys(), [\"ns/s:b\", \"ns/s:a\"])\n        self.eq(target.get(\"ns\", \"a\"), 2)\n        self.eq(target.get(\"ns\", \"b\"), 3)\n\n    def test_restore_validation(self):\n        cache, _clock = build(capacity=3, ttl=10.0)\n        self.raises(TypeError, cache.restore, \"snapshot\")\n        self.raises(TypeError, cache.restore, None)\n        self.raises(TypeError, cache.restore, [])\n        base = make_snapshot([entry(\"ns/s:a\", 1, 0.0, 10.0)])\n        for field in (\"version\", \"created_at\", \"capacity\", \"ttl\", \"stale_ttl\", \"entries\"):\n            broken = dict(base)\n            del broken[field]\n            self.raises(ValueError, cache.restore, broken)\n        for bad in (