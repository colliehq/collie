-      "inbox/model.py": "\"\"\"The record type stored in the inbox.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\n\nSTATES = (\"pending\", \"claimed\", \"done\")\n\n\n@dataclass\nclass Entry:\n    \"\"\"One submitted request.\"\"\"\n\n    key: str\n    seq: int\n    payload: dict\n    state: str = \"pending\"\n    created_at: float = 0.0\n    updated_at: float = 0.0\n    owner: str | None = None\n    lease_expires_at: float | None = None\n\n    def lease_expired(self, now: float) -> bool:\n        if self.state != \"claimed\" or self.lease_expires_at is None:\n            return False\n        return now > self.lease_expires_at\n\n    def to_dict(self) -> dict:\n        return {\"key\": self.key, \"seq\": self.seq, \"payload\": self.payload,\n                \"state\": self.state, \"created_at\": self.created_at,\n                \"updated_at\": self.updated_at, \"claimed_by\": self.owner,\n                \"lease_expires_at\": self.lease_expires_at}\n\n    @classmethod\n    def from_dict(cls, raw: dict) -> \"Entry\":\n        return cls(key=raw[\"key\"], seq=raw[\"seq\"], payload=raw.get(\"payload\", {}),\n                   state=raw.get(\"state\", \"pending\"),\n                   created_at=raw.get(\"created_at\", 0.0),\n                   updated_at=raw.get(\"updated_at\", 0.0),\n                   owner=raw.get(\"claimed_by\"),\n                   lease_expires_at=raw.get(\"lease_expires_at\"))\n",
