ked_revision,\n        }\n\n    @classmethod\n    def from_dict(cls, raw: dict) -> \"Entry\":\n        if not isinstance(raw, dict):\n            raise StateFormatError(\"entry must be a JSON object\")\n        key = raw.get(\"key\")\n        if not isinstance(key, str) or not key.strip():\n            raise StateFormatError(f\"invalid entry key: {key!r}\")\n        seq = raw.get(\"seq\")\n        if isinstance(seq, bool) or not isinstance(seq, int):\n            raise StateFormatError(f\"invalid seq for {key!r}: {seq!r}\")\n        state = raw.get(\"state\", \"pending\")\n        if state not in STATES:\n            raise StateFormatError(f\"invalid state for {key!r}: {state!r}\")\n        payload = raw.get(\"payload\", {})\n        if not isinstance(payload, dict):\n            raise StateFormatError(f\"invalid payload for {key!r}\")\n        lease = raw.get(\"lease_expires_at\")\n        return cls(\n            key=key,\n            seq=seq,\n            payload=copy.deepcopy(payload),\n            state=state,\n            revision=int(raw.get(\"revision\", 1)),\n            attempts=int(raw.get(\"attempts\", 0)),\n            created_at=float(raw.get(\"created_at\", 0.0)),\n            updated_at=float(raw.get(\"updated_at\", 0.0)),\n            owner=raw.get(\"owner\", raw.get(\"claimed_by\")),\n            lease_expires_at=None if lease is None else float(lease),\n            result=copy.deepcopy(raw.get(\"result\")),\n            acked_revision=raw.get(\"acked_revision\"),\n        )\n\n\n@dataclass(frozen=True)\nclass SubmitResult:\n    \"\"\"The outcome of a submission, with shortcuts for legacy callers.\"\"\"\n\n    entry: Entry\n    created: bool\n    updated: bool\n\n    @property\n    def key(self):\n        return self.entry.key\n\n    @property\n    def seq(self):\n        return self.entry.seq\n\n    @property\n    def revision(self):\n        return self.entry.revision\n\n    @property\n    def state(self):\n        return self.entry.state\n",
