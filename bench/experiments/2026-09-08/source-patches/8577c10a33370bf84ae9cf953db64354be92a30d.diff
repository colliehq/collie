       self.eq(got[0].attempts, 2)\n        self.eq(got[0].lease_expires_at, 1045.0)\n        self.raises(LeaseError, box.ack, \"alpha\", \"w1\")\n        entry = box.ack(\"alpha\", \"w2\")\n        self.eq(entry.state, \"done\")\n        self.none(entry.result)\n        self.eq(entry.acked_revision, 1)\n        self.eq(entry.attempts, 2)\n\n    def test_ack_rejects_wrong_state_owner_and_revision(self):\n        box = self.make()\n        box.submit(\"alpha\", {\"n\": 1})\n        self.raises(LeaseError, box.ack, \"alpha\", \"w1\")\n        self.raises(UnknownKeyError, box.ack, \"nope\", \"w1\")\n        box.claim(\"w1\", 50)\n        self.raises(LeaseError, box.ack, \"alpha\", \"w2\")\n        self.raises(ConflictError, box.ack, \"alpha\", \"w1\", revision=2)\n        entry = box.get(\"alpha\")\n        self.eq(entry.state, \"claimed\")\n        self.eq(entry.owner, \"w1\")\n        self.eq(entry.revision, 1)\n        self.eq(box.ack(\"alpha\", \"w1\", {\"ok\": 1}, revision=1).state, \"done\")\n        self.raises(LeaseError, box.ack, \"alpha\", \"w1\")\n\n    def test_ack_stores_an_isolated_result(self):\n        box = self.make()\n        box.submit(\"alpha\", {\"n\": 1})\n        box.claim(\"w1\", 50)\n        self.clock.advance(5)\n        outcome = {\"rows\": [1, 2]}\n        entry = box.ack(\"alpha\", \"w1\", outcome)\n        outcome[\"rows\"].append(3)\n        stored = box.get(\"alpha\")\n        self.eq(stored.result, {\"rows\": [1, 2]})\n        entry.result[\"rows\"].append(9)\n        self.eq(box.get(\"alpha\").result, {\"rows\": [1, 2]})\n        self.eq(stored.state, \"done\")\n        self.none(stored.owner)\n        self.none(stored.lease_expires_at)\n        self.eq(stored.acked_revision, 1)\n        self.eq(stored.revision, 1)\n        self.eq(stored.updated_at, 1005.0)\n        self.eq(stored.attempts, 1)\n        self.eq(box.stats(), {\"pending\": 0, \"claimed\": 0, \"done\": 1, \"total\": 1})\n\n    def test_release_returns_the_entry_to_pending(self):\n        box = self.make()\n        box.submit(\"alpha\", {\"n\": 1})\n        self.raises(LeaseError, box.release, \"alpha\", \"w1\")\n        self.raises(UnknownKeyError, box.release, \"nope\", \"w1\")\n        box.claim(\"w1\", 50)\n        self.raises(LeaseError, box.release, \"alpha\", \"w2\")\n        self.clock.advance(2)\n        entry = box.release(\"alpha\", \"w1\")\n        self.eq(entry.state, \"pending\")\n        self.none(entry.owner)\n        self.none(entry.lease_expires_at)\n        self.eq(entry.attempts, 1)\n        self.eq(entry.revision, 1)\n        self.eq(entry.updated_at, 1002.0)\n        self.raises(LeaseError, box.release, \"alpha\", \"w1\")\n        self.eq(box.claim(\"w2\", 5)[0].attempts, 2)\n\n\nclass ValidationTests(Harness):\n    def test_rejected_arguments(self):\n        box = self.make()\n        self.raises(ValidationError, box.submit, \"\", {})\n        self.raises(ValidationError, box.submit, \"   \", {})\n        self.raises(ValidationError, box.submit, None, {})\n        self.raises(ValidationError, box.submit, 5, {})\n        self.raises(ValidationError, box.submit, b\"alpha\", {})\n        self.raises(ValidationError, box.submit, \"alpha\", None)\n        self.raises(ValidationError, box.submit, \"alpha\", [])\n        self.raises(ValidationError, box.submit, \"alpha\", \"payload\")\n        self.raises(ValidationError, box.submit, \"alpha\", {1: 2})\n        self.raises(ValidationError, box.submit, \"alpha\", {\"s\": {1, 2}})\n        self.raises(ValidationError, box.submit, \"alpha\", {\"s\": object()})\n        self.raises(ValidationError, box.claim, \"\", 5)\n        self.raises(ValidationError, box.claim, \"\\t\", 5)\n        self.raises(ValidationError, box.claim, None, 5)\n        self.raises(ValidationError, box.claim, \"w\", 0)\n        self.raises(ValidationError, box.claim, \"w\", -1)\n        self.raises(ValidationError, box.claim, \"w\", True)\n        self.raises(ValidationError, box.claim, \"w\", \"5\")\n        self.raises(ValidationError, box.claim, \"w\", None)\n        self.raises(ValidationError, box.claim, \"w\", float(\"nan\"))\n        self.raises(ValidationError, box.claim, \"w\", float(\"inf\"))\n        self.raises(ValidationError, box.claim, \"w\", 5, 0)\n        self.raises(ValidationError, box.claim, \"w\", 5, -2)\n        self.raises(ValidationError, box.claim, \"w\", 5, True)\n        self.raises(ValidationError, box.claim, \"w\", 5, 1.0)\n        self.raises(ValidationError, box.ack, \"alpha\", \"\")\n        self.raises(ValidationError, box.ack, \"\", \"w\")\n        self.raises(ValidationError, box.ack, \"alpha\", \"w\", [])\n        self.raises(ValidationError, box.ack, \"alpha\", \"w\", {\"z\": object()})\n        self.raises(ValidationError, box.ack, \"alpha\", \"w\", None, revision=0)\n        self.raises(ValidationError, box.ack, \"alpha\", \"w\", None, revision=\"1\")\n        self.raises(ValidationError, box.ack, \"alpha\", \"w\", None, revision=True)\n        self.raises(ValidationError, box.ack, \"missing\", \"w\", None, revision=0)\n        self.raises(ValidationError, box.release, \"missing\", \"\")\n        self.raises(ValidationError, box.get, \"\")\n        self.raises(ValidationError, box.get, 3)\n        self.raises(ValidationError, box.list_entries, \"gone\")\n        self.raises(ValidationError, box.list_entries, 5)\n        self.raises(ValidationError, Inbox, self.path, \"not-callable\")\n        self.raises(ValidationError, Inbox, self.path, None)\n        self.eq(self.clock.calls, 0)\n        self.eq(box.stats(), {\"pending\": 0, \"claimed\": 0, \"done\": 0, \"total\": 0})\n        self.eq(box.list_entries(), [])\n        self.eq(box.next_seq, 1)\n\n    def test_valid_edge_arguments_are_accepted(self):\n        box = self.make()\n        self.eq(box.submit(\" alpha \", {}).entry.key, \" alpha \")\n        self.none(box.get(\"alpha\"))\n        self.eq(box.get(\" alpha \").key, \" alpha \")\n        self.eq(box.submit(\"beta\", {\"deep\": {\"list\": [1, {\"x\": None}]}}).entry.seq, 2)\n        self.eq(len(box.claim(\"w\", 0.5, limit=10)), 2)\n        self.clock.advance(0.5)\n        self.eq(box.sweep(), 2)\n\n\nclass ModelTests(Harness):\n    def test_entry_copy_and_dict_roundtrip(self):\n        entry = Entry(key=\"alpha\", seq=3, payload={\"n\": {\"m\": 1}}, state=\"claimed\",\n                      revision=2, attempts=5, created_at=1.0, updated_at=2.0,\n                      owner=\"w1\", lease_expires_at=9.0, result={\"r\": [1]},\n                      acked_revision=1)\n        clone = entry.copy()\n        self.isnot(clone, entry)\n        self.isnot(clone.payload, entry.payload)\n        clone.payload[\"n\"][\"m\"] = 99\n        clone.result[\"r\"].append(2)\n        clone.owner = \"other\"\n        self.eq(entry.payload[\"n\"][\"m\"], 1)\n        self.eq(entry.result, {\"r\": [1]})\n        self.eq(entry.owner, \"w1\")\n        data = entry.to_dict()\n        self.eq(set(data), {\"key\", \"seq\", \"payload\", \"state\", \"revision\", \"attempts\",\n                            \"created_at\", \"updated_at\", \"owner\", \"lease_expires_at\",\n                            \"result\", \"acked_revision\"})\n        data[\"payload\"][\"n\"][\"m\"] = 42\n        self.eq(entry.payload[\"n\"][\"m\"], 1)\n        again = Entry.from_dict(entry.to_dict())\n        self.eq(again.to_dict(), entry.to_dict())\n        self.eq(again.owner, \"w1\")\n        self.eq(again.acked_revision, 1)\n\n    def test_lease_expired_boundaries(self):\n        entry = Entry(key=\"a\", seq=1, payload={}, state=\"claimed\", lease_expires_at=10.0)\n        self.false(entry.lease_expired(9.999))\n        self.true(entry.lease_expired(10.0))\n        self.true(entry.lease_expired(11.0))\n        self.false(Entry(key=\"a\", seq=1, payload={}).lease_expired(10.0))\n        self.false(Entry(key=\"a\", seq=1, payload={}, state=\"claimed\").lease_expired(10.0))\n        self.false(Entry(key=\"a\", seq=1, payload={}, state=\"done\",\n                         lease_expires_at=1.0).lease_expired(10.0))\n\n    def test_from_dict_defaults_and_errors(self):\n        entry = Entry.from_dict({\"key\": \"a\", \"seq\": 2, \"claimed_by\": \"w\", \"junk\": 1})\n        self.eq(entry.payload, {})\n        self.eq(entry.revision, 1)\n        self.eq(entry.attempts, 0)\n        self.eq(entry.state, \"pending\")\n        self.eq(entry.created_at, 0.0)\n        self.eq(entry.updated_at, 0.0)\n        self.eq(entry.owner, \"w\")\n        self.none(entry.lease_expires_at)\n        self.none(entry.result)\n        self.none(entry.acked_revision)\n        self.eq(Entry.from_dict({\"key\": \"a\", \"seq\": 2, \"owner\": \"new\",\n                                 \"claimed_by\": \"old\"}).owner, \"new\")\n        self.none(Entry.from_dict({\"key\": \"a\", \"seq\": 2, \"owner\": None,\n                                   \"claimed_by\": \"old\"}).owner)\n        self.raises(StateFormatError, Entry.from_dict, {\"seq\": 1})\n        self.raises(StateFormatError, Entry.from_dict, {\"key\": \"  \", \"seq\": 1})\n        self.raises(StateFormatError, Entry.from_dict, {\"key\": 4, \"seq\": 1})\n        self.raises(StateFormatError, Entry.from_dict, {\"key\": \"a\"})\n        self.raises(StateFormatError, Entry.from_dict, {\"key\": \"a\", \"seq\": \"1\"})\n        self.raises(StateFormatError, Entry.from_dict, {\"key\": \"a\", \"seq\": True})\n        self.raises(StateFormatError, Entry.from_dict,\n                    {\"key\": \"a\", \"seq\": 1, \"state\": \"x\"})\n        self.raises(StateFormatError, Entry.from_dict,\n                    {\"key\": \"a\", \"seq\": 1, \"payload\": []})\n        self.raises(StateFormatError, Entry.from_dict, [])\n\n\nclass StorageTests(Harness):\n    def test_document_shape_is_version_2(self):\n        box = self.make()\n        box.submit(\"alpha\", {\"n\": 1})\n        box.claim(\"w1\", 30)\n        box.ack(\"alpha\", \"w1\", {\"r\": 1})\n        box.submit(\"beta\", {\"n\": 2})\n        doc = self.read_doc()\n        self.eq(set(doc), {\"version\", \"next_seq\", \"entries\"})\n        self.eq(doc[\"version\"], 2)\n        self.eq(doc[\"next_seq\"], 3)\n        self.eq(set(doc[\"entries\"]), {\"alpha\", \"beta\"})\n        item = doc[\"entries\"][\"alpha\"]\n        self.eq(set(item), {\"key\", \"seq\", \"payload\", \"state\", \"revision\", \"attempts\",\n                            \"created_at\", \"updated_at\", \"owner\", \"lease_expires_at\",\n                            \"result\", \"acked_revision\"})\n        self.false(\"claimed_by\" in item)\n        self.eq(item[\"state\"], \"done\")\n        self.eq(item[\"result\"], {\"r\": 1})\n        self.eq(item[\"acked_revision\"], 1)\n        self.eq(item[\"attempts\"], 1)\n        self.none(item[\"owner\"])\n        self.none(item[\"lease_expires_at\"])\n        self.eq(CURRENT_VERSION, 2)\n        self.eq(tuple(SUPPORTED_VERSIONS), (1, 2))\n        self.eq(STATES, (\"pending\", \"claimed\", \"done\"))\n\n    def test_reload_resumes_the_session(self):\n        box = self.make()\n        box.submit(\"alpha\", {\"n\": 1})\n        box.submit(\"beta\", {\"n\": 2})\n        box.claim(\"w1\", 30)\n        later = FakeClock(2000.0)\n        box2 = Inbox(self.path, later)\n        self.eq(later.calls, 0)\n        self.eq(box2.next_seq, 3)\n        self.eq([e.key for e in box2.list_entries()], [\"alpha\", \"beta\"])\n        self.eq(box2.get(\"alpha\").to_dict(), box.get(\"alpha\").to_dict())\n        self.eq(box2.stats(), {\"pending\": 1, \"claimed\": 1, \"done\": 0, \"total\": 2})\n        self.eq(box2.sweep(), 1)\n        self.eq(box2.submit(\"gamma\", {}).entry.seq, 3)\n        self.eq(self.read_doc()[\"next_seq\"], 4)\n        box3 = Inbox(str(self.path), FakeClock(3000.0))\n        self.eq(box3.next_seq, 4)\n        self.eq([e.key for e in box3.list_entries()], [\"alpha\", \"beta\", \"gamma\"])\n        self.eq(box3.get(\"alpha\").attempts, 1)\n\n    def test_next_seq_is_derived_not_trusted(self):\n        self.write_doc({\"version\": 2, \"next_seq\": 99, \"marker\": 1, \"entries\": {\n            \"alpha\": {\"key\": \"ignored\", \"seq\": 2, \"payload\": {}, \"state\": \"pending\",\n                      \"revision\": 3, \"attempts\": 4, \"created_at\": 1.0,\n                      \"updated_at\": 2.0, \"owner\": None, \"lease_expires_at\": None,\n                      \"result\": None, \"acked_revision\": None, \"extra\": \"ignored\"}}})\n        box = self.make()\n        self.eq(box.next_seq, 3)\n        entry = box.get(\"alpha\")\n        self.eq(entry.key, \"alpha\")\n        self.eq(entry.revision, 3)\n        self.eq(entry.attempts, 4)\n        self.eq(box.submit(\"beta\", {}).entry.seq, 3)\n        self.eq(box.next_seq, 4)\n        self.eq(self.read_doc()[\"next_seq\"], 4)\n        self.eq(box.submit(\"alpha\", {\"changed\": True}).entry.revision, 4)\n\n    def test_v1_file_is_migrated(self):\n        self.write_doc({\"version\": 1, \"entries\": {\n            \"alpha\": {\"key\": \"alpha\", \"seq\": 4, \"payload\": {\"n\": 1},\n                      \"state\": \"claimed\", \"created_at\": 10.0, \"updated_at\": 20.0,\n                      \"claimed_by\": \"old\", \"lease_expires_at\": 90.0},\n            \"beta\": {\"key\": \"beta\", \"seq\": 2, \"state\": \"done\", \"created_at\": 5.0,\n                     \"updated_at\": 6.0, \"claimed_by\": None,\n                     \"lease_expires_at\": None}}})\n        box = self.make()\n        self.eq(box.next_seq, 5)\n        alpha = box.get(\"alpha\")\n        self.eq(alpha.owner, \"old\")\n        self.eq(alpha.state, \"claimed\")\n        self.eq(alpha.revision, 1)\n        self.eq(alpha.attempts, 0)\n        self.none(alpha.result)\n        self.none(alpha.acked_revision)\n        self.eq(alpha.lease_expires_at, 90.0)\n        self.eq(alpha.created_at, 10.0)\n        beta = box.get(\"beta\")\n        self.eq(beta.payload, {})\n        self.eq(beta.state, \"done\")\n        self.eq([e.key f