-def _tree_manifest(root: Path) -> dict[str, str]:
-    manifest: dict[str, str] = {}
-    for path in sorted(root.rglob("*")):
-        if path.is_file():
-            manifest[path.relative_to(root).as_posix()] = _sha_file(path)
-    return manifest
