+++ b/tests/test_experimental_session_sdk.py
@@ -0,0 +1,1242 @@
+"""EXPERIMENTAL persistent native SDK session transport.
+
+The question these tests answer is not "does a session work" but "can a session
+ever answer from context the caller believes it removed".  Collie hands a
+provider the whole conversation on every call and freely rewrites it — the
+composer elides old tool output, compaction replaces a span with a summary, the
+loop narrows the tool list at its hard deadline, a critic borrows the same
+provider.  A native session holds its own history, so every one of those must
+force a fresh conversation rather than a delta into a stale one.
+
+Nothing here talks to the network, spawns a process, or imports the optional
+SDK: the worker channel and the SDK client are both scripted.
+"""
+import asyncio
+import copy
+import json
+import threading
+
+import pytest
+
+from harness import claude_agent_worker as checked
+from harness import experimental_session_worker as session_worker
+from harness.claude_agent_sdk import ClaudeAgentSdkProvider
+from harness.experimental_session_sdk import (ExperimentalSessionSdkProvider,
+                                              ResetRequired, SessionHistoryAdapter,
+                                              reply_for, session_key)
+
+
+NAMES = ["read_file", "edit_file", "grep"]
+SCHEMAS = [{"name": name, "description": name, "input_schema": {"type": "object"}}
+           for name in NAMES]
+SYSTEM = "You are collie, a focused coding agent."
+KEY = "a" * 64
+READ = '{"tool": "read_file", "args": {"path": "pager.py"}}'
+EDIT = '{"tool": "edit_file", "args": {"path": "pager.py", "old_string": "a"}}'
+DONE = '{"answer": "the cursor validation order is fixed"}'
+# A real 1x1 PNG: the production transport sniffs the container before it
+# accepts an attachment, so a placeholder string would be refused for the wrong
+# reason and the fallback under test would never be exercised.
+PNG = ("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAh"
+       "KmMIQAAAABJRU5ErkJggg==")
+
+
+# --------------------------------------------------------------------------- #
+#  Scripted transport
+# --------------------------------------------------------------------------- #
+def structured_payload(text, tools=NAMES, cache_read=0):
+    return {"ok": True, "text": text, "api_key_source": "none",
+            "response_format": "structured", "response_tools": list(tools),
+            "usage": {"input_tokens": 2, "output_tokens": 40,
+                      "cache_read_input_tokens": cache_read,
+                      "cache_creation_input_tokens": 0}}
+
+
+def plain_payload(text):
+    return {"ok": True, "text": text, "api_key_source": "none",
+            "usage": {"input_tokens": 2, "output_tokens": 5,
+                      "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}}
+
+
+class _FakeProc:
+    def __init__(self):
+        self.returncode = None
+
+    def poll(self):
+        return self.returncode
+
+
+class _ScriptedChannel:
+    """A session worker that replays payloads and records what it was sent."""
+
+    def __init__(self, key, open_request, script):
+        self.key = key
+        self.open_request = open_request
+        self.script = script
+        self.sent = []
+        self.proc = _FakeProc()
+        self.closed = False
+        self.identity = "b" * 64
+
+    def alive(self):
+        return not self.closed and self.proc.poll() is None
+
+    def exchange(self, frame, timeout):
+        if not self.alive():
+            raise RuntimeError("session worker exited")
+        assert frame["session_key"] == self.key, "a turn must name its own session"
+        self.sent.append(frame["request"])
+        payload = self.script.pop(0)
+        if isinstance(payload, BaseException):
+            raise payload
+        return {"type": "turn", "protocol": 10, "seq": frame["seq"], "payload": payload,
+                "session": {"queries": frame["seq"], "inits": frame["seq"],
+                            "id_sha256": self.identity}}
+
+    def close(self):
+        self.closed = True
+        self.proc.returncode = 0
+        return True
+
+
+class _BlockingChannel(_ScriptedChannel):
+    def __init__(self, *args):
+        super().__init__(*args)
+        self.entered = threading.Event()
+        self.released = threading.Event()
+
+    def exchange(self, frame, timeout):
+        self.entered.set()
+        if not self.released.wait(timeout=10):
+            raise TimeoutError("session worker timed out")
+        return super().exchange(frame, timeout)
+
+    def close(self):
+        result = super().close()
+        self.released.set()
+        return result
+
+
+class _Provider(ExperimentalSessionSdkProvider):
+    def __init__(self, script, channel_class=_ScriptedChannel, **kwargs):
+        kwargs.setdefault("structured_output", True)
+        super().__init__(model="opus", **kwargs)
+        self.script = list(script)
+        self.channels = []
+        self.channel_class = channel_class
+
+    def _open_channel(self, key, open_request):
+        channel = self.channel_class(key, open_request, self.script)
+        self.channels.append(channel)
+        self.session_evidence["sessions_opened"] += 1
+        return channel
+
+
+class _Ledger:
+    """One reservation per physically issued model request."""
+
+    def __init__(self):
+        self.reserved = []
+        self.settled = []
+
+    def reserve(self, purpose):
+        self.reserved.append(purpose)
+        return "req-%d" % len(self.reserved)
+
+    def settle(self, request_id, outcome="completed"):
+        self.settled.append((request_id, outcome))
+
+
+def call(provider, ledger, messages, schemas=SCHEMAS, system=SYSTEM, scope="mission-1"):
+    with provider.request_authority(ledger.reserve, ledger.settle, request_scope=scope):
+        return provider.complete(system, list(messages), schemas)
+
+
+def assistant(completion):
+    """The message harness/loop.py appends for a tool-calling completion."""
+    return {"role": "assistant", "content": completion.text,
+            "tool_calls": completion.tool_calls, "thinking_blocks": []}
+
+
+def observation(completion, output):
+    call_ = completion.tool_calls[0]
+    return {"role": "tool", "tool_call_id": call_.id, "name": call_.name,
+            "content": output}
+
+
+def prompts(provider, index=0):
+    return [request["prompt"] for request in provider.channels[index].sent]
+
+
+# --------------------------------------------------------------------------- #
+#  The real loop's tool / action / result sequence
+# --------------------------------------------------------------------------- #
+def test_real_loop_sequence_sends_only_the_new_observations():
+    provider = _Provider([structured_payload(READ), structured_payload(EDIT),
+                          structured_payload(DONE)])
+    ledger = _Ledger()
+    messages = [{"role": "user", "content": "Fix the cursor validation order."}]
+
+    first = call(provider, ledger, messages)
+    assert first.stop_reason == "tool_use"
+    messages += [assistant(first), observation(first, "line one\nline two")]
+
+    second = call(provider, ledger, messages)
+    assert second.stop_reason == "tool_use"
+    messages += [assistant(second), observation(second, "edited pager.py")]
+
+    third = call(provider, ledger, messages)
+    assert third.stop_reason == "end_turn"
+
+    assert len(provider.channels) == 1, "one conversation carried all three turns"
+    sent = prompts(provider)
+    # Turn 1 is byte-identical to what the shipped stateless transport sends.
+    assert sent[0] == ClaudeAgentSdkProvider(model="opus", structured_output=True)._payload(
+        [{"role": "user", "content": "Fix the cursor validation order."}], SCHEMAS)
+    # Turns 2 and 3 append ONLY the new host observation, in the production
+    # serializer's own wording, and never re-send the assistant turn the native
+    # history already holds.
+    assert sent[1] == "Result of read_file: line one\nline two"
+    assert sent[2] == "Result of edit_file: edited pager.py"
+    assert "Fix the cursor validation order" not in sent[1]
+    assert "read_file" not in sent[2].replace("Result of edit_file", "")
+    assert provider.session_evidence["session_turns"] == 3
+
+
+def test_a_new_user_message_and_a_tool_result_append_together():
+    provider = _Provider([structured_payload(READ), structured_payload(DONE)])
+    ledger = _Ledger()
+    messages = [{"role": "user", "content": "start"}]
+    first = call(provider, ledger, messages)
+    messages += [assistant(first), observation(first, "contents"),
+                 {"role": "user", "content": "also check the pager"}]
+
+    call(provider, ledger, messages)
+
+    assert prompts(provider)[1] == ("Result of read_file: contents\n"
+                                    "User: also check the pager")
+
+
+def test_every_query_takes_exactly_one_reservation():
+    provider = _Provider([structured_payload(READ), structured_payload(DONE)])
+    ledger = _Ledger()
+    messages = [{"role": "user", "content": "start"}]
+
+    first = call(provider, ledger, messages)
+    messages += [assistant(first), observation(first, "contents")]
+    second = call(provider, ledger, messages)
+
+    assert first.request_count == 1 and second.request_count == 1
+    assert ledger.reserved == ["claude_agent_sdk", "claude_agent_sdk"]
+    assert ledger.settled == [("req-1", "completed"), ("req-2", "completed")]
+    assert len(provider.channels[0].sent) == 2, "one physical query per reservation"
+
