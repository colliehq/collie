+
+    # The retained handles now terminate the tree; only then may work resume.
+    result = call(provider, ledger, [{"role": "user", "content": "second task"}])
+
+    assert stuck.closed is True and stuck.close_calls >= 3
+    assert result.stop_reason == "end_turn"
