index 0000000000000000000000000000000000000000..263d7e9a33e5ab5f5c315ee4c6d7e7b626708dd8
--- /dev/null
+++ b/bench/session_transport/smoke_session_transport.py
@@ -0,0 +1,218 @@
+"""EXPERIMENTAL transport smoke for the persistent native SDK session.
+
+The unit suite scripts the worker channel and the SDK client, so it proves the
+protocol and the reset rules but never proves the *process* works.  This script
+issues a small, bounded number of real model requests through the actual
+subprocess: spawn, ownership, line protocol, one connected ``ClaudeSDKClient``,
+Collie's ``{tool|answer}`` contract, and the native-session
+attestation.
+
+It is a transport check, not a coding benchmark, and it deliberately executes
+**no** host tool. Tool schemas use the same names as the coding benchmark;
+every "tool result" fed back is a fixed string in this file, so nothing on disk
+is read or written, and no result is evidence about any repository. Plain mode
+is the default; ``--structured-output`` explicitly selects native formatting.
+
+    python bench/session_transport/smoke_session_transport.py \
+        --out results/smoke --turns 3 --i-will-spend
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import sys
+import time
+
+
+ROOT = Path(__file__).resolve().parents[2]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from harness.experimental_session_sdk import \
+    ExperimentalSessionSdkProvider                                  # noqa: E402
+
+
+# A realistic-shape Collie system prompt, kept short.  Its only job is to be
+# long enough that the provider's cache accounting is meaningful and stable
+# across turns, and identical on every turn so a session can be re-used.
+SYSTEM = (
+    "You are Collie, a coding agent in a frozen transport smoke test.\n"
+    "MODE: Act — use tools to gather facts before answering.\n"
+    "TOOLS (always-on): read_file, write_file, edit_file, grep, glob\n"
+    "WORKING DIRECTORY: /smoke\n"
+    "This is a transport check. No workspace exists and no tool you request will "
+    "actually run; the host replies with a fixed placeholder observation. Do not "
+    "claim to have edited files or run tests. Keep every answer under 60 words."
+)
+# Exactly the frozen benchmark's five tools.  The names matter: Collie's own
+# prompt tells the model to "inspect the workspace with grep, glob, or
+# read_file", and the provider enforces this list as a schema enum — so a
+# smoke that declared a SHORTER list would push the model toward a name the
+# enum rejects, and the resulting formatter error would look like a transport
+# fault rather than the tool-list mismatch it actually is.
+_PATH = {"type": "object", "properties": {"path": {"type": "string"}},
+         "required": ["path"]}
+SCHEMAS = [
+    {"name": "read_file", "description": "read a file", "input_schema": _PATH},
+    {"name": "write_file", "description": "write a file",
+     "input_schema": {"type": "object",
+                      "properties": {"path": {"type": "string"},
+                                     "content": {"type": "string"}},
+                      "required": ["path", "content"]}},
+    {"name": "edit_file", "description": "replace a string in a file",
+     "input_schema": {"type": "object",
+                      "properties": {"path": {"type": "string"},
+                                     "old_string": {"type": "string"},
+                                     "new_string": {"type": "string"}},
+                      "required": ["path", "old_string", "new_string"]}},
+    {"name": "grep", "description": "search the repository",
+     "input_schema": {"type": "object", "properties": {"pattern": {"type": "string"}},
+                      "required": ["pattern"]}},
+    {"name": "glob", "description": "list files matching a pattern",
+     "input_schema": {"type": "object", "properties": {"pattern": {"type": "string"}},
+                      "required": ["pattern"]}},
+]
+TASK = ("A module `pager.py` is reported to mis-order its validation checks. "
+        "Start by requesting the file with the read_file tool.")
+# Fixed, host-authored observations. Nothing here comes from the filesystem.
+OBSERVATIONS = [
+    "def encode(version, rank, key):\n"
+    "    if not isinstance(version, int):\n"
+    "        raise TypeError('version')\n"
+    "    return '%s.%s.%s' % (version, rank, key)\n",
+    "PLACEHOLDER: this transport smoke does not execute host tools, so this "
+    "observation carries no repository content.",
+]
+FOLLOWUPS = [
+    "Name the single most important missing validation, in one sentence.",
+    "State one remaining limitation of this review, in one sentence.",
+]
+
+
+class _Ledger:
+    """One reservation per physical model request, journalled in memory."""
+
+    def __init__(self):
+        self.rows = []
+
+    def reserve(self, purpose):
+        self.rows.append({"purpose": purpose, "outcome": None})
+        return str(len(self.rows))
+
+    def settle(self, request_id, outcome="completed"):
+        row = self.rows[int(request_id) - 1]
+        if row["outcome"] is not None:
+            raise RuntimeError("request is already settled")
+        row["outcome"] = outcome
+
+
+def _turn_record(index, completion, seconds, provider):
+    usage = completion.usage
+    return {
+        "turn": index,
+        "seconds": round(seconds, 3),
+        "stop_reason": completion.stop_reason,
+        "request_count": completion.request_count,
+        "tool": completion.tool_calls[0].name if completion.tool_calls else None,
+        "answer_chars": len(completion.text or ""),
+        "error_detail": (completion.error_detail or "")[:200],
+        "usage": {"input_tokens": usage.input_tokens,
+                  "output_tokens": usage.output_tokens,
+                  "cache_read": usage.cache_read,
+                  "cache_creation": usage.cache_creation},
+        "sessions_opened": provider.session_evidence["sessions_opened"],
+    }
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", required=True, help="fresh output directory")
+    parser.add_argument("--turns", type=int, default=3,
+                        help="physical model requests to issue (hard cap 4)")
+    parser.add_argument("--model", default="claude-opus-5")
+    parser.add_argument("--effort", default="default")
+    parser.add_argument("--structured-output", action="store_true")
+    parser.add_argument("--i-will-spend", action="store_true")
+    args = parser.parse_args(argv)
+    if not 1 <= args.turns <= 4:
+        parser.error("--turns must be between 1 and 4")
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+    if any(out.iterdir()):
+        parser.error("--out must be a fresh directory")
+    if not args.i_will_spend:
+        parser.error("this smoke issues real model requests; pass --i-will-spend")
+
+    provider = ExperimentalSessionSdkProvider(
+        model=args.model, effort=args.effort, subscription_only=True, timeout=180,
+        structured_output=args.structured_output)
+    ledger = _Ledger()
+    messages = [{"role": "user", "content": TASK}]
+    turns = []
+    try:
+        with provider.request_authority(ledger.reserve, ledger.settle,
+                                        request_scope="smoke"):
+            for index in range(args.turns):
+                started = time.monotonic()
+                completion = provider.complete(SYSTEM, list(messages), SCHEMAS)
+                turns.append(_turn_record(index, completion,
+                                          time.monotonic() - started, provider))
+                if completion.stop_reason == "error":
+                    break
+                if completion.tool_calls:
+                    messages.append({"role": "assistant", "content": completion.text,
+                                     "tool_calls": completion.tool_calls,
+                                     "thinking_blocks": completion.thinking_blocks})
+                    call = completion.tool_calls[0]
+                    messages.append({
+                        "role": "tool", "tool_call_id": call.id, "name": call.name,
+                        "content": OBSERVATIONS[min(index, len(OBSERVATIONS) - 1)]})
+                else:
+                    messages.append({"role": "assistant", "content": completion.text})
+                    messages.append({"role": "user",
+                                     "content": FOLLOWUPS[min(index,
+                                                              len(FOLLOWUPS) - 1)]})
+    finally:
+        close_reported = provider.close_session("smoke_finished")
+        if provider._unresolved:
+            provider.cancel_current()
+
+    receipt = {
+        "schema_version": 1,
+        "claim": ("Transport smoke only: one persistent native SDK session serving "
+                  "Collie's response contract. No host tool ran, no repository was "
+                  "read, and this says nothing about coding task success."),
+        "model": args.model,
+        "effort": args.effort,
+        "structured_output": args.structured_output,
+        "requested_turns": args.turns,
+        "turns": turns,
+        "reservations": ledger.rows,
+        "session_evidence": provider.session_evidence,
+        "ownership": {
+            "close_reported": close_reported,
+            "unresolved_workers": len(provider._unresolved),
+            "active_registrations": len(provider._active_runs),
+            "session_retired": provider._session is None,
+        },
+        "one_reservation_per_request": (
+            len(ledger.rows) == sum(row["request_count"] for row in turns)),
+        "single_session": provider.session_evidence["sessions_opened"] == 1,
+        "cache_read_on_followups": [row["usage"]["cache_read"] for row in turns[1:]],
+    }
+    receipt['passed'] = bool(
+        len(turns) == args.turns and all(row['stop_reason'] != 'error' for row in turns)
+        and receipt['one_reservation_per_request'] and receipt['single_session']
+        and provider.session_evidence['longest_session_turns'] == args.turns
+        and receipt['ownership']['session_retired']
+        and not receipt['ownership']['unresolved_workers']
+        and not receipt['ownership']['active_registrations'])
+    (out / "smoke.json").write_text(
+        json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps(receipt, indent=2, sort_keys=True))
+    return 0 if receipt['passed'] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
