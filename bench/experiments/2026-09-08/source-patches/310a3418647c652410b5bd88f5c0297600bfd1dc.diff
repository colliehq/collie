+def test_images_fall_back_to_the_stateless_transport(stateless):
+    provider = _Provider([structured_payload(READ), structured_payload(DONE)])
+    ledger = _Ledger()
+    messages = [{"role": "user", "content": "start"}]
+    first = call(provider, ledger, messages)
+    messages += [assistant(first), observation(first, "contents"),
+                 {"role": "user", "content": [
+                     {"type": "text", "text": "look at this"},
+                     {"type": "image", "media_type": "image/png", "data": PNG}]}]
+
+    result = call(provider, ledger, messages)
+
+    assert result.stop_reason == "end_turn"
+    assert len(stateless) == 1, "the image request went to the shipped provider"
+    assert provider.session_evidence["fallbacks"]["non_text_content"] == 1
+    # The session never observed the image, so it must not continue.
+    assert provider._session is None
