index 0000000000000000000000000000000000000000..cb68e60b6887b66945d8c5325fa8fa46a2b73c20
--- /dev/null
+++ b/harness/experimental_session_sdk.py
@@ -0,0 +1,1063 @@
+"""EXPERIMENTAL persistent native-session transport for Collie's coding loop.
+
+Nothing in the product selects this provider.  It is opt-in, off by default, and
+exists so a controlled benchmark can measure whether a *native* SDK conversation
+beats the shipped stateless transport on Collie's real
+``complete(system, messages, tool_schemas)`` contract.
+
+Why it might.  ``ClaudeAgentSdkProvider`` opens a fresh ``sdk.query()`` per
+logical turn and flattens the whole conversation into one user prompt.  Measured
+on a six-turn public code review (``cache-real-dialogue``, 3 repetitions), that
+path hit the prompt cache on **0 of 15** follow-ups, while one long-lived
+``ClaudeSDKClient`` fed the same turns as appended user messages hit it on
+**15 of 15**.  No coding-benchmark claim is made here: see
+``bench/session_transport/README.md``.
+
+What this module owns.  The caller's history stays authoritative.  A session is
+re-used only when the new request is a strict *append* to what that session has
+already seen AND the system prompt, model, effort, response contract, and tool
+schemas are unchanged.  Anything else — compaction, tool-result elision, a
+rewritten prefix, a changed system prompt, a narrowed tool list, an assistant
+message this session never produced — resets to a fresh session that re-sends
+the full production prompt.  Removed context is never silently carried forward.
+
+What it deliberately does not own.  Model-facing validation is delegated to the
+reviewed production code and is not re-implemented here:
+
+* ``ClaudeAgentSdkProvider.complete`` (inherited unchanged) still performs the
+  reservation, auth attestation, structured-format attestation, envelope
+  parsing, usage validation, and provider-rejection classification;
+* ``claude_agent_worker._build_options`` / ``_query`` still build the options
+  and validate every stream message inside the worker.
+
+Only two seams are overridden: ``_payload`` plans the append-only delta, and
+``_run_worker`` routes that one turn through the persistent worker instead of a
+fresh one.  Images, a concurrent second call on the same provider instance, and
+an explicitly disabled session all fall back to the *unmodified* stateless
+transport rather than degrading any guarantee.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import queue
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import uuid
+
+from .claude_agent_sdk import (_FORMATTER_REFUSED, _STRUCTURED_FORMAT,
+                               ClaudeAgentSdkProvider, _RequestRefused,
+                               _formatter_refusal, _provider_rejection,
+                               _safe_failure, _sanitized_worker_env,
+                               _terminate_worker_tree)
+from .providers import (Completion, _parse_response_envelope, _tc_fields,
+                        content_text)
+
+
+_SESSION_PROTOCOL = 10
+_MAX_FRAME_BYTES = 4 * 1024 * 1024
+_MAX_STDERR = 64 * 1024
+_READY_TIMEOUT = 60.0
+_CLOSE_GRACE = 1.0
+
+
+class ResetRequired(Exception):
+    """This session cannot continue incrementally; a fresh one must be opened.
+
+    Divergence has to be loud.  A session that quietly keeps history the caller
+    deleted is worse than a restarted one: the model would answer from context
+    the host believes is gone.
+    """
+
+    def __init__(self, reason: str, detail: str = ""):
+        super().__init__(detail or reason)
+        self.reason = reason
+        self.detail = detail or reason
+
+
+def _canonical(value) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                      separators=(",", ":"), allow_nan=False)
+
+
+def _reject_constant(value):
+    raise ValueError("non-finite JSON number is forbidden: %s" % value)
+
+
+def session_key(open_request: dict, tool_schemas) -> str:
+    """The identity of one re-usable session.
+
+    Everything that changes what the model was told, or what it is allowed to
+    answer with, is inside this digest: the exact system prompt (including the
+    structured transport suffix), the model route, the effort, the response
+    format and its tool allowlist, and the full tool schemas.  A change to any
+    of them produces a different key, and a different key is a new session.
+    """
+    try:
+        return hashlib.sha256(_canonical({
+            "transport": _SESSION_PROTOCOL,
+            "request": open_request,
+            "tool_schemas": tool_schemas or [],
+        }).encode("utf-8")).hexdigest()
+    except (TypeError, ValueError, RecursionError) as exc:
+        raise _RequestRefused("this request cannot be keyed for session re-use") from exc
+
+
+def is_text_only(messages) -> bool:
+    """Whether every message is plain text this transport can append verbatim."""
+    for message in messages or []:
+        content = message.get("content") if isinstance(message, dict) else None
+        if isinstance(content, list):
+            for block in content:
+                if not isinstance(block, dict) or block.get("type") != "text":
+                    return False
+    return True
+
+
+# --------------------------------------------------------------------------- #
+#  Host history -> one append-only user turn
+# --------------------------------------------------------------------------- #
+class _Reply:
+    """The canonical response this session produced, awaiting the host's copy."""
+
+    __slots__ = ("kind", "text", "name", "args")
+
+    def __init__(self, kind: str, text: str = "", name: str = "", args: str = ""):
+        self.kind = kind          # "tool" | "answer" | "text" | "unparsed"
+        self.text = text
+        self.name = name
+        self.args = args
+
+    def __eq__(self, other):
+        return (isinstance(other, _Reply) and self.kind == other.kind
+                and self.text == other.text and self.name == other.name
+                and self.args == other.args)
+
+    def __repr__(self):
+        return "_Reply(%r, name=%r)" % (self.kind, self.name)
+
+
+class _Entry:
+    """One host message, reduced to its digest and its model-facing rendering."""
+
+    __slots__ = ("role", "digest", "render", "text", "calls")
+
+    def __init__(self, role, digest, render, text, calls):
+        self.role = role
+        self.digest = digest
+        self.render = render
+        self.text = text
+        self.calls = calls
+
+    def matches(self, reply: _Reply) -> bool:
+        """Whether this host assistant message IS the reply we produced.
+
+        The native conversation already holds the model's own turn.  The host's
+        canonical envelope is a different representation of the same answer, so
+        it is reconciled rather than re-sent — and a mismatch is a reset, never a
+        fabricated assistant message.
+        """
+        if reply.kind == "tool":
+            return (len(self.calls) == 1 and self.calls[0][0] == reply.name
+                    and self.calls[0][1] == reply.args and not self.text)
+        if reply.kind in ("answer", "text"):
+            return not self.calls and self.text == reply.text
+        # "unparsed": the model answered but the host could not record a
+        # canonical envelope for it, so no host message can be proven equivalent.
+        return False
+
+
+def _entry(message, tool_bearing: bool) -> _Entry:
+    """Digest + delta rendering for one host message.
+
+    The rendering mirrors the production serializer exactly — ``User:`` /
+    ``Result of <tool>:`` for tool-bearing calls (``ClaudeCliProvider._prompt``
+    with ``tool_result_limit=None``) and ``<Role>: `` for the tool-less planner
+    (``ClaudeAgentSdkProvider._plain_prompt``) — so a delta introduces no new
+    model-facing wording of its own.
+    """
+    if not isinstance(message, dict):
+        raise ResetRequired("unsupported_message", "history entry is not an object")
+    role = str(message.get("role") or "")
+    content = message.get("content", "")
+    if isinstance(content, list):
+        for block in content:
+            if not isinstance(block, dict) or block.get("type") != "text":
+                raise ResetRequired("unsupported_content",
+                                    "non-text content cannot be appended to a session")
+    calls = []
+    if role == "user":
+        # Both production serializers label a user turn "User: ".
+        text = content_text(content)
+        render = "User: " + text
+    elif role == "assistant":
+        text = content_text(content)
+        for call in message.get("tool_calls") or []:
+            _identifier, name, args = _tc_fields(call)
+            try:
+                calls.append((str(name or ""), _canonical(args or {})))
+            except (TypeError, ValueError, RecursionError) as exc:
+                raise ResetRequired("unsupported_content",
+                                    "tool arguments are not canonical JSON") from exc
+        render = ""      # never re-sent: the native history is the authority
+    elif role == "tool":
+        text = str(message.get("content", ""))
+        name = str(message.get("name") or "")
+        render = ("Result of %s: %s" % (name, text) if tool_bearing
+                  else "Tool: " + text)
+        calls = [(name, "")]
+    else:
+        raise ResetRequired("unsupported_role", "unsupported role: %s" % (role or "empty"))
+    digest = hashlib.sha256(_canonical([role, text, calls]).encode("utf-8")).hexdigest()[:32]
+    return _Entry(role, digest, render, text, calls)
+
+
+class TurnPlan:
+    """What this call will send, decided before any request is issued."""
+
+    __slots__ = ("first", "delta", "digests")
+
+    def __init__(self, first: bool, delta: str, digests):
+        self.first = first
+        self.delta = delta
+        self.digests = digests
+
+
+class SessionHistoryAdapter:
+    """Successive immutable host histories -> append-only session turns."""
+
+    def __init__(self, key: str, tool_bearing: bool):
+        self.key = key
+        self.tool_bearing = bool(tool_bearing)
+        self.turns = 0
+        self._prefix: list[str] = []
+        self._pending: _Reply | None = None
+        self._closed = False
+
+    def plan(self, key: str, messages) -> TurnPlan:
+        """One append-only turn, or :class:`ResetRequired`."""
+        if self._closed:
+            raise ResetRequired("session_closed", "this adapter was already reset")
+        if key != self.key:
+            self._closed = True
+            raise ResetRequired("config_changed",
+                                "system prompt, model, effort, or tool schemas changed")
+        entries = [_entry(message, self.tool_bearing) for message in messages or []]
+        digests = [entry.digest for entry in entries]
+        if not entries:
+            raise ResetRequired("empty_history", "a session turn needs a conversation")
+        if self.turns == 0:
+            # A fresh session re-sends the complete production prompt, so nothing
+            # in the caller's history needs reconciling yet.
+            return TurnPlan(True, "", digests)
+        if len(digests) < len(self._prefix):
+            self._closed = True
+            raise ResetRequired("history_shrank",
+                                "history is shorter than what this session was sent "
+                                "(compaction)")
+        for index, digest in enumerate(self._prefix):
+            if digests[index] != digest:
+                self._closed = True
+                raise ResetRequired(
+                    "history_rewritten",
+                    "already-sent message %d changed (edit, tool-result elision, "
+                    "or compaction)" % index)
+        pending = self._pending
+        lines = []
+        for entry in entries[len(self._prefix):]:
+            if entry.role == "assistant":
+                if pending is None:
+                    self._closed = True
+                    raise ResetRequired(
+                        "assistant_not_from_session",
+                        "host appended an assistant turn this session never produced")
+                if not entry.matches(pending):
+                    self._closed = True
+                    raise ResetRequired(
+                        "assistant_history_diverged",
+                        "host assistant message differs from this session's own reply")
+                pending = None
+                continue
+            lines.append(entry.render)
+        if pending is not None:
+            # The SDK still holds a reply the host dropped; a delta would answer
+            # against history the caller cannot see.
+            self._closed = True
+            raise ResetRequired("assistant_reply_missing",
+                                "host history omits a reply this session produced")
+        if not lines:
+            self._closed = True
+            raise ResetRequired("no_new_host_content",
+                                "nothing new to append since the last turn")
+        return TurnPlan(False, "\n".join(lines), digests)
+
+    def commit(self, plan: TurnPlan, reply: _Reply) -> None:
+        """Account one delivered turn and the reply awaiting the host's copy."""
+        self._prefix = list(plan.digests)
+        self._pending = reply
+        self.turns += 1
+
+    def close(self) -> None:
+        self._closed = True
+
+
+def reply_for(text: str, tool_bearing: bool, allowed_tools) -> _Reply:
+    """The canonical envelope the host will record for this response.
+
+    Read with the *same* parser ``complete()`` uses, so the reconciliation on the
+    next turn compares like with like.  An unparsable tool-bearing response is a
+    response-contract error: the host records no assistant message for it, so the
+    session is deliberately left holding a reply that can never match — which
+    forces a reset instead of a silent divergence.
+    """
+    if not tool_bearing:
+        return _Reply("text", text=text)
+    parsed = _parse_response_envelope(text, allowed_tools=allowed_tools)
+    if parsed is None:
+        return _Reply("unparsed")
+    if parsed[0] == "tool":
+        call = parsed[1]
+        return _Reply("tool", name=call.name, args=_canonical(call.args))
+    return _Reply("answer", text=parsed[1])
+
+
+# --------------------------------------------------------------------------- #
+#  Transport channel to the persistent worker
+# --------------------------------------------------------------------------- #
+class _UnresolvedStartup(RuntimeError):
+    def __init__(self, channel):
+        super().__init__("session worker startup failed and process-tree extinction "
+                         "could not be confirmed")
+        self.channel = channel
+
+
+class SubprocessChannel:
+    """A line-framed pipe to one owned, kernel-reaped session worker process."""
+
+    def __init__(self, proc, owner, stderr_file, death_write):
+        self.proc = proc
+        self._owner = owner
+        self._stderr = stderr_file
+        self._death_write = death_write
+        self._closed = False
+        self._close_lock = threading.RLock()
+        # Tri-state on purpose.  ``None`` means termination has not been proven
+        # yet, and it is never allowed to decay into ``True`` by the mere fact
+        # that close() was called before.
+        self._extinct = None
+        self._lines: queue.Queue = queue.Queue()
+        reader = threading.Thread(target=self._drain, name="collie-session-reader",
+                                  daemon=True)
+        reader.start()
+
+    @classmethod
+    def spawn(cls, worker_path: str) -> "SubprocessChannel":
+        """Start the worker under the same ownership contract as production."""
+        from . import plat
+
+        # Isolated mode keeps the target workspace, PYTHON* variables, and
+        # user-site startup hooks out of the trusted transport worker.
+        cmd = [sys.executable, "-I", worker_path]
+        popen_kw = {}
+        popen_kw.update(plat.new_group_kwargs())
+        popen_kw.update(plat.no_window_kwargs())
+        death_read = death_write = None
+        proc = owner = None
+        stderr_file = tempfile.TemporaryFile()
+        try:
+            if not plat.is_windows():
+                if popen_kw.get("start_new_session"):
+                    death_read, death_write = os.pipe()
+                    cmd += ["--collie-parent-death-fd", str(death_read),
+                            "--collie-parent-pid", str(os.getpid())]
+                    popen_kw["pass_fds"] = (death_read,)
+                else:
+                    # Nested Mission workers inherit the outer durable PGID owner.
+                    cmd += ["--collie-external-process-owner"]
+            try:
+                # The worker blocks on stdin.  It cannot import the SDK, open a
+                # socket, or spawn its runtime before the open frame is released.
+                proc = subprocess.Popen(
+                    cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                    stderr=stderr_file, env=_sanitized_worker_env(), cwd=os.getcwd(),
+                    text=True, encoding="utf-8", errors="replace", **popen_kw)
+            finally:
+                if death_read is not None:
+                    read_fd, death_read = death_read, None
+                    try:
+                        os.close(read_fd)
+                    except Exception as exc:
+                        raise RuntimeError(
+                            "session parent-death descriptor cleanup failed") from exc
+            proc._collie_tree_lock = threading.RLock()
+            if not plat.is_windows() and popen_kw.get("start_new_session"):
+                proc._collie_process_group = int(proc.pid)
+            owner = plat.attach_kill_on_close_job(proc)
+            if plat.is_windows() and owner is None:
+                raise RuntimeError("Windows Job Object was not created")
+            if owner is not None:
+                proc._collie_kill_job = owner
+            channel = cls(proc, owner, stderr_file, death_write)
+        except BaseException as exc:
+            # Preserve ownership even if setup failed before the handshake.
+            # No task prompt crossed this boundary.
+            if proc is not None:
+                channel = cls(proc, owner, stderr_file, death_write)
+                if not channel.close():
+                    raise _UnresolvedStartup(channel) from exc
+                death_write = None
+                owner = None
+            for descriptor in (death_read, death_write):
+                if descriptor is not None:
+                    try:
+                        os.close(descriptor)
+                    except Exception:
+                        pass
+            if owner is not None:
+                try:
+                    owner.close()
+                except Exception:
+                    pass
+            stderr_file.close()
+            raise
+        return channel
+
+    # -- framing ---------------------------------------------------------
+    def _drain(self) -> None:
+        try:
+            for line in self.proc.stdout:
+                self._lines.put(line)
+        except Exception:
+            pass
+        finally:
+            self._lines.put(None)
+
+    def alive(self) -> bool:
+        return not self._closed and self.proc.poll() is None
+
+    def send(self, frame: dict) -> None:
+        payload = json.dumps(frame, ensure_ascii=False, allow_nan=False,
+                             separators=(",", ":")) + "\n"
+        if len(payload.encode("utf-8")) > _MAX_FRAME_BYTES:
+            raise _RequestRefused("session frame exceeds the transport limit")
+        try:
+            self.proc.stdin.write(payload)
+            self.proc.stdin.flush()
+        except Exception as exc:
+            raise RuntimeError("session worker is not accepting frames: "
+                               + _safe_failure(exc)) from exc
+
+    def recv(self, deadline: float) -> dict:
+        try:
+            line = self._lines.get(timeout=max(0.0, deadline - time.monotonic()))
+        except queue.Empty:
+            raise TimeoutError("session worker timed out")
+        if line is None:
+            raise RuntimeError("session worker exited%s" % self.diagnostic())
+        if len(line.encode("utf-8")) > _MAX_FRAME_BYTES:
+            raise RuntimeError("session worker frame exceeded the safety limit")
+        try:
+            frame = json.loads(line, parse_constant=_reject_constant)
+        except Exception as exc:
+            raise RuntimeError("session worker returned invalid JSON") from exc
+        if not isinstance(frame, dict):
+            raise RuntimeError("session worker returned an invalid frame")
+        if frame.get("type") == "error":
+            raise RuntimeError("session worker failed: "
+                               + _safe_failure(frame.get("error")))
+        return frame
+
+    def exchange(self, frame: dict, timeout: float) -> dict:
+        self.send(frame)
+        return self.recv(time.monotonic() + float(timeout))
+
+    def diagnostic(self) -> str:
+        try:
+            self._stderr.seek(0)
+            raw = self._stderr.read(_MAX_STDERR)
+        except Exception:
+            return ""
+        text = _safe_failure(raw.decode("utf-8", "replace")
+                             if isinstance(raw, bytes) else raw)
+        return (": " + text) if text else ""
+
+    def unresolved(self) -> bool:
+        """Closing was attempted and the owned tree is still unaccounted for."""
+        return self._closed and self._extinct is not True
+
+    def close(self) -> bool:
+        with self._close_lock:
+            return self._close_locked()
+
+    def _close_locked(self) -> bool:
+        """Terminate the owned tree; True only once it is *proven* extinct.
+
+        A failed termination does not close this channel, it leaves it
+        **unresolved**: the process handle and the kernel ownership handle are
+        retained so a later call retries the real cleanup, and every call keeps
+        answering False until a retry actually confirms extinction.  Returning
+        True because ``close()`` ran once before would hand the caller a
+        cancellation, or a free replacement worker, that never happened.
+        """
+        if self._extinct is True:
+            return True
+        graceful = not self._closed
+        self._closed = True
+        if graceful:
+            # Only the first attempt asks politely; afterwards stdin is gone and
+            # the worker has already been told to stop.
+            try:
+                if self.proc.poll() is None:
+                    self.proc.stdin.write('{"type":"close"}\n')
+                    self.proc.stdin.flush()
+                    deadline = time.monotonic() + _CLOSE_GRACE
+                    while self.proc.poll() is None and time.monotonic() < deadline:
+                        time.sleep(0.02)
+            except Exception:
+                pass
+        extinct = bool(_terminate_worker_tree(self.proc))
+        for stream in (self.proc.stdin, self.proc.stdout):
+            try:
+                if stream is not None:
+                    stream.close()
+            except Exception:
+                pass
+        if self._death_write is not None:
+            # Closing the parent end only helps the child die; it is not a retry
+            # handle, so it is retired on the first attempt either way.
+            try:
+                os.close(self._death_write)
+            except Exception:
+                pass
+            finally:
+                self._death_write = None
+        if self._owner is not None:
+            try:
+                self._owner.close()
+            except Exception:
+                # The job object still owns the tree, so nothing is extinct and
+                # the handle is kept for the retry.
+                extinct = False
+            else:
+                self._owner = None
+        if extinct:
+            # Diagnostics stay readable while the tree is unaccounted for.
+            try:
+                self._stderr.close()
+            except Exception:
+                pass
+        self._extinct = extinct
+        return extinct
+
+
+class NativeSession:
+    """One persistent conversation: its adapter, its worker, its identity."""
+
+    def __init__(self, key: str, adapter: SessionHistoryAdapter):
+        self.key = key
+        self.adapter = adapter
+        self.channel = None
+        self.scope = ""
+        self.queries = 0
+        self.identity = ""
+
+    def usable(self) -> bool:
+        return self.channel is None or self.channel.alive()
+
+    def ensure(self, provider, open_request: dict):
+        if self.channel is not None:
+            if not self.channel.alive():
+                raise RuntimeError("session worker is no longer alive")
+            return self.channel
+        self.channel = provider._open_channel(self.key, open_request)
+        return self.channel
+
+    def turn(self, request: dict, timeout: float) -> dict:
+        sequence = self.queries + 1
+        frame = self.channel.exchange({
+            "type": "turn", "protocol": _SESSION_PROTOCOL, "seq": sequence,
+            "session_key": self.key, "request": request}, timeout)
+        if frame.get("type") != "turn" or frame.get("seq") != sequence:
+            raise RuntimeError("session worker returned an out-of-sequence frame")
+        info = frame.get("session")
+        if not isinstance(info, dict) or info.get("queries") != sequence:
+            raise RuntimeError("session worker returned an invalid session attestation")
+        identity = info.get("id_sha256")
+        if not isinstance(identity, str) or len(identity) != 64:
+            raise RuntimeError("session worker did not attest a native session identity")
+        if self.identity and identity != self.identity:
+            # The SDK re-announces init on every query, so continuity is proven
+            # by a stable native session id, never by the absence of an init.
+            raise RuntimeError("session worker reported a different native session")
+        inits = info.get("inits")
+        if not isinstance(inits, int) or isinstance(inits, bool) or inits < sequence:
+            raise RuntimeError("session worker did not attest this turn's init")
+        payload = frame.get("payload")
+        if not isinstance(payload, dict):
+            raise RuntimeError("session worker returned an invalid payload")
+        self.identity = identity
+        self.queries = sequence
+        return payload
+
+
+# --------------------------------------------------------------------------- #
+#  Provider
+# --------------------------------------------------------------------------- #
+class ExperimentalSessionSdkProvider(ClaudeAgentSdkProvider):
+    """EXPERIMENTAL: ``ClaudeAgentSdkProvider`` over one persistent session.
+
+    Everything except the two overridden seams is the shipped provider's own
+    behaviour, including the request reservation, the cancellation registry, and
+    the whole response-interpretation path.
+    """
+
+    name = "claude-agent-sdk-session"
+
+    def __init__(self, model: str | None = None, timeout: int = 180,
+                 effort: str | None = None, subscription_only: bool = False,
+                 structured_output: bool = False, session_enabled: bool = True):
+        super().__init__(model=model, timeout=timeout, effort=effort,
+                         subscription_only=subscription_only,
+                         structured_output=structured_output)
+        self.session_enabled = bool(session_enabled)
+        self._session_lock = threading.RLock()
+        self._session: NativeSession | None = None
+        # One conversation per provider instance.  A second concurrent call
+        # (a critic or summary sharing this provider) takes the stateless path
+        # instead of interleaving into someone else's session.
+        self._busy = threading.Lock()
+        self._route = threading.local()
+        # Workers whose termination was attempted and could not be confirmed.
+        # Each entry keeps the real ownership handle so cleanup can be retried,
+        # and its presence fences this provider: no replacement worker may be
+        # started while a previous one is unaccounted for.
+        self._unresolved: list[dict] = []
+        self.session_evidence = {
+            "sessions_opened": 0, "session_turns": 0, "stateless_turns": 0,
+            "longest_session_turns": 0, "resets": {}, "fallbacks": {},
+            "unresolved_cleanups": 0, "cleanup_retries_confirmed": 0,
+        }
+
+    # -- evidence --------------------------------------------------------
+    def _note(self, bucket: str, reason: str) -> None:
+        counters = self.session_evidence[bucket]
+        counters[reason] = counters.get(reason, 0) + 1
+
+    # -- session lifecycle ----------------------------------------------
+    def _worker_path(self) -> str:
+        return os.path.join(os.path.dirname(__file__), "experimental_session_worker.py")
+
+    # -- unaccounted ownership -------------------------------------------
+    def _fence_locked(self, channel, scope: str, reason: str) -> None:
+        """Retain a worker whose termination could not be confirmed."""
+        entry = {"channel": channel, "scope": str(scope or ""),
+                 "reason": str(reason or "unspecified")}
+        self._unresolved.append(entry)
+        self.session_evidence["unresolved_cleanups"] += 1
+
+    def _resolve_locked(self, scope=None) -> bool:
+        """Retry every fenced cleanup; True when nothing in scope is left.
+
+        Cleanup is retried rather than assumed: the retained process and job
+        handles are exactly what the failed attempt held, so a transient failure
+        can still be resolved honestly instead of being declared away.
+        """
+        remaining = []
+        for entry in self._unresolved:
+            if scope is not None and entry["scope"] != scope:
+                remaining.append(entry)
+                continue
+            if entry["channel"].close():
+                self.session_evidence["cleanup_retries_confirmed"] += 1
+                self._retired_channel_locked(entry["channel"])
+            else:
+                remaining.append(entry)
+        self._unresolved = remaining
+        return not any(scope is None or entry["scope"] == scope
+                       for entry in remaining)
+
+    def _retired_channel_locked(self, channel):
+        with self._process_condition:
+            for invocation, state in list(self._active_runs.items()):
+                if state["proc"] is channel.proc:
+                    state["tree_extinct"] = True
+                    if state["done"]:
+                        self._active_runs.pop(invocation, None)
+            self._process_condition.notify_all()
+
+    def _retire_pending(self, registration):
+        with self._process_condition:
+            invocation, state = registration
+            if (self._active_runs.get(invocation) is state and state["proc"] is not None
+                    and not state["tree_extinct"]):
+                state["done"] = True
+                self._process_condition.notify_all()
+                return
+        super()._retire_pending(registration)
+
+    def _fence_detail(self) -> str:
+        """The reason this provider may not start another worker, or ``""``."""
+        with self._session_lock:
+            if self._resolve_locked():
+                return ""
+            return ("a previous session worker's process tree could not be "
+                    "confirmed extinct (%s)" % self._unresolved[0]["reason"])
+
+    def _open_channel(self, key: str, open_request: dict):
+        """Spawn and handshake one session worker.  Overridden in tests."""
+        with self._session_lock:
+            if not self._resolve_locked():
+                # Fail closed rather than run two workers where the older one is
+                # unaccounted for and may still hold a live CLI child.
+                raise RuntimeError(
+                    "session worker replacement is blocked: a previous process "
+                    "tree is unaccounted for")
+        try:
+            channel = SubprocessChannel.spawn(self._worker_path())
+        except _UnresolvedStartup as exc:
+            with self._session_lock:
+                scope = self._session.scope if self._session is not None else ""
+                self._fence_locked(exc.channel, scope, "startup cleanup failed")
+            raise
+        try:
+            frame = channel.exchange({"type": "open", "protocol": _SESSION_PROTOCOL,
+                                      "session_key": key, "request": open_request},
+                                     _READY_TIMEOUT)
+            if frame.get("type") != "ready" or frame.get("protocol") != _SESSION_PROTOCOL:
+                raise RuntimeError("session worker did not report readiness")
+        except BaseException:
+            if not channel.close():
+                with self._session_lock:
+                    self._fence_locked(channel, "", "handshake cleanup failed")
+            raise
+        self.session_evidence["sessions_opened"] += 1
+        return channel
+
+    def _close_session_locked(self, reason: str) -> bool:
+        session = self._session
+        if session is None:
+            return False
+        # One place records why a conversation ended, so the benchmark receipt
+        # can separate "the caller changed the context" from "the call failed".
+        self._note("resets", str(reason or "unspecified"))
+        session.adapter.close()
+        self.session_evidence["longest_session_turns"] = max(
+            self.session_evidence["longest_session_turns"], session.queries)
+        channel = session.channel
+        # The session reference is dropped only once its worker is accounted
+        # for: either it never had one, or its tree is proven extinct, or the
+        # channel is fenced with its ownership handles for a retry.  Dropping it
+        # first would turn a failed cleanup into a clean slate.
+        if channel is not None and not channel.close():
+            self._fence_locked(channel, session.scope, str(reason or "unspecified"))
+            self._session = None
+            session.channel = None
+            return False
+        self._session = None
+        session.channel = None
+        if channel is not None:
+            self._retired_channel_locked(channel)
+        return True
+
+    def _close_session(self, reason: str) -> bool:
+        with self._session_lock:
+            return self._close_session_locked(reason)
+
+    def close_session(self, reason: str = "explicit") -> bool:
+        """Retire any live session; the next call opens a fresh one."""
+        return self._close_session(reason)
+
+    def _fresh_session(self, key: str, tool_bearing: bool) -> NativeSession:
+        session = NativeSession(key, SessionHistoryAdapter(key, tool_bearing))
+        self._session = session
+        return session
+
+    # -- overridden seams ------------------------------------------------
+    def complete(self, system, messages, tool_schemas, on_text=None):
+        fenced = self._fence_detail()
+        if fenced:
+            # No reservation is taken and no worker is started: an unaccounted
+            # process tree from a previous call has to be resolved first, and a
+            # stateless fallback would spawn a replacement just the same.
+            detail = "session transport is fenced: " + fenced
+            return Completion(text="ERROR(claude-agent-sdk): " + detail,
+                              stop_reason="error", error_detail=detail,
+                              request_count=0)
+        reason = ""
+        if not self.session_enabled:
+            reason = "session_disabled"
+        elif not is_text_only(messages):
+            # Images explicitly fall back to the shipped stateless transport,
+            # which delivers or refuses them; they are never dropped, and the
+            # session must not continue past a turn it did not observe.
+            reason = "non_text_content"
+            self._close_session(reason)
+        acquired = False
+        if not reason:
+            acquired = self._busy.acquire(blocking=False)
+            if not acquired:
+                reason = "concurrent_call"
+        if reason:
+            self.session_evidence["stateless_turns"] += 1
+            self._note("fallbacks", reason)
+            self._route.session = False
+            try:
+                return super().complete(system, messages, tool_schemas, on_text=on_text)
+            finally:
+                self._route.session = False
+        self._route.session = True
+        self._route.system = system
+        self._route.plan = None
+        self._route.tool_bearing = bool(tool_schemas)
+        self._route.allowed_tools = (
+            {str(schema.get("name") or "") for schema in tool_schemas}
+            if tool_schemas else None)
+        try:
+            return super().complete(system, messages, tool_schemas, on_text=on_text)
+        finally:
+            self._route.session = False
+            self._route.plan = None
+            self._busy.release()
+
+    def _payload(self, messages, tool_schemas):
+        """Plan the append-only delta, before any physical request is issued.
+
+        Runs on the caller's authoritative history, so a compaction or an
+        elision is detected here — while the only cost of resetting is a full
+        prompt — rather than after a delta has already been sent.
+        """
+        if not getattr(self._route, "session", False):
+            return super()._payload(messages, tool_schemas)
+        structured_tools = self._structured_tools(tool_schemas)
+        open_request = self._worker_request(self._route.system, "", structured_tools)
+        open_request.pop("prompt", None)
+        key = session_key(open_request, tool_schemas)
+
+        with self._session_lock:
+            session = self._session
+            if session is not None and session.key != key:
+                self._close_session_locked("config_changed")
+                session = None
+            elif session is not None and not session.usable():
+                self._close_session_locked("worker_lost")
+                session = None
+            if session is None:
+                session = self._fresh_session(key, bool(tool_schemas))
+            try:
+                plan = session.adapter.plan(key, messages)
+            except ResetRequired as exc:
+                self._close_session_locked(exc.reason)
+                session = self._fresh_session(key, bool(tool_schemas))
+                try:
+                    plan = session.adapter.plan(key, messages)
+                except ResetRequired as retry:
+                    # A fresh session skips reconciliation entirely, so a second
+                    # failure is about the conversation itself, not about drift.
+                    self._close_session_locked(retry.reason)
+                    raise _RequestRefused(
+                        "session transport cannot carry this conversation: "
+                        + retry.detail) from retry
+            if not self._resolve_locked():
+                # Retiring the previous conversation just failed.  Refuse before
+                # anything is issued rather than open a replacement session
+                # while its predecessor's process tree is unaccounted for.
+                raise _RequestRefused(
+                    "session transport is fenced: a previous session worker's "
+                    "process tree could not be confirmed extinct")
+
+        if plan.first:
+            # Byte-identical to what the shipped stateless transport would send.
+            text = super()._payload(messages, tool_schemas)
+        else:
+            text = plan.delta
+        if not isinstance(text, str) or not text.strip():
+            raise _RequestRefused("session transport requires text-only conversation")
+        self._route.plan = (session, plan, open_request)
+        return text
+
+    def _run_worker(self, request: dict, cancel_scope: str = "",
+                    registration=None) -> dict:
+        """Route one planned turn through the persistent worker."""
+        if not getattr(self._route, "session", False):
+            return super()._run_worker(request, cancel_scope=cancel_scope,
+                                       registration=registration)
+        routed = getattr(self._route, "plan", None)
+        if routed is None:
+            # _payload is the only place a turn is planned.  Fail closed rather
+            # than append an unplanned prompt into a live conversation.
+            raise RuntimeError("experimental session transport lost its turn plan")
+        self._route.plan = None
+        session, plan, open_request = routed
+
+        with self._process_condition:
+            if registration is None:
+                invocation = uuid.uuid4().hex
+                state = {"scope": str(cancel_scope or ""), "proc": None,
+                         "cancel_requested": False, "done": False,
+                         "tree_extinct": False, "phase": "starting"}
+                self._active_runs[invocation] = state
+            else:
+                invocation, state = registration
+                if self._active_runs.get(invocation) is not state:
+                    raise RuntimeError("Claude Agent SDK worker registration was lost")
+                if cancel_scope:
+                    state["scope"] = str(cancel_scope)
+                if state["cancel_requested"]:
+                    # cancel_for() already returned process-free proof for this
+                    # pending call; consume the tombstone without sending it.
+                    state["done"] = True
+                    state["tree_extinct"] = True
+                    self._active_runs.pop(invocation, None)
+                    self._process_condition.notify_all()
+                    raise _RequestRefused("session request was cancelled before it was issued")
+                state["phase"] = "starting"
+                state["tree_extinct"] = False
+        session.scope = state["scope"]
+
+        issued = False
+        settled = False
+        channel = None
+        try:
+            channel = session.ensure(self, open_request)
+            with self._session_lock:
+                if self._session is not session:
+                    # A cancellation retired this conversation while its worker
+                    # was starting, so that worker has no owner left to reap it.
+                    session.channel = None
+                    if not channel.close():
+                        self._fence_locked(channel, state["scope"],
+                                           "worker started into a retired session")
+                    raise RuntimeError("session was retired while its worker started")
+            with self._process_condition:
+                # Publishing the worker before releasing the prompt is what lets
+                # a concurrent cancel_for() terminate this exact process tree.
+                state["proc"] = channel.proc
+                state["phase"] = "active"
+                cancelled = bool(state["cancel_requested"])
+                self._process_condition.notify_all()
+            if cancelled:
+                raise RuntimeError("cancelled before the request was released")
+            issued = True
+            payload = session.turn(request, self.timeout)
+        except BaseException as exc:
+            # This conversation is not attested past a failed turn, so it is
+            # retired -- but extinction is never fabricated here.  The tree is
+            # only extinct if this call never published a process, or if the
+            # retirement above actually proved it; otherwise the run stays
+            # registered and the channel stays fenced with its handles.
+            confirmed = self._close_session("turn_failed")
+            settled = True
+            with self._process_condition:
+                if self._active_runs.get(invocation) is state:
+                    state["done"] = True
+                    state["tree_extinct"] = bool(channel is None or confirmed)
+                    if state["tree_extinct"]:
+                        self._active_runs.pop(invocation, None)
+                    self._process_condition.notify_all()
+            if not issued and not isinstance(exc, _RequestRefused):
+                # Nothing reached the worker, so no model request was physically
+                # issued and none may be charged against the run's budget.
+                raise _RequestRefused(
+                    "session request was not issued: " + _safe_failure(exc)) from exc
+            raise
+        finally:
+            if not settled:
+                with self._process_condition:
+                    if self._active_runs.get(invocation) is state:
+                        proc = None if channel is None else channel.proc
+                        state["done"] = True
+                        # The turn succeeded, so this worker is not unaccounted
+                        # for: the live session owns it and reaps it on close.
+                        state["tree_extinct"] = bool(
+                            proc is None or proc.poll() is not None)
+                        self._active_runs.pop(invocation, None)
+                        self._process_condition.notify_all()
+
+        if payload.get("ok") is not True or "structured_error" in payload:
+            reason = "worker_failed"
+            try:
+                rejection = _provider_rejection(payload)
+                refusal = None if rejection is not None else self._session_refusal(
+                    payload, request)
+                reason = ("provider_rejected" if rejection is not None else
+                          "formatter_refused" if refusal is not None else "worker_failed")
+            finally:
+                # Invalid attestation is also a poisoned conversation; the
+                # classifier raising must not leave it eligible for reuse.
+                self._close_session(reason)
+            # The native conversation now holds a response the provider itself
+            # refused; it is poisoned for re-use, so the session is discarded
+            # and the host's one authorized repair turn reserves its own call.
+            if rejection is not None:
+                raise rejection
+            if refusal is not None:
+                raise refusal
+            raise RuntimeError("Claude Agent SDK session worker failed%s" % (
+                (": " + _safe_failure(payload.get("error")))
+                if payload.get("error") else ""))
+        if payload.get("provider_error") is not None:
+            self._close_session("forged_payload")
+            raise RuntimeError(
+                "Claude Agent SDK worker reported both success and a provider error")
+        text = payload.get("text")
+        if not isinstance(text, str):
+            self._close_session("missing_text")
+            raise RuntimeError("Claude Agent SDK response is missing assistant text")
+        session.adapter.commit(plan, reply_for(
+            text, self._route.tool_bearing, self._route.allowed_tools))
+        self.session_evidence["session_turns"] += 1
+        self.session_evidence["longest_session_turns"] = max(
+            self.session_evidence["longest_session_turns"], session.queries)
+        return payload
+
+    def _session_refusal(self, payload: dict, request: dict):
+        """A formatter refusal this exact turn may report, or ``None``.
+
+        The production classifier is reused unmodified.  The session transport
+        adds the per-call attestation that a one-shot worker gets for free from
+        its own exit: a refusal may only be classified for a turn that actually
+        requested structured mode, and only with the tool allowlist that turn
+        asked for.  A mismatch is a forged payload, not a repairable response.
+        """
+        if payload.get("structured_error") != _FORMATTER_REFUSED:
+            return None
+        if request.get("response_format") != _STRUCTURED_FORMAT:
+            raise RuntimeError(
+                "Claude Agent SDK session worker refused a structured response "
+                "for a turn that requested no schema")
+        if payload.get("response_format") != _STRUCTURED_FORMAT:
+            raise RuntimeError(
+                "Claude Agent SDK session worker did not attest structured "
+                "response mode for a refused response")
+        if payload.get("response_tools") != request.get("response_tools"):
+            raise RuntimeError(
+                "Claude Agent SDK session worker attested a different response "
+                "tool allowlist for a refused response")
+        return _formatter_refusal(payload)
+
+    def _cancel(self, scope) -> bool:
+        """Cancel matching calls and retire the session they were running in."""
+        with self._process_condition:
+            states = [state for state in self._active_runs.values()
+                      if scope is None or state["scope"] == scope]
+        super()._cancel(scope)
+        with self._session_lock:
+            had_unresolved = any(scope is None or entry["scope"] == scope
+                                 for entry in self._unresolved)
+            resolved = self._resolve_locked(scope)
+            session = self._session
+            in_scope = session is not None and (scope is None or session.scope == scope)
+            # An idle session still owns a live worker and its CLI child; a
+            # cancellation that left them running would not be a cancellation.
+            closed = self._close_session_locked("cancelled") if in_scope else False
+            # Anything this cancellation is responsible for must actually be
+            # gone.  A retry that succeeds resolves it; one that does not keeps
+            # the cancellation reported as unsuccessful.
+        with self._process_condition:
+            active_gone = not states or all(state["tree_extinct"] for state in states)
+        had_work = bool(states) or in_scope or had_unresolved
+        return had_work and active_gone and resolved and (not in_scope or closed)
