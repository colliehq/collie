+def test_cancellation_terminates_the_session_mid_query(monkeypatch):
+    import harness.claude_agent_sdk as production
+
+    def _terminate(proc, timeout_s=5.0):
+        proc.returncode = -9
+        return True
+
+    monkeypatch.setattr(production, "_terminate_worker_tree", _terminate)
+    provider = _Provider([structured_payload(READ)], channel_class=_BlockingChannel)
+    ledger = _Ledger()
+    outcome = []
+
+    def run():
+        outcome.append(call(provider, ledger, [{"role": "user", "content": "start"}]))
+
+    worker = threading.Thread(target=run)
+    worker.start()
+    assert provider.channels[0].entered.wait(timeout=10) if provider.channels \
+        else _wait_for_channel(provider)
+    assert provider.cancel_for("mission-1")() is True
+    worker.join(timeout=10)
+
+    assert not worker.is_alive()
+    assert outcome[0].stop_reason == "error"
+    assert provider.channels[0].closed is True
+    assert provider._session is None
+    assert ledger.settled == [("req-1", "error")]
+
+
+def _wait_for_channel(provider):
+    for _ in range(200):
+        if provider.channels:
+            return provider.channels[0].entered.wait(timeout=10)
+        threading.Event().wait(0.05)
+    raise AssertionError("no session worker was published")
+
