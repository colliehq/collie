index 0000000000000000000000000000000000000000..b7d5be2f74047329de84bea1cccbbea5e891f591
--- /dev/null
+++ b/harness/experimental_session_worker.py
@@ -0,0 +1,391 @@
+"""EXPERIMENTAL persistent-session entry point for the Claude Agent SDK.
+
+Private subprocess behind :mod:`harness.experimental_session_sdk`.  Where
+``claude_agent_worker`` answers exactly one request and exits, this worker keeps
+**one** ``ClaudeSDKClient`` connected across many host turns, so the SDK's own
+native conversation — not a re-flattened transcript — carries the history.
+
+Every model-facing decision is delegated to the reviewed production worker:
+``claude_agent_worker._build_options`` builds the options, and
+``claude_agent_worker._query`` observes and validates the stream (init
+attestation, empty tool surfaces, one model response, structured formatter
+identity, usage, provider-rejection categories, turn limit).  This module adds
+exactly three things on top:
+
+* one connected client re-used across queries, all client calls in one task;
+* per-turn proof that the request still describes the *same* session — the
+  parent's opaque session key and the fingerprint of the options the client was
+  connected with must both match, so a changed system prompt, model, effort,
+  schema, or tool allowlist can never be appended into an existing session;
+* continuity attestation: the SDK emits ``system/init`` on *every* query, so a
+  repeated init is not evidence of a reset.  The native ``session_id`` is
+  therefore pinned on the first init and any change is a hard stop.
+
+Protocol (UTF-8, one JSON object per line, ``\\n`` framed)::
+
+    in   {"type":"open","protocol":10,"session_key":str,"request":{...}}
+    in   {"type":"turn","protocol":10,"seq":int,"session_key":str,"request":{...}}
+    in   {"type":"close"}
+    out  {"type":"ready","protocol":10}
+    out  {"type":"turn","protocol":10,"seq":int,"payload":{...},"session":{...}}
+    out  {"type":"error","seq":int|null,"error":str}        -- terminal
+
+``payload`` is the *unmodified* return value of ``claude_agent_worker._query``
+— or, when that call raises ``_StructuredContractRejected``, the same
+content-free refusal payload production's ``main`` serializes for it, attested
+against this turn's own mode and tool allowlist.  The parent re-validates all of
+it.  Any invalid frame, out-of-sequence frame,
+protocol violation, SDK error, or cancellation stops the process.  There is no
+retry, no fallback model, no route fallback, and no environment bypass.
+
+Process lifetime is the parent's: the POSIX parent-death channel is armed here
+through the production implementation, and the Windows Job Object is attached by
+the parent before any prompt bytes are released.
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+import sys
+
+
+PROTOCOL = 10
+_MAX_FRAME_BYTES = 4 * 1024 * 1024
+
+
+class ProtocolError(RuntimeError):
+    """A frame or SDK observation this worker refuses to continue past."""
+
+
+def _reject_constant(value):
+    raise ValueError("non-finite JSON number is forbidden: %s" % value)
+
+
+def options_fingerprint(options) -> str:
+    """Stable digest of a built ``ClaudeAgentOptions``.
+
+    Session re-use is only safe while the *connected* options still describe the
+    request.  Comparing the built options rather than trusting the parent's key
+    means a parent bug cannot append a turn carrying a different system prompt,
+    model, effort, or response schema into a live conversation.
+    """
+    values = getattr(options, "__dict__", None)
+    if not isinstance(values, dict) or not values:
+        raise ProtocolError("SDK options could not be fingerprinted")
+    parts = ["%s=%r" % (name, values[name]) for name in sorted(values)]
+    return hashlib.sha256("\x00".join(parts).encode("utf-8", "replace")).hexdigest()
+
+
+def _has_tool_result_block(message, checked) -> bool:
+    content = checked._field(message, "content", []) or []
+    if not isinstance(content, list):
+        return False
+    for block in content:
+        kind = str(checked._field(block, "type", "") or type(block).__name__).lower()
+        if "tool_result" in kind or "toolresult" in kind:
+            return True
+    return False
+
+
+class BoundSession:
+    """Drives the reviewed ``_query`` against one already-connected client.
+
+    ``_query`` calls ``sdk.query(prompt=..., options=...)`` and consumes the
+    resulting stream.  This adapter satisfies that surface without opening a new
+    conversation: the prompt is appended to the live client and its response
+    stream is forwarded message by message, observed on the way past.
+    """
+
+    def __init__(self, worker):
+        self._worker = worker
+        self.ClaudeAgentOptions = worker.sdk.ClaudeAgentOptions
+
+    async def query(self, *, prompt, options):
+        worker = self._worker
+        if options_fingerprint(options) != worker.fingerprint:
+            # _query rebuilds options per call; in a session they must still be
+            # the ones the client is connected with, or the caller is silently
+            # asking for a configuration this conversation never had.
+            raise ProtocolError("query options differ from the connected session")
+        await worker.client.query(prompt)
+        async for message in worker.client.receive_response():
+            worker.observe(message)
+            yield message
+
+
+class SessionWorker:
+    """One ClaudeSDKClient, many host turns, all inside one asyncio task."""
+
+    def __init__(self, sdk, checked, emit):
+        self.sdk = sdk
+        self.checked = checked
+        self.emit = emit
+        self.client = None
+        self.fingerprint = ""
+        self.session_key = ""
+        self.structured = False
+        self.session_id = ""
+        self.inits = 0
+        self._seq = 0
+        self._poisoned = ""
+
+    # -- frames ----------------------------------------------------------
+    async def handle(self, frame) -> bool:
+        if not isinstance(frame, dict):
+            raise ProtocolError("frame is not a JSON object")
+        kind = frame.get("type")
+        if kind == "close":
+            if set(frame) - {"type", "protocol"}:
+                raise ProtocolError("close frame has unexpected fields")
+            return False
+        if frame.get("protocol") != PROTOCOL or isinstance(frame.get("protocol"), bool):
+            raise ProtocolError("invalid session protocol")
+        if kind == "open":
+            await self._open(frame)
+            return True
+        if kind == "turn":
+            await self._turn(frame)
+            return True
+        raise ProtocolError("unsupported frame type: %s" % str(kind)[:40])
+
+    async def _open(self, frame) -> None:
+        if self.client is not None:
+            raise ProtocolError("session is already open")
+        key = frame.get("session_key")
+        if not isinstance(key, str) or len(key) != 64 or not key.isalnum():
+            raise ProtocolError("open frame has an invalid session key")
+        request = self._validated(frame.get("request"), prompt=False)
+        options = self.checked._build_options(self.sdk, request)
+        self.fingerprint = options_fingerprint(options)
+        self.structured = request.get("response_format") == self.checked._STRUCTURED_FORMAT
+        client = self.sdk.ClaudeSDKClient(options=options)
+        # connect() without a prompt keeps the CLI in streaming mode, so later
+        # queries append to this same native conversation.  No model request is
+        # issued here: init arrives with the first query.
+        await client.connect()
+        self.client = client
+        self.session_key = key
+        self.emit({"type": "ready", "protocol": PROTOCOL})
+
+    async def _turn(self, frame) -> None:
+        if self.client is None:
+            raise ProtocolError("turn frame arrived before the session was opened")
+        if self._poisoned:
+            raise ProtocolError("session refused a further turn: " + self._poisoned)
+        seq = frame.get("seq")
+        if not isinstance(seq, int) or isinstance(seq, bool) or seq != self._seq + 1:
+            raise ProtocolError("turn frame is out of sequence")
+        if frame.get("session_key") != self.session_key:
+            raise ProtocolError("turn frame does not match this session's key")
+        request = self._validated(frame.get("request"), prompt=True)
+        if (request.get("response_format") == self.checked._STRUCTURED_FORMAT) != self.structured:
+            raise ProtocolError("turn frame changed the session's response contract")
+        options = self.checked._build_options(self.sdk, request)
+        if options_fingerprint(options) != self.fingerprint:
+            raise ProtocolError("turn frame changed the connected session's options")
+        self._seq = seq
+        before = self.inits
+        try:
+            payload = await self.checked._query(request, BoundSession(self))
+        except self.checked._StructuredContractRejected as refusal:
+            # ``_query`` raises this instead of returning; the production worker
+            # serializes it in ``main`` and this worker never reaches ``main``.
+            # Serialize the same content-free classification here, or the one
+            # response the provider's own formatter refused would arrive at the
+            # parent as an unclassifiable transport fault.
+            payload = self._refusal_payload(request, refusal)
+        if self.inits <= before:
+            raise ProtocolError("SDK did not attest this session on this turn")
+        if not self.session_id:
+            raise ProtocolError("SDK did not attest a native session identity")
+        if payload.get("ok") is not True:
+            # A provider rejection or a refused response is forwarded with its
+            # category and usage, but the conversation's state after such a turn
+            # is not attested -- a refused response and its failed formatter
+            # receipt are still in the native history -- so this session may not
+            # serve another turn.  The parent discards it as well.
+            self._poisoned = str(payload.get("provider_error")
+                                 or payload.get("structured_error")
+                                 or "turn was not ok")[:80]
+        self.emit({
+            "type": "turn", "protocol": PROTOCOL, "seq": seq, "payload": payload,
+            "session": {
+                "queries": seq,
+                "inits": self.inits,
+                # Opaque continuity proof only: the native id itself never leaves
+                # this process.
+                "id_sha256": hashlib.sha256(self.session_id.encode("utf-8")).hexdigest(),
+            },
+        })
+
+    def _refusal_payload(self, request: dict, refusal) -> dict:
+        """The reviewed refusal payload, attested against *this* turn.
+
+        Byte-for-byte the categories production's ``main`` reports, plus the
+        per-call attestation the parent re-checks: only a turn that requested
+        structured mode may answer with a formatter refusal, and it carries the
+        allowlist that turn asked for.  Neither the refused response nor the
+        formatter's report is read or forwarded -- the classification, the
+        measured usage and the auth attestation are the whole payload.
+        """
+        if not self.structured or request.get("response_format") != \
+                self.checked._STRUCTURED_FORMAT:
+            raise ProtocolError(
+                "SDK refused a structured response on a turn with no schema")
+        return {"ok": False, "structured_error": self.checked._FORMATTER_REFUSED,
+                "error": "the structured formatter refused the model response",
+                "usage": refusal.usage, "api_key_source": refusal.api_key_source,
+                "response_format": self.checked._STRUCTURED_FORMAT,
+                "response_tools": list(request.get("response_tools") or [])}
+
+    # -- stream observation ----------------------------------------------
+    def observe(self, message) -> None:
+        """Session-level checks layered on top of ``_query``'s own validation."""
+        checked = self.checked
+        kind = checked._message_kind(message)
+        if kind == "system" and str(checked._field(message, "subtype", "")).lower() == "init":
+            data = checked._field(message, "data", {})
+            native = data.get("session_id") if isinstance(data, dict) else None
+            if not isinstance(native, str) or not native.strip():
+                raise ProtocolError("SDK init is missing its native session identity")
+            native = native.strip()
+            if self.session_id and native != self.session_id:
+                # The SDK re-announces init on every query, so a repeated init is
+                # NOT evidence of a reset.  A changed id is.
+                raise ProtocolError("SDK changed its native session identity")
+            self.session_id = native
+            self.inits += 1
+            return
+        if kind == "user" and not self.structured:
+            # A plain turn is configured with no tool at all, so any tool result
+            # means a real tool ran and its output is entering the conversation.
+            # Structured turns are NOT checked here: their one legitimate tool
+            # result is the SDK's own formatter receipt (which populates
+            # ``UserMessage.tool_use_result``), and ``_query`` already proves it
+            # is exactly one receipt, carrying the known text, matching the id of
+            # the single formatter call it receipts.
+            if (checked._field(message, "tool_use_result") is not None
+                    or _has_tool_result_block(message, checked)):
+                raise ProtocolError("SDK delivered a real tool result in plain mode")
+
+    # -- request validation ----------------------------------------------
+    def _validated(self, request, prompt: bool) -> dict:
+        """Re-validate the host request at this process boundary.
+
+        Deliberately mirrors ``claude_agent_worker._read_request`` for the two
+        text protocols this transport supports.  Images are not supported here:
+        the parent falls back to the stateless production transport for them
+        rather than dropping pixels.
+        """
+        if not isinstance(request, dict):
+            raise ProtocolError("session request is not an object")
+        protocol = request.get("protocol")
+        if protocol not in (1, 3) or isinstance(protocol, bool):
+            raise ProtocolError("unsupported session request protocol")
+        for key in ("model", "system_prompt"):
+            if not isinstance(request.get(key), str) or not request[key].strip():
+                raise ProtocolError("session request is missing %s" % key)
+        if "content" in request:
+            raise ProtocolError("the session transport is text-only")
+        if protocol == 3:
+            if request.get("response_format") != self.checked._STRUCTURED_FORMAT:
+                raise ProtocolError("invalid session response format")
+            request["response_tools"] = self.checked._response_tools(
+                request.get("response_tools"))
+        elif "response_format" in request or "response_tools" in request:
+            raise ProtocolError("plain session request must not carry a response format")
+        if prompt:
+            if not isinstance(request.get("prompt"), str) or not request["prompt"].strip():
+                raise ProtocolError("session turn request is missing prompt")
+        elif "prompt" in request:
+            raise ProtocolError("session open request must not carry a prompt")
+        return request
+
+    async def aclose(self) -> None:
+        client, self.client = self.client, None
+        if client is not None:
+            await client.disconnect()
+
+
+async def serve(read_line, emit, sdk, checked) -> int:
+    """Read frames until EOF/close/failure.  Every client call is in this task."""
+    worker = SessionWorker(sdk, checked, emit)
+    status = 0
+    try:
+        while True:
+            line = await read_line()
+            if not line:
+                break                       # EOF: the owning parent went away
+            line = line.strip()
+            if not line:
+                raise ProtocolError("empty frame")
+            if len(line.encode("utf-8")) > _MAX_FRAME_BYTES:
+                raise ProtocolError("frame exceeded the safety limit")
+            try:
+                frame = json.loads(line, parse_constant=_reject_constant)
+            except ProtocolError:
+                raise
+            except Exception as exc:
+                raise ProtocolError("frame is not valid JSON") from exc
+            if not await worker.handle(frame):
+                break
+    except (asyncio.CancelledError, KeyboardInterrupt):
+        emit({"type": "error", "seq": None, "error": "cancelled"})
+        status = 2
+    except BaseException as exc:            # noqa: BLE001 - fail closed and stop
+        emit({"type": "error", "seq": None,
+              "error": "%s: %s" % (type(exc).__name__, str(exc)[:600])})
+        status = 1
+    finally:
+        try:
+            await worker.aclose()
+        except BaseException:               # noqa: BLE001
+            status = status or 1
+    return status
+
+
+def _stdout_emit(frame) -> None:
+    sys.stdout.write(json.dumps(frame, ensure_ascii=False, allow_nan=False,
+                                separators=(",", ":")) + "\n")
+    sys.stdout.flush()
+
+
+def main() -> int:
+    try:
+        # `python -I <script>` puts this directory first on sys.path, so the
+        # reviewed production worker imports as a plain module.  It must be
+        # imported BEFORE the directory is dropped, and the directory must be
+        # dropped before the optional SDK is imported: the sibling
+        # ``claude_agent_sdk.py`` transport would otherwise shadow the installed
+        # official package of the same name.
+        worker_dir = os.path.abspath(os.path.dirname(__file__))
+        if worker_dir not in sys.path:
+            sys.path.insert(0, worker_dir)
+        import claude_agent_worker as checked
+
+        # Arm the exact-parent lifetime channel before importing the SDK or
+        # spawning its runtime, using the reviewed production implementation.
+        checked._arm_parent_death_from_argv()
+
+        normalized = os.path.normcase(worker_dir)
+        sys.path[:] = [entry for entry in sys.path
+                       if os.path.normcase(os.path.abspath(entry or os.getcwd()))
+                       != normalized]
+        import claude_agent_sdk as sdk      # optional dependency: worker-only import
+    except Exception as exc:                # noqa: BLE001
+        _stdout_emit({"type": "error", "seq": None,
+                      "error": "%s: %s" % (type(exc).__name__, str(exc)[:600])})
+        return 1
+
+    async def read_line() -> str:
+        # stdin reads go through a thread so they never move a client call off
+        # the single task that owns connect/query/disconnect.
+        return await asyncio.to_thread(sys.stdin.readline)
+
+    return asyncio.run(serve(read_line, _stdout_emit, sdk, checked))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
