+    with pytest.raises(session_worker.ProtocolError) as failure:
+        worker._refusal_payload({"protocol": 1},
+                                checked._StructuredContractRejected({}, "none"))
+    assert "no schema" in str(failure.value)
+
+
+def test_a_formatter_refusal_is_one_repairable_turn_on_a_discarded_session():
+    provider = _Provider([REFUSAL, structured_payload(DONE)])
+    ledger = _Ledger()
+    history = [{"role": "user", "content": "start"}]
+
+    refused = call(provider, ledger, history)
+
+    assert refused.error_status == 422
+    assert refused.error_code == "response_contract_error"
+    assert refused.request_count == 1, "one response was physically issued"
+    assert refused.usage.input_tokens == 11 and refused.usage.cache_read == 900
+    assert REFUSED_PROSE not in (refused.text or "") + (refused.error_detail or "")
+    # The poisoned native conversation is discarded, not continued.
+    assert provider._session is None and provider.channels[0].closed is True
+    assert provider.session_evidence["resets"] == {"formatter_refused": 1}
+
+    # The host's one authorized repair is independently reserved and re-sends
+    # the full prompt on a new conversation.
+    repaired = call(provider, ledger, history + [
+        {"role": "user", "content": "Your reply did not match the contract."}])
+
+    assert repaired.stop_reason == "end_turn"
+    assert len(provider.channels) == 2
+    assert "start" in prompts(provider, 1)[0], "the repair re-sent the full prompt"
+    assert ledger.reserved == ["claude_agent_sdk"] * 2
+    assert ledger.settled == [("req-1", "completed"), ("req-2", "completed")]
+
+
+@pytest.mark.parametrize("payload,match", [
+    (dict(REFUSAL, response_tools=NAMES[:2]), "different response tool allowlist"),
+    ({key: value for key, value in REFUSAL.items() if key != "response_format"},
+     "did not attest structured"),
+    (dict(REFUSAL, text=DONE), "carried assistant content"),
+    (dict(REFUSAL, api_key_source="apiKey"), "reviewed auth attestation"),
+    (dict(REFUSAL, ok=True), "both success and a refused response"),
+])
+def test_a_refusal_without_its_attestation_fails_closed(payload, match):
+    provider = _Provider([payload])
+    ledger = _Ledger()
+
+    result = call(provider, ledger, [{"role": "user", "content": "start"}])
+
+    assert result.stop_reason == "error" and result.error_status != 422
+    assert match in result.error_detail
+    assert provider._session is None and provider.channels[0].closed is True
+    assert ledger.settled == [("req-1", "error")]
+
+
+def test_a_plain_call_can_never_be_answered_with_a_structured_refusal():
+    provider = _Provider([{key: value for key, value in REFUSAL.items()
+                           if key not in ("response_format", "response_tools")}])
+    ledger = _Ledger()
+
+    result = call(provider, ledger, [{"role": "user", "content": "start"}],
+                  schemas=None)
+
+    assert result.stop_reason == "error" and result.error_status != 422
+    assert "requested no schema" in result.error_detail
+    assert provider._session is None
+
+
+def test_plain_coding_keeps_the_same_tool_observation_history():
+    provider = _Provider([plain_payload(READ), plain_payload(DONE)], structured_output=False)
+    ledger = _Ledger()
+    history = [{"role": "user", "content": "read the file"}]
+    first = call(provider, ledger, history)
+    history += [assistant(first), observation(first, "file content")]
+    second = call(provider, ledger, history)
+    assert second.stop_reason == "end_turn"
+    assert len(provider.channels) == 1
+    assert provider.channels[0].open_request["protocol"] == 1
+    assert prompts(provider)[1] == "Result of read_file: file content"
+
+
+def test_failed_turn_keeps_ownership_until_cleanup_is_confirmed():
+    provider = _Provider([RuntimeError("stream failed")], channel_class=_StuckChannel)
+    result = call(provider, _Ledger(), [{"role": "user", "content": "start"}])
+    assert result.stop_reason == "error"
+    assert provider._unresolved
+    assert provider._active_runs, "parent completion must not discard unknown ownership"
+    stuck = provider.channels[0]
+    stuck.close_failures = 0
+    assert provider.close_session("already retired") is False
+    assert provider._fence_detail() == ""
+    assert not provider._active_runs
+
