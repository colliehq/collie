+def test_unresolved_startup_is_retained_before_any_prompt(monkeypatch):
+    from harness import experimental_session_sdk as session_sdk
+    channel = _StuckChannel(KEY, {}, [])
+    channel.close_failures = 10
+    spawned = []
+
+    def spawn(path):
+        spawned.append(path)
+        raise session_sdk._UnresolvedStartup(channel)
+
+    monkeypatch.setattr(session_sdk.SubprocessChannel, "spawn", spawn)
+    provider = ExperimentalSessionSdkProvider(model="opus", structured_output=True)
+    ledger = _Ledger()
+    first = call(provider, ledger, [{"role": "user", "content": "start"}])
+    assert first.stop_reason == "error" and first.request_count == 0
+    assert provider._unresolved[0]["channel"] is channel
+    second = call(provider, ledger, [{"role": "user", "content": "start"}])
+    assert second.stop_reason == "error" and second.request_count == 0
+    assert len(spawned) == 1
+    assert not channel.sent
