+def test_a_response_contract_miss_cannot_be_followed_by_a_delta():
+    # The model answered, the host recorded no assistant message for it, so the
+    # session holds a turn the caller cannot see.
+    provider = _Provider([structured_payload('{"answer": "x", "_note": "done"}'),
+                          structured_payload(DONE)])
+    ledger = _Ledger()
+    messages = [{"role": "user", "content": "start"}]
+
+    miss = call(provider, ledger, messages)
+    assert miss.stop_reason == "error" and miss.error_code == "response_contract_error"
+    assert miss.request_count == 1, "a contract miss still spent a real request"
+
+    call(provider, ledger, messages + [{"role": "user", "content": "retry"}])
+
+    assert len(provider.channels) == 2
+    assert provider.session_evidence["resets"]["assistant_reply_missing"] == 1
