+def test_closing_idle_session_cannot_hide_another_failed_owned_tree(monkeypatch):
+    import harness.claude_agent_sdk as production
+    provider, _ = _stuck_session()
+    provider.channels[0].close_failures = 0
+    registration = provider._register_pending("mission-1")
+    state = registration[1]
+    state.update(proc=_FakeProc(), phase="running", tree_extinct=False)
+    monkeypatch.setattr(production, "_terminate_worker_tree", lambda *a, **kw: False)
+    assert provider.cancel_for("mission-1")() is False
+    assert provider.channels[0].closed
+    assert not state["tree_extinct"]
+
