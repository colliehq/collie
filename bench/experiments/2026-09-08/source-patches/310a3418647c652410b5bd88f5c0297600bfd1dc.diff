+# --------------------------------------------------------------------------- #
+#  Worker: one client, many turns, one attested native session
+# --------------------------------------------------------------------------- #
+class _Options:
+    def __init__(self, **kwargs):
+        self.__dict__.update(kwargs)
+
+
+class _FakeClient:
+    def __init__(self, scripts):
+        self.scripts = list(scripts)
+        self.prompts = []
+        self.connected = False
+        self.disconnected = False
+        self.consumed = 0
+        self._current = []
+
+    async def connect(self):
+        self.connected = True
+
+    async def query(self, prompt):
+        self.prompts.append(prompt)
+        self._current = self.scripts.pop(0)
+
+    async def receive_response(self):
+        for message in self._current:
+            self.consumed += 1
+            yield message
+
+    async def disconnect(self):
+        self.disconnected = True
+
+
+class _FakeSdk:
+    ClaudeAgentOptions = _Options
+
+    def __init__(self, scripts):
+        self.client = _FakeClient(scripts)
+        self.clients = 0
+
+    def ClaudeSDKClient(self, options=None):
+        self.clients += 1
+        self.options = options
+        return self.client
+
+
+def _init(session_id="native-1", **overrides):
+    data = {"tools": ["StructuredOutput"], "skills": [], "plugins": [], "agents": {},
+            "slash_commands": [], "mcp_servers": [], "model": "opus",
+            "apiKeySource": "none", "session_id": session_id}
+    data.update(overrides)
+    return {"type": "system", "subtype": "init", "data": data}
+
+
+def _structured_stream(response, session_id="native-1", message_id="msg_1",
+                       tool_id="toolu_1"):
+    return [
+        _init(session_id=session_id),
+        {"type": "stream_event", "event": {"type": "message_start",
+                                           "message": {"id": message_id}}},
+        {"type": "assistant", "id": message_id, "content": [
+            {"type": "tool_use", "id": tool_id, "name": "StructuredOutput",
+             "input": response}]},
+        {"type": "user", "content": [
+            {"type": "tool_result", "tool_use_id": tool_id,
+             "content": "Structured output provided successfully"}]},
+        {"type": "result", "subtype": "success", "is_error": False, "num_turns": 2,
+         "usage": {"input_tokens": 2, "output_tokens": 9},
+         "structured_output": copy.deepcopy(response)},
+    ]
+
+
+def _open_request(system=SYSTEM, effort="default", tools=NAMES):
+    return {"protocol": 3, "model": "opus", "system_prompt": system, "effort": effort,
+            "response_format": "structured", "response_tools": list(tools)}
+
+
+def _drive(sdk, frames):
+    """Run the real frame loop, so a refusal is observed as a terminal frame."""
+    emitted = []
+    lines = [json.dumps(frame, ensure_ascii=False) + "\n" for frame in frames]
+
+    async def read_line():
+        return lines.pop(0) if lines else ""
+
+    status = asyncio.run(session_worker.serve(read_line, emitted.append, sdk, checked))
+    return emitted, status
+
+
+def _turn(seq, request, key=KEY):
+    return {"type": "turn", "protocol": 10, "seq": seq, "session_key": key,
+            "request": request}
+
