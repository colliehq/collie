+# --------------------------------------------------------------------------- #
+#  Ownership: a cleanup that failed is never reported as a cleanup that worked
+# --------------------------------------------------------------------------- #
+class _Stdio:
+    """One end of the worker pipe: writable, closable, and empty on read."""
+
+    def __init__(self):
+        self.written = []
+        self.closed = False
+
+    def write(self, text):
+        if self.closed:
+            raise ValueError("I/O operation on closed file")
+        self.written.append(text)
+
+    def flush(self):
+        pass
+
+    def close(self):
+        self.closed = True
+
+    def __iter__(self):
+        return iter(())
+
+
+class _StubProc:
+    """A worker process that only dies when termination actually succeeds."""
+
+    def __init__(self):
+        self.returncode = None
+        self.stdin = _Stdio()
+        self.stdout = _Stdio()
+
+    def poll(self):
+        return self.returncode
+
+
+class _Owner:
+    """A kernel ownership handle whose release fails a given number of times."""
+
+    def __init__(self, failures=0):
+        self.failures = failures
+        self.calls = 0
+
+    def close(self):
+        self.calls += 1
+        if self.failures > 0:
+            self.failures -= 1
+            raise OSError("job object handle is busy")
+
+
+def _channel(monkeypatch, terminations, owner=None):
+    """A real SubprocessChannel over a fake process, scripted terminations."""
+    import tempfile
+
+    from harness import experimental_session_sdk as session_sdk
+
+    proc = _StubProc()
+    scripted = list(terminations)
+
+    def _terminate(target, timeout_s=5.0):
+        assert target is proc
+        ok = scripted.pop(0) if scripted else True
+        if ok:
+            target.returncode = -9
+        return ok
+
+    monkeypatch.setattr(session_sdk, "_terminate_worker_tree", _terminate)
+    channel = session_sdk.SubprocessChannel(proc, owner, tempfile.TemporaryFile(), None)
+    return channel, proc
+
+
+def test_a_failed_close_never_becomes_a_successful_one(monkeypatch):
+    """close() used to answer True on every later call, even after failing."""
+    channel, proc = _channel(monkeypatch, [False, False, True])
+
+    assert channel.close() is False
+    assert proc.poll() is None, "the tree is still alive"
+    # The second call is not free: it retries, and it still tells the truth.
+    assert channel.close() is False
+    assert channel.unresolved() is True
+    # The retained handles are what makes an honest retry possible at all.
+    assert channel.close() is True
+    assert channel.unresolved() is False and proc.poll() == -9
+    # Only the first attempt asks the worker politely to stop.
+    assert proc.stdin.written == ['{"type":"close"}\n']
+
+
+def test_an_unreleasable_ownership_handle_keeps_the_channel_unresolved(monkeypatch):
+    owner = _Owner(failures=1)
+    channel, _proc = _channel(monkeypatch, [True, True], owner=owner)
+
+    assert channel.close() is False, "the job object still owns the tree"
+    assert channel.close() is True
+    assert owner.calls == 2, "the handle was retained and released on the retry"
+
+
+class _StuckChannel(_ScriptedChannel):
+    """A worker whose process tree cannot be confirmed extinct on demand."""
+
+    def __init__(self, *args):
+        super().__init__(*args)
+        self.close_failures = 1
+        self.close_calls = 0
+
+    def close(self):
+        self.close_calls += 1
+        if self.close_failures > 0:
+            self.close_failures -= 1
+            return False
+        return super().close()
+
+
+def _stuck_session(script=None):
+    provider = _Provider(script or [structured_payload(READ)],
+                         channel_class=_StuckChannel)
+    ledger = _Ledger()
+    call(provider, ledger, [{"role": "user", "content": "start"}])
+    return provider, ledger
+
+
