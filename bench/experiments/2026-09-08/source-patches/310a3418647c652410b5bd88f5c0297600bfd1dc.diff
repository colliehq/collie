+def test_worker_serves_three_structured_turns_on_one_native_session():
+    sdk = _FakeSdk([_structured_stream({"response": {"tool": "read_file",
+                                                     "args": {"path": "a.py"}}}),
+                    _structured_stream({"response": {"tool": "edit_file",
+                                                     "args": {"path": "a.py"}}},
+                                       message_id="msg_2", tool_id="toolu_2"),
+                    _structured_stream({"response": {"answer": "done"}},
+                                       message_id="msg_3", tool_id="toolu_3")])
+    frames = [{"type": "open", "protocol": 10, "session_key": KEY,
+               "request": _open_request()}]
+    frames += [_turn(index + 1, {**_open_request(), "prompt": text})
+               for index, text in enumerate(["full prompt", "Result of read_file: x",
+                                             "Result of edit_file: y"])]
+    frames.append({"type": "close"})
+
+    emitted, status = _drive(sdk, frames)
+
+    assert emitted[0] == {"type": "ready", "protocol": 10}
+    turns = [frame for frame in emitted if frame["type"] == "turn"]
+    assert len(turns) == 3 and all(turn["payload"]["ok"] for turn in turns)
+    assert sdk.clients == 1, "one connected client carried every turn"
+    assert sdk.client.prompts == ["full prompt", "Result of read_file: x",
+                                  "Result of edit_file: y"]
+    # The SDK re-announces init on every query; continuity is the stable id.
+    identities = {turn["session"]["id_sha256"] for turn in turns}
+    assert len(identities) == 1
+    assert [turn["session"]["inits"] for turn in turns] == [1, 2, 3]
+    assert json.loads(turns[2]["payload"]["text"]) == {"answer": "done"}
+    assert sdk.client.disconnected is True
