+# --------------------------------------------------------------------------- #
+#  Caller-owned context stays authoritative
+# --------------------------------------------------------------------------- #
+def _two_turn_history(provider, ledger):
+    messages = [{"role": "user", "content": "start"}]
+    first = call(provider, ledger, messages)
+    messages += [assistant(first), observation(first, "a" * 400)]
+    second = call(provider, ledger, messages)
+    messages += [assistant(second), observation(second, "b" * 400)]
+    return messages
+
+
+def test_tool_result_elision_starts_a_new_conversation():
+    provider = _Provider([structured_payload(READ), structured_payload(EDIT),
+                          structured_payload(DONE)])
+    ledger = _Ledger()
+    messages = _two_turn_history(provider, ledger)
+    # ContextComposer stubs tool output older than its window on every build.
+    elided = list(messages)
+    elided[2] = {**elided[2], "content": "aaa …[older tool output elided]"}
+
+    third = call(provider, ledger, elided)
+
+    assert third.stop_reason == "end_turn"
+    assert len(provider.channels) == 2, "an edited prefix must not receive a delta"
+    assert provider.session_evidence["resets"]["history_rewritten"] == 1
+    # The fresh conversation re-sends the caller's history as it now stands —
+    # including the elision marker, never the removed text.
+    resent = prompts(provider, 1)[0]
+    assert "older tool output elided" in resent
+    assert "a" * 400 not in resent
+
+
+def test_compaction_starts_a_new_conversation():
