+# --------------------------------------------------------------------------- #
+#  A formatter refusal: one accounted response, no prose, no hidden retry
+# --------------------------------------------------------------------------- #
+REFUSED_PROSE = ("input must match the requested schema: `rm` is not one of "
+                 "['read_file', 'edit_file', 'grep']")
+REFUSAL = {"ok": False, "structured_error": "formatter_refused_response",
+           "error": "the structured formatter refused the model response",
+           "api_key_source": "none", "response_format": "structured",
+           "response_tools": list(NAMES),
+           "usage": {"input_tokens": 11, "output_tokens": 0,
+                     "cache_read_input_tokens": 900,
+                     "cache_creation_input_tokens": 0}}
+
+
+def _refused_stream(session_id="native-1", message_id="msg_1", tool_id="toolu_1"):
+    """The provider's own formatter refusing one response, then repairing it."""
+    return [
+        _init(session_id=session_id),
+        {"type": "stream_event", "event": {"type": "message_start", "message": {
+            "id": message_id, "usage": {"input_tokens": 11,
+                                        "cache_read_input_tokens": 900}}}},
+        {"type": "assistant", "id": message_id, "content": [
+            {"type": "tool_use", "id": tool_id, "name": "StructuredOutput",
+             "input": {"response": {"tool": "rm", "args": {}}}}]},
+        {"type": "user", "content": [
+            {"type": "tool_result", "tool_use_id": tool_id,
+             "content": REFUSED_PROSE, "is_error": True}]},
+        # What the SDK does next if the stream is read on: an unreserved repair.
+        {"type": "stream_event", "event": {"type": "message_start",
+                                           "message": {"id": "msg_repair"}}},
+        {"type": "assistant", "id": "msg_repair", "content": [
+            {"type": "tool_use", "id": "toolu_repair", "name": "StructuredOutput",
+             "input": {"response": {"answer": "second try"}}}]},
+    ]
+
+
+def test_worker_forwards_a_formatter_refusal_as_the_reviewed_classification():
+    sdk = _FakeSdk([_refused_stream()])
+    frames = [{"type": "open", "protocol": 10, "session_key": KEY,
+               "request": _open_request()},
+              _turn(1, {**_open_request(), "prompt": "one"}),
+              _turn(2, {**_open_request(), "prompt": "two"})]
+
+    emitted, status = _drive(sdk, frames)
+
+    payload = [frame for frame in emitted if frame["type"] == "turn"][0]["payload"]
+    assert payload["ok"] is False
+    assert payload["structured_error"] == checked._FORMATTER_REFUSED
+    assert payload["api_key_source"] == "none"
+    # The request side is measured; the response side is only revised into the
+    # stream after a repair turn has begun, so it stays unmeasured.
+    assert payload["usage"] == {"input_tokens": 11, "output_tokens": 0,
+                                "cache_read_input_tokens": 900,
+                                "cache_creation_input_tokens": 0}
+    # Per-call attestation travels with the classification.
+    assert payload["response_format"] == "structured"
+    assert payload["response_tools"] == NAMES
+    assert "text" not in payload and "provider_error" not in payload
+    assert REFUSED_PROSE not in json.dumps(emitted), "no rejected prose crossed"
+    assert sdk.client.consumed == 4, "the hidden repair turn was never read"
+    # The refused response is still in the native history: no further turn.
+    assert emitted[-1]["type"] == "error"
+    assert "refused a further turn" in emitted[-1]["error"] and status == 1
+
