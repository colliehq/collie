+def test_a_worker_started_into_a_retired_session_is_reaped():
+    """A cancellation landing during startup must not orphan a live worker."""
+    class _Racing(_Provider):
+        def _open_channel(self, key, open_request):
+            channel = super()._open_channel(key, open_request)
+            # Stand in for cancel_for() arriving while the worker starts.
+            self._close_session("cancelled")
+            return channel
+
+    provider = _Racing([structured_payload(READ)])
+    ledger = _Ledger()
+
+    result = call(provider, ledger, [{"role": "user", "content": "start"}])
+
+    assert result.stop_reason == "error"
+    assert result.request_count == 0, "the turn was never released to the worker"
+    assert provider.channels[0].closed is True, "the orphaned worker was reaped"
+    assert provider.channels[0].sent == []
+
