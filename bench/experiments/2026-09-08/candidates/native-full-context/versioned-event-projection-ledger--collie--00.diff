+"""Deterministic JSON persistence for projections."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (MAX_SEQ, normalize_event, validate_entity_id,
+                     validate_payload)
+from .projection import Projection
+
+FORMAT = "eventview/1"
+
+DOC_KEYS = frozenset(
+    ("format", "next_seq", "last_updated_at", "records", "events"))
+RECORD_KEYS = frozenset(
+    ("entity_id", "version", "seq", "updated_at", "deleted", "fields"))
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def dump(projection, path):
+    """Write *projection* to *path*; return the number of bytes written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection")
+    _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_document(path):
+    try:
+        with open(path, "rb") as handle:
+            raw = handle.read()
+    except (IsADirectoryError, PermissionError):
+        raise NotFoundError("cannot read %r" % path)
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise ValidationError("file is not valid UTF-8")
+    try:
+        return json.loads(text)
+    except ValueError:
+        raise ValidationError("file is not valid JSON")
+
+
+def _validate_events(raw_events, next_seq):
+    events = []
+    if not isinstance(raw_events, list):
+        raise ValidationError("events must be a list")
+    for index, item in enumerate(raw_events):
+        event = normalize_event(item)
+        if event["seq"] != index + 1:
+            raise ValidationError("events must be seq 1..next_seq-1")
+        events.append(event)
+    if len(events) != next_seq - 1:
+        raise ValidationError("events do not cover 1..next_seq-1")
+    return events
+
+
+def _validate_records(raw_records, next_seq):
+    if not isinstance(raw_records, list):
+        raise ValidationError("records must be a list")
+    records = {}
+    for item in raw_records:
+        if not isinstance(item, dict):
+            raise ValidationError("record must be a dict")
+        if set(item.keys()) != RECORD_KEYS:
+            raise ValidationError("record has wrong keys")
+        entity_id = validate_entity_id(item["entity_id"])
+        version = item["version"]
+        if not _is_real_int(version) or version < 1:
+            raise ValidationError("bad record version")
+        seq = item["seq"]
+        if not _is_real_int(seq) or seq < 1 or seq >= next_seq:
+            raise ValidationError("bad record seq")
+        updated_at = item["updated_at"]
+        if not _is_real_int(updated_at) or updated_at < 0:
+            raise ValidationError("bad record updated_at")
+        deleted = item["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("bad record deleted flag")
+        fields_in = item["fields"]
+        if not isinstance(fields_in, dict):
+            raise ValidationError("record fields must be a dict")
+        fields = validate_payload(fields_in)
+        if deleted and fields:
+            raise ValidationError("deleted record must have empty fields")
+        if entity_id in records:
+            raise ValidationError("duplicate record %r" % entity_id)
+        records[entity_id] = {
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": fields,
+        }
+    return records
+
+
+def load(path, clock=None):
+    """Read a projection previously written by :func:`dump`."""
+    _validate_path(path)
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %r" % path)
+
+    doc = _load_document(path)
+    if not isinstance(doc, dict):
+        raise ValidationError("document must be an object")
+    if set(doc.keys()) != DOC_KEYS:
+        raise ValidationError("document has wrong keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format")
+
+    next_seq = doc["next_seq"]
+    if not _is_real_int(next_seq) or next_seq < 1 or next_seq > MAX_SEQ + 1:
+        raise ValidationError("bad next_seq")
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_real_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("bad last_updated_at")
+
+    events = _validate_events(doc["events"], next_seq)
+    records = _validate_records(doc["records"], next_seq)
+
+    projection = Projection(clock=clock)
+    projection._records = records
+    projection._log = dict((event["seq"], event) for event in events)
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
+
+
+__all__ = ["dump", "load"]
