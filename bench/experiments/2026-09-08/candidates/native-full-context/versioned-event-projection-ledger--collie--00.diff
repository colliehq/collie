+"""In-memory projection of a versioned event stream."""
+
+import copy
+
+from .errors import ConflictError, NotFoundError, SequenceError, ValidationError
+from .events import canonical_form, normalize_event, validate_entity_id
+
+
+def _default_clock():
+    return 0
+
+
+def _copy_fields(fields):
+    result = {}
+    for key, value in fields.items():
+        if type(value) is list:
+            result[key] = list(value)
+        else:
+            result[key] = value
+    return result
+
+
+def _copy_record(record):
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": _copy_fields(record["fields"]),
+    }
+
+
+class Projection(object):
+    """Projects create/update/delete events into entity records."""
+
+    def __init__(self, clock=None):
+        if clock is None:
+            clock = _default_clock
+        elif not callable(clock):
+            raise ValidationError("clock must be None or callable")
+        self._clock = clock
+        self._records = {}
+        self._log = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internals ---------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if not isinstance(now, int) or isinstance(now, bool) or now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        return (
+            dict((key, _copy_record(rec))
+                 for key, rec in self._records.items()),
+            dict((seq, copy.deepcopy(ev)) for seq, ev in self._log.items()),
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        self._records, self._log, self._next_seq, self._last_updated_at = state
+
+    @staticmethod
+    def _check_flag(value):
+        if not isinstance(value, bool):
+            raise ValidationError("include_deleted must be a bool")
+        return value
+
+    # -- public API --------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; return True if state changed, False on replay."""
+        ev = normalize_event(event)
+        seq = ev["seq"]
+
+        if seq > self._next_seq:
+            raise SequenceError("sequence hole at %d" % seq)
+        if seq < self._next_seq:
+            previous = self._log.get(seq)
+            if previous is None:
+                raise ConflictError("no recorded event at seq %d" % seq)
+            if canonical_form(previous) != canonical_form(ev):
+                raise ConflictError("conflicting replay at seq %d" % seq)
+            return False
+
+        entity_id = ev["entity_id"]
+        op = ev["op"]
+        current = self._records.get(entity_id)
+
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity %r already exists" % entity_id)
+        elif op == "update":
+            if current is None:
+                raise NotFoundError("unknown entity %r" % entity_id)
+            if current["deleted"]:
+                raise ConflictError("entity %r is deleted" % entity_id)
+        else:  # delete
+            if current is None:
+                raise NotFoundError("unknown entity %r" % entity_id)
+            if current["deleted"]:
+                raise ConflictError("entity %r is already deleted" % entity_id)
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": _copy_fields(ev["payload"]),
+            }
+            self._records[entity_id] = record
+        elif op == "update":
+            fields = _copy_fields(current["fields"])
+            for key, value in ev["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                elif type(value) is list:
+                    fields[key] = list(value)
+                else:
+                    fields[key] = value
+            record = _copy_record(current)
+            record["fields"] = fields
+            record["version"] = current["version"] + 1
+            record["seq"] = seq
+            record["updated_at"] = now
+            self._records[entity_id] = record
+        else:
+            record = _copy_record(current)
+            record["version"] = current["version"] + 1
+            record["seq"] = seq
+            record["updated_at"] = now
+            record["deleted"] = True
+            record["fields"] = {}
+            self._records[entity_id] = record
+
+        self._log[seq] = ev
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    def apply_batch(self, events):
+        """Apply several events transactionally; return the change count."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or tuple")
+        state = self._capture()
+        applied = 0
+        try:
+            for event in events:
+                if self.apply_event(event):
+                    applied += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return applied
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        validate_entity_id(entity_id)
+        self._check_flag(include_deleted)
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity %r" % entity_id)
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity %r is deleted" % entity_id)
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return deep copies of all records sorted by entity_id."""
+        self._check_flag(include_deleted)
+        rows = []
+        for entity_id in sorted(self._records):
+            record = self._records[entity_id]
+            if record["deleted"] and not include_deleted:
+                continue
+            rows.append(_copy_record(record))
+        return rows
+
+    def applied_events(self):
+        """Return deep copies of the state-changing events, sorted by seq."""
+        return [copy.deepcopy(self._log[seq]) for seq in sorted(self._log)]
+
+    def stats(self):
+        """Return summary counters for this projection."""
+        live = 0
+        deleted = 0
+        for record in self._records.values():
+            if record["deleted"]:
+                deleted += 1
+            else:
+                live += 1
+        return {
+            "live": live,
+            "deleted": deleted,
+            "applied": len(self._log),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
+
+
+__all__ = ["Projection"]
