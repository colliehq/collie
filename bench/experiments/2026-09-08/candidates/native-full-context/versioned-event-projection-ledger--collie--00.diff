+"""Event construction, validation and canonical serialisation."""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+OPS = ("create", "update", "delete")
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_KEY_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate_seq(seq):
+    """Return *seq* if it is a valid sequence number."""
+    if not _is_real_int(seq):
+        raise ValidationError("seq must be a non-boolean int")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError("seq out of range")
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Return *entity_id* if it matches the entity id grammar."""
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.match(entity_id) is None:
+        raise ValidationError("invalid entity_id")
+    return entity_id
+
+
+def validate_op(op):
+    """Return *op* if it is one of the three supported operations."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("invalid op")
+    return op
+
+
+def _validate_scalar(value):
+    if value is None or isinstance(value, bool):
+        return value
+    if isinstance(value, int):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValidationError("non-finite float")
+        return value
+    if isinstance(value, str):
+        if len(value) > MAX_STR_LEN:
+            raise ValidationError("string too long")
+        return value
+    raise ValidationError("unsupported scalar value")
+
+
+def _copy_value(value):
+    if type(value) is list:
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list too long")
+        return [_validate_scalar(item) for item in value]
+    return _validate_scalar(value)
+
+
+def validate_payload(payload, op=None):
+    """Validate a payload and return an isolated deep copy of it."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and len(payload) > 0:
+        raise ValidationError("delete payload must be empty")
+    result = {}
+    for key in payload:
+        if not isinstance(key, str) or _FIELD_KEY_RE.match(key) is None:
+            raise ValidationError("invalid payload key")
+        result[key] = _copy_value(payload[key])
+    return result
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a validated, fully isolated event dict."""
+    validate_seq(seq)
+    validate_entity_id(entity_id)
+    validate_op(op)
+    fields = validate_payload(payload, op)
+    return {
+        "seq": seq,
+        "entity_id": entity_id,
+        "op": op,
+        "payload": fields,
+    }
+
+
+def normalize_event(event):
+    """Validate an event mapping and return an isolated normalized copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event.keys()) != EVENT_KEYS:
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(event["seq"], event["entity_id"], event["op"],
+                      event["payload"])
+
+
+def canonical_form(event):
+    """Return a deterministic JSON string for *event*."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
+
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
