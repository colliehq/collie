+"""Deterministic JSON persistence for projections."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import normalize_event, validate_entity_id, validate_payload
+from .projection import Projection
+
+FORMAT = "eventview/1"
+
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+RECORD_KEYS = frozenset(("entity_id", "version", "seq", "updated_at",
+                         "deleted", "fields"))
+
+MAX_NEXT_SEQ = 1000000001
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or isinstance(path, bool) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def dump(projection, path):
+    """Write a projection to ``path``; return the number of bytes written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection")
+    _validate_path(path)
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_document(path):
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %r" % path)
+    with open(path, "rb") as handle:
+        raw = handle.read()
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise ValidationError("file is not valid UTF-8")
+    try:
+        doc = json.loads(text)
+    except ValueError:
+        raise ValidationError("file is not valid JSON")
+    if not isinstance(doc, dict):
+        raise ValidationError("document must be a JSON object")
+    if frozenset(doc.keys()) != DOC_KEYS:
+        raise ValidationError("document has unexpected keys")
+    return doc
+
+
+def load(path, clock=None):
+    """Read a projection back from ``path``."""
+    _validate_path(path)
+    doc = _load_document(path)
+
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format")
+
+    next_seq = doc["next_seq"]
+    if not _is_int(next_seq) or next_seq < 1 or next_seq > MAX_NEXT_SEQ:
+        raise ValidationError("invalid next_seq")
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("invalid last_updated_at")
+
+    records = doc["records"]
+    events = doc["events"]
+    if not isinstance(records, list) or not isinstance(events, list):
+        raise ValidationError("records and events must be lists")
+
+    log = {}
+    expected = 1
+    for raw_event in events:
+        ev = normalize_event(raw_event)
+        if ev["seq"] != expected:
+            raise ValidationError("events must be a dense ascending run")
+        log[ev["seq"]] = ev
+        expected += 1
+    if expected != next_seq:
+        raise ValidationError("events do not match next_seq")
+
+    stored = {}
+    for raw_record in records:
+        if not isinstance(raw_record, dict):
+            raise ValidationError("record must be a dict")
+        if frozenset(raw_record.keys()) != RECORD_KEYS:
+            raise ValidationError("record has unexpected keys")
+        entity_id = validate_entity_id(raw_record["entity_id"])
+        version = raw_record["version"]
+        if not _is_int(version) or version < 1:
+            raise ValidationError("invalid record version")
+        seq = raw_record["seq"]
+        if not _is_int(seq) or seq < 1 or seq >= next_seq:
+            raise ValidationError("invalid record seq")
+        updated_at = raw_record["updated_at"]
+        if not _is_int(updated_at) or updated_at < 0:
+            raise ValidationError("invalid record updated_at")
+        deleted = raw_record["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("invalid record deleted flag")
+        raw_fields = raw_record["fields"]
+        if not isinstance(raw_fields, dict):
+            raise ValidationError("record fields must be a dict")
+        fields = validate_payload(raw_fields)
+        if deleted and fields:
+            raise ValidationError("a deleted record must have no fields")
+        if entity_id in stored:
+            raise ValidationError("duplicate record %r" % entity_id)
+        stored[entity_id] = {
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": fields,
+        }
+
+    projection = Projection(clock=clock)
+    projection._records = stored
+    projection._log = log
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
+
+
+__all__ = ["dump", "load"]
