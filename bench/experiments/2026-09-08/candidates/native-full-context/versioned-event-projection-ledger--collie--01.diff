+"""Event construction, validation and canonical serialisation."""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+OPS = ("create", "update", "delete")
+
+MAX_SEQ = 1000000000
+
+ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+FIELD_KEY_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+
+def validate_seq(seq):
+    """Return the validated seq or raise ValidationError."""
+    if isinstance(seq, bool) or not isinstance(seq, int):
+        raise ValidationError("seq must be a non-boolean int")
+    if seq < 1 or seq > MAX_SEQ:
+        raise ValidationError("seq out of range")
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Return the validated entity_id or raise ValidationError."""
+    if not isinstance(entity_id, str) or isinstance(entity_id, bool):
+        raise ValidationError("entity_id must be a str")
+    if ENTITY_ID_RE.match(entity_id) is None:
+        raise ValidationError("entity_id has an invalid form")
+    return entity_id
+
+
+def validate_op(op):
+    """Return the validated op or raise ValidationError."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("op must be create, update or delete")
+    return op
+
+
+def _is_scalar(value):
+    if value is None:
+        return True
+    if isinstance(value, bool):
+        return True
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    if isinstance(value, str):
+        return len(value) <= MAX_STR_LEN
+    return False
+
+
+def _copy_value(value):
+    if isinstance(value, list):
+        return list(value)
+    return value
+
+
+def validate_payload(payload, op=None):
+    """Validate a payload and return an isolated deep copy of it."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and len(payload) > 0:
+        raise ValidationError("delete events must not carry a payload")
+    result = {}
+    for key, value in payload.items():
+        if not isinstance(key, str) or isinstance(key, bool):
+            raise ValidationError("payload keys must be str")
+        if FIELD_KEY_RE.match(key) is None:
+            raise ValidationError("payload key has an invalid form")
+        if isinstance(value, list):
+            if len(value) > MAX_LIST_LEN:
+                raise ValidationError("payload list value is too long")
+            for item in value:
+                if not _is_scalar(item):
+                    raise ValidationError("payload list items must be scalars")
+            result[key] = list(value)
+        else:
+            if not _is_scalar(value):
+                raise ValidationError("payload value is not a scalar")
+            result[key] = value
+    return result
+
+
+def copy_fields(fields):
+    """Return an isolated copy of an already validated field mapping."""
+    return dict((key, _copy_value(value)) for key, value in fields.items())
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a validated, fully isolated event dict."""
+    seq = validate_seq(seq)
+    entity_id = validate_entity_id(entity_id)
+    op = validate_op(op)
+    clean_payload = validate_payload(payload, op)
+    return {
+        "seq": seq,
+        "entity_id": entity_id,
+        "op": op,
+        "payload": clean_payload,
+    }
+
+
+def normalize_event(event):
+    """Validate an existing event mapping and return an isolated copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if frozenset(event.keys()) != EVENT_KEYS:
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(event["seq"], event["entity_id"], event["op"],
+                      event["payload"])
+
+
+def canonical_form(event):
+    """Return the deterministic canonical JSON string of an event."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
+
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
