+"""Exception hierarchy for the pagination library."""
+
+__all__ = ["PaginationError", "InvalidCursorError", "StaleCursorError"]
+
+
+class PaginationError(Exception):
+    """Base class for every error raised by this library."""
+
+
+class InvalidCursorError(PaginationError):
+    """Raised for malformed, corrupt or tampered cursor tokens."""
+
+
+class StaleCursorError(PaginationError):
+    """Raised for a well formed cursor minted against another snapshot."""
