+"""Deterministic, secret-free cursor token encoding/decoding.
+
+Token layout::
+
+    v1.<urlsafe-base64 body without padding>.<8 hex chars of sha256>
+
+The body is the compact, key-sorted JSON payload ``{"k": key, "r": rank,
+"v": version}``.  The signature is not a secret keyed MAC -- it only guards
+against accidental corruption and casual tampering.
+"""
+
+import base64
+import binascii
+import hashlib
+import json
+
+from pageerrors import InvalidCursorError
+
+__all__ = ["encode_cursor", "decode_cursor"]
+
+_PREFIX = "v1"
+_B64_ALPHABET = frozenset(
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZ" "abcdefghijklmnopqrstuvwxyz" "0123456789-_"
+)
+
+
+def _is_int(value):
+    """True for real ints; ``bool`` is explicitly excluded."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _sign(body):
+    return hashlib.sha256((_PREFIX + "." + body).encode("ascii")).hexdigest()[:8]
+
+
+def encode_cursor(version, rank, key):
+    """Return the stable cursor token for the position ``(rank, key)``."""
+    if not _is_int(version):
+        raise TypeError("version must be an int")
+    if version < 0:
+        raise ValueError("version must be >= 0")
+    if not _is_int(rank):
+        raise TypeError("rank must be an int")
+    if not isinstance(key, str):
+        raise TypeError("key must be a str")
+    if key == "":
+        raise ValueError("key must be non-empty")
+
+    payload = {"k": key, "r": rank, "v": version}
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    body = base64.urlsafe_b64encode(raw.encode("utf-8")).decode("ascii").rstrip("=")
+    return _PREFIX + "." + body + "." + _sign(body)
+
+
+def decode_cursor(token):
+    """Return ``(version, rank, key)`` for a valid token."""
+    if not isinstance(token, str):
+        raise TypeError("token must be a str")
+
+    parts = token.split(".")
+    if len(parts) != 3:
+        raise InvalidCursorError("cursor must have exactly 3 segments")
+    prefix, body, sig = parts
+    if prefix != _PREFIX:
+        raise InvalidCursorError("unsupported cursor version prefix")
+    if not body or any(ch not in _B64_ALPHABET for ch in body):
+        raise InvalidCursorError("cursor body is not url-safe base64")
+    if sig != _sign(body):
+        raise InvalidCursorError("cursor signature mismatch")
+
+    padding = "=" * (-len(body) % 4)
+    try:
+        raw = base64.urlsafe_b64decode(body + padding)
+    except (binascii.Error, ValueError):
+        raise InvalidCursorError("cursor body is not decodable base64")
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise InvalidCursorError("cursor body is not valid utf-8")
+    try:
+        payload = json.loads(text)
+    except ValueError:
+        raise InvalidCursorError("cursor body is not valid JSON")
+
+    if not isinstance(payload, dict) or set(payload) != {"k", "r", "v"}:
+        raise InvalidCursorError("cursor payload must be a {k,r,v} object")
+
+    version = payload["v"]
+    rank = payload["r"]
+    key = payload["k"]
+    if not _is_int(version) or version < 0:
+        raise InvalidCursorError("cursor version must be a non-negative int")
+    if not _is_int(rank):
+        raise InvalidCursorError("cursor rank must be an int")
+    if not isinstance(key, str) or key == "":
+        raise InvalidCursorError("cursor key must be a non-empty str")
+
+    return (version, rank, key)
