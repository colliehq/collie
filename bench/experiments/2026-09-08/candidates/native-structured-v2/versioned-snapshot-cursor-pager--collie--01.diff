+"""Stable cursor pagination over :class:`recordstore.Snapshot` values."""
+
+import dataclasses
+
+import cursorcodec
+import recordstore
+from pageerrors import StaleCursorError
+
+__all__ = ["Page", "paginate"]
+
+_MIN_LIMIT = 1
+_MAX_LIMIT = 100
+
+
+def _is_int(value):
+    """True for real ints; ``bool`` is explicitly excluded."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+@dataclasses.dataclass(frozen=True)
+class Page:
+    """An immutable page of records plus its navigation cursors."""
+
+    items: tuple
+    total: int
+    has_prev: bool
+    has_next: bool
+    prev_cursor: object = None
+    next_cursor: object = None
+
+
+def _validate(snapshot, limit, after, before, tag, min_rank, max_rank):
+    if not isinstance(snapshot, recordstore.Snapshot):
+        raise TypeError("snapshot must be a recordstore.Snapshot")
+    if not _is_int(limit):
+        raise TypeError("limit must be an int")
+    if limit < _MIN_LIMIT or limit > _MAX_LIMIT:
+        raise ValueError("limit must be between 1 and 100")
+    if after is not None and not isinstance(after, str):
+        raise TypeError("after must be a str or None")
+    if before is not None and not isinstance(before, str):
+        raise TypeError("before must be a str or None")
+    if after is not None and before is not None:
+        raise ValueError("after and before are mutually exclusive")
+    if tag is not None and not isinstance(tag, str):
+        raise TypeError("tag must be a str or None")
+    if tag == "":
+        raise ValueError("tag must be non-empty")
+    if min_rank is not None and not _is_int(min_rank):
+        raise TypeError("min_rank must be an int or None")
+    if max_rank is not None and not _is_int(max_rank):
+        raise TypeError("max_rank must be an int or None")
+    if min_rank is not None and max_rank is not None and min_rank > max_rank:
+        raise ValueError("min_rank must not exceed max_rank")
+
+
+def _position(token, snapshot):
+    """Decode ``token`` and return its ``(rank, key)`` position."""
+    version, rank, key = cursorcodec.decode_cursor(token)
+    if version != snapshot.version:
+        raise StaleCursorError("cursor was minted against another snapshot")
+    return (rank, key)
+
+
+def _matches(record, tag, min_rank, max_rank):
+    if tag is not None and tag not in record.tags:
+        return False
+    if min_rank is not None and record.rank < min_rank:
+        return False
+    if max_rank is not None and record.rank > max_rank:
+        return False
+    return True
+
+
+def paginate(snapshot, *, limit, after=None, before=None, tag=None,
+             min_rank=None, max_rank=None):
+    """Return one :class:`Page` of the snapshot's matching records."""
+    _validate(snapshot, limit, after, before, tag, min_rank, max_rank)
+
+    matched = [
+        record
+        for record in sorted(snapshot.records, key=lambda r: (r.rank, r.key))
+        if _matches(record, tag, min_rank, max_rank)
+    ]
+    total = len(matched)
+
+    if after is not None:
+        position = _position(after, snapshot)
+        low = sum(1 for r in matched if (r.rank, r.key) <= position)
+        high = min(low + limit, total)
+    elif before is not None:
+        position = _position(before, snapshot)
+        high = sum(1 for r in matched if (r.rank, r.key) < position)
+        low = max(0, high - limit)
+    else:
+        low = 0
+        high = min(limit, total)
+
+    items = tuple(matched[low:high])
+    has_prev = low > 0
+    has_next = high < total
+
+    prev_cursor = None
+    next_cursor = None
+    if items:
+        if has_prev:
+            prev_cursor = cursorcodec.encode_cursor(
+                snapshot.version, items[0].rank, items[0].key
+            )
+        if has_next:
+            next_cursor = cursorcodec.encode_cursor(
+                snapshot.version, items[-1].rank, items[-1].key
+            )
+
+    return Page(
+        items=items,
+        total=total,
+        has_prev=has_prev,
+        has_next=has_next,
+        prev_cursor=prev_cursor,
+        next_cursor=next_cursor,
+    )
