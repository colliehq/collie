+"""Versioned in-memory record storage with point-in-time snapshots."""
+
+import dataclasses
+
+__all__ = ["Record", "Snapshot", "RecordStore"]
+
+
+def _is_int(value):
+    """True for real ints; ``bool`` is explicitly excluded."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+@dataclasses.dataclass(frozen=True)
+class Record:
+    """An immutable stored record."""
+
+    key: str
+    rank: int
+    tags: tuple
+    updated_at: int
+
+
+@dataclasses.dataclass(frozen=True)
+class Snapshot:
+    """An immutable point-in-time view of a :class:`RecordStore`."""
+
+    version: int
+    records: tuple
+
+
+def _check_key(key):
+    if not isinstance(key, str):
+        raise TypeError("key must be a str")
+    if key == "":
+        raise ValueError("key must be non-empty")
+
+
+def _normalise_tags(tags):
+    """Validate ``tags`` and return the distinct tag strings, sorted."""
+    if isinstance(tags, (str, bytes, bytearray)):
+        raise TypeError("tags must be an iterable of str, not a string")
+    try:
+        items = list(tags)
+    except TypeError:
+        raise TypeError("tags must be iterable")
+    for item in items:
+        if not isinstance(item, str):
+            raise TypeError("each tag must be a str")
+    for item in items:
+        if item == "":
+            raise ValueError("tags must not contain empty strings")
+    return tuple(sorted(set(items)))
+
+
+class RecordStore:
+    """A mutable store of :class:`Record` values with a monotonic version."""
+
+    def __init__(self, clock):
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._records = {}
+        self._version = 0
+
+    @property
+    def version(self):
+        """The current store version (read-only)."""
+        return self._version
+
+    def put(self, key, rank, tags=()):
+        """Store or replace a record and return it."""
+        _check_key(key)
+        if not _is_int(rank):
+            raise TypeError("rank must be an int")
+        normalised = _normalise_tags(tags)
+        updated_at = self._clock()
+        if not _is_int(updated_at):
+            raise TypeError("clock() must return an int")
+
+        record = Record(key=key, rank=rank, tags=normalised, updated_at=updated_at)
+        self._records[key] = record
+        self._version += 1
+        return record
+
+    def remove(self, key):
+        """Remove and return the record stored under ``key``."""
+        _check_key(key)
+        if key not in self._records:
+            raise KeyError(key)
+        record = self._records.pop(key)
+        self._version += 1
+        return record
+
+    def get(self, key):
+        """Return the record stored under ``key`` or ``None``."""
+        _check_key(key)
+        return self._records.get(key)
+
+    def snapshot(self):
+        """Return an immutable snapshot ordered by ``(rank, key)``."""
+        records = tuple(
+            sorted(self._records.values(), key=lambda r: (r.rank, r.key))
+        )
+        return Snapshot(version=self._version, records=records)
