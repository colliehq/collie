+"""Projection of a versioned event stream into an entity view."""
+
+from .errors import (ConflictError, NotFoundError, SequenceError,
+                     ValidationError)
+from .events import canonical_form, normalize_event, validate_entity_id
+
+__all__ = ["Projection"]
+
+RECORD_KEYS = frozenset(("entity_id", "version", "seq", "updated_at",
+                         "deleted", "fields"))
+
+
+def _default_clock():
+    """Clock used when the caller does not inject one."""
+    return 0
+
+
+def _copy_fields(fields):
+    """Return an isolated copy of a fields/payload mapping."""
+    return dict((key, list(value) if isinstance(value, list) else value)
+                for key, value in fields.items())
+
+
+def _copy_record(record):
+    """Return an isolated copy of a record."""
+    copied = dict(record)
+    copied["fields"] = _copy_fields(record["fields"])
+    return copied
+
+
+def _copy_event(event):
+    """Return an isolated copy of a normalized event."""
+    copied = dict(event)
+    copied["payload"] = _copy_fields(event["payload"])
+    return copied
+
+
+def _validate_flag(value, name):
+    if not isinstance(value, bool):
+        raise ValidationError("%s must be a bool" % name)
+    return value
+
+
+class Projection(object):
+    """An in-memory view built by applying events in sequence order."""
+
+    def __init__(self, clock=None):
+        if clock is None:
+            clock = _default_clock
+        elif not callable(clock):
+            raise ValidationError("clock must be None or a callable")
+        self._clock = clock
+        self._records = {}
+        self._events = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internals ----------------------------------------------------
+
+    def _now(self):
+        value = self._clock()
+        if not isinstance(value, int) or isinstance(value, bool):
+            raise ValidationError("clock must return an int")
+        if value < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return value
+
+    def _capture(self):
+        return (
+            dict((key, _copy_record(rec))
+                 for key, rec in self._records.items()),
+            dict((seq, _copy_event(evt)) for seq, evt in self._events.items()),
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        records, events, next_seq, last_updated_at = state
+        self._records = records
+        self._events = events
+        self._next_seq = next_seq
+        self._last_updated_at = last_updated_at
+
+    @classmethod
+    def _from_state(cls, records, events, next_seq, last_updated_at,
+                    clock=None):
+        """Build a projection directly from validated stored state."""
+        projection = cls(clock=clock)
+        projection._records = dict(
+            (record["entity_id"], _copy_record(record)) for record in records)
+        projection._events = dict(
+            (event["seq"], _copy_event(event)) for event in events)
+        projection._next_seq = next_seq
+        projection._last_updated_at = last_updated_at
+        return projection
+
+    # -- public API ---------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; return True if the state changed."""
+        normalized = normalize_event(event)
+        seq = normalized["seq"]
+
+        if seq > self._next_seq:
+            raise SequenceError(
+                "event seq %d leaves a hole (expected %d)"
+                % (seq, self._next_seq))
+        if seq < self._next_seq:
+            previous = self._events.get(seq)
+            if previous is not None and \
+                    canonical_form(previous) == canonical_form(normalized):
+                return False
+            raise ConflictError(
+                "event seq %d conflicts with the applied history" % (seq,))
+
+        entity_id = normalized["entity_id"]
+        op = normalized["op"]
+        current = self._records.get(entity_id)
+
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity %r already exists" % (entity_id,))
+        else:
+            if current is None:
+                raise NotFoundError("unknown entity %r" % (entity_id,))
+            if current["deleted"]:
+                raise ConflictError("entity %r is deleted" % (entity_id,))
+
+        now = self._now()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": _copy_fields(normalized["payload"]),
+            }
+        elif op == "update":
+            fields = _copy_fields(current["fields"])
+            for key, value in normalized["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                elif isinstance(value, list):
+                    fields[key] = list(value)
+                else:
+                    fields[key] = value
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": fields,
+            }
+        else:
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": True,
+                "fields": {},
+            }
+
+        self._records[entity_id] = record
+        self._events[seq] = normalized
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    def apply_batch(self, events):
+        """Apply several events all-or-nothing; return the change count."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or a tuple")
+        saved = self._capture()
+        changed = 0
+        try:
+            for event in events:
+                if self.apply_event(event):
+                    changed += 1
+        except BaseException:
+            self._restore(saved)
+            raise
+        return changed
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        validate_entity_id(entity_id)
+        _validate_flag(include_deleted, "include_deleted")
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity %r" % (entity_id,))
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity %r is deleted" % (entity_id,))
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return all records sorted by ``entity_id``."""
+        _validate_flag(include_deleted, "include_deleted")
+        return [_copy_record(self._records[key])
+                for key in sorted(self._records)
+                if include_deleted or not self._records[key]["deleted"]]
+
+    def applied_events(self):
+        """Return the state-changing events sorted by ``seq``."""
+        return [_copy_event(self._events[seq])
+                for seq in sorted(self._events)]
+
+    def stats(self):
+        """Return a summary of the projection state."""
+        deleted = 0
+        for record in self._records.values():
+            if record["deleted"]:
+                deleted += 1
+        return {
+            "live": len(self._records) - deleted,
+            "deleted": deleted,
+            "applied": len(self._events),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
