+"""Deterministic JSON persistence for :class:`~eventview.projection.Projection`.
+"""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (normalize_event, validate_entity_id, validate_payload)
+from .projection import RECORD_KEYS, Projection
+
+__all__ = ["dump", "load"]
+
+FORMAT = "eventview/1"
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+MAX_NEXT_SEQ = 1000000001
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path``; return the number of bytes written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection instance")
+    _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _validate_record(raw, next_seq):
+    if not isinstance(raw, dict):
+        raise ValidationError("each record must be a dict")
+    if frozenset(raw) != RECORD_KEYS:
+        raise ValidationError("record has an unexpected key set")
+
+    entity_id = validate_entity_id(raw["entity_id"])
+
+    version = raw["version"]
+    if not _is_real_int(version) or version < 1:
+        raise ValidationError("record version must be an int >= 1")
+
+    seq = raw["seq"]
+    if not _is_real_int(seq) or seq < 1 or seq >= next_seq:
+        raise ValidationError("record seq must be an int in 1..next_seq-1")
+
+    updated_at = raw["updated_at"]
+    if not _is_real_int(updated_at) or updated_at < 0:
+        raise ValidationError("record updated_at must be an int >= 0")
+
+    deleted = raw["deleted"]
+    if not isinstance(deleted, bool):
+        raise ValidationError("record deleted must be a bool")
+
+    fields = raw["fields"]
+    if not isinstance(fields, dict):
+        raise ValidationError("record fields must be a dict")
+    fields = validate_payload(fields)
+    if deleted and fields:
+        raise ValidationError("a tombstoned record must have empty fields")
+
+    return {
+        "entity_id": entity_id,
+        "version": version,
+        "seq": seq,
+        "updated_at": updated_at,
+        "deleted": deleted,
+        "fields": fields,
+    }
+
+
+def load(path, clock=None):
+    """Read a document written by :func:`dump` and rebuild the projection."""
+    _validate_path(path)
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %r" % (path,))
+
+    with open(path, "rb") as handle:
+        raw_bytes = handle.read()
+    try:
+        text = raw_bytes.decode("utf-8")
+    except UnicodeDecodeError:
+        raise ValidationError("file is not valid UTF-8")
+    try:
+        doc = json.loads(text)
+    except ValueError:
+        raise ValidationError("file is not valid JSON")
+
+    if not isinstance(doc, dict):
+        raise ValidationError("document must be a JSON object")
+    if frozenset(doc) != DOC_KEYS:
+        raise ValidationError("document has an unexpected key set")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported document format")
+
+    next_seq = doc["next_seq"]
+    if not _is_real_int(next_seq) or next_seq < 1 or next_seq > MAX_NEXT_SEQ:
+        raise ValidationError("next_seq is out of range")
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_real_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("last_updated_at must be None or an int >= 0")
+
+    if not isinstance(doc["records"], list):
+        raise ValidationError("records must be a list")
+    if not isinstance(doc["events"], list):
+        raise ValidationError("events must be a list")
+
+    events = [normalize_event(item) for item in doc["events"]]
+    expected = list(range(1, next_seq))
+    if [event["seq"] for event in events] != expected:
+        raise ValidationError("stored events must cover 1..next_seq-1 in order")
+
+    records = []
+    seen = set()
+    for item in doc["records"]:
+        record = _validate_record(item, next_seq)
+        if record["entity_id"] in seen:
+            raise ValidationError("duplicate record entity_id")
+        seen.add(record["entity_id"])
+        records.append(record)
+
+    return Projection._from_state(records, events, next_seq, last_updated_at,
+                                  clock=clock)
