+"""Event construction, validation and canonicalisation.
+
+An *event* is a plain ``dict`` with exactly the four keys ``seq``,
+``entity_id``, ``op`` and ``payload``.
+"""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+OPS = frozenset(("create", "update", "delete"))
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_KEY_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+
+def _is_real_int(value):
+    """True for ``int`` values that are not booleans."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate_seq(seq):
+    """Return ``seq`` if it is a valid sequence number."""
+    if not _is_real_int(seq):
+        raise ValidationError("seq must be an int (bool is not allowed)")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError(
+            "seq must satisfy %d <= seq <= %d" % (MIN_SEQ, MAX_SEQ))
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Return ``entity_id`` if it is a valid entity identifier."""
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.fullmatch(entity_id) is None:
+        raise ValidationError("entity_id %r is not well formed" % (entity_id,))
+    return entity_id
+
+
+def validate_op(op):
+    """Return ``op`` if it is one of the three supported operations."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("op must be one of create/update/delete")
+    return op
+
+
+def _is_scalar(value):
+    if value is None or isinstance(value, bool):
+        return True
+    if isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    if isinstance(value, str):
+        return len(value) <= MAX_STR_LEN
+    return False
+
+
+def _copy_value(value):
+    """Validate a single payload value and return an isolated copy."""
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError(
+                "list values may hold at most %d elements" % MAX_LIST_LEN)
+        for item in value:
+            if not _is_scalar(item):
+                raise ValidationError("list elements must be scalars")
+        return list(value)
+    if not _is_scalar(value):
+        raise ValidationError("payload values must be scalars or lists")
+    return value
+
+
+def validate_payload(payload, op=None):
+    """Validate ``payload`` and return a brand new isolated ``dict``."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and payload:
+        raise ValidationError("delete events must not carry a payload")
+    result = {}
+    for key, value in payload.items():
+        if not isinstance(key, str) or _FIELD_KEY_RE.fullmatch(key) is None:
+            raise ValidationError("payload key %r is not well formed" % (key,))
+        result[key] = _copy_value(value)
+    return result
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a validated, fully isolated event ``dict``."""
+    seq = validate_seq(seq)
+    entity_id = validate_entity_id(entity_id)
+    op = validate_op(op)
+    fields = validate_payload(payload, op)
+    return {
+        "seq": seq,
+        "entity_id": entity_id,
+        "op": op,
+        "payload": fields,
+    }
+
+
+def normalize_event(event):
+    """Validate an existing event mapping and return a normalized copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if frozenset(event) != EVENT_KEYS:
+        raise ValidationError(
+            "event must have exactly the keys seq/entity_id/op/payload")
+    return make_event(event["seq"], event["entity_id"], event["op"],
+                      event["payload"])
+
+
+def canonical_form(event):
+    """Return the deterministic JSON encoding of a normalized event."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
