+"""Event construction, validation and canonical serialisation.
+
+An *event* is a plain ``dict`` with exactly the four keys ``seq``,
+``entity_id``, ``op`` and ``payload``.
+"""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+OPS = frozenset(("create", "update", "delete"))
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate_seq(seq):
+    """Return ``seq`` if it is a valid sequence number."""
+    if not _is_real_int(seq):
+        raise ValidationError("seq must be an int (bool is not accepted)")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError("seq out of range: %r" % (seq,))
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Return ``entity_id`` if it matches the documented pattern."""
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.fullmatch(entity_id) is None:
+        raise ValidationError("invalid entity_id: %r" % (entity_id,))
+    return entity_id
+
+
+def validate_op(op):
+    """Return ``op`` if it is one of the three supported operations."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("invalid op: %r" % (op,))
+    return op
+
+
+def _copy_scalar(value):
+    if value is None or isinstance(value, (bool, int, str)):
+        if isinstance(value, str) and len(value) > MAX_STR_LEN:
+            raise ValidationError("str value too long")
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValidationError("float value must be finite")
+        return value
+    raise ValidationError("unsupported scalar value: %r" % (type(value),))
+
+
+def _copy_value(value):
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list value has too many elements")
+        return [_copy_scalar(item) for item in value]
+    return _copy_scalar(value)
+
+
+def validate_payload(payload, op=None):
+    """Validate ``payload`` and return an isolated deep copy of it."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and payload:
+        raise ValidationError("delete events must not carry a payload")
+    result = {}
+    for key, value in payload.items():
+        if not isinstance(key, str) or _FIELD_RE.fullmatch(key) is None:
+            raise ValidationError("invalid payload key: %r" % (key,))
+        result[key] = _copy_value(value)
+    return result
+
+
+def copy_fields(fields):
+    """Return a deep copy of an already validated field mapping."""
+    return {key: (list(value) if isinstance(value, list) else value)
+            for key, value in fields.items()}
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a new validated, fully isolated event dict."""
+    seq = validate_seq(seq)
+    entity_id = validate_entity_id(entity_id)
+    op = validate_op(op)
+    fields = validate_payload(payload, op)
+    return {"seq": seq, "entity_id": entity_id, "op": op, "payload": fields}
+
+
+def normalize_event(event):
+    """Validate an event mapping and return a normalized copy of it."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event) != set(EVENT_KEYS):
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(event["seq"], event["entity_id"], event["op"],
+                      event["payload"])
+
+
+def canonical_form(event):
+    """Return the deterministic JSON encoding of a normalized event."""
+    return json.dumps(normalize_event(event), sort_keys=True,
+                      separators=(",", ":"))
