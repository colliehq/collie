+"""Projection of a versioned event stream into an entity view."""
+
+from .errors import (ConflictError, NotFoundError, SequenceError,
+                     ValidationError)
+from .events import (canonical_form, copy_fields, make_event, normalize_event,
+                     validate_entity_id)
+
+__all__ = ["Projection"]
+
+RECORD_KEYS = frozenset(("entity_id", "version", "seq", "updated_at",
+                         "deleted", "fields"))
+
+
+def _zero_clock():
+    return 0
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_clock(clock):
+    if clock is None:
+        return _zero_clock
+    if not callable(clock):
+        raise ValidationError("clock must be None or a callable")
+    return clock
+
+
+def _validate_flag(value, name):
+    if not isinstance(value, bool):
+        raise ValidationError("%s must be a bool" % (name,))
+    return value
+
+
+def _copy_record(record):
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": copy_fields(record["fields"]),
+    }
+
+
+class Projection(object):
+    """Applies validated events to build a versioned entity view."""
+
+    def __init__(self, clock=None):
+        self._clock = _validate_clock(clock)
+        self._records = {}
+        self._events = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internal helpers ------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if not _is_real_int(now):
+            raise ValidationError("clock must return an int (not a bool)")
+        if now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        return (
+            {key: _copy_record(rec) for key, rec in self._records.items()},
+            dict(self._events),
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        self._records, self._events, self._next_seq, self._last_updated_at = \
+            state
+
+    def _apply_normalized(self, event):
+        seq = event["seq"]
+        entity_id = event["entity_id"]
+        op = event["op"]
+
+        if seq > self._next_seq:
+            raise SequenceError("sequence hole: expected %d, got %d"
+                                % (self._next_seq, seq))
+        if seq < self._next_seq:
+            previous = self._events[seq]
+            if canonical_form(previous) != canonical_form(event):
+                raise ConflictError("conflicting replay at seq %d" % (seq,))
+            return False
+
+        current = self._records.get(entity_id)
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity already exists: %r" % (entity_id,))
+        else:
+            if current is None:
+                raise NotFoundError("unknown entity: %r" % (entity_id,))
+            if current["deleted"]:
+                raise ConflictError("entity is deleted: %r" % (entity_id,))
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": copy_fields(event["payload"]),
+            }
+        elif op == "update":
+            fields = copy_fields(current["fields"])
+            for key, value in event["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                elif isinstance(value, list):
+                    fields[key] = list(value)
+                else:
+                    fields[key] = value
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": fields,
+            }
+        else:
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": True,
+                "fields": {},
+            }
+
+        self._records[entity_id] = record
+        self._events[seq] = event
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    # -- public API ------------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; return True if the state changed."""
+        return self._apply_normalized(normalize_event(event))
+
+    def apply_batch(self, events):
+        """Apply several events transactionally; return the change count."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or a tuple")
+        state = self._capture()
+        changed = 0
+        try:
+            for event in events:
+                if self._apply_normalized(normalize_event(event)):
+                    changed += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return changed
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        validate_entity_id(entity_id)
+        _validate_flag(include_deleted, "include_deleted")
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity: %r" % (entity_id,))
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity is deleted: %r" % (entity_id,))
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return deep copies of all records sorted by entity_id."""
+        _validate_flag(include_deleted, "include_deleted")
+        return [_copy_record(self._records[key])
+                for key in sorted(self._records)
+                if include_deleted or not self._records[key]["deleted"]]
+
+    def applied_events(self):
+        """Return deep copies of the state-changing events, seq ascending."""
+        return [make_event(event["seq"], event["entity_id"], event["op"],
+                           event["payload"])
+                for _, event in sorted(self._events.items())]
+
+    def stats(self):
+        """Return a summary of the projection state."""
+        deleted = sum(1 for rec in self._records.values() if rec["deleted"])
+        return {
+            "live": len(self._records) - deleted,
+            "deleted": deleted,
+            "applied": len(self._events),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
+
+    # -- internal constructor used by the journal ------------------------
+
+    @classmethod
+    def _from_state(cls, clock, records, events, next_seq, last_updated_at):
+        projection = cls(clock=clock)
+        projection._records = records
+        projection._events = events
+        projection._next_seq = next_seq
+        projection._last_updated_at = last_updated_at
+        return projection
