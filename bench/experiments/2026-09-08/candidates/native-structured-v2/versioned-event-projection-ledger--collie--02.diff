+"""Deterministic JSON persistence for :class:`~eventview.projection.Projection`."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (copy_fields, normalize_event, validate_entity_id,
+                     validate_payload)
+from .projection import RECORD_KEYS, Projection, _validate_clock
+
+__all__ = ["dump", "load"]
+
+FORMAT = "eventview/1"
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+MAX_NEXT_SEQ = 1000000001
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path`` as deterministic JSON; return bytes."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection instance")
+    _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_document(path):
+    if not os.path.isfile(path):
+        raise NotFoundError("no such journal file: %r" % (path,))
+    try:
+        with open(path, "rb") as handle:
+            raw = handle.read()
+    except OSError as exc:
+        raise NotFoundError("cannot read journal file: %r" % (path,)) from exc
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ValidationError("journal file is not valid UTF-8") from exc
+    try:
+        return json.loads(text)
+    except ValueError as exc:
+        raise ValidationError("journal file is not valid JSON") from exc
+
+
+def _load_events(raw_events, next_seq):
+    if not isinstance(raw_events, list):
+        raise ValidationError("'events' must be a list")
+    events = {}
+    expected = 1
+    for entry in raw_events:
+        event = normalize_event(entry)
+        if event["seq"] != expected:
+            raise ValidationError("events must be seq 1..next_seq-1 in order")
+        events[event["seq"]] = event
+        expected += 1
+    if expected != next_seq:
+        raise ValidationError("events do not cover 1..next_seq-1")
+    return events
+
+
+def _load_records(raw_records, next_seq):
+    if not isinstance(raw_records, list):
+        raise ValidationError("'records' must be a list")
+    records = {}
+    for entry in raw_records:
+        if not isinstance(entry, dict) or set(entry) != set(RECORD_KEYS):
+            raise ValidationError("each record must have the six record keys")
+        entity_id = validate_entity_id(entry["entity_id"])
+        version = entry["version"]
+        if not _is_real_int(version) or version < 1:
+            raise ValidationError("record version must be an int >= 1")
+        seq = entry["seq"]
+        if not _is_real_int(seq) or seq < 1 or seq >= next_seq:
+            raise ValidationError("record seq out of range")
+        updated_at = entry["updated_at"]
+        if not _is_real_int(updated_at) or updated_at < 0:
+            raise ValidationError("record updated_at must be an int >= 0")
+        deleted = entry["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("record deleted must be a bool")
+        raw_fields = entry["fields"]
+        if not isinstance(raw_fields, dict):
+            raise ValidationError("record fields must be a dict")
+        fields = validate_payload(raw_fields)
+        if deleted and fields:
+            raise ValidationError("a tombstoned record must have no fields")
+        if entity_id in records:
+            raise ValidationError("duplicate record: %r" % (entity_id,))
+        records[entity_id] = {
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": copy_fields(fields),
+        }
+    return records
+
+
+def load(path, clock=None):
+    """Read a journal file and return the stored :class:`Projection`."""
+    _validate_path(path)
+    clock = _validate_clock(clock)
+    doc = _load_document(path)
+
+    if not isinstance(doc, dict) or set(doc) != set(DOC_KEYS):
+        raise ValidationError("journal document must have exactly five keys")
+    if doc["format"] != FORMAT or not isinstance(doc["format"], str):
+        raise ValidationError("unsupported journal format")
+    next_seq = doc["next_seq"]
+    if not _is_real_int(next_seq) or next_seq < 1 or next_seq > MAX_NEXT_SEQ:
+        raise ValidationError("invalid next_seq")
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_real_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("invalid last_updated_at")
+
+    events = _load_events(doc["events"], next_seq)
+    records = _load_records(doc["records"], next_seq)
+
+    return Projection._from_state(clock, records, events, next_seq,
+                                  last_updated_at)
