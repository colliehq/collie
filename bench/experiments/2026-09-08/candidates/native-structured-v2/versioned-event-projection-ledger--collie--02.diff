+"""eventview -- project a versioned event stream into an entity view.
+
+Public API::
+
+    from eventview import (EventViewError, ValidationError, SequenceError,
+                           ConflictError, NotFoundError, make_event,
+                           normalize_event, canonical_form, Projection,
+                           dump, load)
+
+Every timestamp comes from an injected clock callable; the package uses only
+the standard library and is fully deterministic.
+"""
+
+from .errors import (ConflictError, EventViewError, NotFoundError,
+                     SequenceError, ValidationError)
+from .events import canonical_form, make_event, normalize_event
+from .journal import dump, load
+from .projection import Projection
+
+__all__ = [
+    "EventViewError",
+    "ValidationError",
+    "SequenceError",
+    "ConflictError",
+    "NotFoundError",
+    "make_event",
+    "normalize_event",
+    "canonical_form",
+    "Projection",
+    "dump",
+    "load",
+]
