+"""Projection of a versioned event stream into an entity view."""
+
+from .errors import (ConflictError, NotFoundError, SequenceError,
+                     ValidationError)
+from .events import (canonical_form, copy_payload, copy_value,
+                     normalize_event, validate_entity_id)
+
+__all__ = ["Projection"]
+
+RECORD_KEYS = frozenset(("entity_id", "version", "seq", "updated_at",
+                         "deleted", "fields"))
+
+
+def _default_clock():
+    """Clock used when the caller does not inject one."""
+    return 0
+
+
+def _copy_record(record):
+    """Return an independent deep copy of a record dict."""
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": copy_payload(record["fields"]),
+    }
+
+
+def _copy_event(event):
+    """Return an independent deep copy of a normalized event dict."""
+    return {
+        "seq": event["seq"],
+        "entity_id": event["entity_id"],
+        "op": event["op"],
+        "payload": copy_payload(event["payload"]),
+    }
+
+
+def _validate_flag(value):
+    """Validate an ``include_deleted`` style flag."""
+    if not isinstance(value, bool):
+        raise ValidationError("include_deleted must be a bool")
+    return value
+
+
+class Projection(object):
+    """Applies validated events to an in-memory entity view."""
+
+    def __init__(self, clock=None):
+        if clock is None:
+            clock = _default_clock
+        elif not callable(clock):
+            raise ValidationError("clock must be None or a callable")
+        self._clock = clock
+        self._records = {}
+        self._events = {}
+        self._canonical = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internals ---------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if not isinstance(now, int) or isinstance(now, bool) or now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        return (
+            dict((key, _copy_record(value))
+                 for key, value in self._records.items()),
+            dict((key, _copy_event(value))
+                 for key, value in self._events.items()),
+            dict(self._canonical),
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        (self._records, self._events, self._canonical, self._next_seq,
+         self._last_updated_at) = state
+
+    @classmethod
+    def _from_state(cls, clock, records, events, next_seq, last_updated_at):
+        """Build a projection directly from already-validated state."""
+        projection = cls(clock=clock)
+        projection._records = dict(
+            (record["entity_id"], _copy_record(record)) for record in records)
+        projection._events = dict(
+            (event["seq"], _copy_event(event)) for event in events)
+        projection._canonical = dict(
+            (event["seq"], canonical_form(event)) for event in events)
+        projection._next_seq = next_seq
+        projection._last_updated_at = last_updated_at
+        return projection
+
+    # -- public API --------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; True when state changed, False on replay."""
+        normalized = normalize_event(event)
+        seq = normalized["seq"]
+
+        if seq > self._next_seq:
+            raise SequenceError("event seq %d leaves a hole (expected %d)"
+                                % (seq, self._next_seq))
+        if seq < self._next_seq:
+            if canonical_form(normalized) == self._canonical[seq]:
+                return False
+            raise ConflictError("event seq %d differs from applied history"
+                                % seq)
+
+        entity_id = normalized["entity_id"]
+        op = normalized["op"]
+        current = self._records.get(entity_id)
+
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity %r already exists" % entity_id)
+        else:
+            if current is None:
+                raise NotFoundError("unknown entity %r" % entity_id)
+            if current["deleted"]:
+                raise ConflictError("entity %r is deleted" % entity_id)
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": copy_payload(normalized["payload"]),
+            }
+        elif op == "update":
+            fields = copy_payload(current["fields"])
+            for key, value in normalized["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                else:
+                    fields[key] = copy_value(value)
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": fields,
+            }
+        else:
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": True,
+                "fields": {},
+            }
+
+        self._records[entity_id] = record
+        self._events[seq] = normalized
+        self._canonical[seq] = canonical_form(normalized)
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    def apply_batch(self, events):
+        """Apply many events atomically; return how many changed state."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or tuple")
+        saved = self._capture()
+        changed = 0
+        try:
+            for event in events:
+                if self.apply_event(event):
+                    changed += 1
+        except BaseException:
+            self._restore(saved)
+            raise
+        return changed
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        validate_entity_id(entity_id)
+        _validate_flag(include_deleted)
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity %r" % (entity_id,))
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity %r is deleted" % (entity_id,))
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return deep copies of all records sorted by ``entity_id``."""
+        _validate_flag(include_deleted)
+        rows = []
+        for entity_id in sorted(self._records):
+            record = self._records[entity_id]
+            if record["deleted"] and not include_deleted:
+                continue
+            rows.append(_copy_record(record))
+        return rows
+
+    def applied_events(self):
+        """Return deep copies of the state-changing events, by seq."""
+        return [_copy_event(self._events[seq]) for seq in sorted(self._events)]
+
+    def stats(self):
+        """Return a fresh summary dict of the projection state."""
+        deleted = 0
+        live = 0
+        for record in self._records.values():
+            if record["deleted"]:
+                deleted += 1
+            else:
+                live += 1
+        return {
+            "live": live,
+            "deleted": deleted,
+            "applied": len(self._events),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
