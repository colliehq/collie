+"""Deterministic JSON persistence for :class:`~eventview.projection.Projection`."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (normalize_event, validate_entity_id, validate_payload)
+from .projection import Projection, RECORD_KEYS
+
+__all__ = ["dump", "load"]
+
+FORMAT = "eventview/1"
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+MAX_NEXT_SEQ = 1000000001
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path`` and return the byte count written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection instance")
+    _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_document(path):
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %r" % (path,))
+    with open(path, "rb") as handle:
+        raw = handle.read()
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise ValidationError("file is not valid UTF-8")
+    try:
+        doc = json.loads(text)
+    except ValueError:
+        raise ValidationError("file is not valid JSON")
+    if not isinstance(doc, dict) or set(doc.keys()) != DOC_KEYS:
+        raise ValidationError("document must have exactly the documented keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format")
+    next_seq = doc["next_seq"]
+    if not _is_real_int(next_seq) or next_seq < 1 or next_seq > MAX_NEXT_SEQ:
+        raise ValidationError("invalid next_seq")
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_real_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("invalid last_updated_at")
+    if not isinstance(doc["records"], list):
+        raise ValidationError("records must be a list")
+    if not isinstance(doc["events"], list):
+        raise ValidationError("events must be a list")
+    return doc
+
+
+def _load_events(raw_events, next_seq):
+    events = [normalize_event(item) for item in raw_events]
+    expected = list(range(1, next_seq))
+    if [event["seq"] for event in events] != expected:
+        raise ValidationError("stored events must be exactly 1..next_seq-1")
+    return events
+
+
+def _load_records(raw_records, next_seq):
+    records = []
+    seen = set()
+    for item in raw_records:
+        if not isinstance(item, dict) or set(item.keys()) != set(RECORD_KEYS):
+            raise ValidationError("record must have exactly the six keys")
+        entity_id = validate_entity_id(item["entity_id"])
+        if entity_id in seen:
+            raise ValidationError("duplicate record for %r" % (entity_id,))
+        seen.add(entity_id)
+        version = item["version"]
+        if not _is_real_int(version) or version < 1:
+            raise ValidationError("invalid record version")
+        seq = item["seq"]
+        if not _is_real_int(seq) or seq < 1 or seq >= next_seq:
+            raise ValidationError("invalid record seq")
+        updated_at = item["updated_at"]
+        if not _is_real_int(updated_at) or updated_at < 0:
+            raise ValidationError("invalid record updated_at")
+        deleted = item["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("record deleted must be a bool")
+        raw_fields = item["fields"]
+        if not isinstance(raw_fields, dict):
+            raise ValidationError("record fields must be a dict")
+        fields = validate_payload(raw_fields)
+        if deleted and fields:
+            raise ValidationError("tombstoned records must have no fields")
+        records.append({
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": fields,
+        })
+    return records
+
+
+def load(path, clock=None):
+    """Read a journal file and return a new :class:`Projection`."""
+    _validate_path(path)
+    doc = _load_document(path)
+    next_seq = doc["next_seq"]
+    events = _load_events(doc["events"], next_seq)
+    records = _load_records(doc["records"], next_seq)
+    return Projection._from_state(clock, records, events, next_seq,
+                                  doc["last_updated_at"])
