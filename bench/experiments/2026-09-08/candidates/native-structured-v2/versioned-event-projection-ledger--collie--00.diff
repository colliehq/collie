+"""Event construction, validation and canonical serialisation.
+
+An *event* is a plain :class:`dict` with exactly the four keys ``seq``,
+``entity_id``, ``op`` and ``payload``.
+"""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+OPS = frozenset(("create", "update", "delete"))
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_NAME_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+
+def _is_real_int(value):
+    """True for a genuine ``int`` (booleans are explicitly excluded)."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate_seq(seq):
+    """Validate and return an event sequence number."""
+    if not _is_real_int(seq):
+        raise ValidationError("seq must be an int (bool is not accepted)")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError(
+            "seq must satisfy %d <= seq <= %d" % (MIN_SEQ, MAX_SEQ))
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Validate and return an entity id."""
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.match(entity_id) is None:
+        raise ValidationError("invalid entity_id: %r" % (entity_id,))
+    return entity_id
+
+
+def validate_op(op):
+    """Validate and return an operation name."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("op must be one of create/update/delete")
+    return op
+
+
+def _validate_scalar(value):
+    """Validate a scalar payload value and return a safe copy of it."""
+    if value is None or isinstance(value, bool):
+        return value
+    if isinstance(value, int):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValidationError("float payload values must be finite")
+        return value
+    if isinstance(value, str):
+        if len(value) > MAX_STR_LEN:
+            raise ValidationError("str payload values must be <= %d chars"
+                                  % MAX_STR_LEN)
+        return value
+    raise ValidationError("unsupported payload value: %r" % (type(value),))
+
+
+def _validate_value(value):
+    """Validate one payload value; return an isolated copy."""
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list payload values may hold at most %d "
+                                  "elements" % MAX_LIST_LEN)
+        return [_validate_scalar(item) for item in value]
+    return _validate_scalar(value)
+
+
+def validate_payload(payload, op=None):
+    """Validate ``payload`` and return a brand new isolated ``dict``."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and payload:
+        raise ValidationError("delete events must not carry a payload")
+    result = {}
+    for key in payload:
+        if not isinstance(key, str) or _FIELD_NAME_RE.match(key) is None:
+            raise ValidationError("invalid payload key: %r" % (key,))
+        result[key] = _validate_value(payload[key])
+    return result
+
+
+def copy_payload(payload):
+    """Deep copy an already-validated payload mapping."""
+    result = {}
+    for key, value in payload.items():
+        result[key] = list(value) if isinstance(value, list) else value
+    return result
+
+
+def copy_value(value):
+    """Deep copy an already-validated payload value."""
+    return list(value) if isinstance(value, list) else value
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Validate the parts of an event and return a fresh isolated dict."""
+    seq = validate_seq(seq)
+    entity_id = validate_entity_id(entity_id)
+    op = validate_op(op)
+    fields = validate_payload(payload, op)
+    return {"seq": seq, "entity_id": entity_id, "op": op, "payload": fields}
+
+
+def normalize_event(event):
+    """Validate a whole event dict and return a fresh isolated copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event.keys()) != EVENT_KEYS:
+        raise ValidationError("event must have exactly the keys "
+                              "seq/entity_id/op/payload")
+    return make_event(event["seq"], event["entity_id"], event["op"],
+                      event["payload"])
+
+
+def canonical_form(event):
+    """Return the deterministic JSON text of a normalized event."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
