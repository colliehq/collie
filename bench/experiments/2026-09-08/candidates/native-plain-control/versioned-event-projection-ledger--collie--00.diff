+"""In-memory projection of a versioned event stream."""
+
+from .errors import ConflictError, NotFoundError, SequenceError, ValidationError
+from .events import canonical_form, normalize_event, validate_entity_id
+
+
+def _default_clock():
+    return 0
+
+
+def _copy_fields(fields):
+    result = {}
+    for key, value in fields.items():
+        result[key] = list(value) if isinstance(value, list) else value
+    return result
+
+
+def _copy_record(record):
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": _copy_fields(record["fields"]),
+    }
+
+
+def _copy_event(event):
+    return {
+        "seq": event["seq"],
+        "entity_id": event["entity_id"],
+        "op": event["op"],
+        "payload": _copy_fields(event["payload"]),
+    }
+
+
+def _validate_flag(value, name):
+    if not isinstance(value, bool):
+        raise ValidationError("%s must be a bool" % name)
+    return value
+
+
+class Projection:
+    """Projects create/update/delete events into entity records."""
+
+    def __init__(self, clock=None):
+        if clock is None:
+            clock = _default_clock
+        elif not callable(clock):
+            raise ValidationError("clock must be callable or None")
+        self._clock = clock
+        self._records = {}
+        self._log = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internal helpers ------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if isinstance(now, bool) or not isinstance(now, int):
+            raise ValidationError("clock must return a non-bool int")
+        if now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        return (
+            {key: _copy_record(rec) for key, rec in self._records.items()},
+            {seq: _copy_event(ev) for seq, ev in self._log.items()},
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        records, log, next_seq, last_updated_at = state
+        self._records = records
+        self._log = log
+        self._next_seq = next_seq
+        self._last_updated_at = last_updated_at
+
+    def _apply_normalized(self, ev):
+        """Apply an already-normalized event; return True when state changed."""
+        seq = ev["seq"]
+        if seq > self._next_seq:
+            raise SequenceError("sequence hole: expected %d" % self._next_seq)
+        if seq < self._next_seq:
+            previous = self._log.get(seq)
+            if previous is not None and canonical_form(previous) == canonical_form(ev):
+                return False
+            raise ConflictError("event %d conflicts with the applied event" % seq)
+
+        entity_id = ev["entity_id"]
+        op = ev["op"]
+        cur = self._records.get(entity_id)
+        if op == "create":
+            if cur is not None:
+                raise ConflictError("entity already exists")
+        elif op == "update":
+            if cur is None:
+                raise NotFoundError("unknown entity")
+            if cur["deleted"]:
+                raise ConflictError("entity is deleted")
+        else:  # delete
+            if cur is None:
+                raise NotFoundError("unknown entity")
+            if cur["deleted"]:
+                raise ConflictError("entity is already deleted")
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": _copy_fields(ev["payload"]),
+            }
+            self._records[entity_id] = record
+        else:
+            record = _copy_record(cur)
+            if op == "update":
+                fields = record["fields"]
+                for key, value in ev["payload"].items():
+                    if value is None:
+                        fields.pop(key, None)
+                    else:
+                        fields[key] = list(value) if isinstance(value, list) else value
+            else:
+                record["deleted"] = True
+                record["fields"] = {}
+            record["version"] = cur["version"] + 1
+            record["seq"] = seq
+            record["updated_at"] = now
+            self._records[entity_id] = record
+
+        self._log[seq] = _copy_event(ev)
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    # -- public API ------------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; True when state changed, False for a replay."""
+        ev = normalize_event(event)
+        state = self._capture()
+        try:
+            return self._apply_normalized(ev)
+        except BaseException:
+            self._restore(state)
+            raise
+
+    def apply_batch(self, events):
+        """Apply several events transactionally; return the change count."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or tuple")
+        state = self._capture()
+        applied = 0
+        try:
+            for event in events:
+                ev = normalize_event(event)
+                if self._apply_normalized(ev):
+                    applied += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return applied
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        validate_entity_id(entity_id)
+        _validate_flag(include_deleted, "include_deleted")
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity")
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity is deleted")
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return deep copies of the records sorted by entity_id."""
+        _validate_flag(include_deleted, "include_deleted")
+        return [
+            _copy_record(self._records[key])
+            for key in sorted(self._records)
+            if include_deleted or not self._records[key]["deleted"]
+        ]
+
+    def applied_events(self):
+        """Return deep copies of the state-changing events, sorted by seq."""
+        return [_copy_event(self._log[seq]) for seq in sorted(self._log)]
+
+    def stats(self):
+        """Return a summary dict of the projection state."""
+        deleted = sum(1 for rec in self._records.values() if rec["deleted"])
+        return {
+            "live": len(self._records) - deleted,
+            "deleted": deleted,
+            "applied": len(self._log),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
+
+
+__all__ = ["Projection"]
