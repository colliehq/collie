diff --git a/ledger_report.py b/ledger_report.py
new file mode 100644
index 0000000..4c1b356
--- /dev/null
+++ b/ledger_report.py
@@ -0,0 +1,31 @@
+"""Plain text rendering helpers for a capacity ledger."""
+
+from ledger_core import CapacityLedger
+from ledger_errors import ValidationError
+
+
+def _require_ledger(ledger):
+    if not isinstance(ledger, CapacityLedger):
+        raise ValidationError("ledger must be a CapacityLedger")
+
+
+def render_totals(ledger):
+    """One "{resource_id} {allocated}/{limit}" line per registered resource."""
+    _require_ledger(ledger)
+    totals = ledger.totals()
+    limits = ledger.limits()
+    lines = ["%s %d/%d" % (resource_id, totals[resource_id], limits[resource_id])
+             for resource_id in ledger.resource_ids()]
+    return "\n".join(lines)
+
+
+def render_reservations(ledger, include_released=False):
+    """One "{request_id} {resource_id} {units} {status}" line per reservation."""
+    _require_ledger(ledger)
+    if not isinstance(include_released, bool):
+        raise ValidationError("include_released must be a bool")
+    lines = ["%s %s %d %s" % (record["request_id"], record["resource_id"],
+                              record["units"], record["status"])
+             for record in ledger.list_reservations(
+                 include_released=include_released)]
+    return "\n".join(lines)
