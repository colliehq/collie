+"""Parsing of the textual rule format into Rule objects."""
+
+from ruleengine import Rule
+from ruleerrors import RuleError, RuleSyntaxError
+
+COMMENT = "#"
+FIELD_SEPARATOR = ":"
+STRIP_CHARS = " \t"
+DIGITS = "0123456789"
+
+
+def _parse_priority(text, line_number):
+    if text == "":
+        return 0
+    body = text
+    if body[0] in "+-":
+        body = body[1:]
+    if body == "":
+        raise RuleSyntaxError("invalid priority %r" % (text,), line_number)
+    for char in body:
+        if char not in DIGITS:
+            raise RuleSyntaxError("invalid priority %r" % (text,), line_number)
+    return int(text)
+
+
+def parse_rules(text):
+    """Parse rule text and return a tuple of Rule objects in file order."""
+    if not isinstance(text, str):
+        raise TypeError("text must be a str, got %r" % (type(text).__name__,))
+    rules = []
+    for offset, line in enumerate(text.splitlines()):
+        line_number = offset + 1
+        stripped = line.strip(STRIP_CHARS)
+        if stripped == "" or stripped.startswith(COMMENT):
+            continue
+        fields = stripped.split(FIELD_SEPARATOR, 3)
+        if len(fields) < 4:
+            raise RuleSyntaxError(
+                "expected 4 fields separated by ':'", line_number)
+        action = fields[0].strip(STRIP_CHARS)
+        priority_text = fields[1].strip(STRIP_CHARS)
+        label_text = fields[2].strip(STRIP_CHARS)
+        pattern = fields[3]
+        if action not in ("include", "exclude"):
+            raise RuleSyntaxError("invalid action %r" % (action,), line_number)
+        priority = _parse_priority(priority_text, line_number)
+        label = label_text if label_text != "" else None
+        try:
+            rule = Rule(pattern, action, priority, label)
+        except RuleError as exc:
+            raise RuleSyntaxError(
+                "invalid pattern %r: %s" % (pattern, exc), line_number)
+        rules.append(rule)
+    return tuple(rules)
+
+
+def load_rules(path):
+    """Read rule text from path (UTF-8) and return the parsed rules."""
+    if not isinstance(path, str):
+        raise TypeError("path must be a str, got %r" % (type(path).__name__,))
+    with open(path, "r", encoding="utf-8") as handle:
+        return parse_rules(handle.read())
