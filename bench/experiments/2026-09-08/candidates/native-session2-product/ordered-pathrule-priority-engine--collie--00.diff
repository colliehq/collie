+"""Compilation and matching of ordered path patterns."""
+
+from pathnorm import split_path
+from ruleerrors import PathTraversalError, PatternError
+
+SEPARATOR = "/"
+STAR = "*"
+DOUBLE_STAR = "**"
+ESCAPE = "\\"
+NUL = "\x00"
+CURRENT = "."
+PARENT = ".."
+
+# Token kinds for a parsed segment.
+_LITERAL = 0
+_STAR = 1
+
+
+def _parse_segment(segment):
+    """Return (tokens, has_star) for a raw segment, validating its syntax.
+
+    tokens is a list of (kind, text) where kind is _LITERAL or _STAR.
+    Raises PatternError for invalid escapes or adjacent stars.
+    """
+    if segment == DOUBLE_STAR:
+        return None, True
+    tokens = []
+    literal = []
+    previous_was_star = False
+    index = 0
+    length = len(segment)
+    while index < length:
+        char = segment[index]
+        if char == ESCAPE:
+            if index + 1 >= length:
+                raise PatternError(
+                    "dangling escape at end of segment %r" % (segment,))
+            nxt = segment[index + 1]
+            if nxt != STAR and nxt != ESCAPE:
+                raise PatternError(
+                    "invalid escape %r in segment %r" % ("\\" + nxt, segment))
+            literal.append(nxt)
+            previous_was_star = False
+            index += 2
+            continue
+        if char == STAR:
+            if previous_was_star:
+                raise PatternError(
+                    "adjacent '*' not allowed in segment %r" % (segment,))
+            if literal:
+                tokens.append((_LITERAL, "".join(literal)))
+                literal = []
+            tokens.append((_STAR, STAR))
+            previous_was_star = True
+            index += 1
+            continue
+        literal.append(char)
+        previous_was_star = False
+        index += 1
+    if literal:
+        tokens.append((_LITERAL, "".join(literal)))
+    has_star = any(kind == _STAR for kind, _ in tokens)
+    return tokens, has_star
+
+
+def _match_tokens(tokens, token_index, text, text_index):
+    if token_index == len(tokens):
+        return text_index == len(text)
+    kind, value = tokens[token_index]
+    if kind == _LITERAL:
+        end = text_index + len(value)
+        if text[text_index:end] != value:
+            return False
+        return _match_tokens(tokens, token_index + 1, text, end)
+    # star: try every split
+    for nxt in range(text_index, len(text) + 1):
+        if _match_tokens(tokens, token_index + 1, text, nxt):
+            return True
+    return False
+
+
+def _match_segment(compiled_segment, text):
+    tokens = compiled_segment
+    return _match_tokens(tokens, 0, text, 0)
+
+
+def _match_all(compiled, segments, pattern_index, path_index):
+    if pattern_index == len(compiled):
+        return path_index == len(segments)
+    current = compiled[pattern_index]
+    if current is None:  # '**'
+        for nxt in range(path_index, len(segments) + 1):
+            if _match_all(compiled, segments, pattern_index + 1, nxt):
+                return True
+        return False
+    if path_index >= len(segments):
+        return False
+    if not _match_segment(current, segments[path_index]):
+        return False
+    return _match_all(compiled, segments, pattern_index + 1, path_index + 1)
+
+
+class Pattern(object):
+    """A compiled, immutable pattern."""
+
+    __slots__ = ("_source", "_segments", "_specificity", "_compiled")
+
+    def __init__(self, source, segments, compiled, specificity):
+        object.__setattr__(self, "_source", source)
+        object.__setattr__(self, "_segments", tuple(segments))
+        object.__setattr__(self, "_compiled", tuple(compiled))
+        object.__setattr__(self, "_specificity", int(specificity))
+
+    @property
+    def source(self):
+        return self._source
+
+    @property
+    def segments(self):
+        return self._segments
+
+    @property
+    def specificity(self):
+        return self._specificity
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Pattern instances are immutable")
+
+    def match(self, path):
+        segments = split_path(path)
+        return bool(_match_all(self._compiled, segments, 0, 0))
+
+    def __repr__(self):
+        return "Pattern(%r)" % (self._source,)
+
+
+def compile_pattern(pattern):
+    """Compile pattern into a Pattern object."""
+    if not isinstance(pattern, str):
+        raise TypeError(
+            "pattern must be a str, got %r" % (type(pattern).__name__,))
+    if NUL in pattern:
+        raise PatternError("pattern must not contain a NUL character")
+    raw_segments = []
+    for raw in pattern.split(SEPARATOR):
+        if raw == "" or raw == CURRENT:
+            continue
+        if raw == PARENT:
+            raise PathTraversalError(
+                "pattern must not contain a '..' segment")
+        raw_segments.append(raw)
+    compiled = []
+    literal_count = 0
+    star_count = 0
+    deep_count = 0
+    for raw in raw_segments:
+        tokens, has_star = _parse_segment(raw)
+        if tokens is None:
+            deep_count += 1
+            compiled.append(None)
+            continue
+        if has_star:
+            star_count += 1
+        else:
+            literal_count += 1
+        compiled.append(tuple(tokens))
+    specificity = 100 * literal_count + 10 * star_count + deep_count
+    return Pattern(pattern, raw_segments, compiled, specificity)
