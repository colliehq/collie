diff --git a/ledger_report.py b/ledger_report.py
new file mode 100644
index 0000000..9bdaab5
--- /dev/null
+++ b/ledger_report.py
@@ -0,0 +1,30 @@
+"""Plain text rendering of a ledger's totals and reservations."""
+
+from ledger_core import CapacityLedger
+from ledger_errors import ValidationError
+
+
+def render_totals(ledger):
+    """Render one ``"{resource_id} {allocated}/{limit}"`` line per resource."""
+    _require_ledger(ledger)
+    limits = ledger.limits()
+    totals = ledger.totals()
+    return "\n".join(
+        "%s %d/%d" % (target, totals[target], limits[target])
+        for target in ledger.resource_ids())
+
+
+def render_reservations(ledger, include_released=False):
+    """Render one ``"{request_id} {resource_id} {units} {status}"`` line per record."""
+    _require_ledger(ledger)
+    if not isinstance(include_released, bool):
+        raise ValidationError("include_released must be a bool")
+    return "\n".join(
+        "%s %s %d %s" % (record["request_id"], record["resource_id"],
+                         record["units"], record["status"])
+        for record in ledger.list_reservations(include_released=include_released))
+
+
+def _require_ledger(ledger):
+    if not isinstance(ledger, CapacityLedger):
+        raise ValidationError("ledger must be a CapacityLedger")
