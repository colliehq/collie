+"""Compilation and matching of ordered path patterns."""
+
+import re
+
+from pathnorm import split_path
+from ruleerrors import PathTraversalError, PatternError
+
+__all__ = ["Pattern", "compile_pattern", "SEPARATOR", "STAR", "DOUBLE_STAR"]
+
+SEPARATOR = "/"
+CURRENT = "."
+PARENT = ".."
+STAR = "*"
+DOUBLE_STAR = "**"
+ESCAPE = "\\"
+NUL = "\x00"
+
+_DOUBLE = object()
+
+
+def _parse_segment(segment):
+    """Return ``(has_unescaped_star, regex_source)`` for a plain segment."""
+    parts = []
+    has_star = False
+    previous_was_star = False
+    index = 0
+    length = len(segment)
+    while index < length:
+        char = segment[index]
+        if char == ESCAPE:
+            if index + 1 >= length:
+                raise PatternError(
+                    "dangling escape at the end of segment %r" % (segment,)
+                )
+            nxt = segment[index + 1]
+            if nxt not in (STAR, ESCAPE):
+                raise PatternError(
+                    "invalid escape %r in segment %r" % (ESCAPE + nxt, segment)
+                )
+            parts.append(re.escape(nxt))
+            previous_was_star = False
+            index += 2
+            continue
+        if char == STAR:
+            if previous_was_star:
+                raise PatternError(
+                    "'**' is only valid as a whole segment: %r" % (segment,)
+                )
+            parts.append("[^/]*")
+            has_star = True
+            previous_was_star = True
+            index += 1
+            continue
+        parts.append(re.escape(char))
+        previous_was_star = False
+        index += 1
+    return has_star, "".join(parts)
+
+
+def _compile_segments(segments):
+    compiled = []
+    literal = 0
+    starred = 0
+    deep = 0
+    for segment in segments:
+        if segment == DOUBLE_STAR:
+            compiled.append(_DOUBLE)
+            deep += 1
+            continue
+        has_star, source = _parse_segment(segment)
+        compiled.append(re.compile(source, re.DOTALL))
+        if has_star:
+            starred += 1
+        else:
+            literal += 1
+    specificity = 100 * literal + 10 * starred + deep
+    return tuple(compiled), specificity
+
+
+def _match_from(compiled, segments, pattern_index, path_index):
+    total_patterns = len(compiled)
+    total_segments = len(segments)
+    while pattern_index < total_patterns:
+        item = compiled[pattern_index]
+        if item is _DOUBLE:
+            for nxt in range(path_index, total_segments + 1):
+                if _match_from(compiled, segments, pattern_index + 1, nxt):
+                    return True
+            return False
+        if path_index >= total_segments:
+            return False
+        if item.fullmatch(segments[path_index]) is None:
+            return False
+        pattern_index += 1
+        path_index += 1
+    return path_index == total_segments
+
+
+class Pattern(object):
+    """An immutable compiled path pattern."""
+
+    __slots__ = ("_source", "_segments", "_compiled", "_specificity")
+
+    def __init__(self, source, segments, compiled, specificity):
+        object.__setattr__(self, "_source", source)
+        object.__setattr__(self, "_segments", tuple(segments))
+        object.__setattr__(self, "_compiled", tuple(compiled))
+        object.__setattr__(self, "_specificity", int(specificity))
+
+    @property
+    def source(self):
+        return self._source
+
+    @property
+    def segments(self):
+        return self._segments
+
+    @property
+    def specificity(self):
+        return self._specificity
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Pattern objects are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Pattern objects are immutable")
+
+    def __repr__(self):
+        return "Pattern(%r)" % (self._source,)
+
+    def match(self, path):
+        """Return True when *path* matches this pattern."""
+        segments = split_path(path)
+        return bool(_match_from(self._compiled, segments, 0, 0))
+
+
+def compile_pattern(pattern):
+    """Compile *pattern* into a :class:`Pattern` object."""
+    if not isinstance(pattern, str):
+        raise TypeError(
+            "pattern must be a str, got %r" % (type(pattern).__name__,)
+        )
+    if NUL in pattern:
+        raise PatternError("pattern must not contain a NUL character")
+    raw_segments = []
+    for raw in pattern.split(SEPARATOR):
+        if raw == "" or raw == CURRENT:
+            continue
+        if raw == PARENT:
+            raise PathTraversalError("pattern must not contain a '..' segment")
+        raw_segments.append(raw)
+    compiled, specificity = _compile_segments(raw_segments)
+    return Pattern(pattern, tuple(raw_segments), compiled, specificity)
