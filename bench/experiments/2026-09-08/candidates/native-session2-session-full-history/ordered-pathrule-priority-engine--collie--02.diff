+"""Exception types shared by the path-rule engine."""
+
+__all__ = [
+    "RuleError",
+    "PathTraversalError",
+    "PatternError",
+    "RuleSyntaxError",
+]
+
+
+class RuleError(ValueError):
+    """Base class for every error raised by the engine."""
+
+
+class PathTraversalError(RuleError):
+    """Raised when a path or pattern contains a '..' segment."""
+
+
+class PatternError(RuleError):
+    """Raised when a pattern is syntactically invalid."""
+
+
+class RuleSyntaxError(RuleError):
+    """Raised for an unparsable rule line.
+
+    Constructed as ``RuleSyntaxError(message, line_number)``.
+    """
+
+    def __init__(self, message, line_number=None):
+        super().__init__(message)
+        self.message = message
+        self.line_number = None if line_number is None else int(line_number)
