+"""Parsing of the textual rule format into Rule objects."""
+
+from ruleengine import Rule
+from ruleerrors import RuleError, RuleSyntaxError
+
+__all__ = ["parse_rules", "load_rules", "COMMENT", "FIELD_SEPARATOR"]
+
+COMMENT = "#"
+FIELD_SEPARATOR = ":"
+STRIPPED = " \t"
+ACTIONS = ("include", "exclude")
+DIGITS = "0123456789"
+
+
+def _parse_priority(text, line_number):
+    if text == "":
+        return 0
+    body = text
+    if body[0] in "+-":
+        body = body[1:]
+    if body == "" or any(char not in DIGITS for char in body):
+        raise RuleSyntaxError("invalid priority %r" % (text,), line_number)
+    return int(text)
+
+
+def parse_rules(text):
+    """Parse rule *text* and return the rules, in file order, as a tuple."""
+    if not isinstance(text, str):
+        raise TypeError("text must be a str, got %r" % (type(text).__name__,))
+    rules = []
+    for line_number, line in enumerate(text.splitlines(), start=1):
+        stripped = line.strip(STRIPPED)
+        if stripped == "" or stripped.startswith(COMMENT):
+            continue
+        fields = stripped.split(FIELD_SEPARATOR, 3)
+        if len(fields) < 4:
+            raise RuleSyntaxError(
+                "expected 4 colon separated fields", line_number
+            )
+        action = fields[0].strip(STRIPPED)
+        priority_text = fields[1].strip(STRIPPED)
+        label_text = fields[2].strip(STRIPPED)
+        pattern = fields[3]
+        if action not in ACTIONS:
+            raise RuleSyntaxError("invalid action %r" % (action,), line_number)
+        priority = _parse_priority(priority_text, line_number)
+        label = label_text if label_text != "" else None
+        try:
+            rule = Rule(pattern, action, priority, label)
+        except RuleError as error:
+            raise RuleSyntaxError(
+                "invalid pattern %r: %s" % (pattern, error), line_number
+            ) from None
+        rules.append(rule)
+    return tuple(rules)
+
+
+def load_rules(path):
+    """Read UTF-8 rule text from *path* and return the parsed rules."""
+    if not isinstance(path, str):
+        raise TypeError("path must be a str, got %r" % (type(path).__name__,))
+    with open(path, "r", encoding="utf-8") as handle:
+        return parse_rules(handle.read())
