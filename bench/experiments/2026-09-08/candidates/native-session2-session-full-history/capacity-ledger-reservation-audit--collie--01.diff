+"""Registry of per-resource capacity limits."""
+
+from collections.abc import Mapping
+
+from ledger_errors import UnknownResourceError, ValidationError
+from ledger_ids import normalize_capacity, normalize_resource_id
+
+
+class CapacityTable:
+    """A map of resource id -> capacity limit."""
+
+    def __init__(self, limits=None):
+        built = {}
+        if limits is not None:
+            if not isinstance(limits, Mapping):
+                raise ValidationError("limits must be a mapping or None")
+            for key in limits:
+                resource_id = normalize_resource_id(key)
+                capacity = normalize_capacity(limits[key])
+                if resource_id in built:
+                    raise ValidationError(
+                        "duplicate resource id after normalization: %r"
+                        % (resource_id,))
+                built[resource_id] = capacity
+        self._limits = built
+
+    def set_limit(self, resource_id, capacity):
+        target = normalize_resource_id(resource_id)
+        amount = normalize_capacity(capacity)
+        self._limits[target] = amount
+        return None
+
+    def limit_of(self, resource_id):
+        target = normalize_resource_id(resource_id)
+        if target not in self._limits:
+            raise UnknownResourceError("unknown resource: %r" % (target,))
+        return self._limits[target]
+
+    def has(self, resource_id):
+        return normalize_resource_id(resource_id) in self._limits
+
+    def remove(self, resource_id):
+        target = normalize_resource_id(resource_id)
+        if target not in self._limits:
+            raise UnknownResourceError("unknown resource: %r" % (target,))
+        del self._limits[target]
+        return None
+
+    def resource_ids(self):
+        return tuple(sorted(self._limits))
+
+    def as_dict(self):
+        return dict(self._limits)
+
+    def __len__(self):
+        return len(self._limits)
