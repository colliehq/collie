+"""The capacity reservation ledger."""
+
+from collections.abc import Mapping
+
+from ledger_capacity import CapacityTable
+from ledger_errors import (
+    CapacityError,
+    ConflictError,
+    UnknownReservationError,
+    UnknownResourceError,
+    ValidationError,
+)
+from ledger_ids import (
+    normalize_capacity,
+    normalize_request_id,
+    normalize_resource_id,
+    normalize_units,
+)
+
+_ENTRY_KEYS = frozenset(("request_id", "resource_id", "units"))
+
+
+class CapacityLedger:
+    """Reservation ledger with snapshots and rollback."""
+
+    def __init__(self, clock, limits=None):
+        if not callable(clock):
+            raise ValidationError("clock must be callable")
+        self._table = CapacityTable(limits)
+        self._clock = clock
+        self._records = {}
+        self._snapshots = {}
+        self._snapshot_count = 0
+
+    # -- internal helpers -------------------------------------------------
+
+    def _tick(self):
+        value = self._clock()
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ValidationError("clock must return an int")
+        return int(value)
+
+    def _allocated(self, resource_id):
+        return sum(record["units"] for record in self._records.values()
+                   if record["resource_id"] == resource_id
+                   and record["status"] == "active")
+
+    @staticmethod
+    def _copy(record):
+        return dict(record)
+
+    def _require_resource(self, resource_id):
+        if not self._table.has(resource_id):
+            raise UnknownResourceError("unknown resource: %r" % (resource_id,))
+
+    def _require_record(self, key):
+        if key not in self._records:
+            raise UnknownReservationError("unknown request: %r" % (key,))
+        return self._records[key]
+
+    # -- writing ----------------------------------------------------------
+
+    def reserve(self, request_id, resource_id, units):
+        key = normalize_request_id(request_id)
+        target = normalize_resource_id(resource_id)
+        amount = normalize_units(units)
+
+        self._require_resource(target)
+
+        existing = self._records.get(key)
+        if existing is not None:
+            if (existing["status"] == "active"
+                    and existing["resource_id"] == target
+                    and existing["units"] == amount):
+                return self._copy(existing)
+            raise ConflictError("request already recorded: %r" % (key,))
+
+        if self._allocated(target) + amount > self._table.limit_of(target):
+            raise CapacityError("capacity exceeded for resource: %r" % (target,))
+
+        tick = self._tick()
+        record = {
+            "request_id": key,
+            "resource_id": target,
+            "units": amount,
+            "created_at": tick,
+            "updated_at": tick,
+            "status": "active",
+        }
+        self._records[key] = record
+        return self._copy(record)
+
+    def reserve_many(self, entries):
+        if not isinstance(entries, (list, tuple)):
+            raise ValidationError("entries must be a list or a tuple")
+
+        # phase 1: per element validation, in order.
+        normalized = []
+        for entry in entries:
+            if not isinstance(entry, Mapping):
+                raise ValidationError("each entry must be a mapping")
+            if set(entry.keys()) != set(_ENTRY_KEYS):
+                raise ValidationError("entry keys must be exactly %s"
+                                      % (sorted(_ENTRY_KEYS),))
+            key = normalize_request_id(entry["request_id"])
+            target = normalize_resource_id(entry["resource_id"])
+            amount = normalize_units(entry["units"])
+            normalized.append((key, target, amount))
+
+        # phase 2: duplicate request ids inside the batch.
+        seen = set()
+        for key, _target, _amount in normalized:
+            if key in seen:
+                raise ValidationError("duplicate request id in batch: %r" % (key,))
+            seen.add(key)
+
+        # phase 3: resource existence plus replay / conflict handling.
+        plans = []
+        for key, target, amount in normalized:
+            self._require_resource(target)
+            existing = self._records.get(key)
+            if existing is not None:
+                if (existing["status"] == "active"
+                        and existing["resource_id"] == target
+                        and existing["units"] == amount):
+                    plans.append((key, target, amount, True))
+                    continue
+                raise ConflictError("request already recorded: %r" % (key,))
+            plans.append((key, target, amount, False))
+
+        # phase 4: aggregated capacity check for the new reservations.
+        wanted = {}
+        for key, target, amount, is_replay in plans:
+            if not is_replay:
+                wanted[target] = wanted.get(target, 0) + amount
+        for target, amount in wanted.items():
+            if self._allocated(target) + amount > self._table.limit_of(target):
+                raise CapacityError("capacity exceeded for resource: %r" % (target,))
+
+        tick = None
+        if wanted:
+            tick = self._tick()
+
+        results = []
+        for key, target, amount, is_replay in plans:
+            if is_replay:
+                results.append(self._copy(self._records[key]))
+                continue
+            record = {
+                "request_id": key,
+                "resource_id": target,
+                "units": amount,
+                "created_at": tick,
+                "updated_at": tick,
+                "status": "active",
+            }
+            self._records[key] = record
+            results.append(self._copy(record))
+        return tuple(results)
+
+    def update(self, request_id, units):
+        key = normalize_request_id(request_id)
+        amount = normalize_units(units)
+
+        record = self._require_record(key)
+        if record["status"] != "active":
+            raise ConflictError("reservation already released: %r" % (key,))
+        if record["units"] == amount:
+            return self._copy(record)
+
+        target = record["resource_id"]
+        projected = self._allocated(target) - record["units"] + amount
+        if projected > self._table.limit_of(target):
+            raise CapacityError("capacity exceeded for resource: %r" % (target,))
+
+        tick = self._tick()
+        record["units"] = amount
+        record["updated_at"] = tick
+        return self._copy(record)
+
+    def release(self, request_id):
+        key = normalize_request_id(request_id)
+        record = self._require_record(key)
+        if record["status"] != "active":
+            raise ConflictError("reservation already released: %r" % (key,))
+        tick = self._tick()
+        record["status"] = "released"
+        record["updated_at"] = tick
+        return self._copy(record)
+
+    def set_limit(self, resource_id, capacity):
+        target = normalize_resource_id(resource_id)
+        amount = normalize_capacity(capacity)
+        if self._table.has(target) and amount < self._allocated(target):
+            raise CapacityError(
+                "new capacity below allocated amount for %r" % (target,))
+        self._table.set_limit(target, amount)
+        return None
+
+    def remove_resource(self, resource_id):
+        target = normalize_resource_id(resource_id)
+        if not self._table.has(target):
+            raise UnknownResourceError("unknown resource: %r" % (target,))
+        if self._allocated(target) != 0:
+            raise ConflictError("resource still has active reservations: %r"
+                                % (target,))
+        self._table.remove(target)
+        return None
+
+    # -- reading ----------------------------------------------------------
+
+    def get(self, request_id):
+        key = normalize_request_id(request_id)
+        return self._copy(self._require_record(key))
+
+    def has_request(self, request_id):
+        return normalize_request_id(request_id) in self._records
+
+    def allocated(self, resource_id):
+        target = normalize_resource_id(resource_id)
+        self._require_resource(target)
+        return self._allocated(target)
+
+    def available(self, resource_id):
+        target = normalize_resource_id(resource_id)
+        self._require_resource(target)
+        return self._table.limit_of(target) - self._allocated(target)
+
+    def totals(self):
+        return {resource_id: self._allocated(resource_id)
+                for resource_id in self._table.resource_ids()}
+
+    def limits(self):
+        return self._table.as_dict()
+
+    def resource_ids(self):
+        return self._table.resource_ids()
+
+    def request_ids(self):
+        return tuple(sorted(self._records))
+
+    def list_reservations(self, resource_id=None, include_released=False):
+        target = None
+        if resource_id is not None:
+            target = normalize_resource_id(resource_id)
+        if not isinstance(include_released, bool):
+            raise ValidationError("include_released must be a bool")
+        if target is not None:
+            self._require_resource(target)
+
+        selected = []
+        for record in self._records.values():
+            if target is not None and record["resource_id"] != target:
+                continue
+            if not include_released and record["status"] != "active":
+                continue
+            selected.append(record)
+        selected.sort(key=lambda item: (item["created_at"], item["request_id"]))
+        return tuple(self._copy(record) for record in selected)
+
+    # -- snapshots --------------------------------------------------------
+
+    def snapshot(self):
+        self._snapshot_count += 1
+        token = self._snapshot_count
+        self._snapshots[token] = (
+            {key: dict(record) for key, record in self._records.items()},
+            self._table.as_dict(),
+        )
+        return token
+
+    def rollback(self, token):
+        if isinstance(token, bool) or not isinstance(token, int):
+            raise ValidationError("token must be an int")
+        if not 1 <= token <= self._snapshot_count:
+            raise ValidationError("unknown snapshot token: %r" % (token,))
+        records, limits = self._snapshots[token]
+        self._records = {key: dict(record) for key, record in records.items()}
+        self._table = CapacityTable(limits)
+        return None
