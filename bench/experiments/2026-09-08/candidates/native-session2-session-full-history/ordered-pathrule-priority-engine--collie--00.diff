+"""Ordered include/exclude rule evaluation with explanation metadata."""
+
+from pathnorm import normalize_path
+from patternmatch import compile_pattern
+
+INCLUDE = "include"
+EXCLUDE = "exclude"
+ACTIONS = (INCLUDE, EXCLUDE)
+
+
+def _check_action(action):
+    if not isinstance(action, str):
+        raise TypeError(
+            "action must be a str, not %r" % (type(action).__name__,))
+    if action not in ACTIONS:
+        raise ValueError(
+            "action must be 'include' or 'exclude', not %r" % (action,))
+    return action
+
+
+def _coerce_rules(rules):
+    """Validate an iterable of rules and return it as a list."""
+    if isinstance(rules, (str, bytes, bytearray)):
+        raise TypeError("rules must be an iterable of Rule, not a string")
+    try:
+        iterator = iter(rules)
+    except TypeError:
+        raise TypeError("rules must be an iterable of Rule")
+    collected = []
+    for item in iterator:
+        if not isinstance(item, Rule):
+            raise TypeError(
+                "rules must contain Rule instances, got %r"
+                % (type(item).__name__,))
+        collected.append(item)
+    return collected
+
+
+class Rule(object):
+    """An immutable include/exclude rule."""
+
+    __slots__ = ("_pattern", "_action", "_priority", "_label", "_compiled")
+
+    def __init__(self, pattern, action, priority=0, label=None):
+        compiled = compile_pattern(pattern)
+        _check_action(action)
+        if isinstance(priority, bool) or not isinstance(priority, int):
+            raise TypeError(
+                "priority must be an int, not %r" % (type(priority).__name__,))
+        if label is not None and not isinstance(label, str):
+            raise TypeError(
+                "label must be None or a str, not %r"
+                % (type(label).__name__,))
+        object.__setattr__(self, "_pattern", pattern)
+        object.__setattr__(self, "_action", action)
+        object.__setattr__(self, "_priority", priority)
+        object.__setattr__(self, "_label", label)
+        object.__setattr__(self, "_compiled", compiled)
+
+    @property
+    def pattern(self):
+        return self._pattern
+
+    @property
+    def action(self):
+        return self._action
+
+    @property
+    def priority(self):
+        return self._priority
+
+    @property
+    def label(self):
+        return self._label
+
+    @property
+    def compiled(self):
+        return self._compiled
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Rule instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Rule instances are immutable")
+
+    def __repr__(self):
+        return "Rule(%r, %r, %r, %r)" % (
+            self._pattern, self._action, self._priority, self._label)
+
+    def matches(self, path):
+        """Return True when path matches this rule's pattern."""
+        return self._compiled.match(path)
+
+
+class RuleSet(object):
+    """An ordered collection of rules with a default action."""
+
+    def __init__(self, rules=(), default_action=EXCLUDE):
+        _check_action(default_action)
+        self._default_action = default_action
+        self._rules = _coerce_rules(rules)
+
+    @property
+    def default_action(self):
+        return self._default_action
+
+    @property
+    def rules(self):
+        return tuple(self._rules)
+
+    def __len__(self):
+        return len(self._rules)
+
+    def add(self, rule):
+        """Append rule and return this RuleSet."""
+        if not isinstance(rule, Rule):
+            raise TypeError(
+                "rule must be a Rule instance, not %r" % (type(rule).__name__,))
+        self._rules.append(rule)
+        return self
+
+    def extend(self, rules):
+        """Append every rule atomically and return this RuleSet."""
+        collected = _coerce_rules(rules)
+        self._rules.extend(collected)
+        return self
+
+    def explain(self, path):
+        """Return a fresh dict describing the decision for path."""
+        normalized = normalize_path(path)
+        matched = []
+        winner_index = None
+        for index, rule in enumerate(self._rules):
+            if rule.compiled.match(normalized):
+                matched.append(index)
+                if (winner_index is None
+                        or rule.priority >= self._rules[winner_index].priority):
+                    winner_index = index
+        if winner_index is None:
+            action = self._default_action
+            return {
+                "path": normalized,
+                "allowed": bool(action == INCLUDE),
+                "action": action,
+                "rule_index": None,
+                "label": None,
+                "pattern": None,
+                "priority": None,
+                "specificity": None,
+                "matched": (),
+                "default_used": True,
+            }
+        winner = self._rules[winner_index]
+        return {
+            "path": normalized,
+            "allowed": bool(winner.action == INCLUDE),
+            "action": winner.action,
+            "rule_index": winner_index,
+            "label": winner.label,
+            "pattern": winner.pattern,
+            "priority": winner.priority,
+            "specificity": winner.compiled.specificity,
+            "matched": tuple(matched),
+            "default_used": False,
+        }
+
+    def allows(self, path):
+        """Return True when path is allowed."""
+        return bool(self.explain(path)["allowed"])
+
+    def filter(self, paths):
+        """Return the normalised allowed paths, deduplicated, in order."""
+        if isinstance(paths, (str, bytes, bytearray)):
+            raise TypeError("paths must be an iterable of str, not a string")
+        try:
+            iterator = iter(paths)
+        except TypeError:
+            raise TypeError("paths must be an iterable of str")
+        seen = set()
+        kept = []
+        for item in iterator:
+            normalized = normalize_path(item)
+            if normalized in seen:
+                continue
+            seen.add(normalized)
+            if self.allows(normalized):
+                kept.append(normalized)
+        return tuple(kept)
+
+
+class DecisionLog(object):
+    """A record of rule decisions stamped with a clock value."""
+
+    def __init__(self, clock):
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._entries = []
+
+    def __len__(self):
+        return len(self._entries)
+
+    def record(self, ruleset, path):
+        """Record the decision of ruleset for path and return a copy of it."""
+        if not isinstance(ruleset, RuleSet):
+            raise TypeError(
+                "ruleset must be a RuleSet instance, not %r"
+                % (type(ruleset).__name__,))
+        explanation = ruleset.explain(path)
+        explanation["at"] = self._clock()
+        self._entries.append(explanation)
+        return dict(explanation)
+
+    def entries(self):
+        """Return a tuple of fresh copies of the recorded entries."""
+        return tuple(dict(entry) for entry in self._entries)
+
+    def summary(self):
+        """Return the include/exclude/total counts of the log."""
+        counts = {INCLUDE: 0, EXCLUDE: 0, "total": 0}
+        for entry in self._entries:
+            action = entry["action"]
+            if action in counts:
+                counts[action] += 1
+            counts["total"] += 1
+        return counts
