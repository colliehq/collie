+"""Normalisation of slash separated logical paths."""
+
+from ruleerrors import PathTraversalError, RuleError
+
+SEPARATOR = "/"
+NUL = "\x00"
+CURRENT = "."
+PARENT = ".."
+
+
+def split_path(path):
+    """Return the normalised segments of path as a tuple of str."""
+    if not isinstance(path, str):
+        raise TypeError("path must be a str, not %r" % (type(path).__name__,))
+    if NUL in path:
+        raise RuleError("path must not contain a NUL character")
+    segments = []
+    for raw in path.split(SEPARATOR):
+        if raw == "" or raw == CURRENT:
+            continue
+        if raw == PARENT:
+            raise PathTraversalError("path must not contain a '..' segment")
+        segments.append(raw)
+    return tuple(segments)
+
+
+def normalize_path(path):
+    """Return the canonical string form of path."""
+    return SEPARATOR.join(split_path(path))
