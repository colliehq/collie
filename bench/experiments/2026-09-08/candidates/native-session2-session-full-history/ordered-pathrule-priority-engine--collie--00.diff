+"""Compilation and matching of ordered path patterns."""
+
+from pathnorm import SEPARATOR, split_path
+from ruleerrors import PathTraversalError, PatternError
+
+STAR = "*"
+DOUBLE_STAR = "**"
+ESCAPE = "\\"
+NUL = "\x00"
+CURRENT = "."
+PARENT = ".."
+
+_LITERAL = 0
+_STAR = 1
+
+
+def _parse_segment(segment):
+    """Return the token list of one raw segment.
+
+    Tokens are ``(_LITERAL, character)`` or ``(_STAR, None)``.
+    """
+    tokens = []
+    index = 0
+    length = len(segment)
+    while index < length:
+        char = segment[index]
+        if char == ESCAPE:
+            if index + 1 >= length:
+                raise PatternError(
+                    "dangling escape at end of segment %r" % (segment,))
+            following = segment[index + 1]
+            if following not in (STAR, ESCAPE):
+                raise PatternError(
+                    "invalid escape %r in segment %r"
+                    % (ESCAPE + following, segment))
+            tokens.append((_LITERAL, following))
+            index += 2
+            continue
+        if char == STAR:
+            tokens.append((_STAR, None))
+            index += 1
+            continue
+        tokens.append((_LITERAL, char))
+        index += 1
+    return tokens
+
+
+def _compile_segment(segment):
+    """Return ``None`` for a ``**`` segment or the token list otherwise."""
+    tokens = _parse_segment(segment)
+    if len(tokens) == 2 and tokens[0][0] == _STAR and tokens[1][0] == _STAR:
+        return None
+    previous_star = False
+    for kind, _ in tokens:
+        if kind == _STAR:
+            if previous_star:
+                raise PatternError(
+                    "consecutive '*' are only allowed as a whole '**' segment,"
+                    " got %r" % (segment,))
+            previous_star = True
+        else:
+            previous_star = False
+    return tokens
+
+
+def _match_tokens(tokens, text, token_index, text_index):
+    while True:
+        if token_index == len(tokens):
+            return text_index == len(text)
+        kind, value = tokens[token_index]
+        if kind == _STAR:
+            token_index += 1
+            if token_index == len(tokens):
+                return True
+            for nxt in range(text_index, len(text) + 1):
+                if _match_tokens(tokens, text, token_index, nxt):
+                    return True
+            return False
+        if text_index >= len(text) or text[text_index] != value:
+            return False
+        token_index += 1
+        text_index += 1
+
+
+def _match_segment(tokens, text):
+    return _match_tokens(tokens, text, 0, 0)
+
+
+def _match_all(compiled, segments, pattern_index, path_index):
+    if pattern_index == len(compiled):
+        return path_index == len(segments)
+    current = compiled[pattern_index]
+    if current is None:
+        for nxt in range(path_index, len(segments) + 1):
+            if _match_all(compiled, segments, pattern_index + 1, nxt):
+                return True
+        return False
+    if path_index >= len(segments):
+        return False
+    if not _match_segment(current, segments[path_index]):
+        return False
+    return _match_all(compiled, segments, pattern_index + 1, path_index + 1)
+
+
+class Pattern(object):
+    """An immutable compiled pattern."""
+
+    __slots__ = ("_source", "_segments", "_compiled", "_specificity")
+
+    def __init__(self, source, segments, compiled):
+        literal = 0
+        starred = 0
+        deep = 0
+        for tokens in compiled:
+            if tokens is None:
+                deep += 1
+            elif any(kind == _STAR for kind, _ in tokens):
+                starred += 1
+            else:
+                literal += 1
+        object.__setattr__(self, "_source", source)
+        object.__setattr__(self, "_segments", tuple(segments))
+        object.__setattr__(self, "_compiled", tuple(compiled))
+        object.__setattr__(
+            self, "_specificity", 100 * literal + 10 * starred + deep)
+
+    @property
+    def source(self):
+        return self._source
+
+    @property
+    def segments(self):
+        return self._segments
+
+    @property
+    def specificity(self):
+        return self._specificity
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __repr__(self):
+        return "Pattern(%r)" % (self._source,)
+
+    def match(self, path):
+        """Return True when path matches this pattern."""
+        segments = split_path(path)
+        return bool(_match_all(self._compiled, segments, 0, 0))
+
+
+def compile_pattern(pattern):
+    """Compile pattern into a Pattern."""
+    if not isinstance(pattern, str):
+        raise TypeError(
+            "pattern must be a str, not %r" % (type(pattern).__name__,))
+    if NUL in pattern:
+        raise PatternError("pattern must not contain a NUL character")
+    raw_segments = []
+    for raw in pattern.split(SEPARATOR):
+        if raw == "" or raw == CURRENT:
+            continue
+        if raw == PARENT:
+            raise PathTraversalError(
+                "pattern must not contain a '..' segment")
+        raw_segments.append(raw)
+    compiled = [_compile_segment(raw) for raw in raw_segments]
+    return Pattern(pattern, raw_segments, compiled)
