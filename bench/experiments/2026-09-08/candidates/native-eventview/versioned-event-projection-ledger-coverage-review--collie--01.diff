+"""Event construction, validation and canonicalisation.
+
+An *event* is a plain ``dict`` with exactly the four keys ``seq``,
+``entity_id``, ``op`` and ``payload``.
+"""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+OPS = ("create", "update", "delete")
+
+MIN_SEQ = 1
+MAX_SEQ = 1_000_000_000
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_KEY_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+
+def validate_seq(seq):
+    """Return ``seq`` if it is a valid sequence number."""
+    if isinstance(seq, bool) or not isinstance(seq, int):
+        raise ValidationError("seq must be a non-bool int")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError("seq out of range")
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Return ``entity_id`` if it is a valid entity identifier."""
+    if not isinstance(entity_id, str) or isinstance(entity_id, bool):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.fullmatch(entity_id) is None:
+        raise ValidationError("entity_id has an invalid form")
+    return entity_id
+
+
+def validate_op(op):
+    """Return ``op`` if it is one of the supported operations."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("op must be create, update or delete")
+    return op
+
+
+def _validate_scalar(value):
+    if value is None:
+        return value
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, int):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValidationError("float values must be finite")
+        return value
+    if isinstance(value, str):
+        if len(value) > MAX_STR_LEN:
+            raise ValidationError("str values must be at most 200 chars")
+        return value
+    raise ValidationError("unsupported scalar value")
+
+
+def _copy_value(value):
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list values may hold at most 32 items")
+        return [_validate_scalar(item) for item in value]
+    return _validate_scalar(value)
+
+
+def validate_payload(payload, op=None):
+    """Validate ``payload`` and return an independent copy of it."""
+    if payload is None:
+        payload = {}
+    elif not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and payload:
+        raise ValidationError("delete events must not carry a payload")
+    result = {}
+    for key, value in payload.items():
+        if not isinstance(key, str) or isinstance(key, bool):
+            raise ValidationError("payload keys must be str")
+        if _FIELD_KEY_RE.fullmatch(key) is None:
+            raise ValidationError("payload key has an invalid form")
+        result[key] = _copy_value(value)
+    return result
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a brand new validated event dict."""
+    validate_seq(seq)
+    validate_entity_id(entity_id)
+    validate_op(op)
+    fields = validate_payload(payload, op)
+    return {
+        "seq": seq,
+        "entity_id": entity_id,
+        "op": op,
+        "payload": fields,
+    }
+
+
+def normalize_event(event):
+    """Validate ``event`` and return an isolated normalized copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event.keys()) != set(EVENT_KEYS):
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(
+        event["seq"],
+        event["entity_id"],
+        event["op"],
+        event["payload"],
+    )
+
+
+def canonical_form(event):
+    """Return a deterministic JSON rendering of ``event``."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
+
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
