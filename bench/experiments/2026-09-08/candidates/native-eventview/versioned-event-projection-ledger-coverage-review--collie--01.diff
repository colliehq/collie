+"""Deterministic JSON persistence for projections."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (MAX_SEQ, normalize_event, validate_entity_id,
+                     validate_payload)
+from .projection import Projection, RECORD_KEYS, _copy_fields
+
+FORMAT = "eventview/1"
+
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or isinstance(path, bool) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path``; return the number of bytes written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection")
+    _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def load(path, clock=None):
+    """Read a projection previously written by :func:`dump`."""
+    _validate_path(path)
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %s" % path)
+    with open(path, "rb") as handle:
+        raw = handle.read()
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ValidationError("file is not valid UTF-8") from exc
+    try:
+        doc = json.loads(text)
+    except ValueError as exc:
+        raise ValidationError("file is not valid JSON") from exc
+
+    if not isinstance(doc, dict):
+        raise ValidationError("document must be a dict")
+    if set(doc.keys()) != set(DOC_KEYS):
+        raise ValidationError("document has unexpected keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported document format")
+
+    next_seq = doc["next_seq"]
+    if not _is_int(next_seq) or next_seq < 1 or next_seq > MAX_SEQ + 1:
+        raise ValidationError("next_seq out of range")
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("last_updated_at must be None or int >= 0")
+
+    records = doc["records"]
+    events = doc["events"]
+    if not isinstance(records, list) or not isinstance(events, list):
+        raise ValidationError("records and events must be lists")
+
+    log = {}
+    expected = 1
+    for raw_event in events:
+        event = normalize_event(raw_event)
+        if event["seq"] != expected:
+            raise ValidationError("events must be seq 1..next_seq-1")
+        log[event["seq"]] = event
+        expected += 1
+    if expected != next_seq:
+        raise ValidationError("events must cover 1..next_seq-1")
+
+    stored = {}
+    for raw_record in records:
+        if not isinstance(raw_record, dict):
+            raise ValidationError("record must be a dict")
+        if set(raw_record.keys()) != set(RECORD_KEYS):
+            raise ValidationError("record has unexpected keys")
+        entity_id = validate_entity_id(raw_record["entity_id"])
+        version = raw_record["version"]
+        if not _is_int(version) or version < 1:
+            raise ValidationError("version must be an int >= 1")
+        seq = raw_record["seq"]
+        if not _is_int(seq) or seq < 1 or seq >= next_seq:
+            raise ValidationError("record seq out of range")
+        updated_at = raw_record["updated_at"]
+        if not _is_int(updated_at) or updated_at < 0:
+            raise ValidationError("updated_at must be an int >= 0")
+        deleted = raw_record["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("deleted must be a bool")
+        raw_fields = raw_record["fields"]
+        if not isinstance(raw_fields, dict):
+            raise ValidationError("fields must be a dict")
+        fields = validate_payload(raw_fields)
+        if deleted and fields:
+            raise ValidationError("tombstoned records must have no fields")
+        if entity_id in stored:
+            raise ValidationError("duplicate record entity_id")
+        stored[entity_id] = {
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": _copy_fields(fields),
+        }
+
+    projection = Projection(clock=clock)
+    projection._records = stored
+    projection._log = log
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
+
+
+__all__ = ["dump", "load"]
