+"""Deterministic JSON persistence for projections."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import normalize_event, validate_entity_id, validate_payload
+from .projection import RECORD_KEYS, Projection
+
+FORMAT = "eventview/1"
+
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+
+MAX_LOADED_NEXT_SEQ = 1000000001
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or path == "":
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _build_doc(projection):
+    stats = projection.stats()
+    return {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path`` as deterministic JSON."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection")
+    _validate_path(path)
+    doc = _build_doc(projection)
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_events(raw_events, next_seq):
+    events = {}
+    expected = 1
+    for entry in raw_events:
+        event = normalize_event(entry)
+        if event["seq"] != expected:
+            raise ValidationError("events must be 1..next_seq-1 in order")
+        events[event["seq"]] = event
+        expected += 1
+    if expected != next_seq:
+        raise ValidationError("events do not cover 1..next_seq-1")
+    return events
+
+
+def _load_records(raw_records, next_seq):
+    records = {}
+    for entry in raw_records:
+        if not isinstance(entry, dict):
+            raise ValidationError("record must be a dict")
+        if set(entry.keys()) != set(RECORD_KEYS):
+            raise ValidationError("record must have exactly the record keys")
+        entity_id = validate_entity_id(entry["entity_id"])
+        version = entry["version"]
+        if not _is_int(version) or version < 1:
+            raise ValidationError("bad record version")
+        seq = entry["seq"]
+        if not _is_int(seq) or seq < 1 or seq >= next_seq:
+            raise ValidationError("bad record seq")
+        updated_at = entry["updated_at"]
+        if not _is_int(updated_at) or updated_at < 0:
+            raise ValidationError("bad record updated_at")
+        deleted = entry["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("bad record deleted flag")
+        raw_fields = entry["fields"]
+        if not isinstance(raw_fields, dict):
+            raise ValidationError("record fields must be a dict")
+        fields = validate_payload(raw_fields)
+        if deleted and fields:
+            raise ValidationError("tombstoned record must have empty fields")
+        if entity_id in records:
+            raise ValidationError("duplicate record entity_id")
+        records[entity_id] = {
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": fields,
+        }
+    return records
+
+
+def load(path, clock=None):
+    """Read a projection previously written by :func:`dump`."""
+    _validate_path(path)
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file")
+    try:
+        with open(path, "rb") as handle:
+            raw = handle.read()
+    except OSError as exc:
+        raise NotFoundError("cannot read file") from exc
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ValidationError("file is not valid UTF-8") from exc
+    try:
+        doc = json.loads(text)
+    except ValueError as exc:
+        raise ValidationError("file is not valid JSON") from exc
+
+    if not isinstance(doc, dict):
+        raise ValidationError("document must be a dict")
+    if set(doc.keys()) != set(DOC_KEYS):
+        raise ValidationError("document must have exactly the document keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format")
+    next_seq = doc["next_seq"]
+    if not _is_int(next_seq) or next_seq < 1 or next_seq > MAX_LOADED_NEXT_SEQ:
+        raise ValidationError("bad next_seq")
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("bad last_updated_at")
+    raw_records = doc["records"]
+    raw_events = doc["events"]
+    if not isinstance(raw_records, list) or not isinstance(raw_events, list):
+        raise ValidationError("records and events must be lists")
+
+    events = _load_events(raw_events, next_seq)
+    records = _load_records(raw_records, next_seq)
+
+    projection = Projection(clock=clock)
+    projection._records = records
+    projection._log = events
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
+
+
+__all__ = ["dump", "load"]
