+"""Deterministic JSON persistence for projections."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (normalize_event, validate_entity_id, validate_payload)
+from .projection import Projection, RECORD_KEYS
+
+__all__ = ["dump", "load", "FORMAT"]
+
+FORMAT = "eventview/1"
+
+MAX_NEXT_SEQ = 1_000_000_001
+
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records", "events"))
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or isinstance(path, bool) or path == "":
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def _plain_int(value, minimum, maximum=None):
+    if isinstance(value, bool) or not isinstance(value, int):
+        return False
+    if value < minimum:
+        return False
+    if maximum is not None and value > maximum:
+        return False
+    return True
+
+
+def dump(projection, path):
+    """Write the projection to *path*; return the number of bytes written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection instance")
+    path = _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def load(path, clock=None):
+    """Read a projection previously written by :func:`dump`."""
+    path = _validate_path(path)
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %s" % path)
+
+    with open(path, "rb") as handle:
+        raw = handle.read()
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ValidationError("file is not valid UTF-8") from exc
+    try:
+        doc = json.loads(text)
+    except ValueError as exc:
+        raise ValidationError("file is not valid JSON") from exc
+
+    if not isinstance(doc, dict):
+        raise ValidationError("document must be a JSON object")
+    if frozenset(doc.keys()) != DOC_KEYS:
+        raise ValidationError("document has unexpected keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format")
+
+    next_seq = doc["next_seq"]
+    if not _plain_int(next_seq, 1, MAX_NEXT_SEQ):
+        raise ValidationError("next_seq out of range")
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None and not _plain_int(last_updated_at, 0):
+        raise ValidationError("last_updated_at must be null or a non-negative int")
+
+    records = doc["records"]
+    events = doc["events"]
+    if not isinstance(records, list) or not isinstance(events, list):
+        raise ValidationError("records and events must be lists")
+
+    log = {}
+    expected = 1
+    for raw_event in events:
+        event = normalize_event(raw_event)
+        if event["seq"] != expected:
+            raise ValidationError("events must be seq 1..next_seq-1 in order")
+        log[event["seq"]] = event
+        expected += 1
+    if expected != next_seq:
+        raise ValidationError("event log does not reach next_seq")
+
+    store = {}
+    for raw_record in records:
+        if not isinstance(raw_record, dict):
+            raise ValidationError("records must be dicts")
+        if frozenset(raw_record.keys()) != RECORD_KEYS:
+            raise ValidationError("record has unexpected keys")
+        entity_id = validate_entity_id(raw_record["entity_id"])
+        if entity_id in store:
+            raise ValidationError("duplicate record entity_id")
+        if not _plain_int(raw_record["version"], 1):
+            raise ValidationError("record version must be an int >= 1")
+        if not _plain_int(raw_record["seq"], 1, next_seq - 1):
+            raise ValidationError("record seq out of range")
+        if not _plain_int(raw_record["updated_at"], 0):
+            raise ValidationError("record updated_at must be an int >= 0")
+        deleted = raw_record["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("record deleted must be a bool")
+        raw_fields = raw_record["fields"]
+        if not isinstance(raw_fields, dict):
+            raise ValidationError("record fields must be a dict")
+        fields = validate_payload(raw_fields)
+        if deleted and fields:
+            raise ValidationError("tombstoned record must have empty fields")
+        store[entity_id] = {
+            "entity_id": entity_id,
+            "version": raw_record["version"],
+            "seq": raw_record["seq"],
+            "updated_at": raw_record["updated_at"],
+            "deleted": deleted,
+            "fields": fields,
+        }
+
+    projection = Projection(clock=clock)
+    projection._records = store
+    projection._log = log
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
