+"""In-memory projection of a versioned event stream."""
+
+import copy
+
+from .errors import ConflictError, NotFoundError, SequenceError, ValidationError
+from .events import canonical_form, normalize_event, validate_entity_id
+
+__all__ = ["Projection"]
+
+RECORD_KEYS = frozenset(
+    ("entity_id", "version", "seq", "updated_at", "deleted", "fields")
+)
+
+
+def _default_clock():
+    return 0
+
+
+def _copy_fields(fields):
+    out = {}
+    for key, value in fields.items():
+        out[key] = list(value) if isinstance(value, list) else value
+    return out
+
+
+def _copy_record(record):
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": _copy_fields(record["fields"]),
+    }
+
+
+def _validate_clock(clock):
+    if clock is None:
+        return _default_clock
+    if not callable(clock):
+        raise ValidationError("clock must be None or a callable")
+    return clock
+
+
+class Projection:
+    """Projects create/update/delete events into entity records."""
+
+    def __init__(self, clock=None):
+        self._clock = _validate_clock(clock)
+        self._records = {}
+        self._log = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internals ---------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if isinstance(now, bool) or not isinstance(now, int):
+            raise ValidationError("clock must return a non-bool int")
+        if now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        return (
+            {key: _copy_record(rec) for key, rec in self._records.items()},
+            {seq: copy.deepcopy(ev) for seq, ev in self._log.items()},
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        records, log, next_seq, last_updated_at = state
+        self._records = records
+        self._log = log
+        self._next_seq = next_seq
+        self._last_updated_at = last_updated_at
+
+    @staticmethod
+    def _check_flag(value):
+        if not isinstance(value, bool):
+            raise ValidationError("include_deleted must be a bool")
+        return value
+
+    # -- public API --------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; return True if state changed, False on replay."""
+        ev = normalize_event(event)
+        seq = ev["seq"]
+
+        if seq > self._next_seq:
+            raise SequenceError("sequence hole: expected %d" % self._next_seq)
+        if seq < self._next_seq:
+            previous = self._log.get(seq)
+            if previous is not None and canonical_form(previous) == canonical_form(ev):
+                return False
+            raise ConflictError("event %d conflicts with the applied history" % seq)
+
+        entity_id = ev["entity_id"]
+        op = ev["op"]
+        cur = self._records.get(entity_id)
+        if op == "create":
+            if cur is not None:
+                raise ConflictError("entity already exists")
+        elif op == "update":
+            if cur is None:
+                raise NotFoundError("unknown entity")
+            if cur["deleted"]:
+                raise ConflictError("entity is tombstoned")
+        else:  # delete
+            if cur is None:
+                raise NotFoundError("unknown entity")
+            if cur["deleted"]:
+                raise ConflictError("entity is already tombstoned")
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": _copy_fields(ev["payload"]),
+            }
+            self._records[entity_id] = record
+        elif op == "update":
+            fields = _copy_fields(cur["fields"])
+            for key, value in ev["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                else:
+                    fields[key] = list(value) if isinstance(value, list) else value
+            record = {
+                "entity_id": entity_id,
+                "version": cur["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": fields,
+            }
+            self._records[entity_id] = record
+        else:
+            record = {
+                "entity_id": entity_id,
+                "version": cur["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": True,
+                "fields": {},
+            }
+            self._records[entity_id] = record
+
+        self._log[seq] = ev
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    def apply_batch(self, events):
+        """Apply several events atomically; return the number applied."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or a tuple")
+        state = self._capture()
+        applied = 0
+        try:
+            for event in events:
+                if self.apply_event(event):
+                    applied += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return applied
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        entity_id = validate_entity_id(entity_id)
+        include_deleted = self._check_flag(include_deleted)
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity")
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity is tombstoned")
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return deep copies of all records sorted by entity_id."""
+        include_deleted = self._check_flag(include_deleted)
+        out = []
+        for entity_id in sorted(self._records):
+            record = self._records[entity_id]
+            if record["deleted"] and not include_deleted:
+                continue
+            out.append(_copy_record(record))
+        return out
+
+    def applied_events(self):
+        """Return deep copies of the state-changing events, sorted by seq."""
+        return [copy.deepcopy(self._log[seq]) for seq in sorted(self._log)]
+
+    def stats(self):
+        """Return summary counters for the projection."""
+        deleted = sum(1 for rec in self._records.values() if rec["deleted"])
+        return {
+            "live": len(self._records) - deleted,
+            "deleted": deleted,
+            "applied": len(self._log),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
