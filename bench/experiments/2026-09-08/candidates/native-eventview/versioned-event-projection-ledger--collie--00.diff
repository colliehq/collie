+"""Exception hierarchy for the eventview package."""
+
+__all__ = [
+    "EventViewError",
+    "ValidationError",
+    "SequenceError",
+    "ConflictError",
+    "NotFoundError",
+]
+
+
+class EventViewError(Exception):
+    """Base class for every error raised by this package."""
+
+
+class ValidationError(EventViewError):
+    """Raised when input does not satisfy the specification."""
+
+
+class SequenceError(EventViewError):
+    """Raised when an event would leave a hole in the sequence."""
+
+
+class ConflictError(EventViewError):
+    """Raised when an event conflicts with the current state or history."""
+
+
+class NotFoundError(EventViewError):
+    """Raised when a referenced entity or file does not exist."""
