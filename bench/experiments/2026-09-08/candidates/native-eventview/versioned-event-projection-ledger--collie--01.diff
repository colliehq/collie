+"""Event construction, validation and canonical serialisation.
+
+An *event* is a plain :class:`dict` with exactly the four keys ``seq``,
+``entity_id``, ``op`` and ``payload``.
+"""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+OPS = ("create", "update", "delete")
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_NAME_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+
+def _is_int(value):
+    """True for a real int that is not a bool."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate_seq(seq):
+    if not _is_int(seq):
+        raise ValidationError("seq must be a non-boolean int")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError("seq out of range: %r" % (seq,))
+    return seq
+
+
+def validate_entity_id(entity_id):
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.match(entity_id) is None:
+        raise ValidationError("bad entity_id: %r" % (entity_id,))
+    return entity_id
+
+
+def validate_op(op):
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("bad op: %r" % (op,))
+    return op
+
+
+def _validate_scalar(value):
+    if value is None:
+        return
+    if isinstance(value, bool):
+        return
+    if isinstance(value, int):
+        return
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValidationError("non-finite float is not a valid scalar")
+        return
+    if isinstance(value, str):
+        if len(value) > MAX_STR_LEN:
+            raise ValidationError("str value too long")
+        return
+    raise ValidationError("unsupported scalar value: %r" % (type(value),))
+
+
+def _copy_value(value):
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list value has too many elements")
+        for item in value:
+            _validate_scalar(item)
+        return list(value)
+    _validate_scalar(value)
+    return value
+
+
+def validate_payload(payload, op=None):
+    """Validate ``payload`` and return an isolated deep copy of it."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and payload:
+        raise ValidationError("delete events must not carry a payload")
+    result = {}
+    for key, value in payload.items():
+        if not isinstance(key, str):
+            raise ValidationError("payload keys must be str")
+        if _FIELD_NAME_RE.match(key) is None:
+            raise ValidationError("bad payload key: %r" % (key,))
+        result[key] = _copy_value(value)
+    return result
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a validated, fully isolated event dict."""
+    validate_seq(seq)
+    validate_entity_id(entity_id)
+    validate_op(op)
+    fields = validate_payload(payload, op)
+    return {
+        "seq": seq,
+        "entity_id": entity_id,
+        "op": op,
+        "payload": fields,
+    }
+
+
+def normalize_event(event):
+    """Validate an existing event mapping and return an isolated copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event.keys()) != EVENT_KEYS:
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(
+        event["seq"],
+        event["entity_id"],
+        event["op"],
+        event["payload"],
+    )
+
+
+def canonical_form(event):
+    """Return a deterministic JSON string for ``event``."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
+
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
