+"""Deterministic JSON persistence for :class:`~eventview.projection.Projection`."""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (
+    MAX_SEQ,
+    normalize_event,
+    validate_entity_id,
+    validate_payload,
+)
+from .projection import RECORD_KEYS, Projection, _validate_clock
+
+FORMAT = "eventview/1"
+
+DOC_KEYS = frozenset(
+    ("format", "next_seq", "last_updated_at", "records", "events")
+)
+
+
+def _is_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def _build_doc(projection):
+    stats = projection.stats()
+    return {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path`` and return the number of bytes written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection instance")
+    _validate_path(path)
+    doc = _build_doc(projection)
+    text = json.dumps(doc, sort_keys=True, indent=2) + "\n"
+    data = text.encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_doc(path):
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %r" % (path,))
+    with open(path, "rb") as handle:
+        raw = handle.read()
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ValidationError("file is not valid UTF-8: %s" % (exc,))
+    try:
+        doc = json.loads(text)
+    except ValueError as exc:
+        raise ValidationError("file is not valid JSON: %s" % (exc,))
+    return doc
+
+
+def _validate_record(entry, next_seq):
+    if not isinstance(entry, dict):
+        raise ValidationError("record must be a dict")
+    if set(entry.keys()) != RECORD_KEYS:
+        raise ValidationError("record must have exactly the six record keys")
+
+    entity_id = validate_entity_id(entry["entity_id"])
+
+    version = entry["version"]
+    if not _is_int(version) or version < 1:
+        raise ValidationError("record version must be an int >= 1")
+
+    seq = entry["seq"]
+    if not _is_int(seq) or seq < 1 or seq >= next_seq:
+        raise ValidationError("record seq out of range")
+
+    updated_at = entry["updated_at"]
+    if not _is_int(updated_at) or updated_at < 0:
+        raise ValidationError("record updated_at must be an int >= 0")
+
+    deleted = entry["deleted"]
+    if not isinstance(deleted, bool):
+        raise ValidationError("record deleted must be a bool")
+
+    fields = entry["fields"]
+    if not isinstance(fields, dict):
+        raise ValidationError("record fields must be a dict")
+    fields = validate_payload(fields)
+    if deleted and fields:
+        raise ValidationError("tombstoned record must have empty fields")
+
+    return {
+        "entity_id": entity_id,
+        "version": version,
+        "seq": seq,
+        "updated_at": updated_at,
+        "deleted": deleted,
+        "fields": fields,
+    }
+
+
+def load(path, clock=None):
+    """Read a projection previously written by :func:`dump`."""
+    _validate_path(path)
+    clock = _validate_clock(clock)
+    doc = _load_doc(path)
+
+    if not isinstance(doc, dict):
+        raise ValidationError("document must be a JSON object")
+    if set(doc.keys()) != DOC_KEYS:
+        raise ValidationError("document must have exactly the five keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format: %r" % (doc["format"],))
+
+    next_seq = doc["next_seq"]
+    if not _is_int(next_seq) or next_seq < 1 or next_seq > MAX_SEQ + 1:
+        raise ValidationError("next_seq out of range")
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        if not _is_int(last_updated_at) or last_updated_at < 0:
+            raise ValidationError("last_updated_at must be None or an int >= 0")
+
+    records = doc["records"]
+    events = doc["events"]
+    if not isinstance(records, list):
+        raise ValidationError("records must be a list")
+    if not isinstance(events, list):
+        raise ValidationError("events must be a list")
+
+    log = {}
+    expected = 1
+    for entry in events:
+        ev = normalize_event(entry)
+        if ev["seq"] != expected:
+            raise ValidationError("events must be seq 1..next_seq-1 in order")
+        log[expected] = ev
+        expected += 1
+    if expected != next_seq:
+        raise ValidationError("events must cover seq 1..next_seq-1")
+
+    stored = {}
+    for entry in records:
+        record = _validate_record(entry, next_seq)
+        if record["entity_id"] in stored:
+            raise ValidationError("duplicate record entity_id")
+        stored[record["entity_id"]] = record
+
+    projection = Projection(clock=clock)
+    projection._records = stored
+    projection._log = log
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
+
+
+__all__ = ["dump", "load"]
