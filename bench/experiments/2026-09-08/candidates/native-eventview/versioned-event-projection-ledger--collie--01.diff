+"""In-memory projection of a versioned event stream into entity records."""
+
+from .errors import ConflictError, NotFoundError, SequenceError, ValidationError
+from .events import canonical_form, normalize_event, validate_entity_id
+
+RECORD_KEYS = frozenset(
+    ("entity_id", "version", "seq", "updated_at", "deleted", "fields")
+)
+
+
+def _default_clock():
+    return 0
+
+
+def _copy_fields(fields):
+    """Deep copy of a validated payload/fields mapping."""
+    result = {}
+    for key, value in fields.items():
+        result[key] = list(value) if isinstance(value, list) else value
+    return result
+
+
+def _copy_record(record):
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": _copy_fields(record["fields"]),
+    }
+
+
+def _copy_event(event):
+    return {
+        "seq": event["seq"],
+        "entity_id": event["entity_id"],
+        "op": event["op"],
+        "payload": _copy_fields(event["payload"]),
+    }
+
+
+def _validate_clock(clock):
+    if clock is None:
+        return _default_clock
+    if not callable(clock):
+        raise ValidationError("clock must be None or a callable")
+    return clock
+
+
+def _validate_flag(value, name):
+    if not isinstance(value, bool):
+        raise ValidationError("%s must be a bool" % (name,))
+    return value
+
+
+class Projection:
+    """Projects create/update/delete events into entity records."""
+
+    def __init__(self, clock=None):
+        self._clock = _validate_clock(clock)
+        self._records = {}
+        self._log = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internal helpers -------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if not isinstance(now, int) or isinstance(now, bool):
+            raise ValidationError("clock must return a non-boolean int")
+        if now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        """Snapshot the whole internal state so a change can be undone."""
+        return (
+            {key: _copy_record(rec) for key, rec in self._records.items()},
+            {seq: _copy_event(ev) for seq, ev in self._log.items()},
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        records, log, next_seq, last_updated_at = state
+        self._records = records
+        self._log = log
+        self._next_seq = next_seq
+        self._last_updated_at = last_updated_at
+
+    def _apply_normalized(self, ev):
+        """Apply an already normalized event; return True if state changed."""
+        seq = ev["seq"]
+        if seq > self._next_seq:
+            raise SequenceError("unexpected seq %d, expected %d"
+                                % (seq, self._next_seq))
+        if seq < self._next_seq:
+            previous = self._log.get(seq)
+            if previous is None or canonical_form(previous) != canonical_form(ev):
+                raise ConflictError("seq %d conflicts with the applied event"
+                                    % (seq,))
+            return False
+
+        entity_id = ev["entity_id"]
+        op = ev["op"]
+        current = self._records.get(entity_id)
+
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity %r already exists" % (entity_id,))
+        else:
+            if current is None:
+                raise NotFoundError("unknown entity %r" % (entity_id,))
+            if current["deleted"]:
+                raise ConflictError("entity %r is deleted" % (entity_id,))
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": _copy_fields(ev["payload"]),
+            }
+            self._records[entity_id] = record
+        elif op == "update":
+            fields = _copy_fields(current["fields"])
+            for key, value in ev["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                else:
+                    fields[key] = list(value) if isinstance(value, list) else value
+            self._records[entity_id] = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": fields,
+            }
+        else:  # delete
+            self._records[entity_id] = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": True,
+                "fields": {},
+            }
+
+        self._log[seq] = ev
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    # -- public API -------------------------------------------------------
+
+    def apply_event(self, event):
+        ev = normalize_event(event)
+        state = self._capture()
+        try:
+            return self._apply_normalized(ev)
+        except BaseException:
+            self._restore(state)
+            raise
+
+    def apply_batch(self, events):
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or tuple")
+        state = self._capture()
+        applied = 0
+        try:
+            for event in events:
+                ev = normalize_event(event)
+                if self._apply_normalized(ev):
+                    applied += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return applied
+
+    def get(self, entity_id, include_deleted=False):
+        validate_entity_id(entity_id)
+        _validate_flag(include_deleted, "include_deleted")
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity %r" % (entity_id,))
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity %r is deleted" % (entity_id,))
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        _validate_flag(include_deleted, "include_deleted")
+        return [
+            _copy_record(self._records[key])
+            for key in sorted(self._records)
+            if include_deleted or not self._records[key]["deleted"]
+        ]
+
+    def applied_events(self):
+        return [_copy_event(self._log[seq]) for seq in sorted(self._log)]
+
+    def stats(self):
+        live = 0
+        deleted = 0
+        for record in self._records.values():
+            if record["deleted"]:
+                deleted += 1
+            else:
+                live += 1
+        return {
+            "live": live,
+            "deleted": deleted,
+            "applied": len(self._log),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
+
+
+__all__ = ["Projection"]
