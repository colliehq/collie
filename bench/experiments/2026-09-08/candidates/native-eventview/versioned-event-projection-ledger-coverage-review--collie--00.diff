+"""Exception types used by the eventview package."""
+
+
+class EventViewError(Exception):
+    """Base class for eventview failures."""
+
+
+class ValidationError(EventViewError):
+    """Raised when an input does not satisfy the documented contract."""
+
+
+class SequenceError(EventViewError):
+    """Raised when an event does not continue the sequence."""
+
+
+class ConflictError(EventViewError):
+    """Raised when an event conflicts with the current state."""
+
+
+class NotFoundError(EventViewError):
+    """Raised when an entity or file is missing."""
+
+
+__all__ = [
+    "EventViewError",
+    "ValidationError",
+    "SequenceError",
+    "ConflictError",
+    "NotFoundError",
+]
