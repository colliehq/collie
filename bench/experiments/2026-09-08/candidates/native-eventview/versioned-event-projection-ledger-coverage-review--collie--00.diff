+"""Event helpers: construction, validation, normalization and canonical form."""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+OPS = ("create", "update", "delete")
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_NAME_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+MAX_LIST_LEN = 32
+MAX_STR_LEN = 200
+
+
+def _is_real_int(value):
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def validate_seq(seq):
+    """Validate and return a sequence number."""
+    if not _is_real_int(seq):
+        raise ValidationError("seq must be an int")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError("seq out of range")
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Validate and return an entity id."""
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.match(entity_id) is None:
+        raise ValidationError("malformed entity_id")
+    return entity_id
+
+
+def validate_op(op):
+    """Validate and return an operation name."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("unknown op")
+    return op
+
+
+def _validate_scalar(value):
+    if value is None:
+        return value
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, int):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValidationError("non-finite float")
+        return value
+    if isinstance(value, str):
+        if len(value) > MAX_STR_LEN:
+            raise ValidationError("string too long")
+        return value
+    raise ValidationError("unsupported value type")
+
+
+def _validate_value(value):
+    """Validate a payload value; return an isolated copy of it."""
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list too long")
+        return [_validate_scalar(item) for item in value]
+    return _validate_scalar(value)
+
+
+def validate_payload(payload, op=None):
+    """Validate a payload and return a brand new isolated dict."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    result = {}
+    for key in payload:
+        if not isinstance(key, str):
+            raise ValidationError("payload keys must be str")
+        if _FIELD_NAME_RE.match(key) is None:
+            raise ValidationError("malformed payload key")
+        result[key] = _validate_value(payload[key])
+    if op == "delete" and result:
+        raise ValidationError("delete payload must be empty")
+    return result
+
+
+def copy_fields(fields):
+    """Return a deep copy of an already-validated payload/fields mapping."""
+    result = {}
+    for key, value in fields.items():
+        result[key] = list(value) if isinstance(value, list) else value
+    return result
+
+
+def copy_value(value):
+    """Return an isolated copy of an already-validated payload value."""
+    return list(value) if isinstance(value, list) else value
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a validated, fully isolated event dict."""
+    seq = validate_seq(seq)
+    entity_id = validate_entity_id(entity_id)
+    op = validate_op(op)
+    fields = validate_payload(payload, op)
+    return {
+        "seq": seq,
+        "entity_id": entity_id,
+        "op": op,
+        "payload": fields,
+    }
+
+
+def normalize_event(event):
+    """Validate an event mapping and return a normalized isolated copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event.keys()) != set(EVENT_KEYS):
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(
+        event["seq"],
+        event["entity_id"],
+        event["op"],
+        event["payload"],
+    )
+
+
+def canonical_form(event):
+    """Return a deterministic JSON string for an event."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
+
+
+__all__ = [
+    "make_event",
+    "normalize_event",
+    "canonical_form",
+]
