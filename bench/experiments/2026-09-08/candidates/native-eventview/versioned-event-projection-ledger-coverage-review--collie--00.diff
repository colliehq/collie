+"""In-memory projection of a versioned event stream."""
+
+from .errors import ConflictError, NotFoundError, SequenceError, ValidationError
+from .events import (canonical_form, copy_fields, copy_value, normalize_event,
+                     validate_entity_id)
+
+
+def _default_clock():
+    return 0
+
+
+def _validate_clock(clock):
+    if clock is None:
+        return _default_clock
+    if not callable(clock):
+        raise ValidationError("clock must be None or a callable")
+    return clock
+
+
+def _copy_record(record):
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": copy_fields(record["fields"]),
+    }
+
+
+def _validate_flag(value, name):
+    if not isinstance(value, bool):
+        raise ValidationError("%s must be a bool" % name)
+    return value
+
+
+class Projection:
+    """Projects create/update/delete events into entity records."""
+
+    def __init__(self, clock=None):
+        self._clock = _validate_clock(clock)
+        self._records = {}
+        self._log = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internals ---------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if not isinstance(now, int) or isinstance(now, bool):
+            raise ValidationError("clock must return an int")
+        if now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        records = {}
+        for entity_id, record in self._records.items():
+            records[entity_id] = _copy_record(record)
+        log = {}
+        for seq, event in self._log.items():
+            log[seq] = dict(event, payload=copy_fields(event["payload"]))
+        return (records, log, self._next_seq, self._last_updated_at)
+
+    def _restore(self, state):
+        self._records, self._log, self._next_seq, self._last_updated_at = state
+
+    def _apply_normalized(self, ev):
+        """Apply an already-normalized event; return True if state changed."""
+        seq = ev["seq"]
+        if seq > self._next_seq:
+            raise SequenceError("expected seq %d, got %d"
+                                % (self._next_seq, seq))
+        if seq < self._next_seq:
+            previous = self._log.get(seq)
+            if previous is None or canonical_form(previous) != canonical_form(ev):
+                raise ConflictError("event %d conflicts with the applied log"
+                                    % seq)
+            return False
+
+        entity_id = ev["entity_id"]
+        op = ev["op"]
+        current = self._records.get(entity_id)
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity %r already exists" % entity_id)
+        else:
+            if current is None:
+                raise NotFoundError("unknown entity %r" % entity_id)
+            if current["deleted"]:
+                raise ConflictError("entity %r is deleted" % entity_id)
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": copy_fields(ev["payload"]),
+            }
+            self._records[entity_id] = record
+        elif op == "update":
+            fields = copy_fields(current["fields"])
+            for key, value in ev["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                else:
+                    fields[key] = copy_value(value)
+            current["fields"] = fields
+            current["version"] += 1
+            current["seq"] = seq
+            current["updated_at"] = now
+        else:  # delete
+            current["fields"] = {}
+            current["deleted"] = True
+            current["version"] += 1
+            current["seq"] = seq
+            current["updated_at"] = now
+
+        self._log[seq] = dict(ev, payload=copy_fields(ev["payload"]))
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    # -- public API --------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; True if state changed, False for duplicate replay."""
+        ev = normalize_event(event)
+        state = self._capture()
+        try:
+            return self._apply_normalized(ev)
+        except BaseException:
+            self._restore(state)
+            raise
+
+    def apply_batch(self, events):
+        """Apply several events transactionally; return the number applied."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or tuple")
+        state = self._capture()
+        applied = 0
+        try:
+            for event in events:
+                ev = normalize_event(event)
+                if self._apply_normalized(ev):
+                    applied += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return applied
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        entity_id = validate_entity_id(entity_id)
+        _validate_flag(include_deleted, "include_deleted")
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity %r" % entity_id)
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity %r is deleted" % entity_id)
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return deep copies of all records sorted by entity_id."""
+        _validate_flag(include_deleted, "include_deleted")
+        result = []
+        for entity_id in sorted(self._records):
+            record = self._records[entity_id]
+            if record["deleted"] and not include_deleted:
+                continue
+            result.append(_copy_record(record))
+        return result
+
+    def applied_events(self):
+        """Return deep copies of the applied events, sorted by seq."""
+        return [dict(self._log[seq], payload=copy_fields(self._log[seq]["payload"]))
+                for seq in sorted(self._log)]
+
+    def stats(self):
+        """Return a summary of the projection state."""
+        deleted = 0
+        for record in self._records.values():
+            if record["deleted"]:
+                deleted += 1
+        return {
+            "live": len(self._records) - deleted,
+            "deleted": deleted,
+            "applied": len(self._log),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
+
+
+__all__ = ["Projection"]
