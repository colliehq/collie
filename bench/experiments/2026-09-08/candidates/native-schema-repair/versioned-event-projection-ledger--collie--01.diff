+"""Event construction, validation and canonical serialisation.
+
+An *event* is a plain :class:`dict` with exactly the four keys ``seq``,
+``entity_id``, ``op`` and ``payload``.
+"""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+OPS = frozenset(("create", "update", "delete"))
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_NAME_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+
+def validate_seq(seq):
+    """Return ``seq`` after checking it is an in-range non-bool int."""
+    if isinstance(seq, bool) or not isinstance(seq, int):
+        raise ValidationError("seq must be an int")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError("seq out of range: %r" % (seq,))
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Return ``entity_id`` after checking it against the id pattern."""
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.match(entity_id) is None:
+        raise ValidationError("invalid entity_id: %r" % (entity_id,))
+    return entity_id
+
+
+def validate_op(op):
+    """Return ``op`` after checking it is one of the three known ops."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("invalid op: %r" % (op,))
+    return op
+
+
+def _is_scalar(value):
+    if value is None or isinstance(value, bool) or isinstance(value, int):
+        return True
+    if isinstance(value, float):
+        return math.isfinite(value)
+    if isinstance(value, str):
+        return len(value) <= MAX_STR_LEN
+    return False
+
+
+def _copy_value(value):
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list value has too many elements")
+        copied = []
+        for item in value:
+            if not _is_scalar(item):
+                raise ValidationError("invalid list element: %r" % (item,))
+            copied.append(item)
+        return copied
+    if not _is_scalar(value):
+        raise ValidationError("invalid payload value: %r" % (value,))
+    return value
+
+
+def validate_payload(payload, op=None):
+    """Validate ``payload`` and return an isolated deep copy of it.
+
+    ``None`` normalizes to ``{}``.  When ``op`` is ``"delete"`` the payload
+    must be empty.
+    """
+    if payload is None:
+        fields = {}
+    else:
+        if not isinstance(payload, dict):
+            raise ValidationError("payload must be a dict or None")
+        fields = {}
+        for key, value in payload.items():
+            if not isinstance(key, str) or _FIELD_NAME_RE.match(key) is None:
+                raise ValidationError("invalid payload key: %r" % (key,))
+            fields[key] = _copy_value(value)
+    if op == "delete" and fields:
+        raise ValidationError("delete events must have an empty payload")
+    return fields
+
+
+def copy_fields(fields):
+    """Return an independent copy of an already validated field mapping."""
+    copied = {}
+    for key, value in fields.items():
+        copied[key] = list(value) if isinstance(value, list) else value
+    return copied
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a validated, fully isolated event dict."""
+    seq = validate_seq(seq)
+    entity_id = validate_entity_id(entity_id)
+    op = validate_op(op)
+    fields = validate_payload(payload, op)
+    return {"seq": seq, "entity_id": entity_id, "op": op, "payload": fields}
+
+
+def normalize_event(event):
+    """Validate an event mapping and return a normalized copy of it."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event) != set(EVENT_KEYS):
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(event["seq"], event["entity_id"], event["op"],
+                      event["payload"])
+
+
+def canonical_form(event):
+    """Return the canonical JSON text of a normalized ``event``."""
+    return json.dumps(normalize_event(event), sort_keys=True,
+                      separators=(",", ":"))
