+"""Deterministic JSON persistence for :class:`~eventview.projection.Projection`.
+"""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (MAX_SEQ, normalize_event, validate_entity_id,
+                     validate_payload)
+from .projection import RECORD_KEYS, Projection
+
+__all__ = ["dump", "load"]
+
+FORMAT = "eventview/1"
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+MAX_NEXT_SEQ = MAX_SEQ + 1
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def _validate_count(value, name, minimum):
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValidationError("%s must be an int" % (name,))
+    if value < minimum:
+        raise ValidationError("%s out of range: %r" % (name, value))
+    return value
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path`` as JSON; return the byte count."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection")
+    _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_document(path):
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %r" % (path,))
+    try:
+        with open(path, "rb") as handle:
+            raw = handle.read()
+    except OSError as exc:
+        raise NotFoundError("cannot read %r: %s" % (path, exc))
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        raise ValidationError("file is not valid UTF-8")
+    try:
+        return json.loads(text)
+    except ValueError:
+        raise ValidationError("file is not valid JSON")
+
+
+def load(path, clock=None):
+    """Read a journal file written by :func:`dump` and rebuild a projection."""
+    _validate_path(path)
+    doc = _load_document(path)
+
+    if not isinstance(doc, dict) or set(doc) != set(DOC_KEYS):
+        raise ValidationError("document must have exactly the journal keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format: %r" % (doc["format"],))
+
+    next_seq = doc["next_seq"]
+    if isinstance(next_seq, bool) or not isinstance(next_seq, int):
+        raise ValidationError("next_seq must be an int")
+    if next_seq < 1 or next_seq > MAX_NEXT_SEQ:
+        raise ValidationError("next_seq out of range: %r" % (next_seq,))
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        _validate_count(last_updated_at, "last_updated_at", 0)
+
+    if not isinstance(doc["records"], list):
+        raise ValidationError("records must be a list")
+    if not isinstance(doc["events"], list):
+        raise ValidationError("events must be a list")
+
+    events = {}
+    expected = 1
+    for raw_event in doc["events"]:
+        event = normalize_event(raw_event)
+        if event["seq"] != expected:
+            raise ValidationError("event seq %r is out of order"
+                                  % (event["seq"],))
+        events[event["seq"]] = event
+        expected += 1
+    if expected != next_seq:
+        raise ValidationError("events do not cover 1..next_seq-1")
+
+    records = {}
+    for raw_record in doc["records"]:
+        if not isinstance(raw_record, dict) or \
+                set(raw_record) != set(RECORD_KEYS):
+            raise ValidationError("record must have exactly the record keys")
+        entity_id = validate_entity_id(raw_record["entity_id"])
+        if entity_id in records:
+            raise ValidationError("duplicate record: %r" % (entity_id,))
+        version = _validate_count(raw_record["version"], "version", 1)
+        seq = _validate_count(raw_record["seq"], "seq", 1)
+        if seq >= next_seq:
+            raise ValidationError("record seq out of range: %r" % (seq,))
+        updated_at = _validate_count(raw_record["updated_at"], "updated_at", 0)
+        deleted = raw_record["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("deleted must be a bool")
+        fields_value = raw_record["fields"]
+        if not isinstance(fields_value, dict):
+            raise ValidationError("fields must be a dict")
+        fields = validate_payload(fields_value)
+        if deleted and fields:
+            raise ValidationError("a tombstoned record must have no fields")
+        records[entity_id] = {
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": fields,
+        }
+
+    projection = Projection(clock=clock)
+    projection._records = records
+    projection._events = events
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
