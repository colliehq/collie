+"""In-memory projection of a versioned event stream into entity records."""
+
+from .errors import (ConflictError, NotFoundError, SequenceError,
+                     ValidationError)
+from .events import canonical_form, copy_fields, normalize_event, validate_entity_id
+
+__all__ = ["Projection"]
+
+RECORD_KEYS = frozenset(("entity_id", "version", "seq", "updated_at",
+                         "deleted", "fields"))
+
+
+def _zero_clock():
+    """Default clock: always 0."""
+    return 0
+
+
+def _validate_clock(clock):
+    if clock is None:
+        return _zero_clock
+    if not callable(clock):
+        raise ValidationError("clock must be None or a callable")
+    return clock
+
+
+def _validate_flag(value, name):
+    if not isinstance(value, bool):
+        raise ValidationError("%s must be a bool" % (name,))
+    return value
+
+
+def _copy_record(record):
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": copy_fields(record["fields"]),
+    }
+
+
+def _copy_event(event):
+    return {
+        "seq": event["seq"],
+        "entity_id": event["entity_id"],
+        "op": event["op"],
+        "payload": copy_fields(event["payload"]),
+    }
+
+
+class Projection(object):
+    """Projects a gap-free, versioned event stream into entity records."""
+
+    def __init__(self, clock=None):
+        self._clock = _validate_clock(clock)
+        self._records = {}
+        self._events = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internal helpers ------------------------------------------------
+
+    def _tick(self):
+        now = self._clock()
+        if isinstance(now, bool) or not isinstance(now, int):
+            raise ValidationError("clock must return an int")
+        if now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        return (
+            dict((key, _copy_record(rec))
+                 for key, rec in self._records.items()),
+            dict((seq, _copy_event(evt)) for seq, evt in self._events.items()),
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        self._records, self._events, self._next_seq, self._last_updated_at = state
+
+    # -- public API ------------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; return True if state changed, False on replay."""
+        normalized = normalize_event(event)
+        seq = normalized["seq"]
+
+        if seq > self._next_seq:
+            raise SequenceError("expected seq %d, got %d"
+                                % (self._next_seq, seq))
+        if seq < self._next_seq:
+            previous = self._events.get(seq)
+            if previous is not None and \
+                    canonical_form(previous) == canonical_form(normalized):
+                return False
+            raise ConflictError("seq %d conflicts with applied history" % (seq,))
+
+        entity_id = normalized["entity_id"]
+        op = normalized["op"]
+        current = self._records.get(entity_id)
+
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity %r already exists" % (entity_id,))
+        else:
+            if current is None:
+                raise NotFoundError("unknown entity %r" % (entity_id,))
+            if current["deleted"]:
+                raise ConflictError("entity %r is deleted" % (entity_id,))
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": copy_fields(normalized["payload"]),
+            }
+        elif op == "update":
+            fields = copy_fields(current["fields"])
+            for key, value in normalized["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                else:
+                    fields[key] = list(value) if isinstance(value, list) else value
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": fields,
+            }
+        else:
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": True,
+                "fields": {},
+            }
+
+        self._records[entity_id] = record
+        self._events[seq] = normalized
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    def apply_batch(self, events):
+        """Apply events transactionally; return how many changed state."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or tuple")
+        state = self._capture()
+        changed = 0
+        try:
+            for event in events:
+                if self.apply_event(event):
+                    changed += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return changed
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a deep copy of one record."""
+        entity_id = validate_entity_id(entity_id)
+        _validate_flag(include_deleted, "include_deleted")
+        record = self._records.get(entity_id)
+        if record is None or (record["deleted"] and not include_deleted):
+            raise NotFoundError("unknown entity %r" % (entity_id,))
+        return _copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return deep copies of all records sorted by ``entity_id``."""
+        _validate_flag(include_deleted, "include_deleted")
+        return [_copy_record(self._records[key])
+                for key in sorted(self._records)
+                if include_deleted or not self._records[key]["deleted"]]
+
+    def applied_events(self):
+        """Return deep copies of the state-changing events, sorted by seq."""
+        return [_copy_event(self._events[seq]) for seq in sorted(self._events)]
+
+    def stats(self):
+        """Return a summary dict of the projection state."""
+        deleted = sum(1 for rec in self._records.values() if rec["deleted"])
+        return {
+            "live": len(self._records) - deleted,
+            "deleted": deleted,
+            "applied": len(self._events),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
