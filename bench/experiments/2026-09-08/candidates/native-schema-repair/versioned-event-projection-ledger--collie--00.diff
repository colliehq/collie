+"""Deterministic JSON persistence for :class:`~eventview.projection.Projection`.
+
+The on-disk document is stable: sorted keys, two-space indentation, a single
+trailing newline and UTF-8 bytes written in binary mode, so a round trip
+reproduces byte-identical files on every platform.
+"""
+
+import json
+import os
+
+from .errors import NotFoundError, ValidationError
+from .events import (MIN_SEQ, normalize_event, validate_entity_id,
+                     validate_payload)
+from .projection import RECORD_KEYS, Projection, copy_event, copy_record
+
+__all__ = ["dump", "load"]
+
+FORMAT = "eventview/1"
+DOC_KEYS = frozenset(("format", "next_seq", "last_updated_at", "records",
+                      "events"))
+MAX_NEXT_SEQ = 1000000001
+
+
+def _validate_path(path):
+    if not isinstance(path, str) or not path:
+        raise ValidationError("path must be a non-empty str")
+    return path
+
+
+def _plain_int(value, name, minimum):
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValidationError("%s must be a non-bool int" % (name,))
+    if value < minimum:
+        raise ValidationError("%s must be >= %d" % (name, minimum))
+    return value
+
+
+def dump(projection, path):
+    """Write ``projection`` to ``path``; return the number of bytes written."""
+    if not isinstance(projection, Projection):
+        raise ValidationError("projection must be a Projection")
+    _validate_path(path)
+
+    stats = projection.stats()
+    doc = {
+        "format": FORMAT,
+        "next_seq": stats["next_seq"],
+        "last_updated_at": stats["last_updated_at"],
+        "records": projection.snapshot(include_deleted=True),
+        "events": projection.applied_events(),
+    }
+    data = (json.dumps(doc, sort_keys=True, indent=2) + "\n").encode("utf-8")
+    with open(path, "wb") as handle:
+        handle.write(data)
+    return len(data)
+
+
+def _load_document(path):
+    if not os.path.isfile(path):
+        raise NotFoundError("no such file: %r" % (path,))
+    try:
+        with open(path, "rb") as handle:
+            raw = handle.read()
+    except OSError as exc:
+        raise NotFoundError("cannot read file: %r" % (path,)) from exc
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ValidationError("file is not valid UTF-8") from exc
+    try:
+        return json.loads(text)
+    except ValueError as exc:
+        raise ValidationError("file is not valid JSON") from exc
+
+
+def _load_events(raw_events, next_seq):
+    if not isinstance(raw_events, list):
+        raise ValidationError("events must be a list")
+    if len(raw_events) != next_seq - MIN_SEQ:
+        raise ValidationError("events do not cover 1..next_seq-1")
+    events = {}
+    for index, entry in enumerate(raw_events):
+        normalized = normalize_event(entry)
+        if normalized["seq"] != index + MIN_SEQ:
+            raise ValidationError("events must be seq 1..next_seq-1 in order")
+        events[normalized["seq"]] = normalized
+    return events
+
+
+def _load_records(raw_records, next_seq):
+    if not isinstance(raw_records, list):
+        raise ValidationError("records must be a list")
+    records = {}
+    for entry in raw_records:
+        if not isinstance(entry, dict) or set(entry) != set(RECORD_KEYS):
+            raise ValidationError("record must have exactly the record keys")
+        entity_id = validate_entity_id(entry["entity_id"])
+        if entity_id in records:
+            raise ValidationError("duplicate record: %r" % (entity_id,))
+        version = _plain_int(entry["version"], "version", 1)
+        seq = _plain_int(entry["seq"], "seq", MIN_SEQ)
+        if seq >= next_seq:
+            raise ValidationError("record seq must be < next_seq")
+        updated_at = _plain_int(entry["updated_at"], "updated_at", 0)
+        deleted = entry["deleted"]
+        if not isinstance(deleted, bool):
+            raise ValidationError("deleted must be a bool")
+        fields = entry["fields"]
+        if not isinstance(fields, dict):
+            raise ValidationError("fields must be a dict")
+        fields = validate_payload(fields)
+        if deleted and fields:
+            raise ValidationError("tombstoned record must have no fields")
+        records[entity_id] = {
+            "entity_id": entity_id,
+            "version": version,
+            "seq": seq,
+            "updated_at": updated_at,
+            "deleted": deleted,
+            "fields": fields,
+        }
+    return records
+
+
+def load(path, clock=None):
+    """Read a projection previously written by :func:`dump`."""
+    _validate_path(path)
+    doc = _load_document(path)
+
+    if not isinstance(doc, dict) or set(doc) != set(DOC_KEYS):
+        raise ValidationError("document must have exactly the document keys")
+    if doc["format"] != FORMAT:
+        raise ValidationError("unsupported format: %r" % (doc["format"],))
+
+    next_seq = _plain_int(doc["next_seq"], "next_seq", MIN_SEQ)
+    if next_seq > MAX_NEXT_SEQ:
+        raise ValidationError("next_seq out of range")
+
+    last_updated_at = doc["last_updated_at"]
+    if last_updated_at is not None:
+        last_updated_at = _plain_int(last_updated_at, "last_updated_at", 0)
+
+    events = _load_events(doc["events"], next_seq)
+    records = _load_records(doc["records"], next_seq)
+
+    projection = Projection(clock=clock)
+    projection._records = dict(
+        (key, copy_record(rec)) for key, rec in records.items())
+    projection._events = dict(
+        (seq, copy_event(evt)) for seq, evt in events.items())
+    projection._next_seq = next_seq
+    projection._last_updated_at = last_updated_at
+    return projection
