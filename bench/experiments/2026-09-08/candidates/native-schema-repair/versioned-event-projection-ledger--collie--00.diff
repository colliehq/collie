+"""Event construction, validation and canonical serialisation.
+
+An *event* is a plain ``dict`` with exactly the keys ``seq``, ``entity_id``,
+``op`` and ``payload``.
+"""
+
+import json
+import math
+import re
+
+from .errors import ValidationError
+
+__all__ = ["make_event", "normalize_event", "canonical_form"]
+
+EVENT_KEYS = frozenset(("seq", "entity_id", "op", "payload"))
+OPS = frozenset(("create", "update", "delete"))
+
+MIN_SEQ = 1
+MAX_SEQ = 1000000000
+
+MAX_STR_LEN = 200
+MAX_LIST_LEN = 32
+
+_ENTITY_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,63}$")
+_FIELD_KEY_RE = re.compile(r"^[a-z][a-z0-9_]{0,31}$")
+
+
+def validate_seq(seq):
+    """Return ``seq`` if it is a valid sequence number."""
+    if isinstance(seq, bool) or not isinstance(seq, int):
+        raise ValidationError("seq must be a non-bool int")
+    if seq < MIN_SEQ or seq > MAX_SEQ:
+        raise ValidationError("seq out of range: %r" % (seq,))
+    return seq
+
+
+def validate_entity_id(entity_id):
+    """Return ``entity_id`` if it is a valid entity identifier."""
+    if not isinstance(entity_id, str):
+        raise ValidationError("entity_id must be a str")
+    if _ENTITY_ID_RE.match(entity_id) is None:
+        raise ValidationError("invalid entity_id: %r" % (entity_id,))
+    return entity_id
+
+
+def validate_op(op):
+    """Return ``op`` if it is one of the three known operations."""
+    if not isinstance(op, str) or op not in OPS:
+        raise ValidationError("invalid op: %r" % (op,))
+    return op
+
+
+def _validate_scalar(value):
+    """Return a copy of ``value`` if it is a valid scalar."""
+    if value is None or isinstance(value, bool):
+        return value
+    if isinstance(value, int):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValidationError("non-finite float is not a valid scalar")
+        return value
+    if isinstance(value, str):
+        if len(value) > MAX_STR_LEN:
+            raise ValidationError("str value too long")
+        return value
+    raise ValidationError("invalid scalar value: %r" % (type(value),))
+
+
+def validate_payload_value(value):
+    """Return an isolated copy of a valid payload value."""
+    if isinstance(value, list):
+        if len(value) > MAX_LIST_LEN:
+            raise ValidationError("list value has too many elements")
+        return [_validate_scalar(item) for item in value]
+    return _validate_scalar(value)
+
+
+def validate_payload(payload, op=None):
+    """Return a brand new, deep-copied and validated payload dict."""
+    if payload is None:
+        payload = {}
+    if not isinstance(payload, dict):
+        raise ValidationError("payload must be a dict or None")
+    if op == "delete" and payload:
+        raise ValidationError("delete events must have an empty payload")
+    result = {}
+    for key in payload:
+        if not isinstance(key, str) or _FIELD_KEY_RE.match(key) is None:
+            raise ValidationError("invalid payload key: %r" % (key,))
+        result[key] = validate_payload_value(payload[key])
+    return result
+
+
+def make_event(seq, entity_id, op, payload=None):
+    """Build a validated, fully isolated event dict."""
+    seq = validate_seq(seq)
+    entity_id = validate_entity_id(entity_id)
+    op = validate_op(op)
+    fields = validate_payload(payload, op)
+    return {
+        "seq": seq,
+        "entity_id": entity_id,
+        "op": op,
+        "payload": fields,
+    }
+
+
+def normalize_event(event):
+    """Validate an existing event mapping and return an isolated copy."""
+    if not isinstance(event, dict):
+        raise ValidationError("event must be a dict")
+    if set(event) != set(EVENT_KEYS):
+        raise ValidationError("event must have exactly the four event keys")
+    return make_event(event["seq"], event["entity_id"], event["op"],
+                      event["payload"])
+
+
+def canonical_form(event):
+    """Return the deterministic JSON encoding of a normalized event."""
+    normalized = normalize_event(event)
+    return json.dumps(normalized, sort_keys=True, separators=(",", ":"))
