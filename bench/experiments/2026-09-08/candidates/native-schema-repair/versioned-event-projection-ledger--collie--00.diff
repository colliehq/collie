+"""Projection of a versioned event stream into an entity view.
+
+The projection is deterministic: every timestamp comes from an injected
+clock callable, never from the wall clock.
+"""
+
+from .errors import (ConflictError, NotFoundError, SequenceError,
+                     ValidationError)
+from .events import canonical_form, normalize_event, validate_entity_id
+
+__all__ = ["Projection"]
+
+RECORD_KEYS = frozenset(("entity_id", "version", "seq", "updated_at",
+                         "deleted", "fields"))
+
+
+def _zero_clock():
+    """Default clock: always zero."""
+    return 0
+
+
+def copy_fields(fields):
+    """Return an isolated copy of a validated fields mapping."""
+    out = {}
+    for key, value in fields.items():
+        out[key] = list(value) if isinstance(value, list) else value
+    return out
+
+
+def copy_record(record):
+    """Return an isolated copy of a record dict."""
+    return {
+        "entity_id": record["entity_id"],
+        "version": record["version"],
+        "seq": record["seq"],
+        "updated_at": record["updated_at"],
+        "deleted": record["deleted"],
+        "fields": copy_fields(record["fields"]),
+    }
+
+
+def copy_event(event):
+    """Return an isolated copy of a normalized event dict."""
+    return {
+        "seq": event["seq"],
+        "entity_id": event["entity_id"],
+        "op": event["op"],
+        "payload": copy_fields(event["payload"]),
+    }
+
+
+def _check_flag(value, name):
+    if not isinstance(value, bool):
+        raise ValidationError("%s must be a bool" % (name,))
+    return value
+
+
+class Projection(object):
+    """An entity view built by applying a gap-free stream of events."""
+
+    def __init__(self, clock=None):
+        if clock is None:
+            clock = _zero_clock
+        elif not callable(clock):
+            raise ValidationError("clock must be None or a callable")
+        self._clock = clock
+        self._records = {}
+        self._events = {}
+        self._next_seq = 1
+        self._last_updated_at = None
+
+    # -- internal helpers ------------------------------------------------
+
+    def _tick(self):
+        """Call the injected clock once and validate its result."""
+        now = self._clock()
+        if isinstance(now, bool) or not isinstance(now, int):
+            raise ValidationError("clock must return a non-bool int")
+        if now < 0:
+            raise ValidationError("clock must return a non-negative int")
+        return now
+
+    def _capture(self):
+        """Return a deep copy of the whole mutable state."""
+        return (
+            dict((key, copy_record(rec))
+                 for key, rec in self._records.items()),
+            dict((seq, copy_event(evt)) for seq, evt in self._events.items()),
+            self._next_seq,
+            self._last_updated_at,
+        )
+
+    def _restore(self, state):
+        """Restore a state previously produced by :meth:`_capture`."""
+        records, events, next_seq, last_updated_at = state
+        self._records = records
+        self._events = events
+        self._next_seq = next_seq
+        self._last_updated_at = last_updated_at
+
+    # -- mutation --------------------------------------------------------
+
+    def apply_event(self, event):
+        """Apply one event; return True if the state changed."""
+        normalized = normalize_event(event)
+        seq = normalized["seq"]
+
+        if seq > self._next_seq:
+            raise SequenceError("sequence hole: expected %d, got %d"
+                                % (self._next_seq, seq))
+        if seq < self._next_seq:
+            previous = self._events.get(seq)
+            if previous is None or (canonical_form(previous)
+                                    != canonical_form(normalized)):
+                raise ConflictError("replayed event differs at seq %d" % (seq,))
+            return False
+
+        entity_id = normalized["entity_id"]
+        op = normalized["op"]
+        current = self._records.get(entity_id)
+
+        if op == "create":
+            if current is not None:
+                raise ConflictError("entity already exists: %r" % (entity_id,))
+        else:
+            if current is None:
+                raise NotFoundError("unknown entity: %r" % (entity_id,))
+            if current["deleted"]:
+                raise ConflictError("entity is deleted: %r" % (entity_id,))
+
+        now = self._tick()
+
+        if op == "create":
+            record = {
+                "entity_id": entity_id,
+                "version": 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": copy_fields(normalized["payload"]),
+            }
+        elif op == "update":
+            fields = copy_fields(current["fields"])
+            for key, value in normalized["payload"].items():
+                if value is None:
+                    fields.pop(key, None)
+                elif isinstance(value, list):
+                    fields[key] = list(value)
+                else:
+                    fields[key] = value
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": False,
+                "fields": fields,
+            }
+        else:
+            record = {
+                "entity_id": entity_id,
+                "version": current["version"] + 1,
+                "seq": seq,
+                "updated_at": now,
+                "deleted": True,
+                "fields": {},
+            }
+
+        self._records[entity_id] = record
+        self._events[seq] = normalized
+        self._next_seq = seq + 1
+        self._last_updated_at = now
+        return True
+
+    def apply_batch(self, events):
+        """Apply many events transactionally; return the number applied."""
+        if not isinstance(events, (list, tuple)):
+            raise ValidationError("events must be a list or a tuple")
+        state = self._capture()
+        applied = 0
+        try:
+            for event in events:
+                if self.apply_event(event):
+                    applied += 1
+        except BaseException:
+            self._restore(state)
+            raise
+        return applied
+
+    # -- reads -----------------------------------------------------------
+
+    def get(self, entity_id, include_deleted=False):
+        """Return a copy of one record."""
+        validate_entity_id(entity_id)
+        _check_flag(include_deleted, "include_deleted")
+        record = self._records.get(entity_id)
+        if record is None:
+            raise NotFoundError("unknown entity: %r" % (entity_id,))
+        if record["deleted"] and not include_deleted:
+            raise NotFoundError("entity is deleted: %r" % (entity_id,))
+        return copy_record(record)
+
+    def snapshot(self, include_deleted=False):
+        """Return copies of all records sorted by ``entity_id``."""
+        _check_flag(include_deleted, "include_deleted")
+        return [copy_record(self._records[key])
+                for key in sorted(self._records)
+                if include_deleted or not self._records[key]["deleted"]]
+
+    def applied_events(self):
+        """Return copies of the state-changing events, sorted by ``seq``."""
+        return [copy_event(self._events[seq]) for seq in sorted(self._events)]
+
+    def stats(self):
+        """Return a summary of the projection state."""
+        deleted = 0
+        for record in self._records.values():
+            if record["deleted"]:
+                deleted += 1
+        return {
+            "live": len(self._records) - deleted,
+            "deleted": deleted,
+            "applied": len(self._events),
+            "next_seq": self._next_seq,
+            "last_updated_at": self._last_updated_at,
+        }
