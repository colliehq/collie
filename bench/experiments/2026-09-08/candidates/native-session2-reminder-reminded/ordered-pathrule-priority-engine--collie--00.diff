+"""Pattern compilation and matching for the rule engine.
+
+Patterns use the same slash semantics as paths: '/' is the only separator,
+empty and '.' segments are dropped, '..' is rejected.  Inside a segment the
+backslash escapes '*' or another backslash, a single unescaped '*' matches
+zero or more characters inside one segment, and a segment that is exactly
+'**' matches zero or more whole segments.
+"""
+
+from pathnorm import split_path
+from ruleerrors import PathTraversalError, PatternError
+
+__all__ = ["Pattern", "compile_pattern"]
+
+SEPARATOR = "/"
+DOUBLE_STAR = "**"
+
+
+def _parse_segment(segment):
+    """Validate one raw segment and return its compiled form.
+
+    The compiled form is either the sentinel ``DOUBLE_STAR`` (for a segment
+    that is exactly ``**``) or a tuple of tokens, where a token is either the
+    sentinel ``_STAR`` or a literal ``str``.
+    """
+    if segment == DOUBLE_STAR:
+        return DOUBLE_STAR
+
+    tokens = []
+    literal = []
+    previous_was_star = False
+    index = 0
+    length = len(segment)
+    while index < length:
+        character = segment[index]
+        if character == "\\":
+            if index + 1 >= length:
+                raise PatternError(
+                    "dangling backslash at end of segment: %r" % (segment,)
+                )
+            escaped = segment[index + 1]
+            if escaped not in ("*", "\\"):
+                raise PatternError(
+                    "invalid escape %r in segment %r" % ("\\" + escaped, segment)
+                )
+            literal.append(escaped)
+            previous_was_star = False
+            index += 2
+            continue
+        if character == "*":
+            if previous_was_star:
+                raise PatternError(
+                    "'**' is only allowed as a whole segment: %r" % (segment,)
+                )
+            if literal:
+                tokens.append("".join(literal))
+                literal = []
+            tokens.append(_STAR)
+            previous_was_star = True
+            index += 1
+            continue
+        literal.append(character)
+        previous_was_star = False
+        index += 1
+    if literal:
+        tokens.append("".join(literal))
+    return tuple(tokens)
+
+
+class _Star(object):
+    """Sentinel standing for a single unescaped '*' token."""
+
+    __slots__ = ()
+
+    def __repr__(self):  # pragma: no cover - debugging aid
+        return "<*>"
+
+
+_STAR = _Star()
+
+
+def _match_segment(tokens, text):
+    """Return True if the compiled *tokens* match the whole segment *text*."""
+    # tokens is a tuple of literal strings and _STAR sentinels.
+    return _match_tokens(tokens, 0, text, 0)
+
+
+def _match_tokens(tokens, token_index, text, text_index):
+    while token_index < len(tokens):
+        token = tokens[token_index]
+        if token is _STAR:
+            if token_index + 1 == len(tokens):
+                return True
+            for position in range(text_index, len(text) + 1):
+                if _match_tokens(tokens, token_index + 1, text, position):
+                    return True
+            return False
+        if not text.startswith(token, text_index):
+            return False
+        text_index += len(token)
+        token_index += 1
+    return text_index == len(text)
+
+
+def _match_segments(compiled, seg_index, path_segments, path_index):
+    while seg_index < len(compiled):
+        current = compiled[seg_index]
+        if current is DOUBLE_STAR or current == DOUBLE_STAR:
+            if seg_index + 1 == len(compiled):
+                return True
+            for position in range(path_index, len(path_segments) + 1):
+                if _match_segments(compiled, seg_index + 1, path_segments, position):
+                    return True
+            return False
+        if path_index >= len(path_segments):
+            return False
+        if not _match_segment(current, path_segments[path_index]):
+            return False
+        seg_index += 1
+        path_index += 1
+    return path_index == len(path_segments)
+
+
+class Pattern(object):
+    """An immutable compiled path pattern."""
+
+    __slots__ = ("_source", "_segments", "_compiled", "_specificity")
+
+    def __init__(self, source, segments, compiled, specificity):
+        object.__setattr__(self, "_source", source)
+        object.__setattr__(self, "_segments", segments)
+        object.__setattr__(self, "_compiled", compiled)
+        object.__setattr__(self, "_specificity", specificity)
+
+    @property
+    def source(self):
+        return self._source
+
+    @property
+    def segments(self):
+        return self._segments
+
+    @property
+    def specificity(self):
+        return self._specificity
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __repr__(self):  # pragma: no cover - debugging aid
+        return "Pattern(%r)" % (self._source,)
+
+    def match(self, path):
+        """Return True if *path* matches this pattern."""
+        path_segments = split_path(path)
+        return bool(_match_segments(self._compiled, 0, path_segments, 0))
+
+
+def compile_pattern(pattern):
+    """Compile *pattern* into a :class:`Pattern` object."""
+    if not isinstance(pattern, str):
+        raise TypeError(
+            "pattern must be a str, got %r" % (type(pattern).__name__,)
+        )
+    if "\x00" in pattern:
+        raise PatternError("pattern must not contain a NUL character")
+
+    raw_segments = []
+    for part in pattern.split(SEPARATOR):
+        if part == "" or part == ".":
+            continue
+        if part == "..":
+            raise PathTraversalError(
+                "pattern must not contain a '..' segment: %r" % (pattern,)
+            )
+        raw_segments.append(part)
+
+    compiled = []
+    literal_count = 0
+    star_count = 0
+    deep_count = 0
+    for segment in raw_segments:
+        parsed = _parse_segment(segment)
+        compiled.append(parsed)
+        if parsed == DOUBLE_STAR:
+            deep_count += 1
+        elif any(token is _STAR for token in parsed):
+            star_count += 1
+        else:
+            literal_count += 1
+
+    specificity = 100 * literal_count + 10 * star_count + deep_count
+    return Pattern(pattern, tuple(raw_segments), tuple(compiled), specificity)
