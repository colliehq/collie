+"""Exception types used by the ordered include/exclude path-rule engine."""
+
+__all__ = [
+    "RuleError",
+    "PathTraversalError",
+    "PatternError",
+    "RuleSyntaxError",
+]
+
+
+class RuleError(ValueError):
+    """Base class of every error raised by the rule engine."""
+
+
+class PathTraversalError(RuleError):
+    """Raised when a path or pattern contains a '..' segment."""
+
+
+class PatternError(RuleError):
+    """Raised when a pattern is syntactically invalid."""
+
+
+class RuleSyntaxError(RuleError):
+    """Raised when a textual rule line cannot be parsed."""
+
+    def __init__(self, message, line_number=None):
+        super().__init__(message)
+        self.message = message
+        self.line_number = line_number
