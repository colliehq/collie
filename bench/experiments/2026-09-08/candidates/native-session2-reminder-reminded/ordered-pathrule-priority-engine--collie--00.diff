+"""Rules, rule sets, evaluation, explanation and decision logging."""
+
+from pathnorm import normalize_path
+from patternmatch import compile_pattern
+
+__all__ = ["Rule", "RuleSet", "DecisionLog"]
+
+VALID_ACTIONS = ("include", "exclude")
+
+
+def _check_action(action, what="action"):
+    if not isinstance(action, str):
+        raise TypeError("%s must be a str, got %r" % (what, type(action).__name__))
+    if action not in VALID_ACTIONS:
+        raise ValueError(
+            "%s must be 'include' or 'exclude', got %r" % (what, action)
+        )
+    return action
+
+
+class Rule(object):
+    """An immutable single include/exclude rule."""
+
+    __slots__ = ("_pattern", "_action", "_priority", "_label", "_compiled")
+
+    def __init__(self, pattern, action, priority=0, label=None):
+        compiled = compile_pattern(pattern)
+        _check_action(action)
+        if isinstance(priority, bool) or not isinstance(priority, int):
+            raise TypeError(
+                "priority must be an int, got %r" % (type(priority).__name__,)
+            )
+        if label is not None and not isinstance(label, str):
+            raise TypeError(
+                "label must be None or a str, got %r" % (type(label).__name__,)
+            )
+        object.__setattr__(self, "_pattern", pattern)
+        object.__setattr__(self, "_action", action)
+        object.__setattr__(self, "_priority", priority)
+        object.__setattr__(self, "_label", label)
+        object.__setattr__(self, "_compiled", compiled)
+
+    @property
+    def pattern(self):
+        return self._pattern
+
+    @property
+    def action(self):
+        return self._action
+
+    @property
+    def priority(self):
+        return self._priority
+
+    @property
+    def label(self):
+        return self._label
+
+    @property
+    def compiled(self):
+        return self._compiled
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Rule instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Rule instances are immutable")
+
+    def __repr__(self):  # pragma: no cover - debugging aid
+        return "Rule(%r, %r, %r, %r)" % (
+            self._pattern,
+            self._action,
+            self._priority,
+            self._label,
+        )
+
+    def matches(self, path):
+        """Return True if *path* matches this rule's pattern."""
+        return self._compiled.match(path)
+
+
+def _coerce_rules(rules, what="rules"):
+    """Validate an iterable of rules, returning a list.  Atomic by design."""
+    if isinstance(rules, (str, bytes, bytearray)):
+        raise TypeError("%s must be an iterable of Rule objects" % (what,))
+    try:
+        iterator = iter(rules)
+    except TypeError:
+        raise TypeError("%s must be an iterable of Rule objects" % (what,))
+    collected = []
+    for item in iterator:
+        if not isinstance(item, Rule):
+            raise TypeError(
+                "%s must contain Rule instances, got %r"
+                % (what, type(item).__name__)
+            )
+        collected.append(item)
+    return collected
+
+
+class RuleSet(object):
+    """An ordered collection of rules with a default action."""
+
+    def __init__(self, rules=(), default_action="exclude"):
+        _check_action(default_action, "default_action")
+        collected = _coerce_rules(rules)
+        self._rules = collected
+        self._default_action = default_action
+
+    @property
+    def default_action(self):
+        return self._default_action
+
+    @property
+    def rules(self):
+        return tuple(self._rules)
+
+    def __len__(self):
+        return len(self._rules)
+
+    def __repr__(self):  # pragma: no cover - debugging aid
+        return "RuleSet(%r, default_action=%r)" % (
+            list(self._rules),
+            self._default_action,
+        )
+
+    def add(self, rule):
+        """Append *rule* at the end and return self."""
+        if not isinstance(rule, Rule):
+            raise TypeError(
+                "rule must be a Rule instance, got %r" % (type(rule).__name__,)
+            )
+        self._rules.append(rule)
+        return self
+
+    def extend(self, rules):
+        """Append every rule of *rules* atomically and return self."""
+        collected = _coerce_rules(rules)
+        self._rules.extend(collected)
+        return self
+
+    def explain(self, path):
+        """Return a fresh dict describing the decision taken for *path*."""
+        normalised = normalize_path(path)
+        matched = []
+        winner_index = None
+        winner = None
+        for index, rule in enumerate(self._rules):
+            if rule.compiled.match(normalised):
+                matched.append(index)
+                if winner is None or rule.priority >= winner.priority:
+                    winner = rule
+                    winner_index = index
+        if winner is None:
+            action = self._default_action
+            return {
+                "path": normalised,
+                "allowed": bool(action == "include"),
+                "action": action,
+                "rule_index": None,
+                "label": None,
+                "pattern": None,
+                "priority": None,
+                "specificity": None,
+                "matched": (),
+                "default_used": True,
+            }
+        return {
+            "path": normalised,
+            "allowed": bool(winner.action == "include"),
+            "action": winner.action,
+            "rule_index": winner_index,
+            "label": winner.label,
+            "pattern": winner.pattern,
+            "priority": winner.priority,
+            "specificity": winner.compiled.specificity,
+            "matched": tuple(matched),
+            "default_used": False,
+        }
+
+    def allows(self, path):
+        """Return True if *path* is allowed by this rule set."""
+        return self.explain(path)["allowed"]
+
+    def filter(self, paths):
+        """Return the tuple of normalised allowed paths, deduplicated."""
+        if isinstance(paths, (str, bytes, bytearray)):
+            raise TypeError("paths must be an iterable of str")
+        try:
+            iterator = iter(paths)
+        except TypeError:
+            raise TypeError("paths must be an iterable of str")
+        seen = set()
+        kept = []
+        for item in iterator:
+            normalised = normalize_path(item)
+            if normalised in seen:
+                continue
+            seen.add(normalised)
+            if self.allows(normalised):
+                kept.append(normalised)
+        return tuple(kept)
+
+
+class DecisionLog(object):
+    """Records the decisions taken by rule sets, stamped with a clock."""
+
+    def __init__(self, clock):
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._entries = []
+
+    def __len__(self):
+        return len(self._entries)
+
+    def record(self, ruleset, path):
+        """Evaluate *path* against *ruleset*, log the decision and return it."""
+        if not isinstance(ruleset, RuleSet):
+            raise TypeError(
+                "ruleset must be a RuleSet instance, got %r"
+                % (type(ruleset).__name__,)
+            )
+        entry = ruleset.explain(path)
+        entry["at"] = self._clock()
+        self._entries.append(entry)
+        return dict(entry)
+
+    def entries(self):
+        """Return a tuple of fresh copies of the recorded entries."""
+        return tuple(dict(entry) for entry in self._entries)
+
+    def summary(self):
+        """Return the counts of recorded include/exclude decisions."""
+        counts = {"include": 0, "exclude": 0, "total": len(self._entries)}
+        for entry in self._entries:
+            action = entry.get("action")
+            if action in counts:
+                counts[action] += 1
+        return counts
