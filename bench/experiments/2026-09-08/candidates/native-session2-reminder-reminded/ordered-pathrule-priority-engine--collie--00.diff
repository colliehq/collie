+"""Path normalisation for the rule engine.
+
+Paths are pure strings.  The only separator is '/'; the backslash is an
+ordinary literal character.  Nothing here ever touches the filesystem.
+"""
+
+from ruleerrors import PathTraversalError, RuleError
+
+__all__ = ["split_path", "normalize_path"]
+
+SEPARATOR = "/"
+
+
+def split_path(path):
+    """Split *path* into a tuple of clean segments."""
+    if not isinstance(path, str):
+        raise TypeError("path must be a str, got %r" % (type(path).__name__,))
+    if "\x00" in path:
+        raise RuleError("path must not contain a NUL character")
+    segments = []
+    for part in path.split(SEPARATOR):
+        if part == "" or part == ".":
+            continue
+        if part == "..":
+            raise PathTraversalError("path must not contain a '..' segment: %r" % (path,))
+        segments.append(part)
+    return tuple(segments)
+
+
+def normalize_path(path):
+    """Return the canonical string form of *path*."""
+    return SEPARATOR.join(split_path(path))
