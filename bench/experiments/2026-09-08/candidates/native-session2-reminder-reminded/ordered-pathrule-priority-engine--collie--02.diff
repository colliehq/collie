+"""Pattern compilation and matching for the path-rule engine.
+
+Patterns use the same slash semantics as paths (see :mod:`pathnorm`).  Inside a
+segment, ``\\`` escapes ``*`` or ``\\``, a single unescaped ``*`` matches zero
+or more characters within one segment, and a segment that is exactly ``**``
+matches zero or more whole segments.
+"""
+
+from pathnorm import split_path
+from ruleerrors import PathTraversalError, PatternError
+
+__all__ = ["Pattern", "compile_pattern"]
+
+_LITERAL = "literal"
+_GLOB = "glob"
+_DOUBLE = "double"
+
+
+def _parse_segment(segment):
+    """Validate *segment* and return ``(kind, parts)``.
+
+    ``parts`` is the list of literal chunks separated by unescaped stars for a
+    glob segment, the unescaped literal text for a literal segment, and ``None``
+    for a ``**`` segment.
+    """
+    if segment == "**":
+        return _DOUBLE, None
+
+    parts = []
+    current = []
+    has_star = False
+    previous_was_star = False
+    index = 0
+    length = len(segment)
+    while index < length:
+        char = segment[index]
+        if char == "\\":
+            if index + 1 >= length:
+                raise PatternError(
+                    "dangling backslash at the end of pattern segment %r" % (segment,)
+                )
+            nxt = segment[index + 1]
+            if nxt not in ("*", "\\"):
+                raise PatternError(
+                    "invalid escape '\\%s' in pattern segment %r" % (nxt, segment)
+                )
+            current.append(nxt)
+            previous_was_star = False
+            index += 2
+            continue
+        if char == "*":
+            if previous_was_star:
+                raise PatternError(
+                    "'**' is only allowed as a whole segment, got %r" % (segment,)
+                )
+            has_star = True
+            previous_was_star = True
+            parts.append("".join(current))
+            current = []
+            index += 1
+            continue
+        current.append(char)
+        previous_was_star = False
+        index += 1
+
+    parts.append("".join(current))
+    if has_star:
+        return _GLOB, parts
+    return _LITERAL, parts[0]
+
+
+def _match_glob(parts, text):
+    """Match *text* against the literal chunks *parts* separated by stars."""
+    first = parts[0]
+    if not text.startswith(first):
+        return False
+    position = len(first)
+    last = parts[-1]
+    middles = parts[1:-1]
+    for middle in middles:
+        if middle == "":
+            continue
+        found = text.find(middle, position)
+        if found < 0:
+            return False
+        position = found + len(middle)
+    if last == "":
+        return True
+    end = len(text) - len(last)
+    if end < position:
+        return False
+    return text.endswith(last)
+
+
+class Pattern(object):
+    """An immutable compiled path pattern."""
+
+    __slots__ = ("_source", "_segments", "_compiled", "_specificity")
+
+    def __init__(self, source):
+        if not isinstance(source, str):
+            raise TypeError(
+                "pattern must be a str, got %r" % (type(source).__name__,)
+            )
+        if "\x00" in source:
+            raise PatternError("pattern must not contain a NUL character")
+
+        raw_segments = []
+        for segment in source.split("/"):
+            if segment == "" or segment == ".":
+                continue
+            if segment == "..":
+                raise PathTraversalError(
+                    "pattern must not contain a '..' segment"
+                )
+            raw_segments.append(segment)
+
+        compiled = tuple(_parse_segment(segment) for segment in raw_segments)
+
+        literals = 0
+        globs = 0
+        doubles = 0
+        for kind, _parts in compiled:
+            if kind == _LITERAL:
+                literals += 1
+            elif kind == _GLOB:
+                globs += 1
+            else:
+                doubles += 1
+
+        object.__setattr__(self, "_source", source)
+        object.__setattr__(self, "_segments", tuple(raw_segments))
+        object.__setattr__(self, "_compiled", compiled)
+        object.__setattr__(
+            self, "_specificity", 100 * literals + 10 * globs + doubles
+        )
+
+    # -- immutability ----------------------------------------------------
+    def __setattr__(self, name, value):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Pattern instances are immutable")
+
+    # -- attributes ------------------------------------------------------
+    @property
+    def source(self):
+        return self._source
+
+    @property
+    def segments(self):
+        return self._segments
+
+    @property
+    def specificity(self):
+        return self._specificity
+
+    # -- matching --------------------------------------------------------
+    def match(self, path):
+        """Return ``True`` when *path* matches this pattern."""
+        segments = split_path(path)
+        return bool(self._match_from(0, segments, 0))
+
+    def _match_from(self, pattern_index, segments, path_index):
+        compiled = self._compiled
+        n_pattern = len(compiled)
+        n_path = len(segments)
+        while pattern_index < n_pattern:
+            kind, parts = compiled[pattern_index]
+            if kind == _DOUBLE:
+                for skip in range(path_index, n_path + 1):
+                    if self._match_from(pattern_index + 1, segments, skip):
+                        return True
+                return False
+            if path_index >= n_path:
+                return False
+            text = segments[path_index]
+            if kind == _LITERAL:
+                if text != parts:
+                    return False
+            else:
+                if not _match_glob(parts, text):
+                    return False
+            pattern_index += 1
+            path_index += 1
+        return path_index == n_path
+
+    # -- misc ------------------------------------------------------------
+    def __repr__(self):
+        return "Pattern(%r)" % (self._source,)
+
+    def __eq__(self, other):
+        if isinstance(other, Pattern):
+            return self._source == other._source
+        return NotImplemented
+
+    def __hash__(self):
+        return hash((Pattern, self._source))
+
+
+def compile_pattern(pattern):
+    """Compile *pattern* into a :class:`Pattern` instance."""
+    return Pattern(pattern)
