+"""Path normalisation for the ordered include/exclude path-rule engine.
+
+Paths are pure strings; the filesystem is never touched.  The only separator
+is ``/``; a backslash is an ordinary literal character.
+"""
+
+from ruleerrors import PathTraversalError, RuleError
+
+__all__ = ["split_path", "normalize_path"]
+
+
+def split_path(path):
+    """Split *path* into a tuple of clean segments.
+
+    Empty segments and ``"."`` segments are dropped; a ``".."`` segment is
+    always rejected with :class:`PathTraversalError`.
+    """
+    if not isinstance(path, str):
+        raise TypeError("path must be a str, got %r" % (type(path).__name__,))
+    if "\x00" in path:
+        raise RuleError("path must not contain a NUL character")
+    segments = []
+    for segment in path.split("/"):
+        if segment == "" or segment == ".":
+            continue
+        if segment == "..":
+            raise PathTraversalError("path must not contain a '..' segment")
+        segments.append(segment)
+    return tuple(segments)
+
+
+def normalize_path(path):
+    """Return the canonical string form of *path*."""
+    return "/".join(split_path(path))
