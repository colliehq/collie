+                "path": normalised,
+                "allowed": bool(action == "include"),
+                "action": action,
+                "rule_index": None,
+                "label": None,
+                "pattern": None,
+                "priority": None,
+                "specificity": None,
+                "matched": (),
+                "default_used": True,
+            }
+
+        action = winner.action
+        return {
+            "path": normalised,
+            "allowed": bool(action == "include"),
+            "action": action,
+            "rule_index": winner_index,
+            "label": winner.label,
+            "pattern": winner.pattern,
+            "priority": winner.priority,
+            "specificity": winner.compiled.specificity,
+            "matched": tuple(matched),
+            "default_used": False,
+        }
+
+    def allows(self, path):
+        """Return ``True`` when *path* is allowed by this rule set."""
+        return bool(self.explain(path)["allowed"])
+
+    def filter(self, paths):
+        """Return the tuple of normalised allowed paths, deduplicated."""
+        if isinstance(paths, (str, bytes, bytearray)):
+            raise TypeError("paths must be an iterable of str, not a string")
+        try:
+            iterator = iter(paths)
+        except TypeError:
+            raise TypeError(
+                "paths must be an iterable of str, got %r"
+                % (type(paths).__name__,)
+            )
+        seen = set()
+        kept = []
+        for item in iterator:
+            normalised = normalize_path(item)
+            if normalised in seen:
+                continue
+            seen.add(normalised)
+            if self.allows(normalised):
+                kept.append(normalised)
+        return tuple(kept)
+
+    def __repr__(self):
+        return "RuleSet(%r, default_action=%r)" % (
+            list(self._rules),
+            self._default_action,
+        )
+
+
+class DecisionLog(object):
+    """Record the decisions taken by rule sets, stamped with a clock."""
+
+    def __init__(self, clock):
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._entries = []
+
+    def record(self, ruleset, path):
+        """Evaluate *path* against *ruleset*, log the decision and return it."""
+        if not isinstance(ruleset, RuleSet):
+            raise TypeError(
+                "ruleset must be a RuleSet instance, got %r"
+                % (type(ruleset).__name__,)
+            )
+        entry = ruleset.explain(path)
+        entry["at"] = self._clock()
+        self._entries.append(entry)
+        return dict(entry)
+
+    def entries(self):
+        """Return a tuple of fresh copies of the recorded entries."""
+        return tuple(dict(entry) for entry in self._entries)
+
+    def __len__(self):
+        return len(self._entries)
+
+    def summary(self):
+        """Return counts of the recorded decisions by final action."""
+        counts = {"include": 0, "exclude": 0, "total": 0}
+        for entry in self._entries:
+            action = entry.get("action")
+            if action in counts:
+                counts[action] += 1
+            counts["total"] += 1
+        return counts
+
+    def __repr__(self):
+        return "DecisionLog(entries=%d)" % (len(self._entries),)
