+"""Rules, rule sets, evaluation, explanation and decision logging."""
+
+from pathnorm import normalize_path
+from patternmatch import compile_pattern
+
+__all__ = ["Rule", "RuleSet", "DecisionLog"]
+
+_ACTIONS = ("include", "exclude")
+
+
+class Rule(object):
+    """An immutable include/exclude rule."""
+
+    __slots__ = ("_pattern", "_action", "_priority", "_label", "_compiled")
+
+    def __init__(self, pattern, action, priority=0, label=None):
+        compiled = compile_pattern(pattern)
+
+        if not isinstance(action, str):
+            raise TypeError(
+                "action must be a str, got %r" % (type(action).__name__,)
+            )
+        if action not in _ACTIONS:
+            raise ValueError(
+                "action must be 'include' or 'exclude', got %r" % (action,)
+            )
+
+        if isinstance(priority, bool) or not isinstance(priority, int):
+            raise TypeError(
+                "priority must be an int, got %r" % (type(priority).__name__,)
+            )
+
+        if label is not None and not isinstance(label, str):
+            raise TypeError(
+                "label must be None or a str, got %r" % (type(label).__name__,)
+            )
+
+        object.__setattr__(self, "_pattern", compiled.source)
+        object.__setattr__(self, "_action", action)
+        object.__setattr__(self, "_priority", priority)
+        object.__setattr__(self, "_label", label)
+        object.__setattr__(self, "_compiled", compiled)
+
+    # -- immutability ----------------------------------------------------
+    def __setattr__(self, name, value):
+        raise AttributeError("Rule instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Rule instances are immutable")
+
+    # -- attributes ------------------------------------------------------
+    @property
+    def pattern(self):
+        return self._pattern
+
+    @property
+    def action(self):
+        return self._action
+
+    @property
+    def priority(self):
+        return self._priority
+
+    @property
+    def label(self):
+        return self._label
+
+    @property
+    def compiled(self):
+        return self._compiled
+
+    def matches(self, path):
+        """Return ``True`` when this rule's pattern matches *path*."""
+        return self._compiled.match(path)
+
+    def __repr__(self):
+        return "Rule(%r, %r, %r, %r)" % (
+            self._pattern,
+            self._action,
+            self._priority,
+            self._label,
+        )
+
+
+def _coerce_rules(rules):
+    """Validate *rules* and return them as a list (atomically)."""
+    if isinstance(rules, (str, bytes, bytearray)):
+        raise TypeError("rules must be an iterable of Rule, not a string")
+    try:
+        iterator = iter(rules)
+    except TypeError:
+        raise TypeError(
+            "rules must be an iterable of Rule, got %r" % (type(rules).__name__,)
+        )
+    collected = []
+    for item in iterator:
+        if not isinstance(item, Rule):
+            raise TypeError(
+                "every rule must be a Rule instance, got %r"
+                % (type(item).__name__,)
+            )
+        collected.append(item)
+    return collected
+
+
+class RuleSet(object):
+    """An ordered collection of :class:`Rule` objects with a default action."""
+
+    def __init__(self, rules=(), default_action="exclude"):
+        if not isinstance(default_action, str):
+            raise TypeError(
+                "default_action must be a str, got %r"
+                % (type(default_action).__name__,)
+            )
+        if default_action not in _ACTIONS:
+            raise ValueError(
+                "default_action must be 'include' or 'exclude', got %r"
+                % (default_action,)
+            )
+        collected = _coerce_rules(rules)
+        self._rules = collected
+        self._default_action = default_action
+
+    # -- attributes ------------------------------------------------------
+    @property
+    def default_action(self):
+        return self._default_action
+
+    @property
+    def rules(self):
+        return tuple(self._rules)
+
+    def __len__(self):
+        return len(self._rules)
+
+    # -- mutation --------------------------------------------------------
+    def add(self, rule):
+        """Append *rule* at the end and return this rule set."""
+        if not isinstance(rule, Rule):
+            raise TypeError(
+                "rule must be a Rule instance, got %r" % (type(rule).__name__,)
+            )
+        self._rules.append(rule)
+        return self
+
+    def extend(self, rules):
+        """Append every rule of *rules*, atomically; return this rule set."""
+        collected = _coerce_rules(rules)
+        self._rules.extend(collected)
+        return self
+
+    # -- evaluation ------------------------------------------------------
+    def explain(self, path):
+        """Return a fresh dict describing the decision taken for *path*."""
+        normalised = normalize_path(path)
+
+        matched = []
+        winner_index = None
+        winner = None
+        for index, rule in enumerate(self._rules):
+            if rule.compiled.match(normalised):
+                matched.append(index)
+                if winner is None or rule.priority >= winner.priority:
+                    winner = rule
+                    winner_index = index
