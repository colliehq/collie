+"""Textual rule format: ``action:priority:label:pattern`` per line."""
+
+import io
+
+from ruleengine import Rule
+from ruleerrors import RuleError, RuleSyntaxError
+
+__all__ = ["parse_rules", "load_rules"]
+
+_ACTIONS = ("include", "exclude")
+_DIGITS = "0123456789"
+_STRIP = " \t"
+
+
+def _parse_priority(field, line_number):
+    if field == "":
+        return 0
+    body = field
+    if body[0] in "+-":
+        body = body[1:]
+    if body == "":
+        raise RuleSyntaxError("invalid priority %r" % (field,), line_number)
+    for char in body:
+        if char not in _DIGITS:
+            raise RuleSyntaxError("invalid priority %r" % (field,), line_number)
+    return int(field)
+
+
+def parse_rules(text):
+    """Parse *text* into a tuple of :class:`Rule` objects, in file order."""
+    if not isinstance(text, str):
+        raise TypeError("text must be a str, got %r" % (type(text).__name__,))
+
+    rules = []
+    for offset, line in enumerate(text.splitlines()):
+        line_number = offset + 1
+        stripped = line.strip(_STRIP)
+        if stripped == "" or stripped.startswith("#"):
+            continue
+
+        fields = stripped.split(":", 3)
+        if len(fields) < 4:
+            raise RuleSyntaxError(
+                "expected 'action:priority:label:pattern'", line_number
+            )
+
+        action = fields[0].strip(_STRIP)
+        priority_field = fields[1].strip(_STRIP)
+        label_field = fields[2].strip(_STRIP)
+        pattern = fields[3]
+
+        if action not in _ACTIONS:
+            raise RuleSyntaxError(
+                "action must be 'include' or 'exclude', got %r" % (action,),
+                line_number,
+            )
+
+        priority = _parse_priority(priority_field, line_number)
+        label = label_field if label_field != "" else None
+
+        try:
+            rule = Rule(pattern, action, priority, label)
+        except RuleError as error:
+            raise RuleSyntaxError(
+                "invalid pattern %r: %s" % (pattern, error), line_number
+            )
+        rules.append(rule)
+
+    return tuple(rules)
+
+
+def load_rules(path):
+    """Read the UTF-8 rule file at *path* and parse its contents."""
+    if not isinstance(path, str):
+        raise TypeError("path must be a str, got %r" % (type(path).__name__,))
+    with io.open(path, "r", encoding="utf-8") as handle:
+        text = handle.read()
+    return parse_rules(text)
