+"""Compilation and matching of ordered path patterns."""
+
+import re
+
+from pathnorm import SEPARATOR, split_path
+from ruleerrors import PathTraversalError, PatternError
+
+STAR = "*"
+DOUBLE_STAR = "**"
+ESCAPE = "\\"
+NUL = "\x00"
+CURRENT = "."
+PARENT = ".."
+
+_LITERAL = "literal"
+_WILDCARD = "wildcard"
+
+
+def _parse_segment(segment):
+    """Return the token list of a segment that is not exactly '**'.
+
+    Tokens are ``(_LITERAL, text)`` or ``(_WILDCARD, None)``.
+    """
+    tokens = []
+    literal = []
+    previous_star = False
+    index = 0
+    length = len(segment)
+    while index < length:
+        char = segment[index]
+        if char == ESCAPE:
+            if index + 1 >= length:
+                raise PatternError(
+                    "dangling escape at end of segment %r" % (segment,)
+                )
+            following = segment[index + 1]
+            if following not in (STAR, ESCAPE):
+                raise PatternError(
+                    "invalid escape %r in segment %r" % ("\\" + following, segment)
+                )
+            literal.append(following)
+            previous_star = False
+            index += 2
+            continue
+        if char == STAR:
+            if previous_star:
+                raise PatternError(
+                    "consecutive '*' are only allowed as a whole '**' segment: %r"
+                    % (segment,)
+                )
+            if literal:
+                tokens.append((_LITERAL, "".join(literal)))
+                literal = []
+            tokens.append((_WILDCARD, None))
+            previous_star = True
+            index += 1
+            continue
+        literal.append(char)
+        previous_star = False
+        index += 1
+    if literal:
+        tokens.append((_LITERAL, "".join(literal)))
+    return tokens
+
+
+def _tokens_to_regex(tokens):
+    parts = []
+    for kind, text in tokens:
+        if kind == _LITERAL:
+            parts.append(re.escape(text))
+        else:
+            parts.append(".*")
+    return re.compile("".join(parts), re.DOTALL)
+
+
+def _has_unescaped_star(tokens):
+    for kind, _text in tokens:
+        if kind == _WILDCARD:
+            return True
+    return False
+
+
+class Pattern(object):
+    """A compiled, immutable path pattern."""
+
+    __slots__ = ("source", "segments", "specificity", "_matchers")
+
+    def __init__(self, source, segments, matchers, specificity):
+        object.__setattr__(self, "source", source)
+        object.__setattr__(self, "segments", tuple(segments))
+        object.__setattr__(self, "_matchers", tuple(matchers))
+        object.__setattr__(self, "specificity", specificity)
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Pattern instances are immutable")
+
+    def __repr__(self):
+        return "Pattern(%r)" % (self.source,)
+
+    def match(self, path):
+        """Return True when path matches this pattern."""
+        segments = split_path(path)
+        matchers = self._matchers
+        cache = {}
+
+        def walk(pattern_index, path_index):
+            key = (pattern_index, path_index)
+            cached = cache.get(key)
+            if cached is not None:
+                return cached
+            result = False
+            if pattern_index == len(matchers):
+                result = path_index == len(segments)
+            else:
+                current = matchers[pattern_index]
+                if current is None:  # '**'
+                    for nxt in range(path_index, len(segments) + 1):
+                        if walk(pattern_index + 1, nxt):
+                            result = True
+                            break
+                elif path_index < len(segments) and current.fullmatch(
+                    segments[path_index]
+                ):
+                    result = walk(pattern_index + 1, path_index + 1)
+            cache[key] = result
+            return result
+
+        return bool(walk(0, 0))
+
+
+def compile_pattern(pattern):
+    """Compile pattern into a Pattern object."""
+    if not isinstance(pattern, str):
+        raise TypeError(
+            "pattern must be a str, got %r" % (type(pattern).__name__,)
+        )
+    if NUL in pattern:
+        raise PatternError("pattern must not contain a NUL character")
+
+    segments = []
+    for raw in pattern.split(SEPARATOR):
+        if raw == "" or raw == CURRENT:
+            continue
+        if raw == PARENT:
+            raise PathTraversalError("'..' segment is not allowed in a pattern")
+        segments.append(raw)
+
+    matchers = []
+    literal_count = 0
+    star_count = 0
+    deep_count = 0
+    for segment in segments:
+        if segment == DOUBLE_STAR:
+            matchers.append(None)
+            deep_count += 1
+            continue
+        tokens = _parse_segment(segment)
+        matchers.append(_tokens_to_regex(tokens))
+        if _has_unescaped_star(tokens):
+            star_count += 1
+        else:
+            literal_count += 1
+
+    specificity = 100 * literal_count + 10 * star_count + deep_count
+    return Pattern(pattern, segments, matchers, specificity)
