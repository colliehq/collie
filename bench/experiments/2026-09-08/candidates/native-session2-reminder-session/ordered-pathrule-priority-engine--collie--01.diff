+"""Ordered include/exclude rule evaluation with explanation metadata."""
+
+from pathnorm import normalize_path
+from patternmatch import compile_pattern
+
+INCLUDE = "include"
+EXCLUDE = "exclude"
+ACTIONS = (INCLUDE, EXCLUDE)
+
+
+def _validate_action(action, name="action"):
+    if not isinstance(action, str):
+        raise TypeError(
+            "%s must be a str, got %r" % (name, type(action).__name__)
+        )
+    if action not in ACTIONS:
+        raise ValueError(
+            "%s must be 'include' or 'exclude', got %r" % (name, action)
+        )
+    return action
+
+
+def _iter_rules(rules):
+    """Return a list of validated Rule objects taken from an iterable."""
+    if isinstance(rules, (str, bytes, bytearray)):
+        raise TypeError("rules must be an iterable of Rule, not a string")
+    try:
+        iterator = iter(rules)
+    except TypeError:
+        raise TypeError("rules must be an iterable of Rule")
+    collected = []
+    for item in iterator:
+        if not isinstance(item, Rule):
+            raise TypeError(
+                "every element must be a Rule, got %r" % (type(item).__name__,)
+            )
+        collected.append(item)
+    return collected
+
+
+class Rule(object):
+    """A single immutable include/exclude rule."""
+
+    __slots__ = ("pattern", "action", "priority", "label", "compiled")
+
+    def __init__(self, pattern, action, priority=0, label=None):
+        compiled = compile_pattern(pattern)
+        _validate_action(action)
+        if isinstance(priority, bool) or not isinstance(priority, int):
+            raise TypeError(
+                "priority must be an int, got %r" % (type(priority).__name__,)
+            )
+        if label is not None and not isinstance(label, str):
+            raise TypeError(
+                "label must be None or a str, got %r" % (type(label).__name__,)
+            )
+        object.__setattr__(self, "pattern", pattern)
+        object.__setattr__(self, "action", action)
+        object.__setattr__(self, "priority", priority)
+        object.__setattr__(self, "label", label)
+        object.__setattr__(self, "compiled", compiled)
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Rule instances are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Rule instances are immutable")
+
+    def __repr__(self):
+        return "Rule(%r, %r, %r, %r)" % (
+            self.pattern,
+            self.action,
+            self.priority,
+            self.label,
+        )
+
+    def matches(self, path):
+        return self.compiled.match(path)
+
+
+class RuleSet(object):
+    """An ordered collection of rules with a default action."""
+
+    def __init__(self, rules=(), default_action=EXCLUDE):
+        _validate_action(default_action, "default_action")
+        collected = _iter_rules(rules)
+        self._default_action = default_action
+        self._rules = collected
+
+    @property
+    def default_action(self):
+        return self._default_action
+
+    @property
+    def rules(self):
+        return tuple(self._rules)
+
+    def __len__(self):
+        return len(self._rules)
+
+    def __repr__(self):
+        return "RuleSet(%r, default_action=%r)" % (
+            self.rules,
+            self._default_action,
+        )
+
+    def add(self, rule):
+        if not isinstance(rule, Rule):
+            raise TypeError(
+                "rule must be a Rule, got %r" % (type(rule).__name__,)
+            )
+        self._rules.append(rule)
+        return self
+
+    def extend(self, rules):
+        collected = _iter_rules(rules)
+        self._rules.extend(collected)
+        return self
+
+    def explain(self, path):
+        normalized = normalize_path(path)
+        matched = []
+        winner_index = None
+        winner = None
+        for index, rule in enumerate(self._rules):
+            if rule.compiled.match(normalized):
+                matched.append(index)
+                if winner is None or rule.priority >= winner.priority:
+                    winner = rule
+                    winner_index = index
+        if winner is None:
+            action = self._default_action
+            return {
+                "path": normalized,
+                "allowed": bool(action == INCLUDE),
+                "action": action,
+                "rule_index": None,
+                "label": None,
+                "pattern": None,
+                "priority": None,
+                "specificity": None,
+                "matched": (),
+                "default_used": True,
+            }
+        return {
+            "path": normalized,
+            "allowed": bool(winner.action == INCLUDE),
+            "action": winner.action,
+            "rule_index": winner_index,
+            "label": winner.label,
+            "pattern": winner.pattern,
+            "priority": winner.priority,
+            "specificity": winner.compiled.specificity,
+            "matched": tuple(matched),
+            "default_used": False,
+        }
+
+    def allows(self, path):
+        return bool(self.explain(path)["allowed"])
+
+    def filter(self, paths):
+        if isinstance(paths, (str, bytes, bytearray)):
+            raise TypeError("paths must be an iterable of str, not a string")
+        try:
+            iterator = iter(paths)
+        except TypeError:
+            raise TypeError("paths must be an iterable of str")
+        seen = set()
+        kept = []
+        for item in iterator:
+            normalized = normalize_path(item)
+            if normalized in seen:
+                continue
+            seen.add(normalized)
+            if self.allows(normalized):
+                kept.append(normalized)
+        return tuple(kept)
+
+
+class DecisionLog(object):
+    """A record of evaluated decisions, timestamped with a clock."""
+
+    def __init__(self, clock):
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._entries = []
+
+    def __len__(self):
+        return len(self._entries)
+
+    def record(self, ruleset, path):
+        if not isinstance(ruleset, RuleSet):
+            raise TypeError(
+                "ruleset must be a RuleSet, got %r" % (type(ruleset).__name__,)
+            )
+        explanation = ruleset.explain(path)
+        explanation["at"] = self._clock()
+        self._entries.append(explanation)
+        return dict(explanation)
+
+    def entries(self):
+        return tuple(dict(entry) for entry in self._entries)
+
+    def summary(self):
+        counts = {INCLUDE: 0, EXCLUDE: 0, "total": 0}
+        for entry in self._entries:
+            action = entry["action"]
+            if action in counts:
+                counts[action] += 1
+            counts["total"] += 1
+        return counts
