+"""Exception types shared by the path-rule engine."""
+
+
+class RuleError(ValueError):
+    """Base class for engine errors."""
+
+
+class PathTraversalError(RuleError):
+    """Raised for a '..' segment."""
+
+
+class PatternError(RuleError):
+    """Raised for an invalid pattern."""
+
+
+class RuleSyntaxError(RuleError):
+    """Raised for an unparsable rule line."""
+
+    def __init__(self, message, line_number):
+        super(RuleSyntaxError, self).__init__(
+            "line %s: %s" % (line_number, message)
+        )
+        self.message = message
+        self.line_number = int(line_number)
