+"""Validation and normalization helpers shared by the ledger modules."""
+
+import re
+
+from ledger_errors import ValidationError
+
+MAX_UNITS = 1000000
+MAX_CAPACITY = 1000000000
+
+_STRIP_CHARS = " \t\n\r\f\v"
+
+_RESOURCE_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
+_REQUEST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$")
+
+
+def normalize_resource_id(value):
+    """Return the canonical form of a resource id."""
+    if not isinstance(value, str) or isinstance(value, bool):
+        raise ValidationError("resource id must be a str")
+    text = str(value).strip(_STRIP_CHARS).lower()
+    if _RESOURCE_RE.match(text) is None:
+        raise ValidationError("malformed resource id: %r" % (value,))
+    return str(text)
+
+
+def normalize_request_id(value):
+    """Return the canonical (case sensitive) form of a request id."""
+    if not isinstance(value, str):
+        raise ValidationError("request id must be a str")
+    text = str(value).strip(_STRIP_CHARS)
+    if _REQUEST_RE.match(text) is None:
+        raise ValidationError("malformed request id: %r" % (value,))
+    return str(text)
+
+
+def normalize_units(value):
+    """Return a validated reservation size in whole units."""
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValidationError("units must be an int")
+    if not 1 <= value <= MAX_UNITS:
+        raise ValidationError("units out of range: %r" % (value,))
+    return int(value)
+
+
+def normalize_capacity(value):
+    """Return a validated capacity limit in whole units."""
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValidationError("capacity must be an int")
+    if not 0 <= value <= MAX_CAPACITY:
+        raise ValidationError("capacity out of range: %r" % (value,))
+    return int(value)
