+"""Exception hierarchy for the capacity reservation ledger."""
+
+
+class LedgerError(Exception):
+    """Base class for every error raised by the ledger package."""
+
+
+class ValidationError(LedgerError):
+    """Raised when an argument is malformed or out of range."""
+
+
+class UnknownResourceError(LedgerError):
+    """Raised when a well formed resource id is not registered."""
+
+
+class UnknownReservationError(LedgerError):
+    """Raised when a well formed request id is not known to the ledger."""
+
+
+class ConflictError(LedgerError):
+    """Raised when an operation contradicts the recorded state."""
+
+
+class CapacityError(LedgerError):
+    """Raised when an operation would exceed a resource's capacity limit."""
