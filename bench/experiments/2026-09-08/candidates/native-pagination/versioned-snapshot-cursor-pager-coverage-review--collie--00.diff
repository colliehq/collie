+"""Opaque cursor tokens.
+
+Token format (deterministic, no secrets):
+
+    payload = {"k": key, "r": rank, "v": version}
+    raw     = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    body    = urlsafe_b64encode(raw.encode("utf-8")) without "=" padding
+    sig     = sha256(("v1." + body).encode("ascii")).hexdigest()[:8]
+    token   = "v1." + body + "." + sig
+"""
+
+import base64
+import hashlib
+import json
+
+from pageerrors import InvalidCursorError
+
+__all__ = ["encode_cursor", "decode_cursor"]
+
+PREFIX = "v1"
+
+_B64_ALPHABET = frozenset(
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+    "abcdefghijklmnopqrstuvwxyz"
+    "0123456789-_"
+)
+
+
+def _is_int(value):
+    """True only for real ints; bools are explicitly rejected."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+def _signature(body):
+    return hashlib.sha256((PREFIX + "." + body).encode("ascii")).hexdigest()[:8]
+
+
+def encode_cursor(version, rank, key):
+    """Return an opaque token for the position (rank, key) in a snapshot."""
+    if not _is_int(version):
+        raise TypeError("version must be int")
+    if version < 0:
+        raise ValueError("version must be non-negative")
+    if not _is_int(rank):
+        raise TypeError("rank must be int")
+    if not isinstance(key, str):
+        raise TypeError("key must be str")
+    if key == "":
+        raise ValueError("key must be non-empty")
+
+    payload = {"k": key, "r": rank, "v": version}
+    raw = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    body = base64.urlsafe_b64encode(raw.encode("utf-8")).decode("ascii").rstrip("=")
+    return PREFIX + "." + body + "." + _signature(body)
+
+
+def decode_cursor(token):
+    """Return (version, rank, key) for a token produced by encode_cursor."""
+    if not isinstance(token, str):
+        raise TypeError("token must be str")
+
+    parts = token.split(".")
+    if len(parts) != 3:
+        raise InvalidCursorError("malformed cursor")
+    prefix, body, sig = parts
+    if prefix != PREFIX:
+        raise InvalidCursorError("unsupported cursor version")
+    if not body or any(ch not in _B64_ALPHABET for ch in body):
+        raise InvalidCursorError("malformed cursor body")
+    if sig != _signature(body):
+        raise InvalidCursorError("cursor signature mismatch")
+
+    try:
+        padding = "=" * (-len(body) % 4)
+        raw = base64.urlsafe_b64decode((body + padding).encode("ascii"))
+        payload = json.loads(raw.decode("utf-8"))
+    except InvalidCursorError:
+        raise
+    except Exception as exc:
+        raise InvalidCursorError("undecodable cursor") from exc
+
+    if not isinstance(payload, dict) or set(payload.keys()) != {"k", "r", "v"}:
+        raise InvalidCursorError("unexpected cursor payload")
+
+    version = payload["v"]
+    rank = payload["r"]
+    key = payload["k"]
+
+    if not _is_int(version) or version < 0:
+        raise InvalidCursorError("invalid cursor version")
+    if not _is_int(rank):
+        raise InvalidCursorError("invalid cursor rank")
+    if not isinstance(key, str) or key == "":
+        raise InvalidCursorError("invalid cursor key")
+
+    return (version, rank, key)
