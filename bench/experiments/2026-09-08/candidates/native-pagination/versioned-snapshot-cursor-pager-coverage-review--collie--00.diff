+"""Cursor pagination over snapshots."""
+
+from dataclasses import dataclass
+
+from cursorcodec import decode_cursor, encode_cursor
+from pageerrors import StaleCursorError
+from recordstore import Snapshot
+
+__all__ = ["Page", "paginate"]
+
+MAX_LIMIT = 100
+
+
+def _is_int(value):
+    """True only for real ints; bools are explicitly rejected."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+@dataclass(frozen=True)
+class Page:
+    """One slice of a snapshot plus the cursors framing it."""
+
+    items: tuple
+    total: int
+    has_prev: bool
+    has_next: bool
+    prev_cursor: object
+    next_cursor: object
+
+
+def _position(token, snapshot):
+    version, rank, key = decode_cursor(token)
+    if version != snapshot.version:
+        raise StaleCursorError("cursor was minted against another snapshot")
+    return (rank, key)
+
+
+def paginate(snapshot, *, limit, after=None, before=None, tag=None,
+             min_rank=None, max_rank=None):
+    """Return one page of `snapshot` without mutating it."""
+    if not isinstance(snapshot, Snapshot):
+        raise TypeError("snapshot must be a Snapshot")
+    if not _is_int(limit):
+        raise TypeError("limit must be int")
+    if limit < 1 or limit > MAX_LIMIT:
+        raise ValueError("limit must be between 1 and %d" % MAX_LIMIT)
+    if after is not None and not isinstance(after, str):
+        raise TypeError("after must be str or None")
+    if before is not None and not isinstance(before, str):
+        raise TypeError("before must be str or None")
+    if after is not None and before is not None:
+        raise ValueError("after and before are mutually exclusive")
+    if tag is not None and not isinstance(tag, str):
+        raise TypeError("tag must be str or None")
+    if tag == "":
+        raise ValueError("tag must be non-empty")
+    if min_rank is not None and not _is_int(min_rank):
+        raise TypeError("min_rank must be int or None")
+    if max_rank is not None and not _is_int(max_rank):
+        raise TypeError("max_rank must be int or None")
+    if min_rank is not None and max_rank is not None and min_rank > max_rank:
+        raise ValueError("min_rank must not exceed max_rank")
+
+    position = None
+    if after is not None:
+        position = _position(after, snapshot)
+    elif before is not None:
+        position = _position(before, snapshot)
+
+    matched = []
+    for record in snapshot.records:
+        if tag is not None and tag not in record.tags:
+            continue
+        if min_rank is not None and record.rank < min_rank:
+            continue
+        if max_rank is not None and record.rank > max_rank:
+            continue
+        matched.append(record)
+    matched.sort(key=lambda r: (r.rank, r.key))
+    total = len(matched)
+
+    if after is not None:
+        low = sum(1 for r in matched if (r.rank, r.key) <= position)
+        high = min(low + limit, total)
+    elif before is not None:
+        high = sum(1 for r in matched if (r.rank, r.key) < position)
+        low = max(0, high - limit)
+    else:
+        low = 0
+        high = min(limit, total)
+
+    items = tuple(matched[low:high])
+    has_prev = low > 0
+    has_next = high < total
+
+    prev_cursor = None
+    next_cursor = None
+    if items:
+        if has_prev:
+            prev_cursor = encode_cursor(snapshot.version, items[0].rank,
+                                        items[0].key)
+        if has_next:
+            next_cursor = encode_cursor(snapshot.version, items[-1].rank,
+                                        items[-1].key)
+
+    return Page(
+        items=items,
+        total=total,
+        has_prev=has_prev,
+        has_next=has_next,
+        prev_cursor=prev_cursor,
+        next_cursor=next_cursor,
+    )
