+"""Error types for the pagination library."""
+
+__all__ = ["PaginationError", "InvalidCursorError", "StaleCursorError"]
+
+
+class PaginationError(Exception):
+    """Base class for pagination failures."""
+
+
+class InvalidCursorError(PaginationError):
+    """The cursor token could not be understood."""
+
+
+class StaleCursorError(PaginationError):
+    """The cursor does not belong to this snapshot."""
