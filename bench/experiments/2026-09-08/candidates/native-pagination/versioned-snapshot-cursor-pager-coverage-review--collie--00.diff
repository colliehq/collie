+"""Versioned in-memory records."""
+
+from dataclasses import dataclass
+
+__all__ = ["Record", "Snapshot", "RecordStore"]
+
+
+def _is_int(value):
+    """True only for real ints; bools are explicitly rejected."""
+    return isinstance(value, int) and not isinstance(value, bool)
+
+
+@dataclass(frozen=True)
+class Record:
+    """One stored row - an immutable value object."""
+
+    key: str
+    rank: int
+    tags: tuple
+    updated_at: int
+
+
+@dataclass(frozen=True)
+class Snapshot:
+    """A point-in-time view of the store."""
+
+    version: int
+    records: tuple
+
+
+def _check_key(key):
+    if not isinstance(key, str):
+        raise TypeError("key must be str")
+    if key == "":
+        raise ValueError("key must be non-empty")
+
+
+def _normalise_tags(tags):
+    if isinstance(tags, (str, bytes, bytearray)):
+        raise TypeError("tags must be an iterable of str, not a string")
+    try:
+        items = list(tags)
+    except TypeError as exc:
+        raise TypeError("tags must be iterable") from exc
+    for item in items:
+        if not isinstance(item, str):
+            raise TypeError("tags must contain only str")
+    for item in items:
+        if item == "":
+            raise ValueError("tags must not contain empty strings")
+    return tuple(sorted(set(items)))
+
+
+class RecordStore:
+    """Holds records keyed by a unique string key."""
+
+    def __init__(self, clock):
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._records = {}
+        self._version = 0
+
+    @property
+    def version(self):
+        return self._version
+
+    def put(self, key, rank, tags=()):
+        _check_key(key)
+        if not _is_int(rank):
+            raise TypeError("rank must be int")
+        normalised = _normalise_tags(tags)
+        updated_at = self._clock()
+        if not _is_int(updated_at):
+            raise TypeError("clock must return int")
+
+        record = Record(key=key, rank=rank, tags=normalised,
+                        updated_at=updated_at)
+        self._records[key] = record
+        self._version += 1
+        return record
+
+    def remove(self, key):
+        _check_key(key)
+        if key not in self._records:
+            raise KeyError(key)
+        record = self._records.pop(key)
+        self._version += 1
+        return record
+
+    def get(self, key):
+        _check_key(key)
+        return self._records.get(key)
+
+    def snapshot(self):
+        ordered = tuple(sorted(self._records.values(),
+                               key=lambda r: (r.rank, r.key)))
+        return Snapshot(version=self._version, records=ordered)
