+"""Ordered include/exclude rule evaluation with explanation metadata."""
+
+from pathnorm import normalize_path
+from patternmatch import compile_pattern
+
+INCLUDE = "include"
+EXCLUDE = "exclude"
+ACTIONS = (INCLUDE, EXCLUDE)
+
+__all__ = ["Rule", "RuleSet", "DecisionLog"]
+
+
+def _check_action(action, what="action"):
+    if not isinstance(action, str):
+        raise TypeError("%s must be a str, not %r" % (what, type(action).__name__))
+    if action not in ACTIONS:
+        raise ValueError("%s must be 'include' or 'exclude', not %r" % (what, action))
+    return action
+
+
+def _iterate(items, what):
+    if isinstance(items, (str, bytes, bytearray)):
+        raise TypeError("%s must be an iterable of items, not a string" % (what,))
+    try:
+        iterator = iter(items)
+    except TypeError:
+        raise TypeError("%s must be iterable" % (what,))
+    return iterator
+
+
+class Rule(object):
+    """A single immutable include/exclude rule."""
+
+    __slots__ = ("pattern", "action", "priority", "label", "compiled")
+
+    def __init__(self, pattern, action, priority=0, label=None):
+        compiled = compile_pattern(pattern)
+        _check_action(action)
+        if isinstance(priority, bool) or not isinstance(priority, int):
+            raise TypeError(
+                "priority must be an int, not %r" % (type(priority).__name__,)
+            )
+        if label is not None and not isinstance(label, str):
+            raise TypeError(
+                "label must be None or a str, not %r" % (type(label).__name__,)
+            )
+        object.__setattr__(self, "pattern", pattern)
+        object.__setattr__(self, "action", action)
+        object.__setattr__(self, "priority", priority)
+        object.__setattr__(self, "label", label)
+        object.__setattr__(self, "compiled", compiled)
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Rule objects are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Rule objects are immutable")
+
+    def matches(self, path):
+        return self.compiled.match(path)
+
+    def __repr__(self):
+        return "Rule(%r, %r, %r, %r)" % (
+            self.pattern,
+            self.action,
+            self.priority,
+            self.label,
+        )
+
+
+class RuleSet(object):
+    """An ordered collection of rules with a default action."""
+
+    def __init__(self, rules=(), default_action=EXCLUDE):
+        self._default_action = _check_action(default_action, "default_action")
+        self._rules = []
+        self.extend(rules)
+
+    @property
+    def default_action(self):
+        return self._default_action
+
+    @property
+    def rules(self):
+        return tuple(self._rules)
+
+    def __len__(self):
+        return len(self._rules)
+
+    def add(self, rule):
+        if not isinstance(rule, Rule):
+            raise TypeError("rule must be a Rule, not %r" % (type(rule).__name__,))
+        self._rules.append(rule)
+        return self
+
+    def extend(self, rules):
+        iterator = _iterate(rules, "rules")
+        collected = []
+        for rule in iterator:
+            if not isinstance(rule, Rule):
+                raise TypeError(
+                    "rules must contain Rule objects, not %r" % (type(rule).__name__,)
+                )
+            collected.append(rule)
+        self._rules.extend(collected)
+        return self
+
+    def explain(self, path):
+        normalized = normalize_path(path)
+        matched = []
+        winner_index = None
+        for index, rule in enumerate(self._rules):
+            if rule.compiled.match(normalized):
+                matched.append(index)
+                if (
+                    winner_index is None
+                    or rule.priority >= self._rules[winner_index].priority
+                ):
+                    winner_index = index
+        if winner_index is None:
+            action = self._default_action
+            return {
+                "path": normalized,
+                "allowed": bool(action == INCLUDE),
+                "action": action,
+                "rule_index": None,
+                "label": None,
+                "pattern": None,
+                "priority": None,
+                "specificity": None,
+                "matched": (),
+                "default_used": True,
+            }
+        winner = self._rules[winner_index]
+        return {
+            "path": normalized,
+            "allowed": bool(winner.action == INCLUDE),
+            "action": winner.action,
+            "rule_index": winner_index,
+            "label": winner.label,
+            "pattern": winner.pattern,
+            "priority": winner.priority,
+            "specificity": winner.compiled.specificity,
+            "matched": tuple(matched),
+            "default_used": False,
+        }
+
+    def allows(self, path):
+        return bool(self.explain(path)["allowed"])
+
+    def filter(self, paths):
+        iterator = _iterate(paths, "paths")
+        seen = set()
+        kept = []
+        for item in iterator:
+            normalized = normalize_path(item)
+            if normalized in seen:
+                continue
+            seen.add(normalized)
+            if self.allows(normalized):
+                kept.append(normalized)
+        return tuple(kept)
+
+    def __repr__(self):
+        return "RuleSet(%d rules, default_action=%r)" % (
+            len(self._rules),
+            self._default_action,
+        )
+
+
+class DecisionLog(object):
+    """A record of rule set decisions stamped with a clock value."""
+
+    def __init__(self, clock):
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._entries = []
+
+    def __len__(self):
+        return len(self._entries)
+
+    def record(self, ruleset, path):
+        if not isinstance(ruleset, RuleSet):
+            raise TypeError(
+                "ruleset must be a RuleSet, not %r" % (type(ruleset).__name__,)
+            )
+        entry = ruleset.explain(path)
+        entry["at"] = self._clock()
+        self._entries.append(entry)
+        return dict(entry)
+
+    def entries(self):
+        return tuple(dict(entry) for entry in self._entries)
+
+    def summary(self):
+        counts = {INCLUDE: 0, EXCLUDE: 0, "total": 0}
+        for entry in self._entries:
+            action = entry["action"]
+            if action in counts:
+                counts[action] += 1
+            counts["total"] += 1
+        return counts
