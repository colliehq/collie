+"""Parsing of the textual rule format into Rule objects."""
+
+import re
+
+from ruleengine import Rule
+from ruleerrors import RuleError, RuleSyntaxError
+
+COMMENT = "#"
+FIELD_SEPARATOR = ":"
+STRIP_CHARS = " \t"
+ACTIONS = ("include", "exclude")
+_PRIORITY_RE = re.compile(r"[+-]?[0-9]+\Z")
+
+__all__ = ["parse_rules", "load_rules"]
+
+
+def parse_rules(text):
+    """Parse rule text and return the rules in file order."""
+    if not isinstance(text, str):
+        raise TypeError("text must be a str, not %r" % (type(text).__name__,))
+    rules = []
+    for line_number, line in enumerate(text.splitlines(), 1):
+        stripped = line.strip(STRIP_CHARS)
+        if stripped == "" or stripped.startswith(COMMENT):
+            continue
+        fields = stripped.split(FIELD_SEPARATOR, 3)
+        if len(fields) < 4:
+            raise RuleSyntaxError(
+                "expected 4 colon separated fields", line_number
+            )
+        action = fields[0].strip(STRIP_CHARS)
+        priority_text = fields[1].strip(STRIP_CHARS)
+        label_text = fields[2].strip(STRIP_CHARS)
+        pattern = fields[3]
+        if action not in ACTIONS:
+            raise RuleSyntaxError(
+                "action must be 'include' or 'exclude', not %r" % (action,),
+                line_number,
+            )
+        if priority_text == "":
+            priority = 0
+        elif _PRIORITY_RE.match(priority_text):
+            priority = int(priority_text)
+        else:
+            raise RuleSyntaxError(
+                "invalid priority %r" % (priority_text,), line_number
+            )
+        label = label_text if label_text else None
+        try:
+            rule = Rule(pattern, action, priority, label)
+        except RuleError as error:
+            raise RuleSyntaxError(
+                "invalid pattern %r: %s" % (pattern, error), line_number
+            )
+        rules.append(rule)
+    return tuple(rules)
+
+
+def load_rules(path):
+    """Read rule text from *path* and return the rules."""
+    if not isinstance(path, str):
+        raise TypeError("path must be a str, not %r" % (type(path).__name__,))
+    with open(path, "r", encoding="utf-8") as handle:
+        return parse_rules(handle.read())
