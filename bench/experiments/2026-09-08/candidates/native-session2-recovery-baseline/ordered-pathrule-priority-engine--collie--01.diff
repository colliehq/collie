+"""Compilation and matching of ordered path patterns."""
+
+from pathnorm import SEPARATOR, split_path
+from ruleerrors import PathTraversalError, PatternError
+
+STAR = "*"
+DOUBLE_STAR = "**"
+ESCAPE = "\\"
+NUL = "\x00"
+
+DOUBLE_STAR_MARKER = object()
+
+__all__ = ["Pattern", "compile_pattern"]
+
+
+def _parse_segment(segment):
+    """Return (tokens, has_star) for a plain (non ``**``) segment.
+
+    Tokens are either literal ``str`` pieces or the ``None`` marker which
+    stands for a single unescaped star.
+    """
+    tokens = []
+    literal = []
+    has_star = False
+    previous_star = False
+    index = 0
+    length = len(segment)
+    while index < length:
+        char = segment[index]
+        if char == ESCAPE:
+            if index + 1 >= length:
+                raise PatternError(
+                    "dangling escape at end of segment %r" % (segment,)
+                )
+            following = segment[index + 1]
+            if following not in (STAR, ESCAPE):
+                raise PatternError(
+                    "invalid escape %r in segment %r" % (ESCAPE + following, segment)
+                )
+            literal.append(following)
+            previous_star = False
+            index += 2
+            continue
+        if char == STAR:
+            if previous_star:
+                raise PatternError(
+                    "'**' is only allowed as a whole segment: %r" % (segment,)
+                )
+            if literal:
+                tokens.append("".join(literal))
+                literal = []
+            tokens.append(None)
+            has_star = True
+            previous_star = True
+            index += 1
+            continue
+        literal.append(char)
+        previous_star = False
+        index += 1
+    if literal:
+        tokens.append("".join(literal))
+    return tuple(tokens), has_star
+
+
+def _match_from(tokens, token_index, text, position):
+    while token_index < len(tokens):
+        token = tokens[token_index]
+        if token is None:
+            if token_index + 1 == len(tokens):
+                return True
+            for nxt in range(position, len(text) + 1):
+                if _match_from(tokens, token_index + 1, text, nxt):
+                    return True
+            return False
+        if not text.startswith(token, position):
+            return False
+        position += len(token)
+        token_index += 1
+    return position == len(text)
+
+
+def _match_tokens(tokens, text):
+    return _match_from(tokens, 0, text, 0)
+
+
+def _match_all(compiled, segments, pattern_index, path_index):
+    while pattern_index < len(compiled):
+        current = compiled[pattern_index]
+        if current is DOUBLE_STAR_MARKER:
+            if pattern_index + 1 == len(compiled):
+                return True
+            for nxt in range(path_index, len(segments) + 1):
+                if _match_all(compiled, segments, pattern_index + 1, nxt):
+                    return True
+            return False
+        if path_index >= len(segments):
+            return False
+        if not _match_tokens(current, segments[path_index]):
+            return False
+        pattern_index += 1
+        path_index += 1
+    return path_index == len(segments)
+
+
+class Pattern(object):
+    """An immutable compiled path pattern."""
+
+    __slots__ = ("source", "segments", "specificity", "_compiled")
+
+    def __init__(self, source, segments, compiled, specificity):
+        object.__setattr__(self, "source", source)
+        object.__setattr__(self, "segments", tuple(segments))
+        object.__setattr__(self, "_compiled", tuple(compiled))
+        object.__setattr__(self, "specificity", int(specificity))
+
+    def __setattr__(self, name, value):
+        raise AttributeError("Pattern objects are immutable")
+
+    def __delattr__(self, name):
+        raise AttributeError("Pattern objects are immutable")
+
+    def match(self, path):
+        """Return True when *path* matches this pattern."""
+        segments = split_path(path)
+        return bool(_match_all(self._compiled, segments, 0, 0))
+
+    def __repr__(self):
+        return "Pattern(%r)" % (self.source,)
+
+
+def compile_pattern(pattern):
+    """Compile *pattern* into a :class:`Pattern`."""
+    if not isinstance(pattern, str):
+        raise TypeError(
+            "pattern must be a str, not %r" % (type(pattern).__name__,)
+        )
+    if NUL in pattern:
+        raise PatternError("pattern must not contain a NUL character")
+    raw_segments = []
+    for raw in pattern.split(SEPARATOR):
+        if raw == "" or raw == ".":
+            continue
+        if raw == "..":
+            raise PathTraversalError("pattern must not contain a '..' segment")
+        raw_segments.append(raw)
+    compiled = []
+    literal_count = 0
+    star_count = 0
+    deep_count = 0
+    for segment in raw_segments:
+        if segment == DOUBLE_STAR:
+            compiled.append(DOUBLE_STAR_MARKER)
+            deep_count += 1
+            continue
+        tokens, has_star = _parse_segment(segment)
+        compiled.append(tokens)
+        if has_star:
+            star_count += 1
+        else:
+            literal_count += 1
+    specificity = 100 * literal_count + 10 * star_count + deep_count
+    return Pattern(pattern, raw_segments, compiled, specificity)
